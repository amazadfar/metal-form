---
/**
 * HOMEPAGE
 *
 * Two jobs at once. Read alone it has to explain a manufacturing business in
 * about forty seconds. Presented live it has to give a salesperson obvious
 * talking points and let them jump to any vertical in one click.
 *
 * ── Order ───────────────────────────────────────────────────────────────────
 * Industries used to sit two thirds of the way down, after the full argument
 * for changing supplier. That is the wrong way round: a buyer arrives wanting
 * to know whether this company makes anything like their part, and will not
 * read three sections of general positioning to find out.
 *
 * So the order is now: what we do and what it costs you to find out (hero,
 * with the verified capability rail as its floor) → which door is yours
 * (industries, immediately) → how the chain works → the engineering depth
 * behind it → what we will and will not claim → who we are → send us the part.
 *
 * The depth is not removed, only deferred. A visitor who wants the argument
 * still gets all of it; a visitor who wants their industry gets it in one
 * screen.
 */
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Hero from '../../components/home/Hero.astro';
import ProcessRail from '../../components/home/ProcessRail.astro';
import Pillars from '../../components/home/Pillars.astro';
import IndustryBento from '../../components/IndustryBento.astro';
import TrustRow from '../../components/TrustRow.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import RfqDock from '../../components/RfqDock.astro';
import { LOCALE_ORDER, localePath, type Locale } from '../../i18n/locales.ts';
import { getHome, getCommon } from '../../content/index.ts';
import { absoluteUrl, breadcrumbSchema } from '../../lib/seo.ts';
import { BRAND } from '../../config/site.ts';

export function getStaticPaths() {
  return LOCALE_ORDER.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const h = getHome(locale);
const c = getCommon(locale);

const stages = h.process.steps.map((s) => s.title);

const schemas = [
  breadcrumbSchema([{ name: BRAND.name, url: absoluteUrl(locale) }]),
];
---

<Base locale={locale} meta={h.meta} route="" schemas={schemas}>
  <a class="skip-link" href="#main">{c.a11y.skipToContent}</a>
  <SiteHeader locale={locale} overDark />

  <main id="main">
  <Hero
    locale={locale}
    hero={h.hero}
    prefill={h.cta.prefill}
    stages={stages}
    d={h.diagram.hero}
    schematicLabel={c.schematic}
  />

  {/* ── Industries — the second thing on the page, not the sixth ───────── */}
  <section class="ind" id="industries">
    <div class="shell--wide">
      <p class="eyebrow">{h.bento.kicker}</p>
      <div class="ind__head split">
        <h2 class="t-statement t-statement--xl ind__title" data-split-copy>{h.bento.heading}</h2>
        <p class="t-lead ind__lead" data-split-figure>{h.bento.lead}</p>
      </div>
    </div>

    <div class="shell--wide ind__grid">
      <IndustryBento locale={locale} />
    </div>

    <div class="shell--wide ind__fallback">
      <p class="ind__fallback-text">{h.bento.fallback}</p>
      <a class="btn btn--ruled" href={localePath(locale, 'industries', 'custom-projects')}>
        <span>{h.bento.fallbackAction}</span>
        <svg class="btn__arrow" viewBox="0 0 16 12" aria-hidden="true" fill="none">
          <path d="M1 6h13M9.5 1.2 14.3 6l-4.8 4.8" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </a>
    </div>
  </section>

  {/* ── How the chain works ────────────────────────────────────────────── */}
  <ProcessRail process={h.process} d={h.diagram.process} schematicLabel={c.schematic} />

  {/* ── The engineering depth behind it ────────────────────────────────── */}
  <Pillars pillars={h.pillars} d={h.diagram.hero} schematicLabel={c.schematic} />

  {/* ── Evidence + trust ───────────────────────────────────────────────── */}
  <section class="proof">
    <div class="shell--wide proof__inner split">
      <div class="proof__copy" data-split-copy>
        <p class="eyebrow">{h.proof.kicker}</p>
        <h2 class="t-h3 proof__title">{h.proof.heading}</h2>
        <p class="t-lead proof__lead">{h.proof.lead}</p>
        <p class="proof__disclosure">{h.proof.disclosure}</p>
      </div>
      <div class="proof__trust" data-split-figure>
        <TrustRow locale={locale} layout="stack" />
      </div>
    </div>
  </section>

  {/* ── About ──────────────────────────────────────────────────────────── */}
  <section class="ab" id="about">
    <div class="shell ab__inner">
      <p class="eyebrow">{h.about.kicker}</p>
      <h2 class="t-h3 ab__title">{h.about.heading}</h2>
      <div class="ab__body">
        {h.about.body.map((p) => <p>{p}</p>)}
      </div>
      <p class="ab__position">{h.about.position}</p>
      <a class="btn btn--ghost" href={localePath(locale, 'about')}>
        <span>{c.nav.about}</span>
        <svg class="btn__arrow" viewBox="0 0 16 12" aria-hidden="true" fill="none">
          <path d="M1 6h13M9.5 1.2 14.3 6l-4.8 4.8" stroke="currentColor" stroke-width="1.4" />
        </svg>
      </a>
    </div>
  </section>

  <CtaBlock locale={locale} cta={h.cta} source="home_cta" index="06" inverse />
  </main>

  <SiteFooter locale={locale} />
  <RfqDock locale={locale} prefill={h.cta.prefill} source="home_cta" />
</Base>

<style>
  /* ── Industries ───────────────────────────────────────────────────────── */
  .ind { padding-block: var(--section-y-tight) var(--section-y); }
  .ind__head {
    margin-block-start: var(--sp-5);
    padding-block-start: var(--sp-6);
    border-block-start: var(--rule-strong);
    --split-a: 1.15fr;
    --split-b: 0.85fr;
    --split-align: end;
  }
  .ind__title { max-inline-size: 11ch; }
  .ind__lead { padding-block-end: 0.35em; }
  .ind__grid { margin-block-start: clamp(1.5rem, 4vw, 3.5rem); }
  /* On a phone the section heading was taking a screen of its own before the
     first industry appeared. */
  @media (max-width: 720px) {
    .ind { padding-block: var(--sp-8) var(--sp-9); }
    .ind__head { margin-block-start: var(--sp-4); padding-block-start: var(--sp-5); }
    .ind__title { font-size: var(--step-5); }
    .ind__lead { font-size: var(--step-0); }
  }

  .ind__fallback {
    margin-block-start: var(--sp-7);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
    flex-wrap: wrap;
    padding-block-start: var(--sp-5);
    border-block-start: var(--rule);
  }
  .ind__fallback-text {
    font-size: var(--step-1);
    letter-spacing: var(--track-head);
    max-inline-size: 40ch;
  }

  /* ── Proof ────────────────────────────────────────────────────────────── */
  .proof {
    padding-block: var(--section-y);
    background: var(--surface-sunk);
    border-block: var(--rule);
  }
  .proof__inner { --split-a: 1.1fr; --split-b: 0.9fr; }

  .proof__title { margin-block-start: var(--sp-5); max-inline-size: 18ch; }
  .proof__lead { margin-block-start: var(--sp-5); }
  .proof__disclosure {
    margin-block-start: var(--sp-6);
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 60ch;
  }

  /* ── About ────────────────────────────────────────────────────────────── */
  .ab { padding-block: var(--section-y); }
  .ab__title { margin-block-start: var(--sp-5); max-inline-size: 22ch; }
  .ab__body {
    margin-block-start: var(--sp-7);
    display: grid;
    gap: var(--sp-5);
    max-inline-size: 68ch;
    color: var(--ink-muted);
    font-size: var(--step-0);
  }
  .ab__position {
    margin-block-start: var(--sp-7);
    font-size: var(--step-2);
    line-height: 1.35;
    letter-spacing: var(--track-head);
    max-inline-size: 30ch;
    color: var(--ink);
  }
  .ab .btn { margin-block-start: var(--sp-6); }
</style>
