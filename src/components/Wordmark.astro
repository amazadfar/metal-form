---
/**
 * The mark.
 *
 * No logo file exists, so the identity is typographic plus one drawn glyph:
 * a square split by a parting line with a cavity straddling it — a mould, in
 * the fewest strokes that still read at 16px. It carries meaning rather than
 * decoration, which is the whole brief for this brand.
 *
 * The name comes from `BRAND` so a future rebrand is a one-line change.
 */
import { BRAND } from '../config/site.ts';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  /** Render as a link back to the locale home. Omit on the home page itself. */
  href?: string;
  /** Inverts to the light-on-dark treatment. */
  inverse?: boolean;
  class?: string;
}

const { size = 'md', href, inverse = false, class: className = '' } = Astro.props;
const [first, second] = BRAND.nameParts;
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['wm', `wm--${size}`, inverse && 'wm--inverse', className]}
  href={href}
  aria-label={href ? `${BRAND.name} — home` : undefined}
  dir="ltr"
>
  <svg class="wm__glyph" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    {/* Mould block */}
    <rect x="2.6" y="2.6" width="26.8" height="26.8" fill="none" stroke="currentColor" stroke-width="1.6" />
    {/* Parting line — the split between the two halves */}
    <line x1="16" y1="2.6" x2="16" y2="29.4" stroke="currentColor" stroke-width="1.1" opacity="0.55" />
    {/* Cavity, straddling the split */}
    <circle cx="16" cy="16" r="6.4" fill="none" stroke="currentColor" stroke-width="1.6" />
    {/* Gate */}
    <line x1="16" y1="2.6" x2="16" y2="9.6" stroke="currentColor" stroke-width="2.4" />
  </svg>

  <span class="wm__type">
    <span class="wm__a">{first}</span><span class="wm__b">{second}</span>
  </span>
</Tag>

<style>
  .wm {
    --wm-size: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.62em;
    font-size: var(--wm-size);
    line-height: 1;
    color: var(--ink);
    /* The wordmark stays Latin in every locale — it is a registered name, not
       a translatable string. */
    font-family: var(--font-latin);
    white-space: nowrap;
    transition: color var(--dur-2) var(--ease-out);
  }
  .wm--sm { --wm-size: 0.9rem; }
  .wm--md { --wm-size: 1.05rem; }
  .wm--lg { --wm-size: 1.4rem; }
  .wm--inverse { color: var(--inverse-ink); }

  .wm__glyph {
    inline-size: 1.32em;
    block-size: 1.32em;
    flex: none;
    overflow: visible;
  }

  .wm__type {
    display: inline-flex;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-size: 0.92em;
  }
  .wm__a { font-weight: 600; }
  .wm__b { font-weight: 400; opacity: 0.72; margin-inline-start: 0.42em; }

  a.wm:hover { color: var(--accent-deep); }
  a.wm--inverse:hover { color: var(--inverse-ink); opacity: 0.8; }
</style>
