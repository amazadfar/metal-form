---
/**
 * ─────────────────────────────────────────────────────────────────────────────
 * LANGUAGE FLAGS — drawn, not fetched
 * ─────────────────────────────────────────────────────────────────────────────
 * Nine national flags as inline SVG at their true aspect ratios, in their
 * official colours. No emoji: emoji flags are a font lottery — they render as
 * two letters on most of Windows, they cannot be cropped, scrimmed or
 * composed, and at card size they look like a chat message.
 *
 * ── Two decisions worth recording ───────────────────────────────────────────
 *
 * 1. Every card shows a CROP of its flag, never the whole field. That is a
 *    uniform art direction, and it is also the honest answer to one specific
 *    problem: the flag of Iran carries a central emblem whose geometry this
 *    project cannot reproduce faithfully, and a tricolour drawn without that
 *    emblem is not a neutral simplification — it is a different, historical
 *    flag. Rather than render one country less accurately than the other
 *    eight, no card renders a complete flag. The crop is the composition, and
 *    the language name is what identifies the tile.
 *
 * 2. Geometry follows each country's published construction where one exists —
 *    the union flag's 1:2 field with its 6/4/10/6 stroke widths, the Turkish
 *    crescent's two-circle construction, the five-band Thai proportions of
 *    1:1:2:1:1. Getting these wrong is the kind of detail a buyer from that
 *    market notices immediately, and it is exactly the kind of care the rest
 *    of this site claims to take with a drawing.
 *
 * `slice` on preserveAspectRatio is what makes the crop happen: the flag fills
 * the card and overflows it, rather than letter-boxing inside it.
 */
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
  /**
   * `chip` is the one used on the selector: the flag fills a small 4:3 plate
   * and is cropped by it. 4:3 is chosen deliberately — every one of these nine
   * flags keeps the feature that identifies it inside a centred 4:3 crop
   * (Pakistan's crescent, China's stars, the union flag's cross, the UAE's
   * hoist bar), and a single ratio is what makes a row of nine chips look
   * designed rather than assembled.
   *
   * `field` and `hoist` fill a larger box; kept for any future use where a
   * flag is the ground rather than a mark.
   */
  variant?: 'chip' | 'field' | 'hoist';
  class?: string;
}
const { locale, variant = 'field', class: className = '' } = Astro.props;

const fit = variant === 'hoist' ? 'xMinYMid slice' : 'xMidYMid slice';

/** Five-pointed star as a path, outer radius 1, centred on the origin. */
function star(rotationDeg = 0): string {
  const pts: string[] = [];
  for (let i = 0; i < 10; i++) {
    const r = i % 2 === 0 ? 1 : 0.38196601;
    const a = ((i * 36 - 90 + rotationDeg) * Math.PI) / 180;
    pts.push(`${(Math.cos(a) * r).toFixed(5)},${(Math.sin(a) * r).toFixed(5)}`);
  }
  return `M${pts.join('L')}Z`;
}

const STAR = star();
/** The small stars on the flag of China each point at the large one. */
const chinaSmall = [
  { x: 10, y: 2, rot: 23.036 },
  { x: 12, y: 4, rot: 45.87 },
  { x: 12, y: 7, rot: 69.945 },
  { x: 10, y: 9, rot: 20.66 },
];
---

{locale === 'en' && (
  /* United Kingdom — 1:2, per the published construction. */
  <svg class:list={['flag', className]} viewBox="0 0 60 30" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <clipPath id="mf-flag-gb-clip">
      <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
    </clipPath>
    <rect width="60" height="30" fill="#012169" />
    <path d="M0,0 L60,30 M60,0 L0,30" stroke="#FFFFFF" stroke-width="6" />
    <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#mf-flag-gb-clip)" stroke="#C8102E" stroke-width="4" />
    <path d="M30,0 v30 M0,15 h60" stroke="#FFFFFF" stroke-width="10" />
    <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
  </svg>
)}

{locale === 'ru' && (
  /* Russia — 2:3, equal bands. */
  <svg class:list={['flag', className]} viewBox="0 0 9 6" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="9" height="6" fill="#FFFFFF" />
    <rect y="2" width="9" height="4" fill="#0039A6" />
    <rect y="4" width="9" height="2" fill="#D52B1E" />
  </svg>
)}

{locale === 'hy' && (
  /* Armenia — 1:2, equal bands. */
  <svg class:list={['flag', className]} viewBox="0 0 6 3" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="6" height="3" fill="#D90012" />
    <rect y="1" width="6" height="2" fill="#0033A0" />
    <rect y="2" width="6" height="1" fill="#F2A800" />
  </svg>
)}

{locale === 'tr' && (
  /* Türkiye — 2:3. Crescent from two circles, star rotated so one arm points
     back towards the crescent's opening, per the TSE construction. */
  <svg class:list={['flag', className]} viewBox="0 0 1200 800" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="1200" height="800" fill="#E30A17" />
    <circle cx="425" cy="400" r="200" fill="#FFFFFF" />
    <circle cx="475" cy="400" r="160" fill="#E30A17" />
    <path d={STAR} fill="#FFFFFF" transform="translate(725,400) rotate(-90) scale(100)" />
  </svg>
)}

{locale === 'th' && (
  /* Thailand — 2:3, bands in 1:1:2:1:1. */
  <svg class:list={['flag', className]} viewBox="0 0 9 6" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="9" height="6" fill="#A51931" />
    <rect y="1" width="9" height="4" fill="#F4F5F8" />
    <rect y="2" width="9" height="2" fill="#2D2A4A" />
  </svg>
)}

{locale === 'zh' && (
  /* China — 2:3. Large star at (5,5) with radius 3; the four small stars sit
     on the published grid and each is rotated to face the large one. */
  <svg class:list={['flag', className]} viewBox="0 0 30 20" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="30" height="20" fill="#EE1C25" />
    <path d={STAR} fill="#FFDE00" transform="translate(5,5) scale(3)" />
    {chinaSmall.map((s) => (
      <path d={STAR} fill="#FFDE00" transform={`translate(${s.x},${s.y}) rotate(${s.rot}) scale(1)`} />
    ))}
  </svg>
)}

{locale === 'ur' && (
  /* Pakistan — 2:3. White hoist band is a quarter of the field; the crescent
     and star are centred in the green. */
  <svg class:list={['flag', className]} viewBox="0 0 900 600" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="900" height="600" fill="#01411C" />
    <rect width="225" height="600" fill="#FFFFFF" />
    <circle cx="618.75" cy="300" r="168.75" fill="#FFFFFF" />
    <circle cx="675" cy="243.75" r="168.75" fill="#01411C" />
    <path d={STAR} fill="#FFFFFF" transform="translate(731.25,196.875) rotate(-41.25) scale(84.375)" />
  </svg>
)}

{locale === 'ar' && (
  /* United Arab Emirates — 1:2. Chosen as a neutral, widely recognised
     Arab-market visual for a language shared across many states. */
  <svg class:list={['flag', className]} viewBox="0 0 12 6" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="12" height="6" fill="#FFFFFF" />
    <rect width="12" height="2" fill="#00732F" />
    <rect y="4" width="12" height="2" fill="#000000" />
    <rect width="3" height="6" fill="#FF0000" />
  </svg>
)}

{locale === 'fa' && (
  /* Iran — 4:7, equal bands, with the fine band that runs along the inner
     edge of the green and the red. The central emblem is not drawn; see the
     note at the top of this file for why no card shows a complete field. */
  <svg class:list={['flag', className]} viewBox="0 0 630 360" preserveAspectRatio={fit} data-nomirror aria-hidden="true">
    <rect width="630" height="360" fill="#FFFFFF" />
    <rect width="630" height="120" fill="#239F40" />
    <rect y="240" width="630" height="120" fill="#DA0000" />
    {/* The takbir band: eleven marks along the lower edge of the green and
        eleven along the upper edge of the red, both in white, as on the flag. */}
    <g fill="#FFFFFF">
      {Array.from({ length: 11 }, (_, i) => (
        <rect x={20 + i * 56} y="100" width="24" height="12" />
      ))}
      {Array.from({ length: 11 }, (_, i) => (
        <rect x={20 + i * 56} y="248" width="24" height="12" />
      ))}
    </g>
  </svg>
)}

<style>
  .flag { inline-size: 100%; block-size: 100%; display: block; }
</style>
