---
/**
 * INDUSTRY MARKS
 *
 * Thirteen drawings, one per vertical. Each is a real piece of that sector's
 * engineering rather than a pictogram: a cavity array, a preform beside the
 * bottle it becomes, a cam-driven slide, a labyrinth flow path, a family of
 * fittings on one grid. They are what makes the bento readable at a glance and
 * they are the reason there is not a single emoji anywhere on this site.
 *
 * All are stroke-only and inherit `currentColor`, so a tile sets one colour and
 * the mark follows.
 */
import type { IndustryKey } from '../config/industries.ts';

interface Props {
  industry: IndustryKey;
  class?: string;
}
const { industry, class: className = '' } = Astro.props;
---

<svg
  class:list={['mark', `mark--${industry}`, className]}
  viewBox="0 0 200 140"
  fill="none"
  aria-hidden="true"
  data-nomirror
>
  {industry === 'medical' && (
    /* A cavity plate seen from above. Precision as repetition. */
    <g class="mark__g">
      <rect x="18" y="14" width="164" height="112" stroke="currentColor" stroke-width="1.1" opacity="0.45" />
      {Array.from({ length: 32 }).map((_, i) => {
        const c = i % 8, r = Math.floor(i / 8);
        return (
          <circle cx={31 + c * 20.3} cy={30 + r * 27} r="6.2" stroke="currentColor" stroke-width="1.1"
            class="mark__cav" style={`--i:${i}`} />
        );
      })}
      <circle cx="31" cy="30" r="6.2" fill="currentColor" opacity="0.9" class="mark__cav-hot" />
      <line x1="100" y1="6" x2="100" y2="134" stroke="currentColor" stroke-width="0.7" stroke-dasharray="8 3 1.5 3" opacity="0.5" />
    </g>
  )}

  {industry === 'beverage' && (
    /* Preform and the bottle it becomes. The neck is identical in both. */
    <g class="mark__g">
      <g class="mark__preform">
        <path d="M44 18 h26 v7 h-5 v6 h5 v7 h-26 v-7 h5 v-6 h-5 z" stroke="currentColor" stroke-width="1.2" />
        <path d="M49 38 v42 q0 14 8 14 t8 -14 v-42" stroke="currentColor" stroke-width="1.3" />
      </g>
      <path d="M92 60 l16 0" stroke="currentColor" stroke-width="1.1" opacity="0.5" />
      <path d="M104 56 l6 4 l-6 4" stroke="currentColor" stroke-width="1.1" opacity="0.5" />
      <g class="mark__bottle">
        <path d="M126 18 h26 v7 h-5 v6 h5 v7 h-26 v-7 h5 v-6 h-5 z" stroke="currentColor" stroke-width="1.2" />
        <path d="M131 38 q-18 16 -18 42 v34 q0 8 8 8 h32 q8 0 8 -8 v-34 q0 -26 -18 -42" stroke="currentColor" stroke-width="1.3" />
        {/* Stretch vectors — the physical relationship the page is built on */}
        <line x1="113" y1="88" x2="103" y2="88" stroke="currentColor" stroke-width="0.9" opacity="0.55" />
        <line x1="165" y1="88" x2="175" y2="88" stroke="currentColor" stroke-width="0.9" opacity="0.55" />
      </g>
    </g>
  )}

  {industry === 'automotive' && (
    /* A slide withdrawing on its cam angle — the mechanism, not the vehicle. */
    <g class="mark__g">
      <rect x="20" y="20" width="160" height="44" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
      <rect x="20" y="76" width="160" height="44" stroke="currentColor" stroke-width="1.2" opacity="0.5" />
      <line x1="10" y1="70" x2="190" y2="70" stroke="currentColor" stroke-width="1.1" stroke-dasharray="14 4 2 4" />
      <rect x="76" y="52" width="48" height="36" stroke="currentColor" stroke-width="1.4" fill="none" />
      <g class="mark__slide">
        <rect x="30" y="78" width="40" height="30" stroke="currentColor" stroke-width="1.3" />
        <line x1="70" y1="78" x2="98" y2="46" stroke="currentColor" stroke-width="1.1" opacity="0.7" />
        <path d="M92 40 l8 4 l-4 8" stroke="currentColor" stroke-width="1.1" opacity="0.7" />
      </g>
      <g class="mark__slide mark__slide--b">
        <rect x="130" y="78" width="40" height="30" stroke="currentColor" stroke-width="1.3" />
        <line x1="130" y1="78" x2="102" y2="46" stroke="currentColor" stroke-width="1.1" opacity="0.7" />
      </g>
    </g>
  )}

  {industry === 'cosmetics' && (
    /* A show surface and the gate that must not appear on it. */
    <g class="mark__g">
      <path d="M52 116 v-56 q0 -34 48 -34 t48 34 v56" stroke="currentColor" stroke-width="1.4" />
      <path d="M52 116 h96" stroke="currentColor" stroke-width="1.4" />
      <path d="M64 108 v-48 q0 -24 36 -24 t36 24 v48" stroke="currentColor" stroke-width="1" opacity="0.45" stroke-dasharray="5 4" />
      {/* Specular sweep across the show surface */}
      <path d="M70 96 q10 -46 30 -58" stroke="currentColor" stroke-width="3" opacity="0.22" class="mark__sheen" stroke-linecap="round" />
      {/* Gate, deliberately underneath */}
      <circle cx="100" cy="118" r="4" stroke="currentColor" stroke-width="1.2" />
      <line x1="104" y1="122" x2="140" y2="132" stroke="currentColor" stroke-width="0.8" opacity="0.6" />
    </g>
  )}

  {industry === 'appliances' && (
    /* A large flat panel and its cooling serpentine — warpage is the enemy. */
    <g class="mark__g">
      <rect x="16" y="24" width="168" height="92" stroke="currentColor" stroke-width="1.3" />
      <path
        d="M32 42 h136 v18 h-136 v18 h136 v18 h-136"
        stroke="currentColor" stroke-width="1.2" opacity="0.55" class="mark__serpent"
      />
      <line x1="16" y1="120" x2="184" y2="120" stroke="currentColor" stroke-width="0.8" opacity="0.35" stroke-dasharray="4 4" />
      {/* Bow, exaggerated — the failure this section is about */}
      <path d="M16 124 q84 12 168 0" stroke="currentColor" stroke-width="1.1" opacity="0.75" />
    </g>
  )}

  {industry === 'chemical' && (
    /* Thread engaging thread. The millimetre between contained and leaking. */
    <g class="mark__g">
      <path d="M62 18 v104" stroke="currentColor" stroke-width="1.3" />
      <path d="M138 18 v104" stroke="currentColor" stroke-width="1.3" />
      {Array.from({ length: 7 }).map((_, i) => (
        <g class="mark__thread" style={`--i:${i}`}>
          <path d={`M62 ${28 + i * 14} l14 -6 l0 12 z`} stroke="currentColor" stroke-width="1.1" />
          <path d={`M138 ${34 + i * 14} l-14 -6 l0 12 z`} stroke="currentColor" stroke-width="1.1" />
        </g>
      ))}
      <line x1="100" y1="10" x2="100" y2="130" stroke="currentColor" stroke-width="0.7" stroke-dasharray="8 3 1.5 3" opacity="0.5" />
      <circle cx="100" cy="26" r="3.4" fill="currentColor" opacity="0.85" />
    </g>
  )}

  {industry === 'electrical' && (
    /* Flow length against wall thickness — the thin-wall problem, drawn. */
    <g class="mark__g">
      <path d="M24 34 h152 v72 h-152 z" stroke="currentColor" stroke-width="1.2" opacity="0.45" />
      <path d="M30 40 h140 v60 h-140 z" stroke="currentColor" stroke-width="1" opacity="0.3" />
      <circle cx="30" cy="70" r="4" fill="currentColor" />
      <path d="M30 70 h140" stroke="currentColor" stroke-width="2" class="mark__flow" stroke-linecap="round" />
      {[54, 82, 110, 138].map((x, i) => (
        <line x1={x} y1="40" x2={x} y2="100" stroke="currentColor" stroke-width="0.8" opacity="0.28" />
      ))}
      <text x="24" y="126" class="mark__t">L / t</text>
      <line x1="172" y1="62" x2="172" y2="78" stroke="currentColor" stroke-width="1.4" />
    </g>
  )}

  {industry === 'toys' && (
    /* Three mouldings becoming one. Part consolidation, drawn as arithmetic. */
    <g class="mark__g">
      <g class="mark__three">
        <rect x="20" y="30" width="42" height="30" stroke="currentColor" stroke-width="1.2" />
        <rect x="20" y="70" width="42" height="30" stroke="currentColor" stroke-width="1.2" />
        <rect x="70" y="50" width="42" height="30" stroke="currentColor" stroke-width="1.2" />
      </g>
      <path d="M120 65 h16" stroke="currentColor" stroke-width="1.1" opacity="0.5" />
      <path d="M132 61 l6 4 l-6 4" stroke="currentColor" stroke-width="1.1" opacity="0.5" />
      <rect x="146" y="38" width="38" height="54" stroke="currentColor" stroke-width="1.5" class="mark__one" />
      <text x="20" y="122" class="mark__t">3 → 1</text>
    </g>
  )}

  {industry === 'agriculture' && (
    /* A dripper labyrinth. A few tenths of a millimetre, magnified. */
    <g class="mark__g">
      <rect x="18" y="34" width="164" height="72" stroke="currentColor" stroke-width="1.1" opacity="0.4" />
      <path
        d="M28 50 h20 v14 h-20 v14 h20 v14 h20 v-14 h20 v14 h20 v-14 h20 v14 h20 v-14 h20 v-14 h-20 v-14 h-20 v14 h-20 v-14 h-20 v14 h-20 z"
        stroke="currentColor" stroke-width="1.3" class="mark__laby"
      />
      <circle cx="28" cy="50" r="3.4" fill="currentColor" />
      <circle cx="172" cy="78" r="3.4" fill="currentColor" opacity="0.5" />
      <text x="18" y="126" class="mark__t">0.6 mm</text>
    </g>
  )}

  {industry === 'plumbing' && (
    /* A family of fittings on one grid — one tooling logic, forty part numbers. */
    <g class="mark__g">
      <g class="mark__fit" style="--i:0">
        <path d="M24 34 h30 v30 h-30 z M54 44 h22 v10 h-22 z" stroke="currentColor" stroke-width="1.2" />
      </g>
      <g class="mark__fit" style="--i:1">
        <path d="M96 34 h30 v30 h-30 z M111 64 v18 M126 44 h20" stroke="currentColor" stroke-width="1.2" />
      </g>
      <g class="mark__fit" style="--i:2">
        <path d="M154 34 h30 v30 h-30 z M154 44 h-18 M169 64 v18" stroke="currentColor" stroke-width="1.2" />
      </g>
      <g class="mark__fit" style="--i:3">
        <path d="M24 92 h30 v26 h-30 z M54 100 h26" stroke="currentColor" stroke-width="1.2" />
      </g>
      <g class="mark__fit" style="--i:4">
        <path d="M96 92 h30 v26 h-30 z M126 100 h20 M111 92 v-14" stroke="currentColor" stroke-width="1.2" />
      </g>
      <g class="mark__fit" style="--i:5">
        <circle cx="169" cy="105" r="15" stroke="currentColor" stroke-width="1.2" />
        <path d="M169 90 v-12 M169 120 v10" stroke="currentColor" stroke-width="1.2" />
      </g>
    </g>
  )}

  {industry === 'furniture' && (
    /* A load path through a moulded part. Where it must be strong. */
    <g class="mark__g">
      <path d="M100 20 v22" stroke="currentColor" stroke-width="2" class="mark__load" />
      <path d="M94 36 l6 8 l6 -8" stroke="currentColor" stroke-width="2" fill="none" class="mark__load" />
      <path d="M56 48 h88 q10 0 10 10 v18 q0 10 -10 10 h-16 v10 h-40 v-10 h-22 q-10 0 -10 -10 v-18 q0 -10 10 -10 z"
        stroke="currentColor" stroke-width="1.4" />
      {/* Ribs — the structure that carries the load */}
      {[74, 92, 110, 128].map((x) => (
        <line x1={x} y1="52" x2={x} y2="82" stroke="currentColor" stroke-width="0.9" opacity="0.4" />
      ))}
      <circle cx="80" cy="112" r="12" stroke="currentColor" stroke-width="1.3" />
      <circle cx="120" cy="112" r="12" stroke="currentColor" stroke-width="1.3" />
      <circle cx="80" cy="112" r="3" fill="currentColor" opacity="0.5" />
      <circle cx="120" cy="112" r="3" fill="currentColor" opacity="0.5" />
    </g>
  )}

  {industry === 'marine' && (
    /* A worn part measured back into geometry. No drawing was ever kept. */
    <g class="mark__g">
      {/* The worn original */}
      <path d="M40 96 q4 -34 26 -42 q22 -8 42 2 q20 10 24 30 q3 14 -6 18 l-78 2 q-9 -2 -8 -10 z"
        stroke="currentColor" stroke-width="1.6" opacity="0.55" stroke-linejoin="round" class="mark__worn" />
      {/* The measured reconstruction */}
      <path d="M40 96 q4 -36 28 -44 q24 -8 44 2 q22 10 24 32 v10 h-96 z"
        stroke="currentColor" stroke-width="1.2" stroke-dasharray="6 4" class="mark__recon" />
      {/* Measurement points */}
      {[[52, 78], [76, 54], [108, 52], [132, 72], [136, 96]].map(([x, y]) => (
        <g><circle cx={x} cy={y} r="2.6" fill="currentColor" /><line x1={x} y1={y} x2={x} y2="118" stroke="currentColor" stroke-width="0.6" opacity="0.3" /></g>
      ))}
      <line x1="34" y1="118" x2="150" y2="118" stroke="currentColor" stroke-width="0.9" opacity="0.5" />
    </g>
  )}

  {industry === 'custom' && (
    /* The engineer's desk: whatever arrived, annotated in red. */
    <g class="mark__g">
      <rect x="24" y="18" width="118" height="104" stroke="currentColor" stroke-width="1.1" opacity="0.4" />
      <path d="M50 96 q6 -44 34 -50 q28 -6 38 22 q6 20 -6 28 z" stroke="currentColor" stroke-width="1.4" />
      <g class="mark__redline">
        <circle cx="122" cy="66" r="12" stroke-width="1.3" />
        <line x1="131" y1="57" x2="168" y2="34" stroke-width="1" />
        <line x1="168" y1="34" x2="188" y2="34" stroke-width="1" />
        <path d="M60 100 l24 -18" stroke-width="1.3" />
        <circle cx="60" cy="100" r="3" fill="currentColor" stroke="none" />
        <text x="150" y="28" class="mark__t mark__t--red">?</text>
      </g>
    </g>
  )}
</svg>

<style>
  .mark { inline-size: 100%; block-size: auto; overflow: visible; }
  .mark__t {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    fill: currentColor;
    opacity: 0.55;
  }
  .mark__t--red { fill: currentColor; opacity: 1; font-size: 14px; }

  /* Motion is opt-in per tile: it runs only where the tile is engaged, which is
     what keeps thirteen animated marks from turning the bento into a fairground. */
  :global(.bento-tile:hover) .mark__cav,
  :global(.bento-tile:focus-visible) .mark__cav {
    animation: mk-settle 900ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 14ms);
  }
  @keyframes mk-settle { from { opacity: 0.15; transform: scale(0.7); } to { opacity: 1; transform: none; } }
  .mark__cav { transform-box: fill-box; transform-origin: center; }

  :global(.bento-tile:hover) .mark__slide { animation: mk-slide 1.1s var(--ease-mech) both; }
  :global(.bento-tile:hover) .mark__slide--b { animation-direction: reverse; }
  @keyframes mk-slide { 0% { transform: translateX(0); } 100% { transform: translateX(-14px); } }

  :global(.bento-tile:hover) .mark__sheen { animation: mk-sheen 1.4s var(--ease-out) both; }
  @keyframes mk-sheen { from { opacity: 0; transform: translate(-10px, 10px); } to { opacity: 0.22; transform: none; } }

  :global(.bento-tile:hover) .mark__laby,
  :global(.bento-tile:hover) .mark__serpent,
  :global(.bento-tile:hover) .mark__flow {
    stroke-dasharray: 700;
    animation: mk-draw 1.6s var(--ease-out) both;
  }
  @keyframes mk-draw { from { stroke-dashoffset: 700; } to { stroke-dashoffset: 0; } }

  :global(.bento-tile:hover) .mark__thread {
    animation: mk-thread 900ms var(--ease-mech) both;
    animation-delay: calc(var(--i) * 40ms);
  }
  @keyframes mk-thread { from { transform: translateY(-6px); opacity: 0.3; } to { transform: none; opacity: 1; } }

  :global(.bento-tile:hover) .mark__fit {
    animation: mk-pop 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms);
  }
  @keyframes mk-pop { from { opacity: 0.25; } to { opacity: 1; } }

  :global(.bento-tile:hover) .mark__recon {
    stroke-dasharray: 6 4;
    animation: mk-measure 1.2s linear both;
  }
  @keyframes mk-measure { from { stroke-dashoffset: 120; } to { stroke-dashoffset: 0; } }

  :global(.bento-tile:hover) .mark__one { animation: mk-pop 700ms var(--ease-out) 200ms both; }
  :global(.bento-tile:hover) .mark__load { animation: mk-load 1.2s var(--ease-in-out) infinite; }
  @keyframes mk-load { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(3px); } }

  .mark__redline { color: var(--signal-ink); stroke: currentColor; fill: none; }
  .mark__preform, .mark__bottle { transform-box: fill-box; }

  @media (prefers-reduced-motion: reduce) {
    .mark * { animation: none !important; }
  }
</style>
