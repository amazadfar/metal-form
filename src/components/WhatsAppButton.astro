---
/**
 * The conversion control.
 *
 * One component, used on every page, so a returning visitor recognises it
 * instantly. While the production number is still pending it degrades to the
 * contact route rather than rendering a dead link — the UI is complete either
 * way, and setting one value in `src/config/site.ts` switches the whole site
 * from one behaviour to the other.
 */
import { primaryContactLink, analyticsEvent, type CtaSource } from '../lib/contact.ts';
import { localePath, type Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
  /** The message the visitor sends. Industry-specific, in their language. */
  prefill: string;
  label: string;
  source: CtaSource;
  variant?: 'whatsapp' | 'primary' | 'solid' | 'ruled' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Contact pages disable route fallback so the control cannot link to itself. */
  allowContactFallback?: boolean;
}

const {
  locale, prefill, label, source,
  variant = 'whatsapp', size = 'md', class: className = '',
  allowContactFallback = true,
} = Astro.props;

const direct = primaryContactLink(prefill, source, locale, allowContactFallback);
const target = direct.href ?? (direct.channel === 'contact-page' ? localePath(locale, 'contact') : undefined);
const effectiveVariant = variant === 'whatsapp' && direct.channel !== 'whatsapp' ? 'primary' : variant;
---

{target && <a
  class:list={['btn', `btn--${effectiveVariant}`, size !== 'md' && `btn--${size}`, className]}
  href={target}
  target={direct.external ? '_blank' : undefined}
  rel={direct.external ? 'noopener noreferrer' : undefined}
  data-analytics={analyticsEvent(source)}
  data-channel={direct.channel}
>
  {effectiveVariant === 'whatsapp' && (
    <svg class="btn__glyph" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.08-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47s1.06 2.86 1.21 3.06c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.42 9.42 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43a9.37 9.37 0 0 1 6.67 2.77 9.34 9.34 0 0 1 2.76 6.67c0 5.2-4.23 9.43-9.44 9.43zM20.13 3.9A11.31 11.31 0 0 0 12.05.55C5.78.55.68 5.65.68 11.92c0 2 .52 3.96 1.52 5.68L.58 23.45l5.99-1.57a11.35 11.35 0 0 0 5.48 1.4h.01c6.26 0 11.36-5.1 11.37-11.37a11.3 11.3 0 0 0-3.3-8.01z" />
    </svg>
  )}
  <span>{label}</span>
  {effectiveVariant !== 'whatsapp' && (
    <svg class="btn__arrow" viewBox="0 0 16 12" aria-hidden="true" fill="none">
      <path d="M1 6h13M9.5 1.2 14.3 6l-4.8 4.8" stroke="currentColor" stroke-width="1.4" />
    </svg>
  )}
</a>}
