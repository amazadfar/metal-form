---
/**
 * BEVERAGE & PET PACKAGING — flagship chapter.
 *
 * Written for a bottler. The spine is: grams, cavities, seconds, sources — in
 * that order, because that is the order the money moves in.
 *
 * The argument the whole page turns on is in section 02: a plant trims the
 * process until the *lightest* cavity clears the specification floor, so every
 * other cavity runs heavy, and that difference is bought again on every shot for
 * the life of the tool. Tooling price is a one-off. Cavity spread is an annuity.
 *
 * Visual language: transparent PET, refraction, a constant neck against a
 * stretching body, cavity arrays, cyan on near-white. Industrial, not an advert.
 */
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';
import ProjectProof from '../ProjectProof.astro';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { content, common } = Astro.props;
const b = content.blocks as any;

// Preform and bottle profiles. The finish geometry is identical in both — that
// is the point of the figure and it must stay true in the drawing.
const NECK = 'M-15 0 h30 v5 h-6 v4.5 h6 v5 h-30 v-5 h6 v-4.5 h-6 z';
const PREFORM_BODY = 'M-11 15 v40 q0 13 11 13 t11 -13 v-40';
const BOTTLE_BODY = 'M-11 15 q-17 15 -17 40 v33 q0 8 8 8 h40 q8 0 8 -8 v-33 q0 -25 -17 -40';

// Cavity weight scatter for section 02. Deliberately synthetic and labelled as
// a schematic: a real distribution belongs to a real plant, not to a web page.
const SPREAD = [
  62, 41, 74, 55, 38, 68, 47, 80, 52, 44, 71, 59, 35, 66, 50, 77,
  43, 69, 56, 39, 73, 48, 61, 45, 79, 53, 40, 64, 57, 42, 70, 51,
];
---

<article class="bev">

  {/* ═══ HERO ═══════════════════════════════════════════════════════════ */}
  <header class="bev-hero">
    <div class="bev-hero__bleed" aria-hidden="true">
      <svg viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid slice" data-nomirror>
        <defs>
          <linearGradient id="bev-refract" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.09" />
            <stop offset="55%" stop-color="var(--signal)" stop-opacity="0.05" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect width="1400" height="700" fill="url(#bev-refract)" />
        {/* Caustic bands — light bent through a curved transparent wall. */}
        {Array.from({ length: 22 }).map((_: any, i: number) => (
          <path
            d={`M${-120 + i * 74} 700 Q${40 + i * 74} 380 ${-40 + i * 74} 0`}
            fill="none"
            stroke="var(--accent)"
            stroke-width={i % 4 === 0 ? 1.4 : 0.7}
            opacity={i % 4 === 0 ? 0.16 : 0.08}
          />
        ))}
      </svg>
    </div>

    <div class="shell--wide bev-hero__inner">
      <div class="bev-hero__copy">
        <p class="eyebrow">{content.hero.kicker}</p>
        <h1 class="bev-hero__head">
          {content.hero.headline.map((line: any, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>
        <p class="bev-hero__lead">{content.hero.lead}</p>
        {content.hero.markers && (
          <ul class="bev-hero__markers">
            {content.hero.markers.map((m: any) => <li class="t-mono">{m}</li>)}
          </ul>
        )}
      </div>

      {/* The signature figure: constant neck, stretched body. */}
      <figure class="bev-hero__fig">
        <svg viewBox="0 0 380 232" data-nomirror role="img" aria-label={common.schematic}>
          {/* The finish is drawn identically on both figures and dimensioned
              once, across both — that shared dimension is the whole argument. */}
          <g transform="translate(104 44) scale(1.25)">
            <path d={NECK} class="bev-line" />
            <path d={PREFORM_BODY} class="bev-line bev-fill" />
          </g>
          <g transform="translate(266 44) scale(1.25)">
            <path d={NECK} class="bev-line" />
            <path d={BOTTLE_BODY} class="bev-line" />
          </g>

          {/* One dimension line spanning both necks. */}
          <g class="bev-dimspan">
            <line x1="85" y1="30" x2="285" y2="30" />
            <line x1="85" y1="24" x2="85" y2="48" />
            <line x1="285" y1="24" x2="285" y2="48" />
            <text x="185" y="22" text-anchor="middle" class="bev-micro">{b.hero.dimension}</text>
          </g>

          {/* Stretch vectors, anchored on the bottle wall they describe. */}
          <path d="M244 150 h-18" class="bev-vector" />
          <path d="M288 150 h18" class="bev-vector" />

          <line x1="176" y1="120" x2="204" y2="120" class="bev-arrow" />
          <path d="M198 116 l7 4 l-7 4" class="bev-arrow" fill="none" />
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
    </div>
  </header>

  {/* ═══ 01 · GRAMS ═════════════════════════════════════════════════════ */}
  <section class="bev-grams" id="grams">
    <div class="shell--wide">
      <div class="bev-grams__head">
        <p class="eyebrow">{b.grams.index} · {b.grams.kicker}</p>
        <h2 class="bev-h2">{b.grams.heading}</h2>
        <p class="t-lead">{b.grams.body}</p>
        <p class="bev-grams__sub t-small">{b.grams.body2}</p>
      </div>

      {/* One continuous ruler carrying every weight band. No cards. */}
      <div class="bev-scale" data-reveal>
        <p class="t-label bev-scale__cap">{b.grams.scaleLabel}</p>
        <ol class="bev-scale__rows">
          {b.grams.rows.map((row: any, i: number) => (
            <li class="bev-row" style={`--i:${i}`}>
              <span class="bev-row__w t-mono">{row.weight}</span>
              <span class="bev-row__bar" aria-hidden="true">
                <svg viewBox="0 0 40 90" class="bev-row__pf" data-nomirror>
                  <path d={NECK} transform="translate(20 6) scale(0.62)" class="bev-line" />
                  <path d={PREFORM_BODY} transform={`translate(20 6) scale(0.62 ${0.5 + i * 0.14})`} class="bev-line bev-fill" />
                </svg>
              </span>
              <span class="bev-row__std">{row.standard}</span>
              <span class="bev-row__note">{row.note}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="bev-grams__close">{b.grams.close}</p>
    </div>
  </section>

  {/* ═══ 02 · CAVITIES — the only inverted section on the page ═══════════ */}
  <section class="bev-cav" id="cavities">
    <div class="shell--wide">
      <div class="bev-cav__head">
        <p class="eyebrow">{b.cavities.index} · {b.cavities.kicker}</p>
        <h2 class="bev-h2 bev-cav__h">{b.cavities.heading}</h2>
        <div class="bev-cav__copy">
          <p class="t-lead">{b.cavities.body}</p>
          <p class="bev-cav__annuity">{b.cavities.body2}</p>
        </div>
      </div>

      <div class="bev-cav__figs" data-reveal>
        {/* A real 32-cavity positional array. */}
        <figure class="bev-plate">
          <svg viewBox="0 0 300 200" data-nomirror role="img" aria-label={common.schematic}>
            <rect x="10" y="10" width="280" height="180" class="bev-plate__body" />
            {SPREAD.map((_: any, i: number) => {
              const col = i % 8;
              const row = Math.floor(i / 8);
              return (
                <circle
                  cx={34 + col * 33} cy={38 + row * 41} r="10.5"
                  class="bev-plate__cav" style={`--i:${i}`}
                />
              );
            })}
            <line x1="150" y1="4" x2="150" y2="196" class="bev-plate__cl" />
          </svg>
          <figcaption class="t-label">{b.hero.plateCaption}</figcaption>
        </figure>

        {/* Weight scatter against the floor. The gap is the argument. */}
        <figure class="bev-plot">
          <p class="t-label bev-plot__cap">{b.cavities.chartCaption}</p>
          <svg viewBox="0 0 340 190" data-nomirror role="img" aria-label={b.cavities.chartCaption}>
            {/* The band between the floor and the mean is the money. */}
            <rect x="0" y="96" width="340" height="42" class="bev-plot__gap" />
            <line x1="0" y1="138" x2="340" y2="138" class="bev-plot__floor" />
            <line x1="0" y1="96" x2="340" y2="96" class="bev-plot__mean" />
            {SPREAD.map((v: any, i: number) => (
              <circle cx={8 + i * 10.3} cy={175 - v * 1.15} r="3.1" class="bev-plot__dot" style={`--i:${i}`} />
            ))}
          </svg>
          <ul class="bev-plot__key">
            <li><span class="bev-plot__swatch bev-plot__swatch--mean"></span>{b.cavities.chartMean}</li>
            <li><span class="bev-plot__swatch bev-plot__swatch--floor"></span>{b.cavities.chartFloor}</li>
            <li><span class="bev-plot__swatch bev-plot__swatch--gap"></span>{b.cavities.chartGap}</li>
          </ul>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>
      </div>

      <p class="bev-cav__close">{b.cavities.close}</p>

      <div class="bev-cav__band">
        <h3 class="bev-h3">{b.cavities.cavityHeading}</h3>
        <div class="bev-cav__band-cols">
          <p>{b.cavities.cavityBody}</p>
          <p class="bev-cav__ours">{b.cavities.cavityBody2}</p>
          <p>{b.cavities.cavityBody3}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ═══ 03 · NECK ══════════════════════════════════════════════════════ */}
  <section class="bev-neck" id="neck">
    <div class="shell--wide">
      <div class="bev-neck__head">
        <p class="eyebrow">{b.neck.index} · {b.neck.kicker}</p>
        <h2 class="bev-h2">{b.neck.heading}</h2>
        <p class="t-lead">{b.neck.body}</p>
      </div>

      <div class="bev-std" data-tabs>
        <div class="bev-std__tabs" role="tablist" aria-label={b.neck.tabsLabel}>
          {b.neck.standards.map((s: any) => (
            <button
              class="bev-std__tab"
              type="button"
              role="tab"
              data-tab={s.id}
              aria-selected="false"
              id={`tab-${s.id}`}
              aria-controls={`panel-${s.id}`}
            >{s.name}</button>
          ))}
        </div>

        {b.neck.standards.map((s: any, i: number) => (
          <div
            class="bev-std__panel"
            data-panel={s.id}
            role="tabpanel"
            id={`panel-${s.id}`}
            aria-labelledby={`tab-${s.id}`}
            hidden
          >
            {/* Six finishes on a shared support-ring baseline, so height
                difference reads instantly rather than being stated. */}
            <figure class="bev-std__fig">
              <svg viewBox="0 0 180 150" data-nomirror role="img" aria-label={common.schematic}>
                {/* Half section against a centre line, the way a neck finish is
                    actually drawn. Thread turns and finish height vary per
                    standard, so the six drawings differ in the way the six
                    real finishes differ. */}
                <line x1="20" y1="126" x2="164" y2="126" class="bev-std__base" />
                <line x1="56" y1="10" x2="56" y2="142" class="bev-std__cl" />
                <g>
                  {(() => {
                    const turns = [3, 4, 3, 4, 2, 3][i] ?? 3;
                    const pitch = 12;
                    const top = 116 - turns * pitch;
                    return (
                      <>
                        {/* Bore wall and outer wall of the finish. */}
                        <path d={`M62 ${top} V116`} class="bev-std__wall" />
                        <path d={`M92 ${top} V116`} class="bev-std__wall" />
                        <path d={`M62 ${top} H92`} class="bev-std__wall" />
                        {/* Thread profile on the outer face. */}
                        {Array.from({ length: turns }).map((_: any, t: any) => (
                          <path
                            d={`M92 ${top + 6 + t * pitch} l14 -5 v10 z`}
                            class="bev-std__thread"
                          />
                        ))}
                        {/* Support ring — the datum the capper works from. */}
                        <path d="M62 116 H124 V126 H62 Z" class="bev-std__ring" />
                        {/* Sealing surface. */}
                        <path d={`M62 ${top} H92`} class="bev-std__seal" />
                        <line x1="106" y1={top} x2="150" y2={top} class="bev-std__ext" />
                        <line x1="128" y1={top} x2="128" y2="116" class="bev-std__dim" />
                      </>
                    );
                  })()}
                </g>
              </svg>
              <figcaption class="figure-note">{common.schematic}</figcaption>
            </figure>

            <dl class="bev-std__spec">
              <div><dt class="t-label">{b.neck.specLabels.geometry}</dt><dd>{s.summary}</dd></div>
              <div><dt class="t-label">{b.neck.specLabels.use}</dt><dd>{s.use}</dd></div>
              <div><dt class="t-label">{b.neck.specLabels.weight}</dt><dd class="t-mono">{s.weight}</dd></div>
              <div class="bev-std__warn"><dt class="t-label">{b.neck.specLabels.warning}</dt><dd>{s.warning}</dd></div>
            </dl>
          </div>
        ))}
      </div>

      <div class="bev-conv">
        <h3 class="bev-h4">{b.neck.conversionHeading}</h3>
        <ol class="bev-conv__list">
          {b.neck.conversion.map((step: string, i: number) => (
            <li><span class="t-mono">{String(i + 1).padStart(2, '0')}</span>{step}</li>
          ))}
        </ol>
        <p class="bev-conv__note">{b.neck.conversionNote}</p>
      </div>
    </div>
  </section>

  {/* ═══ 04 · STRETCH ═══════════════════════════════════════════════════ */}
  <section class="bev-stretch" id="stretch" data-stepper data-step="0">
    <div class="shell--wide bev-stretch__head">
      <p class="eyebrow">{b.stretch.index} · {b.stretch.kicker}</p>
      <h2 class="bev-h2">{b.stretch.heading}</h2>
      <p class="t-lead">{b.stretch.body}</p>
    </div>

    <div class="shell--wide bev-stretch__grid">
      <figure class="bev-stretch__fig">
        <svg viewBox="0 0 640 240" data-nomirror role="img" aria-label={common.schematic}>
          <line x1="0" y1="206" x2="640" y2="206" class="bev-stretch__line" />
          {[0, 1, 2, 3, 4].map((s: any) => (
            <g transform={`translate(${72 + s * 128} 40)`} class="bev-stage" data-stage={s}>
              <path d={NECK} transform="scale(1.15)" class="bev-line" />
              {s === 0 && <path d={PREFORM_BODY} transform="scale(1.15)" class="bev-line bev-fill" />}
              {s === 1 && (
                <>
                  <path d={PREFORM_BODY} transform="scale(1.15)" class="bev-line bev-fill bev-hot" />
                  {[-30, -18, 18, 30].map((x: any) => (
                    <line x1={x} y1="30" x2={x} y2="110" class="bev-ir" />
                  ))}
                </>
              )}
              {s === 2 && (
                <>
                  <path d="M-13 17 v66 q0 15 13 15 t13 -15 v-66" transform="scale(1.15)" class="bev-line bev-fill" />
                  <line x1="0" y1="20" x2="0" y2="132" class="bev-rod" />
                  <path d="M-6 126 l6 8 l6 -8" class="bev-rod" fill="none" />
                </>
              )}
              {s === 3 && (
                <>
                  <path d="M-12 17 q-16 22 -16 52 v42 q0 9 9 9 h38 q9 0 9 -9 v-42 q0 -30 -16 -52" transform="scale(1.05)" class="bev-line bev-fill" />
                  {[-40, -24, 24, 40].map((x: any) => (
                    <path d={`M${x} 60 l${x < 0 ? 10 : -10} 6 l${x < 0 ? -10 : 10} 6`} class="bev-press" fill="none" />
                  ))}
                </>
              )}
              {s === 4 && <path d={BOTTLE_BODY} transform="scale(1.15)" class="bev-line" />}
              <line x1="0" y1="166" x2="0" y2="178" class="bev-stretch__tick" />
            </g>
          ))}
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <ol class="bev-stretch__steps">
        {b.stretch.stages.map((stage: any, i: number) => (
          <li class="bev-stretch__step" data-station-step={i}>
            <span class="t-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{stage.label}</h3>
            <p>{stage.note}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="shell--wide">
      <p class="bev-stretch__close">{b.stretch.close}</p>
    </div>
  </section>

  {/* ═══ 05 · DEFECTS ═══════════════════════════════════════════════════ */}
  <section class="bev-def" id="defects">
    <div class="shell--wide">
      <div class="bev-def__head">
        <p class="eyebrow">{b.defects.index} · {b.defects.kicker}</p>
        <h2 class="bev-h2">{b.defects.heading}</h2>
        <p class="t-lead">{b.defects.body}</p>
      </div>

      <div class="bev-matrix__scroll">
        <table class="bev-matrix">
          <thead>
            <tr>
              <th scope="col" class="bev-matrix__corner"><span class="vh">{b.defects.heading}</span></th>
              {b.defects.columns.map((col: string) => (
                <th scope="col"><span>{col}</span></th>
              ))}
            </tr>
          </thead>
          <tbody>
            {b.defects.rows.map((row: any) => (
              <tr data-side={row.side}>
                <th scope="row">
                  <span class="bev-matrix__name">{row.defect}</span>
                  <span class="bev-matrix__note">{row.note}</span>
                </th>
                {row.origins.map((on: number, ci: number) => (
                  <td>
                    {on === 1 && <span class="bev-matrix__mark" aria-hidden="true"></span>}
                    <span class="vh">{on === 1 ? b.defects.columns[ci] : ''}</span>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <ul class="bev-def__key">
        <li><span class="bev-def__swatch bev-def__swatch--tool"></span>{b.defects.toolSide}</li>
        <li><span class="bev-def__swatch bev-def__swatch--proc"></span>{b.defects.processSide}</li>
      </ul>
    </div>
  </section>

  {/* ═══ 06 · CLOSURES ══════════════════════════════════════════════════ */}
  <section class="bev-cap" id="closures">
    <div class="shell--wide">
      <div class="bev-cap__head">
        <p class="eyebrow">{b.closures.index} · {b.closures.kicker}</p>
        <h2 class="bev-h2">{b.closures.heading}</h2>
        <p class="t-lead">{b.closures.body}</p>
      </div>

      <div class="bev-cap__grid">
        {/* Two routes on one time axis: the cycle difference is a length. */}
        <div class="bev-tracks">
          {b.closures.tracks.map((track: any, i: number) => (
            <div class="bev-track" data-track={i}>
              <p class="bev-track__name t-label">{track.name}</p>
              <div class="bev-track__bar" aria-hidden="true">
                <span style={`--w:${i === 0 ? 100 : 62}%`}></span>
              </div>
              <p class="bev-track__note">{track.note}</p>
            </div>
          ))}
          <p class="bev-tracks__note t-fine">{b.closures.tracksNote}</p>
        </div>

        {/* The tethered cap, in plan and section. */}
        <figure class="bev-capfig">
          <p class="t-label">{b.closures.capHeading}</p>
          <svg viewBox="0 0 260 190" data-nomirror role="img" aria-label={common.schematic}>
            {/* Plan */}
            <g transform="translate(66 78)">
              <circle r="52" class="bev-line" />
              <circle r="43" class="bev-line bev-faint" />
              {Array.from({ length: 30 }).map((_: any, i: number) => {
                const a = (i / 30) * Math.PI * 2;
                return (
                  <line
                    x1={Math.cos(a) * 43} y1={Math.sin(a) * 43}
                    x2={Math.cos(a) * 52} y2={Math.sin(a) * 52}
                    class="bev-knurl"
                  />
                );
              })}
              {/* Bridge pattern, interrupted where the tether is */}
              {Array.from({ length: 18 }).map((_: any, i: number) => {
                const a = (i / 18) * Math.PI * 2 + 0.3;
                if (i > 12 && i < 16) return null;
                return <circle cx={Math.cos(a) * 47} cy={Math.sin(a) * 47} r="2.1" class="bev-bridge" />;
              })}
              <path d="M-14 44 q14 14 28 0" class="bev-hinge" fill="none" />
            </g>
            {/* Section */}
            <g transform="translate(190 78)">
              <path d="M-38 -30 h76 v14 h-6 v46 h-64 v-46 h-6 z" class="bev-line" />
              <path d="M-32 -16 h64" class="bev-faint" />
              <path d="M-32 18 h64" class="bev-band" />
              <text x="0" y="52" text-anchor="middle" class="bev-micro">section</text>
            </g>
          </svg>
          <dl class="bev-capfig__parts">
            {b.closures.capParts.map((part: any) => (
              <div><dt>{part.name}</dt><dd>{part.note}</dd></div>
            ))}
          </dl>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>
      </div>

      <p class="bev-cap__boundary">{b.closures.boundary}</p>
    </div>
  </section>

  {/* ═══ 07 · FREIGHT ═══════════════════════════════════════════════════ */}
  <section class="bev-freight" id="freight">
    <div class="shell--wide bev-freight__inner">
      <div class="bev-freight__head">
        <p class="eyebrow">{b.freight.index} · {b.freight.kicker}</p>
        <h2 class="bev-h2">{b.freight.heading}</h2>
        <p class="t-lead">{b.freight.body}</p>
      </div>

      <figure class="bev-freight__fig" data-reveal>
        <div class="bev-box">
          <p class="t-label">{b.freight.figureA}</p>
          <svg viewBox="0 0 300 120" data-nomirror role="img" aria-label={b.freight.figureA}>
            <rect x="1" y="1" width="298" height="118" class="bev-container" />
            {Array.from({ length: 4 }).map((_: any, r: any) =>
              Array.from({ length: 12 }).map((_: any, c: any) => (
                <g transform={`translate(${17 + c * 24} ${14 + r * 27})`}>
                  <path d={NECK} transform="scale(0.34)" class="bev-line bev-thin" />
                  <path d={BOTTLE_BODY} transform="scale(0.34)" class="bev-line bev-thin" />
                </g>
              ))
            )}
          </svg>
        </div>

        <div class="bev-box">
          <p class="t-label">{b.freight.figureB}</p>
          <svg viewBox="0 0 300 120" data-nomirror role="img" aria-label={b.freight.figureB}>
            <rect x="1" y="1" width="298" height="118" class="bev-container" />
            {Array.from({ length: 9 }).map((_: any, r: any) =>
              Array.from({ length: 30 }).map((_: any, c: any) => (
                <g transform={`translate(${8 + c * 9.8} ${8 + r * 12.6})`}>
                  <path d={NECK} transform="scale(0.13)" class="bev-line bev-thin" />
                  <path d={PREFORM_BODY} transform="scale(0.13)" class="bev-line bev-thin bev-fill" />
                </g>
              ))
            )}
          </svg>
        </div>
        <figcaption class="figure-note">{b.freight.figureNote}</figcaption>
      </figure>

      <p class="bev-freight__close">{b.freight.close}</p>
    </div>
  </section>

  {/* ═══ 08 · START ═════════════════════════════════════════════════════ */}
  <section class="bev-start" id="start">
    <div class="shell--wide">
      <div class="bev-start__head">
        <p class="eyebrow">{b.start.index} · {b.start.kicker}</p>
        <h2 class="bev-h2">{b.start.heading}</h2>
        <p class="t-lead">{b.start.body}</p>
      </div>

      <div class="bev-ledger">
        <section class="bev-ledger__col">
          <h3 class="bev-h4">{b.start.sendHeading}</h3>
          <ul>{b.start.send.map((item: string) => <li>{item}</li>)}</ul>
        </section>
        <section class="bev-ledger__col bev-ledger__col--out">
          <h3 class="bev-h4">{b.start.getHeading}</h3>
          <ul>{b.start.get.map((item: string) => <li>{item}</li>)}</ul>
        </section>
      </div>

      {/* Layer three: the technical depth, folded away until it is wanted. */}
      <div class="bev-panels">
        <h3 class="t-label bev-panels__h">{b.panels?.heading ?? b.blocksPanelsHeading}</h3>
        {(b.panels?.items ?? []).map((panel: any, i: number) => (
          <div class="disc" data-open={i === 0 ? 'true' : 'false'}>
            <h4>
              <button class="disc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                <span>{panel.title}</span>
                <span class="disc__sign" aria-hidden="true"></span>
              </button>
            </h4>
            <div class="disc__panel">
              <div class="disc__inner">
                <div>
                  <ul class="bev-panel__list">
                    {panel.bullets.map((bullet: string) => <li>{bullet}</li>)}
                  </ul>
                  {panel.source && <p class="bev-panel__src t-fine">{panel.source}</p>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  {/* Renders only when real, permitted project media exists. */}
  <ProjectProof locale={Astro.props.locale} industry="beverage" copy={b.proof} />
</article>

<style>
  /* ═══ Chapter scope ══════════════════════════════════════════════════════
     Everything here is scoped to the beverage chapter. Cyan on near-white,
     hairline geometry, transparent fills — the material's own behaviour used
     as the visual language. */
  .bev { --bev-thin: 1.1; }

  .bev-h2 {
    font-size: clamp(1.9rem, 4vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 18ch;
  }
  .bev-h3 { font-size: var(--step-3); letter-spacing: var(--track-head); max-inline-size: 24ch; }
  .bev-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); }

  /* Shared drawing conventions for this chapter. */
  .bev-line { fill: none; stroke: var(--accent-deep); stroke-width: 1.6; stroke-linejoin: round; }
  .bev-thin { stroke-width: 0.9; }
  .bev-fill { fill: color-mix(in oklab, var(--accent) 14%, transparent); }
  .bev-faint { stroke: var(--accent-deep); stroke-width: 0.9; opacity: 0.45; fill: none; }
  .bev-tick { stroke: var(--accent); stroke-width: 0.9; opacity: 0.55; }
  .bev-vector { stroke: var(--signal); stroke-width: 1.6; stroke-linecap: round; }
  .bev-dimspan line { stroke: var(--accent); stroke-width: 0.9; opacity: 0.6; }
  .bev-arrow { stroke: var(--accent); stroke-width: 1.2; }
  .bev-micro {
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.06em;
    fill: var(--ink-muted);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .bev-hero { position: relative; padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem); overflow: clip; }
  .bev-hero__bleed { position: absolute; inset: 0; pointer-events: none; }
  .bev-hero__bleed svg { inline-size: 100%; block-size: 100%; }

  .bev-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (max-width: 940px) { .bev-hero__inner { grid-template-columns: 1fr; } }

  .bev-hero__head {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 1.0;
    letter-spacing: -0.035em;
    font-weight: 500;
  }
  .bev-hero__head span { display: block; }
  .bev-hero__head span:nth-child(2) { color: color-mix(in oklab, var(--ink) 62%, var(--surface)); }
  .bev-hero__head span:last-child { color: var(--accent-deep); }

  .bev-hero__lead {
    margin-block-start: clamp(1.25rem, 2.5vw, 1.85rem);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 48ch;
  }
  .bev-hero__markers {
    margin-block-start: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .bev-hero__markers li {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    padding: 0.4em 0.75em;
    border: 1px solid color-mix(in oklab, var(--accent) 34%, transparent);
    color: var(--accent-deep);
    background: color-mix(in oklab, var(--surface-raise) 70%, transparent);
  }
  .bev-hero__fig svg { inline-size: 100%; block-size: auto; }
  .bev-hero__fig .figure-note { margin-block-start: var(--sp-4); }

  /* ── 01 Grams ─────────────────────────────────────────────────────────── */
  .bev-grams { padding-block: var(--section-y); border-block-start: var(--rule); }
  .bev-grams__head { max-inline-size: 72ch; }
  .bev-grams__head .t-lead { margin-block-start: var(--sp-5); }
  .bev-grams__sub { margin-block-start: var(--sp-4); color: var(--ink-muted); max-inline-size: 62ch; }

  .bev-scale { margin-block-start: clamp(2rem, 5vw, 3.5rem); }
  .bev-scale__cap { display: block; margin-block-end: var(--sp-4); }
  .bev-scale__rows { border-block-start: var(--rule-strong); }
  .bev-row {
    display: grid;
    grid-template-columns: 7.5rem 3rem 8rem minmax(0, 1fr);
    gap: var(--sp-5);
    align-items: center;
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
  }
  @media (max-width: 780px) {
    .bev-row { grid-template-columns: 6rem 2.4rem minmax(0, 1fr); gap: var(--sp-4); }
    .bev-row__note { grid-column: 1 / -1; }
  }
  .bev-row__w { font-size: var(--step-1); color: var(--accent-deep); font-variant-numeric: tabular-nums; }
  .bev-row__pf { inline-size: 100%; block-size: auto; }
  .bev-row__std { font-size: var(--step-0); font-weight: var(--weight-medium); letter-spacing: 0.02em; }
  .bev-row__note { font-size: var(--step--1); line-height: 1.55; color: var(--ink-muted); }

  .bev-grams__close {
    margin-block-start: var(--sp-8);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 62ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }

  /* ── 02 Cavities — inverted ───────────────────────────────────────────── */
  .bev-cav {
    padding-block: var(--section-y-loose);
    background: var(--inverse);
    color: var(--inverse-ink);
    --ink: var(--inverse-ink);
    --signal: var(--signal-inverse);
    --signal-ink: var(--signal-inverse);
    --accent: var(--accent-inverse);
    --accent-deep: var(--accent-inverse);
    --ink-muted: color-mix(in oklab, var(--inverse-ink) 64%, transparent);
    --line: color-mix(in oklab, var(--inverse-ink) 18%, transparent);
    --accent-deep: var(--signal);
  }
  .bev-cav .bev-line { stroke: color-mix(in oklab, var(--inverse-ink) 78%, transparent); }
  .bev-cav__h { max-inline-size: 20ch; }
  .bev-cav__copy {
    margin-block-start: var(--sp-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 860px) { .bev-cav__copy { grid-template-columns: 1fr; } }
  .bev-cav__annuity {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--signal-ink);
    max-inline-size: 44ch;
  }

  .bev-cav__figs {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 860px) { .bev-cav__figs { grid-template-columns: 1fr; } }

  .bev-plate svg, .bev-plot svg { inline-size: 100%; block-size: auto; }
  .bev-plate__body { fill: none; stroke: var(--line); stroke-width: 1.1; }
  .bev-plate__cav { fill: none; stroke: var(--signal); stroke-width: 1.2; opacity: 0.85; }
  .bev-plate__cl { stroke: var(--line); stroke-width: 0.8; stroke-dasharray: 9 3 1.5 3; }
  .bev-plate figcaption { display: block; margin-block-start: var(--sp-3); }

  .bev-plot__cap { display: block; margin-block-end: var(--sp-4); }
  .bev-plot__gap { fill: color-mix(in oklab, var(--signal) 22%, transparent); }
  .bev-plot__floor { stroke: var(--inverse-ink); stroke-width: 1.2; }
  .bev-plot__mean { stroke: var(--signal); stroke-width: 1.2; stroke-dasharray: 6 4; }
  .bev-plot__dot { fill: var(--signal); }
  @keyframes bev-dot { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  :global(html.js) .bev-cav__figs[data-reveal='in'] .bev-plot__dot {
    animation: bev-dot 500ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 22ms);
  }
  .bev-plot__key {
    margin-block-start: var(--sp-4);
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
  .bev-plot__key li { display: flex; align-items: center; gap: 0.6rem; }
  .bev-plot__swatch { inline-size: 1.1rem; block-size: 2px; flex: none; }
  .bev-plot__swatch--mean { background: var(--signal); }
  .bev-plot__swatch--floor { background: var(--inverse-ink); }
  .bev-plot__swatch--gap { block-size: 0.7rem; background: color-mix(in oklab, var(--signal) 32%, transparent); }

  .bev-cav__close {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 68ch;
  }
  .bev-cav__band {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    padding-block-start: var(--sp-7);
    border-block-start: 1px solid var(--line);
  }
  .bev-cav__band-cols {
    margin-block-start: var(--sp-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--ink-muted);
    font-size: var(--step--1);
    line-height: 1.62;
  }
  .bev-cav__ours { color: var(--inverse-ink); }

  /* ── 03 Neck ──────────────────────────────────────────────────────────── */
  .bev-neck { padding-block: var(--section-y); }
  .bev-neck__head { max-inline-size: 68ch; }
  .bev-neck__head .t-lead { margin-block-start: var(--sp-5); }

  .bev-std { margin-block-start: clamp(2rem, 5vw, 3.5rem); }
  .bev-std__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: var(--rule);
  }
  .bev-std__tab {
    flex: 1 1 8rem;
    padding: 0.85rem 0.9rem;
    background: var(--surface);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-muted);
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
    white-space: nowrap;
  }
  .bev-std__tab:hover { background: var(--accent-wash); color: var(--accent-deep); }
  .bev-std__tab[aria-selected='true'] { background: var(--accent-deep); color: #fff; }

  .bev-std__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: var(--rule);
    border-block-start: 0;
    background: var(--surface-raise);
    align-items: start;
  }
  .bev-std__panel[hidden] { display: none; }
  @media (max-width: 780px) { .bev-std__panel { grid-template-columns: 1fr; } }

  .bev-std__fig svg { inline-size: 100%; block-size: auto; max-inline-size: 22rem; }
  .bev-std__base { stroke: var(--line); stroke-width: 1; stroke-dasharray: 5 4; }
  .bev-std__wall { stroke: var(--accent-deep); stroke-width: 1.5; }
  .bev-std__thread { fill: none; stroke: var(--accent-deep); stroke-width: 1.1; }
  .bev-std__ring { fill: color-mix(in oklab, var(--accent) 18%, transparent); stroke: var(--accent-deep); stroke-width: 1.3; }
  .bev-std__seal { stroke: var(--signal); stroke-width: 2.4; }
  .bev-std__ext { stroke: var(--accent); stroke-width: 0.8; opacity: 0.45; }
  .bev-std__dim { stroke: var(--accent); stroke-width: 0.9; opacity: 0.7; }
  .bev-std__cl { stroke: var(--accent); stroke-width: 0.7; stroke-dasharray: 8 3 1.5 3; opacity: 0.6; }

  .bev-std__spec { display: grid; border-block-start: var(--rule); }
  .bev-std__spec > div {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: baseline;
  }
  @media (max-width: 560px) { .bev-std__spec > div { grid-template-columns: 1fr; gap: 0.2rem; } }
  .bev-std__spec dd { font-size: var(--step--1); line-height: 1.6; }
  .bev-std__warn dd { color: var(--signal-ink); }

  .bev-conv { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .bev-conv__list {
    margin-block-start: var(--sp-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: var(--rule);
  }
  .bev-conv__list li {
    background: var(--surface);
    padding: var(--sp-5);
    display: grid;
    gap: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .bev-conv__list li span { font-size: var(--step--2); letter-spacing: 0.14em; color: var(--accent-deep); }
  .bev-conv__note {
    margin-block-start: var(--sp-5);
    font-size: var(--step--1);
    color: var(--ink-muted);
    max-inline-size: 60ch;
  }

  /* ── 04 Stretch ───────────────────────────────────────────────────────── */
  .bev-stretch { padding-block: var(--section-y); background: var(--surface-sunk); border-block: var(--rule); }
  .bev-stretch__head { max-inline-size: 68ch; }
  .bev-stretch__head .t-lead { margin-block-start: var(--sp-5); }

  .bev-stretch__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .bev-stretch__fig {
    background: var(--surface-raise);
    border: var(--rule);
    padding: clamp(1rem, 2vw, 1.75rem);
    position: sticky;
    inset-block-start: clamp(5rem, 11vh, 7rem);
  }
  @media (max-width: 900px) { .bev-stretch__fig { position: static; } }
  .bev-stretch__fig svg { inline-size: 100%; block-size: auto; }
  .bev-stretch__line { stroke: var(--line); stroke-width: 1; }
  .bev-stretch__tick { stroke: var(--line); stroke-width: 1; }
  .bev-stage { opacity: 0.24; transition: opacity 420ms var(--ease-out); }
  .bev-stretch[data-step='0'] .bev-stage[data-stage='0'],
  .bev-stretch[data-step='1'] .bev-stage[data-stage='1'],
  .bev-stretch[data-step='2'] .bev-stage[data-stage='2'],
  .bev-stretch[data-step='3'] .bev-stage[data-stage='3'],
  .bev-stretch[data-step='4'] .bev-stage[data-stage='4'] { opacity: 1; }
  .bev-hot { fill: color-mix(in oklab, var(--signal) 22%, transparent); }
  .bev-ir { stroke: var(--signal); stroke-width: 1.6; opacity: 0.75; }
  .bev-rod { stroke: var(--ink); stroke-width: 2.2; }
  .bev-press { stroke: var(--accent); stroke-width: 1.3; }

  .bev-stretch__steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0;
    border-block-start: var(--rule-strong);
  }
  .bev-stretch__step {
    padding: var(--sp-5) var(--sp-4) var(--sp-6) 0;
    border-inline-end: var(--rule);
    display: grid;
    gap: 0.4rem;
    align-content: start;
    opacity: 0.5;
    transition: opacity 380ms var(--ease-out);
  }
  .bev-stretch__step:last-child { border-inline-end: 0; }
  .bev-stretch[data-step='0'] .bev-stretch__step[data-station-step='0'],
  .bev-stretch[data-step='1'] .bev-stretch__step[data-station-step='1'],
  .bev-stretch[data-step='2'] .bev-stretch__step[data-station-step='2'],
  .bev-stretch[data-step='3'] .bev-stretch__step[data-station-step='3'],
  .bev-stretch[data-step='4'] .bev-stretch__step[data-station-step='4'] { opacity: 1; }
  @media (max-width: 760px) {
    .bev-stretch__step { opacity: 1; border-inline-end: 0; border-block-end: var(--rule); }
  }
  .bev-stretch__step span { font-size: var(--step--2); letter-spacing: 0.14em; color: var(--accent-deep); }
  .bev-stretch__step h3 { font-size: var(--step-1); letter-spacing: var(--track-head); }
  .bev-stretch__step p { font-size: var(--step--1); line-height: 1.55; color: var(--ink-muted); }

  .bev-stretch__close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-0);
    line-height: 1.6;
    max-inline-size: 68ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
  }

  /* ── 05 Defects ───────────────────────────────────────────────────────── */
  .bev-def { padding-block: var(--section-y); }
  .bev-def__head { max-inline-size: 66ch; }
  .bev-def__head .t-lead { margin-block-start: var(--sp-5); }

  .bev-matrix__scroll { margin-block-start: clamp(2rem, 4vw, 3rem); overflow-x: auto; min-inline-size: 0; max-inline-size: 100%; }
  .bev-matrix {
    inline-size: 100%;
    min-inline-size: 46rem;
    border-collapse: collapse;
    font-size: var(--step--1);
  }
  .bev-matrix th, .bev-matrix td { text-align: start; vertical-align: top; }
  .bev-matrix thead th {
    padding: 0 0.5rem var(--sp-4);
    border-block-end: var(--rule-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: var(--weight-regular);
    inline-size: 6.5rem;
  }
  .bev-matrix__corner { inline-size: auto !important; min-inline-size: 18rem; }
  .bev-matrix tbody th {
    padding: var(--sp-4) var(--sp-5) var(--sp-4) 0;
    border-block-end: var(--rule);
    font-weight: var(--weight-regular);
    display: grid;
    gap: 0.25rem;
  }
  .bev-matrix__name { font-weight: var(--weight-medium); font-size: var(--step-0); }
  .bev-matrix__note { font-size: var(--step--2); line-height: 1.5; color: var(--ink-muted); }
  .bev-matrix tbody td {
    padding: var(--sp-4) 0.5rem;
    border-block-end: var(--rule);
  }
  .bev-matrix__mark {
    display: block;
    inline-size: 0.72rem;
    block-size: 0.72rem;
    background: var(--accent);
