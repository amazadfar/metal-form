            <path d="M30 130 H250 V196 H30 Z" class="cos-line" />
            <path d="M90 130 C90 118 108 112 140 112 C172 112 190 118 190 130" class="cos-line" />
            <path d="M14 120 H266" class="cos-cl" />
            <text x="140" y="228" text-anchor="middle" class="cos-mono">{b.continuity.figLabels.toolA}</text>
          </g>

          <g class="cos-tool cos-tool--b">
            <path d="M390 44 H610 V110 H550 C550 84 532 76 500 76 C468 76 450 84 450 110 H390 Z" class="cos-line" />
            <path d="M390 130 H610 V196 H390 Z" class="cos-line" />
            <path d="M450 130 C450 118 468 112 500 112 C532 112 550 118 550 130" class="cos-line" />
            <path d="M374 120 H626" class="cos-cl" />
            <text x="500" y="228" text-anchor="middle" class="cos-mono">{b.continuity.figLabels.toolB}</text>
          </g>

          <path d="M280 120 H358" class="cos-transfer" marker-end="url(#cos-transfer)" />
          <text x="320" y="104" text-anchor="middle" class="cos-mono">{b.continuity.figLabels.path}</text>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
    </div>

    <div class="shell cos-cont__send">
      <h3 class="cos-h4">{b.continuity.sendHeading}</h3>
      <ul class="cos-send__list">
        {b.continuity.send.map((item: string) => <li>{item}</li>)}
      </ul>
      <p class="cos-cont__note">{b.continuity.note}</p>
    </div>

    {/* Layer three: the depth, folded away until it is wanted. */}
    <div class="shell cos-panels">
      <h3 class="t-label cos-panels__cap">{b.panels.heading}</h3>
      {b.panels.items.map((panel: any, i: number) => (
        <div class="disc" data-open={i === 0 ? 'true' : 'false'}>
          <h4>
            <button class="disc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span>{panel.title}</span>
              <span class="disc__sign" aria-hidden="true"></span>
            </button>
          </h4>
          <div class="disc__panel">
            <div class="disc__inner">
              <div>
                <ul class="cos-panel__list">
                  {panel.bullets.map((bullet: string) => <li>{bullet}</li>)}
                </ul>
                {panel.source && <p class="cos-panel__src t-fine">{panel.source}</p>}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</article>

<style>
  /* ═══════════════════════════════════════════════════════════════════════
     COSMETICS — chapter scope.

     Everything is prefixed `cos-`. Warm ivory ground, deep aubergine ink,
     rose-taupe accent, one champagne highlight. Hairlines and space carry the
     structure; there is not a single filled card on this page.
     ═══════════════════════════════════════════════════════════════════════ */

  /* The specular peak of every sheen gradient on this page. On the chapter's
     own near-white ground the brightest thing available is the raised surface;
     inside the one inverted band a highlight has to be an actual light, or a
     mirror grade and a matte grade look identical. */
  .cos { --cos-hair: 1.6; --cos-spec: var(--surface-raise); }
  /* On steel the ground's raised surface is a lifted near-black, so the peak
     moves to the ground's own light — the token the inverted band already
     sets its ink and its texture from. No colour is restated here. */
  .cos .ground--steel { --cos-spec: var(--inverse-ink); }

  /* ── Shared drawing conventions ───────────────────────────────────────── */
  .cos-line { fill: none; stroke: var(--accent-deep); stroke-width: var(--cos-hair); stroke-linejoin: round; }
  .cos-line--faint { stroke-width: 0.9; opacity: 0.45; }
  .cos-line--thin { stroke-width: 0.85; opacity: 0.7; }
  .cos-face { fill: color-mix(in oklab, var(--accent-deep) 9%, transparent); stroke: none; }
  .cos-face--deep { fill: color-mix(in oklab, var(--accent-deep) 20%, transparent); }
  .cos-cl { fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 12 4 2 4; opacity: 0.8; }
  .cos-cl--fine { stroke-width: 0.7; opacity: 0.4; stroke-dasharray: 7 3 1.5 3; }
  .cos-ldr { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; opacity: 0.9; }
  .cos-rule { stroke: var(--ink-muted); stroke-width: 0.9; opacity: 0.5; fill: none; }
  .cos-dot { fill: var(--accent-deep); }
  .cos-dot--gate { fill: var(--signal); }
  .cos-wash { fill: color-mix(in oklab, var(--accent) 22%, transparent); }
  .cos-wash--hot { fill: color-mix(in oklab, var(--signal) 34%, transparent); }
  .cos-grain { stroke: var(--accent-deep); stroke-width: 0.8; opacity: 0.32; }
  .cos-hinge { stroke: var(--signal); stroke-width: 1.8; fill: none; }
  .cos-flow { fill: none; stroke: var(--accent); stroke-width: 1.3; }
  .cos-dim { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; }
  .cos-inset { fill: none; stroke: var(--line); stroke-width: 1; }
  .cos-transfer { fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 7 5; }
  .cos-grid { stroke: var(--grid-line); stroke-width: 1; }
  .cos-axis { fill: none; stroke: var(--ink-muted); stroke-width: 1; opacity: 0.55; }
  .cos-curve { fill: none; stroke-width: 1.8; stroke-linejoin: round; stroke-linecap: round; }
  .cos-curve--tool { stroke: var(--accent-deep); }
  .cos-curve--part { stroke: var(--signal); stroke-dasharray: 8 4; }

  .cos-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    fill: var(--ink);
    text-transform: uppercase;
  }
  .cos-mono--mark { fill: var(--accent); letter-spacing: 0.14em; }
  .cos-mono--tool { fill: var(--accent-deep); }
  .cos-mono--part { fill: var(--signal); }
  .cos-mono--inset { fill: var(--accent-deep); }

  /* ── Type ─────────────────────────────────────────────────────────────── */
  .cos-h2 {
    margin-block-start: var(--sp-5);
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.07;
    letter-spacing: -0.028em;
    font-weight: 500;
    text-wrap: balance;
  }
  .cos-h2--start { text-align: start; max-inline-size: 16ch; }
  .cos-h3 { font-size: var(--step-2); letter-spacing: var(--track-head); font-weight: 500; max-inline-size: 26ch; }
  .cos-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); font-weight: 500; }

  .cos-lead {
    margin-block-start: var(--sp-6);
    font-size: var(--step-1);
    line-height: 1.52;
    color: var(--ink-muted);
    max-inline-size: 56ch;
    margin-inline: auto;
  }
  .cos-close {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    margin-inline: auto;
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 46ch;
    text-align: center;
    text-wrap: balance;
  }
  .cos-close--strong { font-size: var(--step-2); letter-spacing: var(--track-head); max-inline-size: 34ch; }
  .cos-boundaryline {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    margin-inline: auto;
    max-inline-size: 62ch;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-muted);
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
  }

  /* Section frame. The champagne bar sitting on the hairline is the motif at
     its smallest scale — the still page still carries the highlight. */
  .cos-sec {
    position: relative;
    padding-block: var(--section-y-loose);
    border-block-start: var(--rule);
  }
  .cos-sec::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline: 0;
    margin-inline: auto;
    inline-size: 5rem;
    block-size: 2px;
    background: var(--signal);
    opacity: 0.85;
  }
  .cos-head { text-align: center; max-inline-size: 62rem; }
  .cos-head .eyebrow { justify-content: center; }

  /* ── Hero — SPLIT ─────────────────────────────────────────────────────────
     Argument in a narrow column, one large show surface beside it. The two
     tracks are deliberately uneven: the drawing is the thing being sold, so it
     gets the wider half and runs to the edge of the wide shell rather than
     floating with air on both sides. The sheen sits on the whole opening. */
  .cos-hero {
    position: relative;
    padding-block: clamp(3rem, 7vw, 6rem) clamp(3.5rem, 8vw, 7rem);
    overflow: clip;
    --tex-opacity: 0.24;
  }
  .cos-hero__wash {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 80% at 50% 0%, color-mix(in oklab, var(--signal) 12%, transparent), transparent 62%);
    pointer-events: none;
  }
  .cos-hero__inner { position: relative; }

  .cos-hero__split {
    --split-a: 0.85fr;
    --split-b: 1.15fr;
    --split-align: center;
    --split-gap: clamp(2rem, 4vw, 3.5rem);
    --split-gap-stacked: clamp(2.25rem, 7vw, 3.5rem);
  }
  .cos-hero__copy { min-inline-size: 0; }

  .cos-hero__head { margin-block-start: clamp(1.25rem, 3vw, 2rem); }
  .cos-hero__head span { display: block; }
  .cos-hero__head span:last-child { color: var(--accent-deep); }

  .cos-hero__fig { min-inline-size: 0; }
  .cos-hero__figlabel { display: block; margin-block-end: var(--sp-4); }
  .cos-hero__fig svg { inline-size: 100%; block-size: auto; display: block; }
  .cos-hero__fig .figure-note { margin-block-start: var(--sp-4); }

  /* The signature move: one sweep, decelerating to rest. It never loops. */
  .cos-sweep { transform-box: view-box; transform-origin: 0 0; }
  @keyframes cos-sweep {
    from { transform: translateX(calc((-300px + var(--dx, 0) * 1px) * var(--dir))); }
    to   { transform: translateX(calc((300px + var(--dx, 0) * 1px) * var(--dir))); }
  }
  .cos-hero__fig .cos-sweep { transform: translateX(calc((300px + var(--dx, 0) * 1px) * var(--dir))); }
  :global(html.js) .cos-hero__fig[data-reveal='in'] .cos-sweep {
    animation: cos-sweep 2600ms cubic-bezier(0.22, 0.61, 0.36, 1) 240ms both;
  }
  @keyframes cos-draw { from { stroke-dashoffset: 900; } to { stroke-dashoffset: 0; } }
  :global(html.js) .cos-hero__fig[data-reveal='in'] .cos-draw {
    stroke-dasharray: 900;
    animation: cos-draw 1100ms var(--ease-out) both;
  }

  .cos-hero__lead {
    margin-block-start: clamp(1.75rem, 3.5vw, 2.5rem);
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }
  /* Verified capability, set to be read rather than to be tidy. */
  .cos-hero__markers { margin-block-start: var(--sp-6); }

  .cos-rail {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-5) clamp(2rem, 5vw, 4rem);
    padding-block-start: var(--sp-5);
    border-block-start: var(--rule);
    text-align: start;
  }
  @media (max-width: 1000px) { .cos-rail { grid-template-columns: minmax(0, 1fr); } }
  .cos-rail__item { font-size: var(--step--2); line-height: 1.6; color: var(--ink-muted); }
  .cos-rail__item--nda { color: var(--accent-deep); }

  /* ── 01 The light table ───────────────────────────────────────────────── */
  .cos-lt__table { margin-block-start: clamp(2.5rem, 6vw, 4.5rem); }
  .cos-lt__figlabel { display: block; margin-block-end: var(--sp-4); text-align: center; }
  .cos-lt__fig { color: var(--accent-deep); }
  .cos-lt__fig svg { inline-size: 100%; block-size: auto; }
  .cos-lt__fig .figure-note { margin-block-start: var(--sp-4); justify-content: center; }

  .cos-lt__notes {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    border-block-start: var(--rule-strong);
  }
  @media (max-width: 1200px) { .cos-lt__notes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 1000px) { .cos-lt__notes { grid-template-columns: minmax(0, 1fr); } }

  .cos-note {
    padding-block: var(--sp-5) var(--sp-7);
    padding-inline: var(--col-pad) var(--sp-5);
    border-inline-end: var(--rule);
    display: grid;
    gap: 0.4rem;
    align-content: start;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .cos-note:first-child { padding-inline-start: 0; }
  .cos-note:last-child { border-inline-end: 0; }
  /* Two columns and then a stack. Once the vertical rule is gone the leading
     indent goes with it, or column two reads as an outdent with no cause. */
  @media (max-width: 1200px) {
    .cos-note {
      border-inline-end: 0;
      border-block-end: var(--rule);
      padding-inline: 0 var(--sp-6);
    }
  }
  .cos-note:focus-visible { outline: var(--focus); outline-offset: var(--focus-offset); }
  .cos-note__mark { font-size: var(--step--2); letter-spacing: 0.16em; color: var(--accent-deep); }
  .cos-note__term { font-size: var(--step-0); font-weight: 500; letter-spacing: var(--track-head); }
  .cos-note__body { font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }

  /* Focusing one callout quiets the other four. Nothing is hidden by it — the
     information is on the page either way. */
  .cos-lt__table:has(.cos-note:hover) .cos-note:not(:hover),
  .cos-lt__table:has(.cos-note:focus-visible) .cos-note:not(:focus-visible) { opacity: 0.42; }

  .cos-lt__close {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    margin-inline: auto;
    max-inline-size: 40ch;
    text-align: center;
    font-size: var(--step-2);
    line-height: 1.34;
    letter-spacing: var(--track-head);
    text-wrap: balance;
  }

  /* ── 02 The gloss ladder — the chapter's one inverted band ─────────────── */
  .cos-gloss { isolation: isolate; }
  /* The sheen rides the full bleed of the band, under the content and over the
     ground. Negative z-index inside the section's own stacking context. */
  .cos-gloss__bed {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    --tex-opacity: 0.34;
  }
  .cos-gloss__work { margin-block-start: clamp(2.5rem, 6vw, 4.5rem); }

  .cos-gloss__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block-end: clamp(2rem, 4vw, 3rem);
  }
  .cos-gloss__panel[hidden] { display: none; }
  @media (max-width: 1000px) { .cos-gloss__panel { grid-template-columns: minmax(0, 1fr); } }
  .cos-gloss__sample svg { inline-size: 100%; block-size: auto; }
  .cos-gloss__sample .figure-note { margin-block-start: var(--sp-4); }

  .cos-gloss__grade { font-size: var(--step-3); letter-spacing: var(--track-head); font-weight: 500; }
  /* One capability, so one track at every width — the shared two-up fallback
     would leave it stranded at half measure on a phone. */
  .cos-gloss__caps { margin-block-start: var(--sp-5); grid-template-columns: minmax(0, 1fr); }
  .cos-gloss__ra { font-variant-numeric: tabular-nums; }
  .cos-gloss__rows { margin-block-start: var(--sp-5); }
  .cos-gloss__draft dd { color: var(--accent-deep); }

  .cos-ladder { margin-block-start: clamp(1.5rem, 3vw, 2.5rem); }
  .cos-ladder__cap { display: block; margin-block-end: var(--sp-4); }
  .cos-ladder__scroll { overflow-x: auto; min-inline-size: 0; max-inline-size: 100%; padding-block-end: var(--sp-2); }
  .cos-ladder__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(7rem, 1fr);
    gap: 1px;
    min-inline-size: 56rem;
    background: var(--line);
    border: var(--rule);
  }
  .cos-rung {
    background: var(--surface);
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding-block: var(--sp-4);
    padding-inline: var(--sp-3);
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .cos-rung svg { inline-size: 3.4rem; block-size: auto; }
  .cos-rung__name { font-size: var(--step--1); font-weight: 500; white-space: nowrap; }
  .cos-rung__scale { font-size: var(--step--2); color: var(--ink-muted); white-space: nowrap; }
  .cos-rung:hover { background: var(--accent-wash); }
  .cos-rung[aria-selected='true'] { background: var(--accent-wash); }
  .cos-rung[aria-selected='true'] .cos-rung__name { color: var(--accent-deep); }
  .cos-rung[aria-selected='true'] .cos-line { stroke-width: 2; }
  .cos-ladder__note {
    margin-block-start: var(--sp-5);
    margin-inline: auto;
    max-inline-size: 62ch;
    color: var(--ink-muted);
  }
  .cos-gloss__tail { margin-block-start: clamp(1rem, 2vw, 2rem); }

  /* ── 03 Gate and parting line ─────────────────────────────────────────── */
  .cos-gate__trip {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  @media (max-width: 1000px) { .cos-gate__trip { grid-template-columns: minmax(0, 1fr); } }
  .cos-gate__case svg { inline-size: 100%; block-size: auto; }
  .cos-gate__cap { margin-block-start: var(--sp-4); padding-block-start: var(--sp-4); border-block-start: var(--rule); }
  .cos-gate__name { font-size: var(--step-1); font-weight: 500; letter-spacing: var(--track-head); }
  .cos-gate__short { margin-block-start: var(--sp-3); }
  .cos-gate__note { margin-block-start: var(--sp-4); font-size: var(--step--1); line-height: 1.62; color: var(--ink-muted); }

  .cos-part { margin-block-start: clamp(4rem, 9vw, 8rem); }
  .cos-part__head { text-align: center; max-inline-size: 62rem; margin-inline: auto; }
  .cos-part__head .cos-h3 { margin-inline: auto; }
  .cos-part__body {
    margin-block-start: var(--sp-5);
    margin-inline: auto;
    max-inline-size: 54ch;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .cos-part__fig { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .cos-part__fig svg { inline-size: 100%; block-size: auto; }
  .cos-part__fig .figure-note { margin-block-start: var(--sp-4); justify-content: center; }

  .cos-part__list {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-block-start: var(--rule-strong);
  }
  @media (max-width: 1000px) { .cos-part__list { grid-template-columns: minmax(0, 1fr); } }
  .cos-part__list li {
    padding-block: var(--sp-5) var(--sp-6);
    padding-inline: var(--col-pad) var(--sp-6);
    border-inline-end: var(--rule);
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }
  .cos-part__list li:first-child { padding-inline-start: 0; }
  .cos-part__list li:last-child { border-inline-end: 0; }
  @media (max-width: 1000px) {
    .cos-part__list li { border-inline-end: 0; border-block-end: var(--rule); padding-inline: 0 var(--sp-6); }
  }
  .cos-part__mark { font-size: var(--step--2); letter-spacing: 0.16em; color: var(--accent-deep); }
  .cos-part__name { font-size: var(--step-0); font-weight: 500; letter-spacing: var(--track-head); }
  .cos-part__note { font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }

  /* ── 04 Component atlas ───────────────────────────────────────────────── */
  .cos-atlas__rows { margin-block-start: clamp(2.5rem, 6vw, 4.5rem); border-block-start: var(--rule-strong); }
  .cos-row {
    display: grid;
    grid-template-columns: 3rem 12rem minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: start;
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
    border-block-end: var(--rule);
  }
  @media (max-width: 1000px) {
    .cos-row { grid-template-columns: 3rem minmax(0, 1fr); }
    .cos-row__fig { grid-column: 2; }
    .cos-row__copy { grid-column: 2; }
  }
  .cos-row__i { font-size: var(--step--2); letter-spacing: 0.16em; color: var(--accent-deep); padding-block-start: 0.4rem; }
  .cos-row__fig svg { inline-size: 100%; block-size: auto; max-inline-size: 12rem; }
  .cos-row__name { font-size: var(--step-2); font-weight: 500; letter-spacing: var(--track-head); max-inline-size: 22ch; }
  .cos-row__spec { margin-block-start: var(--sp-4); }
  .cos-row__note { margin-block-start: var(--sp-4); font-size: var(--step--1); line-height: 1.68; color: var(--ink-muted); max-inline-size: 62ch; }
  .cos-atlas__note { margin-block-start: var(--sp-6); justify-content: center; }

  /* ── 05 Thread, land and seal ─────────────────────────────────────────── */
  .cos-seal__grid {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .cos-seal__grid { grid-template-columns: minmax(0, 1fr); } }
  .cos-seal__fig svg { inline-size: 100%; block-size: auto; }
  .cos-seal__fig .figure-note { margin-block-start: var(--sp-4); }

