---
/**
 * COSMETICS & PERSONAL CARE — the light study.
 *
 * Every other chapter on this site is composed around information. This one is
 * composed around a surface, because a surface is the only thing this buyer's
 * customer will ever look at.
 *
 * The signature motif is a travelling specular highlight: a soft band crossing a
 * curved wall that visibly BREAKS where the parting line falls and STEPS where
 * the gate sits. It appears at four scales — the hero light study, the gloss
 * ladder, the gate triptych, and as a 2 px champagne bar sitting on every
 * section hairline, so even the still page carries the same idea.
 *
 * Composition is centred and unusually empty. Larger type, fewer words, more
 * air than any other chapter. Warm ivory ground, deep aubergine ink, rose-taupe
 * accent, one champagne highlight — all from the vertical's palette tokens.
 */
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { content, common } = Astro.props;
const b = content.blocks as any;

/* ── Drawing constants ──────────────────────────────────────────────────────
   Geometry only. Every readable string comes out of the content JSON. */

const clamp01 = (v: number) => Math.max(0, Math.min(1, v));

/* Gloss ladder. Index-matched to blocks.gloss.rungs, mirror grade first.
   `c` is where the highlight sits across the wall, `half` its falloff radius,
   `peak` its brightness, `grain` the number of texture ticks drawn on it. */
const GLOSS = [
  { c: 0.34, half: 0.055, peak: 0.98, grain: 0 },
  { c: 0.34, half: 0.090, peak: 0.86, grain: 0 },
  { c: 0.34, half: 0.135, peak: 0.71, grain: 0 },
  { c: 0.35, half: 0.185, peak: 0.57, grain: 6 },
  { c: 0.35, half: 0.255, peak: 0.43, grain: 12 },
  { c: 0.36, half: 0.340, peak: 0.31, grain: 20 },
  { c: 0.38, half: 0.440, peak: 0.21, grain: 30 },
  { c: 0.40, half: 0.550, peak: 0.15, grain: 40 },
];

/* Cavitation plot. Published industry practice gives the shape of both curves:
   tooling cost scales sub-linearly (16 cavities ≈ 5×, not 16×) and part cost
   falls then flattens because cooling dominates the cycle. */
const CAVS = Array.from({ length: 48 }, (_, i) => i + 1);
const PX = (n: number) => 70 + ((n - 1) / 47) * 760;
const PY = (v: number) => 340 - v * 250;
const toolAt = (n: number) => Math.pow(n, 0.58) / Math.pow(48, 0.58);
const partAt = (n: number) => 0.3 + 0.7 / Math.pow(n, 0.62);
const toolPts = CAVS.map((n) => `${PX(n).toFixed(1)},${PY(toolAt(n)).toFixed(1)}`).join(' ');
const partPts = CAVS.map((n) => `${PX(n).toFixed(1)},${PY(partAt(n)).toFixed(1)}`).join(' ');
const CROSS_N = 13;
const crossX = PX(CROSS_N);
const crossY = PY(toolAt(CROSS_N));
const markX = PX(46);

/* One closure section, reused at four scales. Drawing it once is what makes the
   gate triptych and the parting-line rail read as the same object. */
const CAP_OUT = 'M40 200 V110 C40 74 62 58 100 58 H220 C258 58 280 74 280 110 V200';
const CAP_IN = 'M58 200 V112 C58 88 74 78 104 78 H216 C246 78 262 88 262 112 V200';
const CAP_CROWN = 'M40 200 V110 C40 74 62 58 100 58 H220 C258 58 280 74 280 110 V200 H40 Z';
---

<article class="cos">

  {/* ═══ HERO — one curved surface, one travelling highlight ═══════════════ */}
  <header class="cos-hero" data-tex="sheen">
    <div class="cos-hero__wash" aria-hidden="true"></div>

    <div class="shell--wide cos-hero__inner">
     <div class="split cos-hero__split">
      <div class="cos-hero__copy" data-split-copy>
        <p class="eyebrow">{content.hero.kicker}</p>
        <h1 class="t-statement cos-hero__head">
          {content.hero.headline.map((line: string, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>

        <p class="cos-hero__lead">{content.hero.lead}</p>

        {content.hero.markers && (
          <ul class="badges cos-hero__markers">
            {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
          </ul>
        )}
      </div>

      <figure class="cos-hero__fig" data-split-figure data-reveal>
        <p class="t-label cos-hero__figlabel">{b.surface.heroLabels.highlight}</p>
        <svg viewBox="-46 0 866 420" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <linearGradient id="cos-sheen" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="var(--signal)" stop-opacity="0" />
              <stop offset="0.34" stop-color="var(--signal)" stop-opacity="0.34" />
              <stop offset="0.5" stop-color="var(--cos-spec)" stop-opacity="0.96" />
              <stop offset="0.66" stop-color="var(--signal)" stop-opacity="0.34" />
              <stop offset="1" stop-color="var(--signal)" stop-opacity="0" />
            </linearGradient>
            <clipPath id="cos-clip-dome">
              <path d="M120 236 C120 110 240 76 380 76 C520 76 640 110 640 236 Z" />
            </clipPath>
            <clipPath id="cos-clip-domeL" clip-path="url(#cos-clip-dome)">
              <rect x="0" y="0" width="352" height="420" />
            </clipPath>
            <clipPath id="cos-clip-domeG" clip-path="url(#cos-clip-dome)">
              <rect x="352" y="0" width="56" height="420" />
            </clipPath>
            <clipPath id="cos-clip-domeR" clip-path="url(#cos-clip-dome)">
              <rect x="408" y="0" width="420" height="420" />
            </clipPath>
            <clipPath id="cos-clip-wall">
              <path d="M120 236 H640 V372 H120 Z" />
            </clipPath>
          </defs>

          {/* The surface itself: a wash so light has something to fall on. */}
          <path d="M120 236 C120 110 240 76 380 76 C520 76 640 110 640 236 Z" class="cos-face" />
          <path d="M120 236 H640 V372 H120 Z" class="cos-face" />

          {/* Four bands, one gesture. The wall band is offset from the dome band,
              so the highlight breaks at the parting line; the gate strip is
              offset again, so it steps at the gate. */}
          <g class="cos-sweep" style="--dx:0" clip-path="url(#cos-clip-domeL)">
            <rect x="-160" y="-80" width="150" height="560" fill="url(#cos-sheen)" transform="rotate(-15 380 220)" />
          </g>
          <g class="cos-sweep" style="--dx:17" clip-path="url(#cos-clip-domeG)">
            <rect x="-160" y="-80" width="150" height="560" fill="url(#cos-sheen)" transform="rotate(-15 380 220)" />
          </g>
          <g class="cos-sweep" style="--dx:0" clip-path="url(#cos-clip-domeR)">
            <rect x="-160" y="-80" width="150" height="560" fill="url(#cos-sheen)" transform="rotate(-15 380 220)" />
          </g>
          <g class="cos-sweep" style="--dx:38" clip-path="url(#cos-clip-wall)">
            <rect x="-160" y="-80" width="150" height="560" fill="url(#cos-sheen)" transform="rotate(-15 380 220)" />
          </g>

          {/* Outline over the light. */}
          <path d="M120 236 C120 110 240 76 380 76 C520 76 640 110 640 236" class="cos-line cos-draw" />
          <path d="M138 236 C138 126 246 94 380 94 C514 94 622 126 622 236" class="cos-line cos-line--faint" />
          <path d="M120 236 V372 M640 236 V372 M138 236 V372 M622 236 V372" class="cos-line" />
          <path d="M120 372 H640" class="cos-line" />

          {/* Parting line, drawn as a witness line and called out. */}
          <path d="M84 236 H676" class="cos-cl" />
          <circle cx="120" cy="236" r="3.2" class="cos-dot" />
          <path d="M120 236 H96" class="cos-ldr" />
          <text x="90" y="232" text-anchor="end" class="cos-mono">{b.surface.heroLabels.parting}</text>

          {/* Gate at the crown — the step in the band sits here. */}
          <circle cx="380" cy="76" r="4" class="cos-dot" />
          <path d="M380 76 V44 H446" class="cos-ldr" />
          <text x="452" y="48" class="cos-mono">{b.surface.heroLabels.gate}</text>

          {/* Sealing land — inside, hidden, unforgiving. */}
          <path d="M556 236 V214 H600" class="cos-line cos-line--faint" />
          <rect x="556" y="206" width="46" height="8" class="cos-wash" />
          <circle cx="600" cy="210" r="3.2" class="cos-dot" />
          <path d="M600 210 L682 318" class="cos-ldr" />
          <text x="688" y="322" class="cos-mono">{b.surface.heroLabels.land}</text>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
     </div>

      <div class="cos-rail">
        <p class="cos-rail__item">{b.surface.railAttribution}</p>
        <p class="cos-rail__item cos-rail__item--nda">{b.surface.railNda}</p>
      </div>
    </div>
  </header>

  {/* ═══ 01 · THE SHOW SURFACE — the light table ════════════════════════════ */}
  <section class="cos-sec cos-lt" id="surface">
    <div class="shell cos-head">
      <p class="eyebrow">{b.surface.index} · {b.surface.kicker}</p>
      <h2 class="cos-h2">{b.surface.heading}</h2>
      <p class="cos-lead">{b.surface.body}</p>
    </div>

    <div class="shell--wide cos-lt__table">
      <figure class="cos-lt__fig">
        <p class="t-label cos-lt__figlabel">{b.surface.figureLabel}</p>
        <svg viewBox="0 0 1200 360" data-nomirror role="img" aria-label={b.surface.figureLabel}>
          <defs>
            <linearGradient id="cos-lt-sheen" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="var(--signal)" stop-opacity="0" />
              <stop offset="0.34" stop-color="var(--signal)" stop-opacity="0.34" />
              <stop offset="0.5" stop-color="var(--cos-spec)" stop-opacity="0.96" />
              <stop offset="0.66" stop-color="var(--signal)" stop-opacity="0.34" />
              <stop offset="1" stop-color="var(--signal)" stop-opacity="0" />
            </linearGradient>
            <clipPath id="cos-lt-crown"><path d="M250 74 H950 V96 H250 Z" /></clipPath>
          </defs>

          {/* Closure in section, drawn once at full width. */}
          <path d="M150 300 V150 C150 96 186 74 250 74 H950 C1014 74 1050 96 1050 150 V300" class="cos-line" />
          <path d="M178 300 V152 C178 116 206 100 254 100 H946 C994 100 1022 116 1022 152 V300" class="cos-line cos-line--faint" />
          <path d="M150 300 H1050" class="cos-line" />

          {/* Internal thread turns. */}
          {[196, 226, 256, 286].map((y: any) => (
            <g>
              <path d={`M178 ${y} l16 -7 v14 z`} class="cos-line cos-line--thin" />
              <path d={`M1022 ${y} l-16 -7 v14 z`} class="cos-line cos-line--thin" />
            </g>
          ))}

          {/* A static highlight on the crown — the same motif at rest. */}
          <g clip-path="url(#cos-lt-crown)">
            <rect x="560" y="60" width="120" height="30" fill="url(#cos-lt-sheen)" />
          </g>

          {/* 01 parting line */}
          <path d="M120 210 H1080" class="cos-cl" />
          <circle cx="150" cy="210" r="3.4" class="cos-dot" />
          <path d="M150 210 V318" class="cos-ldr" />

          {/* 02 gate on the crown */}
          <path d="M392 74 q8 -9 16 0" class="cos-line cos-line--thin" />
          <circle cx="400" cy="74" r="3.4" class="cos-dot" />
          <path d="M400 74 V318" class="cos-ldr" />

          {/* 03 polish grade */}
          <circle cx="620" cy="74" r="3.4" class="cos-dot" />
          <path d="M620 74 V318" class="cos-ldr" />

          {/* 04 sealing land */}
          <rect x="836" y="100" width="52" height="9" class="cos-wash" />
          <path d="M836 109 H888" class="cos-line cos-line--thin" />
          <circle cx="862" cy="105" r="3.4" class="cos-dot" />
          <path d="M862 105 V318" class="cos-ldr" />

          {/* 05 draft on the outer skirt */}
          <path d="M1050 300 L1064 150" class="cos-cl cos-cl--fine" />
          <path d="M1050 240 A 62 62 0 0 1 1056 240" class="cos-line cos-line--thin" />
          <circle cx="1050" cy="240" r="3.4" class="cos-dot" />
          <path d="M1050 240 V318" class="cos-ldr" />

          {/* The measuring rail every leader lands on. */}
          <path d="M100 318 H1130" class="cos-rule" />
          {[150, 400, 620, 862, 1050].map((x: any) => (
            <path d={`M${x} 318 V330`} class="cos-rule" />
          ))}
          {b.surface.callouts.map((c: any, i: number) => (
            <text x={[150, 400, 620, 862, 1050][i]} y="348" text-anchor="middle" class="cos-mono cos-mono--mark">{c.mark}</text>
          ))}
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <ol class="cos-lt__notes">
        {b.surface.callouts.map((c: any, i: number) => (
          <li class="cos-note" data-k={c.mark} tabindex="0" style={`--reveal-delay:${i * 70}ms`} data-reveal>
            <span class="t-mono cos-note__mark">{c.mark}</span>
            <h3 class="cos-note__term">{c.term}</h3>
            <p class="cos-note__body">{c.note}</p>
          </li>
        ))}
      </ol>

      <p class="cos-lt__close">{b.surface.close}</p>
    </div>
  </section>

  {/* ═══ 02 · THE GLOSS LADDER ══════════════════════════════════════════════ */}
  <section class="cos-sec cos-gloss ground--steel" id="gloss">
    {/* The chapter's contrast anchor. A polish grade is only legible as light
        against dark, so the one band that argues about gloss is the one band
        that inverts. The sheen rides the whole bed, full bleed. */}
    <div class="cos-gloss__bed" data-tex="sheen" aria-hidden="true"></div>

    <div class="shell cos-head">
      <p class="eyebrow">{b.gloss.index} · {b.gloss.kicker}</p>
      <h2 class="cos-h2">{b.gloss.heading}</h2>
      <p class="cos-lead">{b.gloss.body}</p>
    </div>

    <div class="shell--wide cos-gloss__work" data-tabs>
      {/* The large sample re-renders at the selected grade. */}
      {b.gloss.rungs.map((r: any, i: number) => (
        <div
          class="cos-gloss__panel"
          data-panel={r.id}
          role="tabpanel"
          id={`cos-panel-${r.id}`}
          aria-labelledby={`cos-tab-${r.id}`}
          hidden={i !== 0}
        >
          <figure class="cos-gloss__sample">
            <svg viewBox="0 0 420 250" data-nomirror role="img" aria-label={common.schematic}>
              <defs>
                <linearGradient id={`cos-gp-${r.id}`} x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="var(--signal)" stop-opacity="0" />
                  <stop offset={clamp01(GLOSS[i].c - GLOSS[i].half).toFixed(3)} stop-color="var(--signal)" stop-opacity="0" />
                  <stop offset={clamp01(GLOSS[i].c - GLOSS[i].half * 0.4).toFixed(3)} stop-color="var(--signal)" stop-opacity={(GLOSS[i].peak * 0.42).toFixed(2)} />
                  <stop offset={GLOSS[i].c.toFixed(3)} stop-color="var(--cos-spec)" stop-opacity={GLOSS[i].peak.toFixed(2)} />
                  <stop offset={clamp01(GLOSS[i].c + GLOSS[i].half * 0.4).toFixed(3)} stop-color="var(--signal)" stop-opacity={(GLOSS[i].peak * 0.42).toFixed(2)} />
                  <stop offset={clamp01(GLOSS[i].c + GLOSS[i].half).toFixed(3)} stop-color="var(--signal)" stop-opacity="0" />
                  <stop offset="1" stop-color="var(--signal)" stop-opacity="0" />
                </linearGradient>
                <clipPath id={`cos-gpc-${r.id}`}>
                  <path d="M46 22 C16 82 16 168 46 228 L374 228 C404 168 404 82 374 22 Z" />
                </clipPath>
              </defs>
              <path d="M46 22 C16 82 16 168 46 228 L374 228 C404 168 404 82 374 22 Z" class="cos-face cos-face--deep" />
              <rect x="0" y="0" width="420" height="250" fill={`url(#cos-gp-${r.id})`} clip-path={`url(#cos-gpc-${r.id})`} />
              {/* Texture grain, drawn only where the grade actually has any. */}
              <g clip-path={`url(#cos-gpc-${r.id})`}>
                {Array.from({ length: GLOSS[i].grain }).map((_: any, k: number) => (
                  <line
                    x1={30 + ((k * 97) % 360)}
                    y1={30 + ((k * 53) % 196)}
                    x2={30 + ((k * 97) % 360) + 7}
                    y2={30 + ((k * 53) % 196) + 3}
                    class="cos-grain"
                  />
                ))}
              </g>
              <path d="M46 22 C16 82 16 168 46 228 L374 228 C404 168 404 82 374 22 Z" class="cos-line" />
            </svg>
            <figcaption class="figure-note">{common.schematic}</figcaption>
          </figure>

          <div class="cos-gloss__spec">
            <p class="cos-gloss__grade">{r.name}</p>
            <div class="caps caps--tight cos-gloss__caps">
              <div class="cap">
                <span class="cap__k">{b.gloss.specLabels.ra}</span>
                <span class="cap__v cos-gloss__ra">{r.ra}</span>
                <span class="cap__n">{r.scale}</span>
              </div>
            </div>
            <dl class="spec cos-gloss__rows">
              <div class="spec__row"><dt class="spec__k">{b.gloss.specLabels.method}</dt><dd class="spec__v">{r.method}</dd></div>
              <div class="spec__row"><dt class="spec__k">{b.gloss.specLabels.cost}</dt><dd class="spec__v">{r.cost}</dd></div>
              <div class="spec__row"><dt class="spec__k">{b.gloss.specLabels.steel}</dt><dd class="spec__v">{r.steel}</dd></div>
              <div class="spec__row cos-gloss__draft"><dt class="spec__k">{b.gloss.specLabels.draft}</dt><dd class="spec__v">{r.draft}</dd></div>
            </dl>
          </div>
        </div>
      ))}

      {/* The ladder itself: the same wall, eight grades, in order. */}
      <div class="cos-ladder">
        <p class="t-label cos-ladder__cap">{b.gloss.ladderLabel}</p>
        <div class="cos-ladder__scroll">
          <div class="cos-ladder__row" role="tablist" aria-label={b.gloss.tabsLabel}>
            {b.gloss.rungs.map((r: any, i: number) => (
              <button
                class="cos-rung"
                type="button"
                role="tab"
                data-tab={r.id}
                id={`cos-tab-${r.id}`}
                aria-controls={`cos-panel-${r.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              >
                <svg viewBox="0 0 60 130" data-nomirror aria-hidden="true">
                  <defs>
                    <linearGradient id={`cos-gl-${r.id}`} x1="0" y1="0" x2="1" y2="0">
                      <stop offset="0" stop-color="var(--signal)" stop-opacity="0" />
                      <stop offset={clamp01(GLOSS[i].c - GLOSS[i].half).toFixed(3)} stop-color="var(--signal)" stop-opacity="0" />
                      <stop offset={GLOSS[i].c.toFixed(3)} stop-color="var(--cos-spec)" stop-opacity={GLOSS[i].peak.toFixed(2)} />
                      <stop offset={clamp01(GLOSS[i].c + GLOSS[i].half).toFixed(3)} stop-color="var(--signal)" stop-opacity="0" />
                      <stop offset="1" stop-color="var(--signal)" stop-opacity="0" />
                    </linearGradient>
                    <clipPath id={`cos-glc-${r.id}`}>
                      <path d="M10 8 C3 44 3 94 10 122 L50 122 C57 94 57 44 50 8 Z" />
                    </clipPath>
                  </defs>
                  <path d="M10 8 C3 44 3 94 10 122 L50 122 C57 94 57 44 50 8 Z" class="cos-face cos-face--deep" />
                  <rect x="0" y="0" width="60" height="130" fill={`url(#cos-gl-${r.id})`} clip-path={`url(#cos-glc-${r.id})`} />
                  <path d="M10 8 C3 44 3 94 10 122 L50 122 C57 94 57 44 50 8 Z" class="cos-line cos-line--thin" />
                </svg>
                <span class="cos-rung__name">{r.name}</span>
                <span class="cos-rung__scale t-mono">{r.scale}</span>
              </button>
            ))}
          </div>
        </div>
        <p class="cos-ladder__note t-small">{b.gloss.note}</p>
      </div>
    </div>

    <div class="shell cos-gloss__tail">
      <p class="cos-close">{b.gloss.close}</p>
      <p class="cos-boundaryline">{b.gloss.downstream}</p>
    </div>
  </section>

  {/* ═══ 03 · GATE AND PARTING LINE ═════════════════════════════════════════ */}
  <section class="cos-sec cos-gate" id="gate">
    <div class="shell cos-head">
      <p class="eyebrow">{b.gate.index} · {b.gate.kicker}</p>
      <h2 class="cos-h2">{b.gate.heading}</h2>
      <p class="cos-lead">{b.gate.body}</p>
    </div>

    <div class="shell--wide cos-gate__trip">
      {b.gate.cases.map((g: any, i: number) => (
        <figure class="cos-gate__case" data-reveal style={`--reveal-delay:${i * 110}ms`}>
          <svg viewBox="0 0 320 236" data-nomirror role="img" aria-label={common.schematic}>
            <defs>
              <linearGradient id={`cos-gs-${i}`} x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--signal)" stop-opacity="0" />
                <stop offset="0.34" stop-color="var(--signal)" stop-opacity="0.34" />
                <stop offset="0.5" stop-color="var(--cos-spec)" stop-opacity="0.96" />
                <stop offset="0.66" stop-color="var(--signal)" stop-opacity="0.34" />
                <stop offset="1" stop-color="var(--signal)" stop-opacity="0" />
              </linearGradient>
              <clipPath id={`cos-gc-${i}`}><path d={CAP_CROWN} /></clipPath>
              <marker id={`cos-flow-${i}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M0 0 L10 5 L0 10 z" fill="var(--accent)" />
              </marker>
            </defs>

            <path d={CAP_CROWN} class="cos-face" />

            {/* The highlight, at rest, stepping where this gate sits. */}
            <g clip-path={`url(#cos-gc-${i})`}>
              <rect x="60" y="52" width={i === 1 ? 200 : 100} height="26" fill={`url(#cos-gs-${i})`} />
              {i !== 1 && (
                <rect x="160" y={i === 0 ? 62 : 55} width="100" height="26" fill={`url(#cos-gs-${i})`} />
              )}
            </g>

            <path d={CAP_OUT} class="cos-line" />
            <path d={CAP_IN} class="cos-line cos-line--faint" />
            <path d="M40 200 H280" class="cos-line" />
            {[126, 152, 178].map((y: any) => (
              <g>
                <path d={`M58 ${y} l12 -5 v10 z`} class="cos-line cos-line--thin" />
                <path d={`M262 ${y} l-12 -5 v10 z`} class="cos-line cos-line--thin" />
              </g>
            ))}

            {/* Gate marker + fill vector, in this case's position. */}
            {i === 0 && (
              <g>
