---
/**
 * CHEMICAL & DETERGENT — the section-cut chapter.
 *
 * Every section of this page opens on a cross-section. That repetition is the
 * identity: the reader is looking at one continuous drawing sheet, not a page
 * with pictures on it. Three scales of the same motif carry it — the full-bleed
 * hero section, the small silhouettes in the dimension gutter, and the 45°
 * hatched rules that divide the sections.
 *
 * The argument: a closure has to work twice. Once on the capper at line speed,
 * and again in a hand months later after transport, heat and continuous contact
 * with the formulation. Everything that decides whether it works twice is
 * geometry, and geometry is cut in steel before a single part exists.
 *
 * Drawing conventions used throughout: hairline outlines, 45° section hatch on
 * cut material, dash-dot centre lines, orthogonal leader lines with a dot at the
 * anchor and a mono label at the shelf, and a surface-coloured mask under every
 * leader so it breaks the hatch the way a real drawing does.
 */
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { content, common } = Astro.props;
const b = content.blocks as any;

/* ── Drawing primitives ─────────────────────────────────────────────────── */

type Pt = [number, number];
const n1 = (v: number) => Math.round(v * 10) / 10;
const L = (pts: Pt[]) => pts.map(([x, y]) => `L ${n1(x)} ${n1(y)}`).join(' ');
const rev = (pts: Pt[]) => pts.slice().reverse();

/** A thread profile in section: n teeth from y0, root at xr, crest at xc. */
function teeth(xr: number, xc: number, y0: number, n: number, p: number): Pt[] {
  const pts: Pt[] = [];
  for (let i = 0; i < n; i++) {
    const y = y0 + i * p;
    pts.push([xr, y], [xc, y + p * 0.26], [xc, y + p * 0.5], [xr, y + p * 0.76]);
  }
  pts.push([xr, y0 + n * p]);
  return pts;
}

/**
 * Orthogonal leader: out from the anchor, along, then a shelf to the label.
 * Never diagonal — this chapter's annotations turn at right angles only.
 */
const lead = (ax: number, ay: number, mx: number, ty: number, lx: number) =>
  `M ${n1(ax)} ${n1(ay)} H ${n1(mx)} V ${n1(ty)} H ${n1(lx)}`;
/** The anchor a leader starts on, read back off its own path data. */
const dotX = (d: string) => d.split(' ')[1];
const dotY = (d: string) => d.split(' ')[2];

/** Ratchet zigzag: teeth hanging below a baseline. */
function zig(x0: number, x1: number, y: number, amp: number, step: number): Pt[] {
  const pts: Pt[] = [[x0, y]];
  for (let x = x0; x < x1 - 0.001; x += step) pts.push([x + step / 2, y + amp], [x + step, y]);
  return pts;
}

/* ── Hero: closure seated on a neck finish, sectioned on the centreline ──── */

const H_CT_R = teeth(154, 130, 152, 3, 44);
const H_CT_L = teeth(-154, -130, 152, 3, 44);
const H_NT_R = teeth(124, 148, 174, 3, 44);
const H_NT_L = teeth(-124, -148, 174, 3, 44);

const HERO_CLOSURE =
  `M -180 336 L -180 88 L 180 88 L 180 336 Z ` +
  `M -154 336 L -154 284 ${L(rev(H_CT_L))} L -154 108 L 154 108 ${L(H_CT_R)} L 154 336 Z`;

const HERO_NECK_R: Pt[] = [
  [130, 116], [124, 126], ...H_NT_R,
  [124, 316], [142, 322], [142, 334], [124, 340], [124, 660],
];
const HERO_NECK_L: Pt[] = [
  [-130, 116], [-124, 126], ...H_NT_L,
  [-124, 316], [-142, 322], [-142, 334], [-124, 340], [-124, 660],
];
const HERO_NECK =
  `M -130 116 ${L(HERO_NECK_L.slice(1))} L 124 660 ${L(rev(HERO_NECK_R))} Z ` +
  `M -100 116 L 100 116 L 100 660 L -100 660 Z`;

const HERO_BAND_R = 'M 156 344 L 180 344 L 180 404 L 156 404 L 156 372 L 136 364 L 136 354 L 156 346 Z';
const HERO_BAND_L = 'M -156 344 L -180 344 L -180 404 L -156 404 L -156 372 L -136 364 L -136 354 L -156 346 Z';

/* ── 01 · thread engagement, magnified ──────────────────────────────────── */

const EN_C = teeth(210, 280, -20, 3, 120);   // closure internal thread
const EN_N = teeth(295, 225, 33.3, 3, 120);  // neck external thread
const EN_CLOSURE = `M -10 -20 ${L(EN_C)} L -10 340 Z`;
const EN_NECK = `M 630 -20 L 295 -20 ${L(EN_N)} L 630 393 Z`;
/** Contact bands: where the two flanks share a line. One per turn. */
const EN_CONTACT = [0, 1, 2].map((i) => `M 280 ${40 + i * 120} L 225 ${64.5 + i * 120}`);

/* ── 04 · child-resistant ratchet, two states ───────────────────────────── */

function crOuter(top: number, yO: number) {
  return `M 100 ${top} H 540 V 250 H 510 V ${yO} ${L(rev(zig(160, 480, yO, 20, 40)))} L 130 ${yO} V 250 H 100 Z`;
}
function crInner(yI: number) {
  return `M 140 ${yI} ${L(zig(160, 480, yI, 20, 40))} L 500 ${yI} V 268 H 140 Z`;
}
const CR_MESH = (y: number) => `M 160 ${y} ${L(zig(160, 480, y, 20, 40).slice(1))}`;

/* ── 05 · thread forming: one core, two release routes ──────────────────── */

const RT_CORE_R = teeth(34, 54, 60, 4, 42);
const RT_CORE_L = teeth(-34, -54, 81, 4, 42);
const RT_CORE =
  `M -34 40 ${L(RT_CORE_L)} L -34 268 L 34 268 ${L(rev(RT_CORE_R))} L 34 40 Z`;

/* ── Gutter silhouettes. The signature motif at its smallest scale. ─────── */

const GUT: Record<string, string[]> = {
  engagement: ['M7 4 V72', 'M7 16 H19 V26 H7', 'M7 40 H19 V50 H7', 'M27 4 V72', 'M27 28 H17 V38 H27', 'M27 52 H17 V62 H27'],
  seal: ['M5 8 H29 V18 H5 Z', 'M9 22 H25 V28 H9 Z', 'M9 32 V72', 'M25 32 V72'],
  tamper: ['M9 6 H25 V34 H9 Z', 'M9 42 H25 V70 H9 Z', 'M14 34 V42', 'M20 34 V42'],
  cr: ['M5 10 H29 V20 H5 Z', 'M9 30 l5 6 l5 -6 l5 6', 'M9 44 l5 -6 l5 6 l5 -6', 'M5 54 H29 V68 H5 Z'],
  route: ['M11 6 V72', 'M23 6 V72', 'M11 20 H5 V30 H11', 'M23 20 H29 V30 H23', 'M11 46 H5 V56 H11', 'M23 46 H29 V56 H23'],
  cavity: ['M4 8 H30 V66 H4 Z', 'M11 18 H23 V66 H11 Z', 'M15 28 V66', 'M19 28 V66'],
  material: ['M6 14 H28 V24 H6 Z', 'M6 24 H28 V30 H6 Z', 'M6 30 H28 V40 H6 Z', 'M6 40 H28 V62 H6 Z'],
  boundary: ['M5 12 H15 V64 H5 Z', 'M19 12 H29 V64 H19 Z', 'M17 4 V72'],
};
---

<article class="chm">

  {/* ═══ HERO — one closure, one neck, one sealing interface ═══════════════ */}
  <header class="chm-hero ground--steel mat mat--milled" data-tex="grain">
    <div class="shell--wide chm-hero__inner split">
      <div class="chm-hero__copy" data-split-copy>
        <p class="eyebrow">{content.hero.kicker}</p>
        <h1 class="chm-hero__head t-statement">
          {content.hero.headline.map((line: string, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>
        <div class="chm-hero__note">
          <p class="chm-hero__lead">{content.hero.lead}</p>
          {content.hero.markers && (
            <ul class="badges chm-hero__markers">
              {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
            </ul>
          )}
        </div>
      </div>

      <figure class="chm-hero__fig" data-split-figure>
        <svg viewBox="-340 52 760 568" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="chm-hatch-hero" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="9" class="chm-hl" />
            </pattern>
            <marker id="chm-ar-hero" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" class="chm-arrowhead" />
            </marker>
          </defs>

          <line x1="0" y1="60" x2="0" y2="660" class="chm-cl" />

          {/* Neck — fixed. It runs off the bottom edge on purpose. */}
          <path d={HERO_NECK} fill-rule="evenodd" fill="url(#chm-hatch-hero)" class="chm-hero__cut" />
          <path d={HERO_NECK} fill-rule="evenodd" class="chm-out chm-hero__draw" pathLength="1" />

          {/* Closure — seats downward once, on load, and stops hard. */}
          <g class="chm-hero__cap">
            <path d={HERO_CLOSURE} fill-rule="evenodd" fill="url(#chm-hatch-hero)" class="chm-hero__cut" />
            <path d={HERO_BAND_R} fill="url(#chm-hatch-hero)" class="chm-hero__cut" />
            <path d={HERO_BAND_L} fill="url(#chm-hatch-hero)" class="chm-hero__cut" />
            <rect x="-140" y="108" width="280" height="8" class="chm-solid chm-hero__cut" />
            <path d={HERO_CLOSURE} fill-rule="evenodd" class="chm-out chm-hero__draw" pathLength="1" />
            <path d={HERO_BAND_R} class="chm-out chm-hero__draw" pathLength="1" />
            <path d={HERO_BAND_L} class="chm-out chm-hero__draw" pathLength="1" />
            <rect x="160" y="336" width="16" height="8" class="chm-out chm-hero__draw" />
            <rect x="-176" y="336" width="16" height="8" class="chm-out chm-hero__draw" />
          </g>

          {/* The single place colour is spent in the hero: the sealing land. */}
          <path d="M -130 116 H -100 M 100 116 H 130" class="chm-hot chm-hero__hot" />

          {/* Finish height, drawn as a dimension rather than stated. */}
          <g class="chm-hero__ann" style="--a:0">
            <path d="M -136 116 H -258 M -124 340 H -258" class="chm-ext" />
            <path d="M -250 116 V 340" class="chm-dim" marker-start="url(#chm-ar-hero)" marker-end="url(#chm-ar-hero)" />
            <text x="-244" y="232" class="chm-lbl">{b.engagement.letters[3]?.k}</text>
          </g>

          {[
            { d: lead(180, 130, 250, 104, 292), tx: 298, ty: 107.5, t: b.engagement.heroLabels.closure, end: false },
            { d: lead(148, 218, 262, 176, 292), tx: 298, ty: 179.5, t: b.engagement.heroLabels.thread, end: false },
            { d: lead(115, 116, 274, 248, 292), tx: 298, ty: 251.5, t: b.engagement.heroLabels.land, end: false },
            { d: lead(-124, 470, -214, 440, -258), tx: -264, ty: 443.5, t: b.engagement.heroLabels.neck, end: true },
            { d: lead(-180, 378, -214, 352, -258), tx: -264, ty: 355.5, t: b.engagement.heroLabels.band, end: true },
          ].map((a: any, i: number) => (
            <g class="chm-hero__ann" style={`--a:${i + 1}`}>
              <path d={a.d} class="chm-lead__mask" />
              <path d={a.d} class="chm-lead" />
              <circle cx={dotX(a.d)} cy={dotY(a.d)} r="2.4" class="chm-dot" />
              <text x={a.tx} y={a.ty} class="chm-lbl" text-anchor={a.end ? 'end' : 'start'}>{a.t}</text>
            </g>
          ))}
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
    </div>
  </header>

  <hr class="chm-rule" />

  {/* ═══ 01 · THREAD ENGAGEMENT ════════════════════════════════════════════ */}
  <section class="chm-sec chm-eng" id="engagement" data-stepper data-step="0">
    <div class="shell--wide chm-sec__inner">
      <div class="chm-gut" aria-hidden="true">
        <span class="chm-gut__n t-mono">{b.engagement.index}</span>
        <svg class="chm-gut__fig" viewBox="0 0 34 76" data-nomirror>
          {GUT.engagement.map((d: string) => <path d={d} class="chm-gsil" />)}
        </svg>
      </div>

      <div class="chm-body">
        <p class="eyebrow">{b.engagement.kicker}</p>
        <h2 class="chm-h2">{b.engagement.heading}</h2>
        <p class="t-lead chm-lead-p">{b.engagement.body}</p>
        <p class="chm-sub">{b.engagement.body2}</p>

        <div class="chm-eng__grid">
          <figure class="chm-fig chm-eng__fig">
            <svg viewBox="0 0 620 360" data-nomirror role="img" aria-label={common.schematic}>
              <defs>
                <pattern id="chm-hatch-eng" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <line x1="0" y1="0" x2="0" y2="9" class="chm-hl" />
                </pattern>
              </defs>

              <path d={EN_CLOSURE} fill="url(#chm-hatch-eng)" />
              <path d={EN_NECK} fill="url(#chm-hatch-eng)" />
              <path d={EN_CLOSURE} class="chm-out" />
              <path d={EN_NECK} class="chm-out" />

              <g data-ann="0">
                {EN_CONTACT.map((d: string) => <path d={d} class="chm-hot" />)}
              </g>

              {[
                { g: '1', d: lead(280, 25, 150, 40, 100), tx: 94, ty: 43.5, t: b.engagement.labels.crest, end: true },
                { g: '2', d: lead(245, 115, 150, 130, 100), tx: 94, ty: 133.5, t: b.engagement.labels.flank, end: true },
                { g: '1', d: lead(210, 200, 150, 215, 100), tx: 94, ty: 218.5, t: b.engagement.labels.root, end: true },
                { g: '0', d: lead(252, 172, 370, 150, 430), tx: 436, ty: 153.5, t: b.engagement.labels.contact, end: false },
                { g: '2', d: lead(217, 320, 370, 300, 430), tx: 436, ty: 303.5, t: b.engagement.labels.clearance, end: false },
              ].map((a: any) => (
                <g data-ann={a.g}>
                  <path d={a.d} class="chm-lead__mask" />
                  <path d={a.d} class="chm-lead" />
                  <circle cx={dotX(a.d)} cy={dotY(a.d)} r="2.4" class="chm-dot" />
                  <text x={a.tx} y={a.ty} class="chm-lbl" text-anchor={a.end ? 'end' : 'start'}>{a.t}</text>
                </g>
              ))}
            </svg>
            <figcaption class="figure-note">{b.engagement.figCaption} · {common.schematic}</figcaption>
          </figure>

          <ol class="chm-steps" aria-label={b.engagement.stepsLabel}>
            {b.engagement.steps.map((s: any, i: number) => (
              <li class="chm-step" data-station-step={i}>
                <span class="t-mono chm-step__n">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="chm-h5">{s.label}</h3>
                <p>{s.note}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="chm-eng__data">
          <div class="chm-letters">
            <h3 class="t-label chm-cap">{b.engagement.lettersHeading}</h3>
            <dl class="chm-letters__list">
              {b.engagement.letters.map((l: any) => (
                <div><dt class="t-mono">{l.k}</dt><dd>{l.v}</dd></div>
              ))}
            </dl>
          </div>

          <div class="chm-profiles">
            <h3 class="t-label chm-cap">{b.engagement.profilesHeading}</h3>
            <ul class="chm-profiles__list">
              {b.engagement.profiles.map((p: any, i: number) => (
                <li>
                  <svg class="chm-profiles__fig" viewBox="0 0 44 58" data-nomirror aria-hidden="true">
                    <path d="M8 4 V54" class="chm-out chm-thin" />
                    {[0, 1, 2].slice(0, i + 1).map((t: number) => (
                      <path d={`M8 ${10 + t * 15} H${16 + i * 7} V${20 + t * 15} H8`} class="chm-out chm-thin" />
                    ))}
                  </svg>
                  <span class="chm-profiles__n t-mono">{p.name}</span>
                  <span class="chm-profiles__d t-mono">{p.depth}</span>
                  <span class="chm-profiles__t">{p.note}</span>
                </li>
              ))}
            </ul>
            <p class="t-fine chm-src">{b.engagement.profilesNote}</p>
          </div>
        </div>

        <p class="chm-close">{b.engagement.close}</p>
      </div>
    </div>
  </section>

  <hr class="chm-rule" />

  {/* ═══ 02 · SEAL ROUTES ══════════════════════════════════════════════════ */}
  <section class="chm-sec" id="seal">
    <div class="shell--wide chm-sec__inner">
      <div class="chm-gut" aria-hidden="true">
        <span class="chm-gut__n t-mono">{b.seal.index}</span>
        <svg class="chm-gut__fig" viewBox="0 0 34 76" data-nomirror>
          {GUT.seal.map((d: string) => <path d={d} class="chm-gsil" />)}
        </svg>
      </div>

      <div class="chm-body">
        <p class="eyebrow">{b.seal.kicker}</p>
        <h2 class="chm-h2">{b.seal.heading}</h2>
        <p class="t-lead chm-lead-p">{b.seal.body}</p>

        <figure class="chm-fig" data-reveal>
          <svg viewBox="0 0 620 215" data-nomirror role="img" aria-label={common.schematic}>
            <defs>
              <pattern id="chm-hatch-seal" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="9" class="chm-hl" />
              </pattern>
            </defs>

            {[80, 235, 390, 545].map((cx: number, i: number) => (
              <g>
                <rect x={cx - 58} y="26" width="116" height="18" fill="url(#chm-hatch-seal)" />
                <rect x={cx - 58} y="26" width="116" height="18" class="chm-out chm-thin" />
                <rect x={cx - 50} y="62" width="18" height="128" fill="url(#chm-hatch-seal)" />
                <rect x={cx + 32} y="62" width="18" height="128" fill="url(#chm-hatch-seal)" />
                <rect x={cx - 50} y="62" width="18" height="128" class="chm-out chm-thin" />
                <rect x={cx + 32} y="62" width="18" height="128" class="chm-out chm-thin" />
                <line x1={cx} y1="66" x2={cx} y2="196" class="chm-cl" />

                {i === 0 && <rect x={cx - 46} y="48" width="92" height="12" class="chm-solid" />}
                {i === 1 && (
                  <g>
                    <rect x={cx - 38} y="44" width="10" height="34" fill="url(#chm-hatch-seal)" />
                    <rect x={cx + 28} y="44" width="10" height="34" fill="url(#chm-hatch-seal)" />
                    <rect x={cx - 38} y="44" width="10" height="34" class="chm-out chm-thin" />
                    <rect x={cx + 28} y="44" width="10" height="34" class="chm-out chm-thin" />
                    <path d={`M ${cx - 32} 62 V 76 M ${cx + 32} 62 V 76`} class="chm-contact" />
                  </g>
                )}
                {i === 2 && <path d={`M ${cx - 50} 60 H ${cx + 50}`} class="chm-contact" />}
                {i === 3 && (
                  <g>
                    <rect x={cx - 46} y="48" width="28" height="12" class="chm-solid" />
                    <rect x={cx - 8} y="48" width="16" height="12" class="chm-solid" />
                    <rect x={cx + 18} y="48" width="28" height="12" class="chm-solid" />
                  </g>
                )}
              </g>
            ))}

            {[
              { d: lead(118, 62, 118, 14, 150), tx: 156, ty: 17.5, t: b.seal.labels.land, end: false },
              { d: lead(80, 60, 80, 194, 30), tx: 24, ty: 197.5, t: b.seal.labels.liner, end: true },
              { d: lead(263, 70, 263, 194, 190), tx: 184, ty: 197.5, t: b.seal.labels.bore, end: true },
              { d: lead(390, 60, 390, 194, 350), tx: 344, ty: 197.5, t: b.seal.labels.foil, end: true },
              { d: lead(545, 54, 545, 194, 510), tx: 504, ty: 197.5, t: b.seal.labels.vent, end: true },
            ].map((a: any) => (
              <g>
                <path d={a.d} class="chm-lead__mask" />
                <path d={a.d} class="chm-lead" />
                <circle cx={dotX(a.d)} cy={dotY(a.d)} r="2.4" class="chm-dot" />
                <text x={a.tx} y={a.ty} class="chm-lbl" text-anchor={a.end ? 'end' : 'start'}>{a.t}</text>
              </g>
            ))}
          </svg>
          <figcaption class="figure-note">{b.seal.figCaption} · {common.schematic}</figcaption>
        </figure>

        <div class="chm-scroll">
          <table class="chm-table">
            <thead>
              <tr>
                <th scope="col"><span class="vh">{b.seal.figCaption}</span></th>
                <th scope="col">{b.seal.colWhat}</th>
                <th scope="col">{b.seal.colTooling}</th>
                <th scope="col">{b.seal.colLimit}</th>
              </tr>
            </thead>
            <tbody>
              {b.seal.routes.map((r: any) => (
                <tr>
                  <th scope="row">{r.name}</th>
                  <td>{r.what}</td>
                  <td>{r.tooling}</td>
                  <td>{r.limit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="t-fine chm-src">{b.seal.routesNote}</p>
        <p class="chm-close">{b.seal.close}</p>
      </div>
    </div>
  </section>

  <hr class="chm-rule" />

  {/* ═══ 03 · TAMPER EVIDENCE ══════════════════════════════════════════════ */}
  <section class="chm-sec" id="tamper">
    <div class="shell--wide chm-sec__inner">
      <div class="chm-gut" aria-hidden="true">
        <span class="chm-gut__n t-mono">{b.tamper.index}</span>
        <svg class="chm-gut__fig" viewBox="0 0 34 76" data-nomirror>
          {GUT.tamper.map((d: string) => <path d={d} class="chm-gsil" />)}
        </svg>
      </div>

      <div class="chm-body">
        <p class="eyebrow">{b.tamper.kicker}</p>
        <h2 class="chm-h2">{b.tamper.heading}</h2>
        <p class="t-lead chm-lead-p">{b.tamper.body}</p>
        <p class="chm-sub">{b.tamper.body2}</p>

        <div class="chm-pair" data-reveal>
          <figure class="chm-fig">
            <svg viewBox="0 0 440 400" data-nomirror role="img" aria-label={common.schematic}>
              <defs>
                <pattern id="chm-hatch-tam" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
