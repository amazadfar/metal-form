</article>

<style>
  /* ═══ Chapter scope — the drawing sheet ═════════════════════════════════
     Deep alkaline teal on a cool near-white, one acid-lime signal spent three
     times on the whole page: the sealing land in the hero, the contact bands in
     section 01, the tamper bridges in section 03. Nothing else may take it. */

  .chm {
    --chm-field: var(--surface-raise);
    --chm-gut: 6rem;
    /* The shell puts the header clearance on <article>, which is transparent,
       and a near-white strip above a steel opening is exactly the seam this
       chapter must not have. The hero carries the clearance instead, so the
       steel runs to the top edge and the header overlays the composition. */
    padding-block-start: 0;
  }

  .chm-h2 {
    font-size: clamp(1.85rem, 3.9vw, 3.05rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 19ch;
  }
  .chm-h4 { font-size: var(--step-2); letter-spacing: var(--track-head); max-inline-size: 26ch; }
  .chm-h5 { font-size: var(--step-1); letter-spacing: var(--track-head); line-height: 1.24; }

  /* ── Drawing conventions, shared by every figure in the chapter ────────── */
  .chm-hl { stroke: var(--accent); stroke-width: 0.9; opacity: 0.4; }
  .chm-out { fill: none; stroke: var(--accent-deep); stroke-width: 1.5; stroke-linejoin: miter; }
  .chm-thin { stroke-width: 1; }
  .chm-cl { fill: none; stroke: var(--accent); stroke-width: 0.7; stroke-dasharray: 11 3 2 3; opacity: 0.55; }
  .chm-solid { fill: var(--accent-wash); stroke: var(--accent-deep); stroke-width: 1; }
  .chm-part { fill: none; stroke: var(--ink); stroke-width: 1.2; opacity: 0.5; }
  .chm-contact { fill: none; stroke: var(--accent-deep); stroke-width: 2.6; }
  .chm-hot { fill: none; stroke: var(--signal); stroke-width: 3; stroke-linecap: square; }
  .chm-hot-fill { fill: var(--signal); stroke: none; }
  .chm-mask-fill { fill: var(--chm-field); stroke: none; }
  .chm-dim { fill: none; stroke: var(--accent); stroke-width: 1; }
  .chm-ext { fill: none; stroke: var(--ink-muted); stroke-width: 0.7; opacity: 0.6; }
  .chm-arrowhead { fill: var(--accent); }
  .chm-link { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; stroke-dasharray: 5 4; opacity: 0.7; }
  .chm-detail { fill: none; stroke: var(--ink-muted); stroke-width: 1; stroke-dasharray: 7 4; opacity: 0.75; }

  /* Orthogonal leaders. The mask breaks the hatch the way a drawing does. */
  .chm-lead { fill: none; stroke: var(--accent); stroke-width: 0.9; }
  .chm-lead__mask { fill: none; stroke: var(--chm-field); stroke-width: 5; }
  .chm-dot { fill: var(--accent); }
  .chm-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    fill: var(--ink-muted);
  }

  /* ── Hero — SPLIT, on steel ────────────────────────────────────────────
     The chapter opens on its own inverse, so the first thing a buyer sees is a
     section cut lit like a blueprint rather than a line drawing on paper.

     `ground--steel` owns every colour in this band — ink, muted ink, rules,
     accent, signal, focus and the buttons — so nothing below restates one, and
     the figure's own `--chm-field` follows the remapped surface on its own.

     The split is deliberately unequal and it is not the old composition: the
     statement is a size step up and carries the band, the drawing is a
     recessed plate that fills its column to the trailing edge instead of
     floating in half of one, and a hairline divides them the way a sheet
     border does. */
  .chm-hero {
    position: relative;
    padding-block: calc(4.25rem + clamp(2.5rem, 6vw, 5rem)) clamp(3rem, 7vw, 5.5rem);
    overflow: clip;
    /* Cast grain over milled steel. Felt, not seen. */
    --tex-opacity: 0.45;
  }
  .chm-hero__inner {
    --split-a: 1.3fr;
    --split-b: 1fr;
    --split-gap: clamp(2rem, 5vw, 4.5rem);
    --split-align: stretch;
  }
  /* The divider between the two columns needs air on BOTH sides of it; the
     grid still starts and ends flush with the shell. */
  .chm-hero__inner > * { padding-inline: var(--col-pad); min-inline-size: 0; }
  .chm-hero__inner > :first-child { padding-inline-start: 0; }
  .chm-hero__inner > * + * { border-inline-start: var(--rule); }
  .chm-hero__copy { align-self: center; }

  .chm-hero__head {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2.7rem, 6.2vw, 5.6rem);
    max-inline-size: 14ch;
  }
  .chm-hero__head span { display: block; }
  .chm-hero__head span:last-child { color: var(--accent-deep); }

  /* Lead and verified capability sit below the statement's own rule, so the
     opening reads as a title block and then its notes. */
  .chm-hero__note {
    margin-block-start: clamp(1.75rem, 3.4vw, 2.6rem);
    padding-block-start: clamp(1.1rem, 2.2vw, 1.7rem);
    border-block-start: var(--rule-strong);
  }
  .chm-hero__lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }
  .chm-hero__markers { margin-block-start: var(--sp-5); }
  /* `ground--steel` remaps ink, rules and accent but not the relief edges, so
     the badge takes the dark relief here rather than a white top edge. */
  .chm-hero .badge { box-shadow: var(--relief-dark); }

  .chm-hero__fig {
    --chm-field: var(--surface-sunk);
    margin: 0;
    display: grid;
    align-content: center;
    gap: var(--sp-4);
    background: var(--surface-sunk);
    padding-block: clamp(1rem, 2.6vw, 2.25rem);
  }
  .chm-hero__fig svg { inline-size: 100%; block-size: auto; }
  .chm-hero__fig .figure-note { margin-block-start: 0; }

  /* Below the split breakpoint the opening is a stack, not a narrow pair. */
  @media (max-width: 1000px) {
    .chm-hero__inner > * { padding-inline: 0; border-inline-start: 0; }
    .chm-hero__fig { padding-inline: var(--col-pad); }
  }

  @keyframes chm-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes chm-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes chm-seat { from { transform: translateY(-16px); } to { transform: translateY(0); } }

  .chm-hero__draw { stroke-dasharray: 1; animation: chm-draw var(--dur-6) var(--ease-glide) both; }
  .chm-hero__cut { animation: chm-fade var(--dur-4) var(--ease-out) 820ms both; }
  .chm-hero__cap { animation: chm-seat 820ms var(--ease-mech) 220ms both; }
  .chm-hero__hot { animation: chm-fade var(--dur-3) var(--ease-out) 1320ms both; }
  .chm-hero__ann { animation: chm-fade var(--dur-3) var(--ease-out) both; animation-delay: calc(1180ms + var(--a) * 90ms); }

  @media (prefers-reduced-motion: reduce) {
    .chm-hero__draw, .chm-hero__cut, .chm-hero__cap, .chm-hero__hot, .chm-hero__ann { animation: none; }
  }

  /* ── The hatched section rule. No coloured bands anywhere on this page. ── */
  .chm-rule {
    block-size: 15px;
    border: 0;
    border-block: var(--hair) solid var(--line);
    background-image: repeating-linear-gradient(
      45deg,
      color-mix(in oklab, var(--accent) 36%, transparent) 0 1px,
      transparent 1px 8px
    );
  }

  /* ── The dimension gutter. This chapter's structural signature. ────────── */
  .chm-sec { padding-block: var(--section-y); }
  .chm-sec__inner {
    display: grid;
    grid-template-columns: var(--chm-gut) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }
  .chm-gut {
    position: sticky;
    inset-block-start: clamp(5.5rem, 12vh, 7.5rem);
    display: grid;
    gap: var(--sp-5);
    justify-items: start;
  }
  .chm-gut__n {
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    color: var(--accent-deep);
    padding-block-end: var(--sp-2);
    border-block-end: var(--hair-strong) solid var(--accent);
  }
  .chm-gut__fig { inline-size: 2.1rem; block-size: auto; }
  .chm-gsil { fill: none; stroke: var(--ink-muted); stroke-width: 1.4; opacity: 0.5; }
  /* Below the breakpoint the gutter stops being a column and becomes a
     header strip above the body: index and silhouette on one line. */
  @media (max-width: 1000px) {
    .chm-sec__inner { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); }
    .chm-gut {
      position: static;
      display: flex;
      align-items: center;
      gap: var(--sp-4);
    }
    .chm-gut__fig { inline-size: 1.5rem; }
    .chm-gut__n { font-size: var(--step--2); letter-spacing: 0.1em; }
  }

  .chm-lead-p { margin-block-start: var(--sp-5); max-inline-size: 68ch; }
  .chm-sub {
    margin-block-start: var(--sp-4);
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-muted);
    max-inline-size: 66ch;
  }
  .chm-close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-0);
    line-height: 1.6;
    max-inline-size: 66ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }
  .chm-close--loud { font-size: var(--step-2); line-height: 1.35; letter-spacing: var(--track-head); max-inline-size: 30ch; }
  .chm-src { margin-block-start: var(--sp-4); max-inline-size: 68ch; }
  .chm-cap { display: block; margin-block-end: var(--sp-4); }
  .chm-cap--gap { margin-block-start: clamp(2.25rem, 5vw, 3.5rem); }

  .chm-fig {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
    background: var(--surface-raise);
    border: var(--rule);
    padding: clamp(0.9rem, 2.2vw, 1.75rem);
  }
  .chm-fig--flush { margin-block-start: 0; }
  .chm-fig svg { inline-size: 100%; block-size: auto; }
  .chm-fig .figure-note { margin-block-start: var(--sp-4); }

  .chm-pair {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }
  .chm-pair .chm-fig { margin-block-start: 0; }
  @media (max-width: 1000px) { .chm-pair { grid-template-columns: minmax(0, 1fr); } }

  .chm-two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  @media (max-width: 1000px) { .chm-two { grid-template-columns: minmax(0, 1fr); } }
  .chm-two__col p { margin-block-start: var(--sp-3); font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }

  /* ── 01 Engagement ────────────────────────────────────────────────────── */
  .chm-eng__grid {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
