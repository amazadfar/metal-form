---
/**
 * MEDICAL & PHARMACEUTICAL — flagship chapter.
 *
 * Written to survive a pharmaceutical manufacturing executive reading it
 * sceptically. Its credibility does not come from claiming capability; it comes
 * from section 04, which draws the regulatory line and puts Metal Form firmly on
 * the tooling and engineering side of it. Knowing exactly where that line falls
 * is the signal. Blurring it would be the disqualification.
 *
 * The technical heart is section 03 — shear-induced imbalance. A geometrically
 * balanced runner does not produce balanced cavities, defects group by flow path
 * rather than by cavity number, and that is not something a marketing writer
 * would know to say.
 *
 * Visual language: cavity arrays, precision as repetition, cool clinical
 * neutrals with a single teal. No hospitals, no cleanrooms, no sterile-suit
 * imagery — those would be a regulatory claim made with a picture.
 */
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';
import ProjectProof from '../ProjectProof.astro';
import TechNote from '../TechNote.astro';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;
const isEnglish = locale === 'en';
const splitCompactItems = (items: string[]): string[] =>
  items.flatMap((item) => String(item).split('\n').filter(Boolean));
const medicalStartNeed = isEnglish ? splitCompactItems(b.start.need.slice(0, 5)) : [];
const medicalStartGet = isEnglish
  ? splitCompactItems([...b.start.need.slice(5), ...b.start.get])
  : [];
const showUnsupportedRunnerTemperature = false;
const showUnsupportedMouldClassTable = false;
const showUnsupportedLifeTable = false;

/**
 * A 32-cavity plate, laid out as a real balanced tree would place it: eight
 * across, four deep. The hero renders it as an index of cells; section 03
 * renders the same array as part weights.
 */
const CAV = Array.from({ length: 32 }, (_, i) => ({
  i,
  // Flow group: which branch of the runner tree the cavity hangs off.
  group: (i % 8 < 2 || i % 8 > 5) ? 'outer' : 'inner',
}));

/** Part-weight bars, grouped by flow path rather than by cavity number. */
const WEIGHTS = CAV.map((c) => ({
  ...c,
  w: c.group === 'inner' ? 74 + ((c.i * 7) % 9) : 52 + ((c.i * 5) % 11),
}));

/**
 * Unit symbols for the section 02 calculator come from the content JSON
 * (`arithmetic.controls[].unit`), never from this template: "s" and "h" are
 * English abbreviations, and a locale that writes seconds and hours another way
 * has to be able to. They reach the calculator script through `data-unit`,
 * because an Astro `<script>` is a module and cannot read frontmatter.
 */
const unitOf = (i: number): string => String(b.arithmetic?.controls?.[i]?.unit ?? '');
const withUnit = (value: number, i: number): string => {
  const u = unitOf(i);
  return u ? `${value} ${u}` : String(value);
};
---

<article class="med">

  {/* ═══ HERO — INDEX ═══════════════════════════════════════════════════
       The opening figure is a catalogue, not an object: thirty-two cavities
       laid out as a numbered index, each cell identical to every other, which
       is the whole argument of the chapter. The copy sits above it in two
       unequal columns rather than beside it, so the array is what the page
       actually opens on. */}
  <header class="med-hero" data-tex="dot">
    <div class="shell--wide med-hero__inner">
      <div class="med-hero__copy">
        <div class="med-hero__lede">
          <p class="eyebrow">{content.hero.kicker}</p>
          <h1 class="med-hero__head">
            {content.hero.headline.map((line: any, i: number) => <span style={`--l:${i}`}>{line}</span>)}
          </h1>
        </div>
        <div class="med-hero__aside">
          <p class="med-hero__lead">{content.hero.lead}</p>
          {content.hero.markers && (
            <ul class="badges med-hero__markers">
              {content.hero.markers.map((m: any) => <li class="badge">{m}</li>)}
            </ul>
          )}
        </div>
      </div>

      {/* Precision drawn as repetition: a cavity array coming into registration.
          Set as HTML cells rather than one SVG so the index numbers stay real
          text at every script and the grid reflows instead of scaling down. */}
      <figure class="med-hero__fig">
        <div class="med-index" role="img" aria-label={common.schematic}>
          {CAV.map((c: any) => (
            <div class="med-index__cell" style={`--i:${c.i}`}>
              <span class="med-index__ring" aria-hidden="true"></span>
              <span class="med-index__n t-mono">{String(c.i + 1).padStart(2, '0')}</span>
            </div>
          ))}
        </div>
        <figcaption class="figure-note med-hero__rail">{common.schematic}</figcaption>
      </figure>
    </div>
  </header>

  {/* ═══ 01 · ATLAS ═════════════════════════════════════════════════════ */}
  <section class="med-atlas" id="atlas">
    <div class="shell--wide">
      <div class="med-head">
        <p class="eyebrow">{isEnglish ? b.atlas.kicker : `${b.atlas.index} · ${b.atlas.kicker}`}</p>
        <h2 class="med-h2">{b.atlas.heading}</h2>
        <p class="t-lead">{b.atlas.body}</p>
      </div>

      <div class="med-atlas__grid" data-tabs>
        <div class="med-atlas__index" role="tablist" aria-label={b.atlas.listLabel} aria-orientation="vertical">
          {b.atlas.items.map((item: any, i: number) => (
            <button
              class="med-atlas__row"
              type="button"
              role="tab"
              data-tab={item.id}
              id={`med-tab-${item.id}`}
              aria-controls={`med-panel-${item.id}`}
              aria-selected="false"
            >
              <span class="t-mono">{String(i + 1).padStart(2, '0')}</span>
              <span>{item.name}</span>
            </button>
          ))}
        </div>

        {b.atlas.items.map((item: any) => (
          <div
            class="med-atlas__panel"
            data-panel={item.id}
            role="tabpanel"
            id={`med-panel-${item.id}`}
            aria-labelledby={`med-tab-${item.id}`}
            hidden
          >
            <h3 class="med-h4">{item.name}</h3>
            <p class="med-atlas__hard">{item.hard}</p>
            <ul class="badges med-atlas__spec">
              {(isEnglish ? item.spec.slice(0, 3) : item.spec).map((s: string) => <li class="badge">{s}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ═══ 02 · ARITHMETIC ════════════════════════════════════════════════ */}
  {isEnglish ? (
  <section class="med-calc med-calc--compact" id="arithmetic">
    <div class="shell--wide">
      <div class="med-head">
        <p class="eyebrow">{b.arithmetic.kicker}</p>
        <h2 class="med-h2">{b.arithmetic.heading}</h2>
        <p class="t-lead">{b.arithmetic.body}</p>
        <p class="med-calc__sub">{b.arithmetic.body2}</p>
      </div>

      <div class="med-calc__band" data-calc>
        <div class="med-calc__controls">
          <label class="med-ctrl">
            <span class="t-label">{b.arithmetic.controls[0].label}</span>
            <input type="range" min="1" max="46" step="1" value="32" data-calc-cavities />
            <output class="t-mono" data-calc-out="cavities" data-unit={unitOf(0)}>{withUnit(32, 0)}</output>
          </label>
          <label class="med-ctrl">
            <span class="t-label">{b.arithmetic.controls[1].label}</span>
            <input type="range" min="3" max="40" step="1" value="10" data-calc-cycle />
            <output class="t-mono" data-calc-out="cycle" data-unit={unitOf(1)}>{withUnit(10, 1)}</output>
          </label>
          <label class="med-ctrl">
            <span class="t-label">{b.arithmetic.controls[2].label}</span>
            <input type="range" min="8" max="24" step="1" value="24" data-calc-hours />
            <output class="t-mono" data-calc-out="hours" data-unit={unitOf(2)}>{withUnit(24, 2)}</output>
          </label>
        </div>

        <div class="med-calc__readout">
          <p class="t-label">{b.arithmetic.calcLabel}</p>
          <p class="med-calc__big t-mono" data-calc-year>—</p>
          <p class="med-calc__unit">{b.arithmetic.outputs[2].label}</p>
          <dl class="med-calc__sub-out">
            <div><dt class="t-label">{b.arithmetic.outputs[0].label}</dt><dd class="t-mono" data-calc-hour>—</dd></div>
            <div><dt class="t-label">{b.arithmetic.outputs[1].label}</dt><dd class="t-mono" data-calc-day>—</dd></div>
          </dl>
        </div>
      </div>

      <p class="med-calc__note">{b.arithmetic.note}</p>
      <div class="med-amort">
        <p>{b.arithmetic.amort}</p>
      </div>

      <div class="med-consistency">
        <div class="med-consistency__copy">
          <p class="eyebrow">{b.imbalance.kicker}</p>
          <h3 class="med-h3">{b.imbalance.heading}</h3>
          <p>{b.imbalance.body}</p>
        </div>
        <figure class="med-consistency__fig">
          <div class="med-consistency__array" role="img" aria-label={common.schematic}>
            {WEIGHTS.map((w: any) => (
              <span class="med-consistency__cell" style={`--w:${w.w}%`}>
                <span class="med-consistency__n t-mono">{String(w.i + 1).padStart(2, '0')}</span>
                <span class:list={['med-consistency__bar', `med-consistency__bar--${w.group}`]} aria-hidden="true"></span>
              </span>
            ))}
          </div>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>
      </div>
    </div>
  </section>
  ) : (
  <>
  <section class="med-calc" id="arithmetic">
    <div class="shell--wide">
      <div class="med-head">
        <p class="eyebrow">{b.arithmetic.index} · {b.arithmetic.kicker}</p>
        <h2 class="med-h2">{b.arithmetic.heading}</h2>
        <p class="t-lead">{b.arithmetic.body}</p>
        <p class="med-calc__sub">{b.arithmetic.body2}</p>
      </div>

      <div class="med-calc__band" data-calc>
        <div class="med-calc__controls">
          <label class="med-ctrl">
            <span class="t-label">{b.arithmetic.controls[0].label}</span>
            <input type="range" min="1" max="46" step="1" value="32" data-calc-cavities />
            <output class="t-mono" data-calc-out="cavities" data-unit={unitOf(0)}>{withUnit(32, 0)}</output>
          </label>
          <label class="med-ctrl">
            <span class="t-label">{b.arithmetic.controls[1].label}</span>
            <input type="range" min="3" max="40" step="1" value="10" data-calc-cycle />
            <output class="t-mono" data-calc-out="cycle" data-unit={unitOf(1)}>{withUnit(10, 1)}</output>
          </label>
          <label class="med-ctrl">
            <span class="t-label">{b.arithmetic.controls[2].label}</span>
            <input type="range" min="8" max="24" step="1" value="24" data-calc-hours />
            <output class="t-mono" data-calc-out="hours" data-unit={unitOf(2)}>{withUnit(24, 2)}</output>
          </label>
        </div>

        <div class="med-calc__readout">
          <p class="t-label">{b.arithmetic.calcLabel}</p>
          <p class="med-calc__big t-mono" data-calc-year>—</p>
          <p class="med-calc__unit">{b.arithmetic.outputs[2].label}</p>
          <dl class="med-calc__sub-out">
            <div><dt class="t-label">{b.arithmetic.outputs[0].label}</dt><dd class="t-mono" data-calc-hour>—</dd></div>
            <div><dt class="t-label">{b.arithmetic.outputs[1].label}</dt><dd class="t-mono" data-calc-day>—</dd></div>
          </dl>
        </div>
      </div>

      <p class="med-calc__note">{b.arithmetic.note}</p>

      <div class="med-amort">
        <h3 class="med-h4">{b.arithmetic.amortHeading}</h3>
        <p>{b.arithmetic.amort}</p>
      </div>
    </div>
  </section>

  {/* ═══ 03 · IMBALANCE — the technical heart ═══════════════════════════ */}
  <section class="med-imb" id="imbalance" data-stepper data-step="0">
    <div class="shell--wide med-head med-imb__head">
      <p class="eyebrow">{b.imbalance.index} · {b.imbalance.kicker}</p>
      <h2 class="med-h2 med-imb__h">{b.imbalance.heading}</h2>
      <p class="t-lead">{b.imbalance.body}</p>
    </div>

    <div class="shell--wide med-imb__grid">
      <figure class="med-imb__fig">
        <svg viewBox="0 0 420 320" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <linearGradient id="med-laminate" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--signal)" stop-opacity="0.85" />
              <stop offset="30%" stop-color="var(--accent)" stop-opacity="0.5" />
              <stop offset="70%" stop-color="var(--accent)" stop-opacity="0.5" />
              <stop offset="100%" stop-color="var(--signal)" stop-opacity="0.85" />
            </linearGradient>
          </defs>

          {/* State A — the runner tree. Always drawn; later states overlay it. */}
          <g class="med-tree">
            <circle cx="210" cy="26" r="7" class="med-sprue" />
            <path d="M210 33 V70 M110 70 H310 M110 70 V110 M310 70 V110
                     M60 110 H160 M260 110 H360 M60 110 V150 M160 110 V150 M260 110 V150 M360 110 V150"
              class="med-runner" />
            {[60, 160, 260, 360].map((x: any) => (
              <circle cx={x} cy="158" r="9" class="med-gate" />
            ))}
          </g>

          {/* State B — the melt is not uniform. */}
          <g class="med-layer med-layer--laminate">
            <rect x="203" y="33" width="14" height="37" fill="url(#med-laminate)" />
            <rect x="110" y="63" width="200" height="14" fill="url(#med-laminate)" />
            {showUnsupportedRunnerTemperature && <text x="330" y="46" class="med-micro">{b.imbalance.figureMark}</text>}
            {showUnsupportedRunnerTemperature && <path d="M326 52 L312 66" class="med-lead" />}
          </g>

          {/* State C — the split does not mix. */}
          <g class="med-layer med-layer--split">
            <circle cx="110" cy="70" r="16" class="med-focus" />
            <circle cx="310" cy="70" r="16" class="med-focus" />
            <path d="M96 86 L60 110" class="med-lead" />
            <path d="M324 86 L360 110" class="med-lead" />
          </g>

          {/* State D — cavities disagree by flow group. */}
          <g class="med-layer med-layer--bars" transform="translate(0 176)">
            <line x1="18" y1="118" x2="402" y2="118" class="med-axis" />
            {WEIGHTS.map((w: any) => (
              <rect
                x={20 + w.i * 11.9} y={118 - w.w}
                width="8" height={w.w}
                class:list={['med-bar', `med-bar--${w.group}`]}
                style={`--i:${w.i}`}
              />
            ))}
          </g>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <ol class="med-imb__steps">
        {b.imbalance.steps.map((step: any, i: number) => (
          <li class="med-imb__step" data-station-step={i}>
            <span class="t-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.label}</h3>
            <p>{step.body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="shell--wide med-imb__foot">
      <p class="med-imb__evidence">{b.imbalance.evidence}</p>

      {/* The four steps above are the argument. How you prove it on a press,
          and how each symptom maps to a cause, is what a process engineer
          wants next — and only a process engineer. */}
      <TechNote locale={locale} kind="reasoning" class="med-imb__note">
        <div class="med-imb__cols">
          <section>
            <h3 class="med-h5">{b.imbalance.methodHeading}</h3>
            <ol class="med-imb__method">
              {b.imbalance.method.map((m: string, i: number) => (
                <li><span class="t-mono">{String(i + 1).padStart(2, '0')}</span>{m}</li>
              ))}
            </ol>
          </section>

          <section>
            <h3 class="med-h5">{b.imbalance.diagnosisHeading}</h3>
            <dl class="med-diag">
              {b.imbalance.diagnosis.map((d: any) => (
                <div><dt>{d.symptom}</dt><dd>{d.cause}</dd></div>
              ))}
            </dl>
          </section>
        </div>
      </TechNote>

      <p class="med-imb__close">{b.imbalance.close}</p>
    </div>
  </section>
  </>
  )}

  {/* ═══ 04 · THE LINE — the credibility instrument ═════════════════════ */}
  <section class="med-line ground--steel" id="line" data-tex="dot">
    <div class="shell--wide">
      <div class="med-head med-line__head">
        <p class="eyebrow">{isEnglish ? b.line.kicker : `${b.line.index} · ${b.line.kicker}`}</p>
        <h2 class="med-h2">{b.line.heading}</h2>
        <p class="t-lead">{b.line.body}</p>
        {!isEnglish && <p class="med-line__sub">{b.line.body2}</p>}
      </div>

      {/* One continuous rule down the middle. Nothing crosses it. */}
      <div class="med-ledger">
        <section class="med-ledger__col med-ledger__col--ours">
          <h3 class="med-h5 med-ledger__h">{b.line.supplyHeading}</h3>
          <ul>{(isEnglish ? b.line.supply.slice(0, 5) : b.line.supply).map((item: string) => <li>{item}</li>)}</ul>
        </section>
        <section class="med-ledger__col med-ledger__col--yours">
          <h3 class="med-h5 med-ledger__h">{b.line.staysHeading}</h3>
          {/* The sentence that names these as nobody's certifications but the
              customer's, placed before the list rather than after both
              columns — which is where it used to sit, and where a reader
              skimming two columns never reached it. */}
          <p class="med-ledger__caveat">{b.line.close}</p>
          <ul>{(isEnglish ? b.line.stays.slice(0, 5) : b.line.stays).map((item: string) => <li>{item}</li>)}</ul>
        </section>
      </div>

      {/* The ledger and the sentence under it are the section. How the
          arrangement works commercially is real, useful and long, and it is
          the third thing a buyer needs rather than the first. */}
      <TechNote locale={locale} kind="reasoning" label={b.line.howHeading} class="med-line__how">
        <p>{b.line.how}</p>
      </TechNote>
    </div>
  </section>

  {/* ═══ 05 · ANATOMY ═══════════════════════════════════════════════════ */}
  {!isEnglish && (
  <section class="med-anat" id="anatomy">
    <div class="shell--wide">
      <div class="med-head">
        <p class="eyebrow">{b.anatomy.index} · {b.anatomy.kicker}</p>
        <h2 class="med-h2">{b.anatomy.heading}</h2>
        <p class="t-lead">{b.anatomy.body}</p>
      </div>

      <div class="med-anat__grid">
        {/* The plate stack, separated on the Z axis. */}
        <figure class="med-anat__fig">
          <svg viewBox="0 0 240 460" data-nomirror role="img" aria-label={common.schematic}>
            <defs>
              <pattern id="med-hatch" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="0.8" opacity="0.35" />
              </pattern>
            </defs>
            <line x1="120" y1="6" x2="120" y2="454" class="med-cl" />
            {b.anatomy.stack.map((_: any, i: number) => (
              <g class="med-plate-lvl" style={`--i:${i}`}>
                <path
                  d={`M40 ${26 + i * 52} L200 ${26 + i * 52} L200 ${26 + i * 52 + 30} L40 ${26 + i * 52 + 30} Z`}
                  fill="url(#med-hatch)" class="med-plate-lvl__body"
                />
                <line x1="200" y1={26 + i * 52 + 15} x2="228" y2={26 + i * 52 + 15} class="med-lead" />
                <circle cx="232" cy={26 + i * 52 + 15} r="3" class="med-lead-dot" />
              </g>
            ))}
          </svg>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>

        <dl class="med-anat__list">
          {b.anatomy.stack.map((item: any, i: number) => (
            <div class="med-anat__item" data-lvl={i}>
              <dt><span class="t-mono">{String(i + 1).padStart(2, '0')}</span>{item.name}</dt>
              <dd>{item.note}</dd>
            </div>
          ))}
        </dl>
      </div>

      {/* SPI mould classes are the grammar of a tooling enquiry and a wall of
          hardness figures to everyone else. The plate stack above is the
          section's argument; this is its appendix. */}
      {showUnsupportedMouldClassTable && <TechNote locale={locale} label={b.anatomy.classHeading} class="med-class">
        <p class="med-class__note">{b.anatomy.classNote}</p>
        <div class="scroller med-class__scroll">
          <table class="med-class__table">
            <tbody>
              {b.anatomy.classes.map((cls: any) => (
                <tr>
                  <th scope="row">{cls.name}</th>
                  <td class="t-mono">{cls.life}</td>
                  <td>{cls.spec}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="med-class__close">{b.anatomy.classClose}</p>
      </TechNote>}
    </div>
  </section>
  )}

  {/* ═══ 06 · WEAR ══════════════════════════════════════════════════════ */}
  {showUnsupportedLifeTable && <section class="med-wear" id="wear">
    <div class="shell--wide">
      <div class="med-head">
        <p class="eyebrow">{b.wear.index} · {b.wear.kicker}</p>
        <h2 class="med-h2">{b.wear.heading}</h2>
        <p class="t-lead">{b.wear.body}</p>
      </div>

      <div class="med-axis-wrap">
        <p class="t-label">{b.wear.axisLabel}</p>
        <ol class="med-axis-list">
          {b.wear.marks.map((mark: any, i: number) => (
            <li data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="med-axis__at t-mono">{mark.at}</span>
              <span class="med-axis__dot" aria-hidden="true"></span>
              <span class="med-axis__label">{mark.label}</span>
              <span class="med-axis__note">{mark.note}</span>
            </li>
          ))}
        </ol>
      </div>

      {/* The timeline makes the point. Which six components belong on a shelf
          is a purchasing conversation, and it keeps. */}
      <TechNote locale={locale} label={b.wear.sparesHeading} class="med-spares-note">
        <div class="med-spares">
          <ul class="med-spares__list">
            {b.wear.spares.map((s: string) => <li>{s}</li>)}
          </ul>
          <div class="med-spares__side">
            <p>{b.wear.sparesNote}</p>
            <p class="med-warranty">{b.wear.warranty}</p>
          </div>
        </div>
      </TechNote>
    </div>
  </section>}

  {/* ═══ 07 · SECOND TOOL ═══════════════════════════════════════════════ */}
  <section class="med-second" id="second">
