      </dl>
      <p class="el-figcap t-fine el-mag__note">{b.pitch.detailNote}</p>

      <div class="el-steel">
        <h3 class="el-h5">{b.pitch.steelHeading}</h3>
        <p class="el-steel__body">{b.pitch.steelBody}</p>
        <div class="el-table__scroll">
          <table class="el-table el-table--steel">
            <thead>
              <tr>{b.pitch.steelColumns.map((col: string) => <th scope="col">{col}</th>)}</tr>
            </thead>
            <tbody>
              {b.pitch.steelRows.map((row: any) => (
                <tr>
                  <th scope="row" class="t-mono el-table__grade">{row.grade}</th>
                  <td class="t-mono el-table__num">{row.hardness}</td>
                  <td class="el-table__con">{row.use}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="el-caveat">{b.pitch.steelNote}</p>
      </div>

      <p class="el-close">{b.pitch.close}</p>
    </div>
  </section>

  {/* ═══ 07 · SECOND SOURCE — the orthogonal rail ═══════════════════════ */}
  <section class="el-sec el-source" id="el-source">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.source.index} · {b.source.kicker}</p>
        <h2 class="el-h2">{b.source.heading}</h2>
        <p class="el-head__body">{b.source.body}</p>
      </div>

      <div class="el-rail" data-reveal>
        <p class="t-label el-rail__cap">{b.source.railLabel}</p>
        <div class="el-rail__spine" aria-hidden="true"></div>
        <ol class="el-rail__stages">
          {b.source.stages.map((stage: any, i: number) => (
            <li class="el-stage" style={`--i:${i}`}>
              <span class="el-stage__drop" aria-hidden="true"></span>
              <span class="el-stage__n t-mono">{String(i + 1).padStart(2, '0')}</span>
              <h3>{stage.title}</h3>
              <p>{stage.note}</p>
            </li>
          ))}
        </ol>
      </div>

      <p class="el-close">{b.source.close}</p>
      <p class="el-caveat">{b.source.warranty}</p>
    </div>
  </section>

  {/* ═══ 08 · THE BOUNDARY ══════════════════════════════════════════════ */}
  <section class="el-sec el-bound" id="el-boundary">
    <div class="el-comb" aria-hidden="true"></div>
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.boundary.index} · {b.boundary.kicker}</p>
        <h2 class="el-h2 el-bound__h">{b.boundary.heading}</h2>
        <p class="el-head__body">{b.boundary.body}</p>
      </div>

      <div class="el-bound__cols">
        <section class="el-bound__col">
          <h3 class="el-h5">{b.boundary.doHeading}</h3>
          <ul>{b.boundary.doList.map((item: string) => <li>{item}</li>)}</ul>
        </section>
        <section class="el-bound__col el-bound__col--not">
          <h3 class="el-h5">{b.boundary.dontHeading}</h3>
          <ul>{b.boundary.dontList.map((item: string) => <li>{item}</li>)}</ul>
        </section>
      </div>

      <p class="el-close el-close--wide">{b.boundary.close}</p>

      {/* Layer three: the technical depth, folded away until it is wanted. */}
      <div class="el-panels">
        <h3 class="t-label el-panels__h">{b.panels.heading}</h3>
        {b.panels.items.map((panel: any, i: number) => (
          <div class="disc" data-open={i === 0 ? 'true' : 'false'}>
            <h4>
              <button class="disc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                <span>{panel.title}</span>
                <span class="disc__sign" aria-hidden="true"></span>
              </button>
            </h4>
            <div class="disc__panel">
              <div class="disc__inner">
                <div>
                  <ul class="el-panel__list">
                    {panel.bullets.map((bullet: string) => <li>{bullet}</li>)}
                  </ul>
                  {panel.source && <p class="el-panel__src t-fine">{panel.source}</p>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</article>

<style>
  /* ═══ Chapter scope ═════════════════════════════════════════════════════
     Insulation indigo on cool near-white. Copper — --el-metal — appears only
     where the subject is a real metal terminal, contact or insert. Nothing
     decorative is ever copper, and that single constraint is the identity of
     this chapter. */
  .el {
    --el-metal: var(--signal);
    --el-hair: 1.1;
    --el-tick: color-mix(in oklab, var(--ink) 30%, transparent);
  }

  .el-h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.024em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 21ch;
  }
  .el-h3 {
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 20ch;
  }
  .el-h5 { font-size: var(--step-1); letter-spacing: var(--track-head); max-inline-size: 34ch; }

  .el-sec { padding-block: var(--section-y); border-block-start: var(--rule); position: relative; }

  .el-head { max-inline-size: 74ch; }
  .el-head__body {
    margin-block-start: var(--sp-5);
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 68ch;
  }

  .el-close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-0);
    line-height: 1.6;
    max-inline-size: 64ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }
  .el-close--wide { max-inline-size: 78ch; }

  .el-caveat {
    margin-block-start: var(--sp-5);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-muted);
    max-inline-size: 74ch;
    padding-inline-start: var(--sp-4);
    border-inline-start: var(--rule);
  }

  .el-figcap { margin-block-start: var(--sp-3); max-inline-size: 62ch; }

  /* ── Drawing conventions, shared by every figure ─────────────────────── */
  .el svg { inline-size: 100%; block-size: auto; }
  .el-hatch { stroke: var(--accent); stroke-width: 0.6; opacity: 0.34; }
  .el-body { stroke: var(--accent-deep); stroke-width: var(--el-hair); }
  .el-rule { stroke: var(--ink); stroke-width: 1; opacity: 0.5; }
  .el-tick { stroke: var(--el-tick); stroke-width: 0.9; }
  .el-tick--metal { stroke: var(--el-metal); stroke-width: 1.9; }
  .el-cl { stroke: var(--accent); stroke-width: 0.7; stroke-dasharray: 10 3 2 3; opacity: 0.55; }
  .el-dim { stroke: var(--ink-muted); stroke-width: 0.9; }
  .el-arwhead { fill: none; stroke: var(--ink-muted); stroke-width: 1.1; }
  .el-leader { fill: none; stroke: var(--ink-muted); stroke-width: 0.8; }
  .el-dot { fill: var(--ink-muted); }
  .el-gate { fill: var(--accent-deep); }
  .el-steel { stroke: var(--accent-deep); stroke-width: var(--el-hair); }
  .el-poly { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 0.9; }
  .el-shut { stroke: var(--accent); stroke-width: 2.4; }
  .el-detail { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; stroke-dasharray: 5 3; }
  .el-detail--solid { stroke-dasharray: none; opacity: 0.6; }
  .el-tagbg { fill: var(--surface-raise); }

  /* Copper. Metal only. */
  .el-metal { fill: color-mix(in oklab, var(--el-metal) 26%, transparent); stroke: var(--el-metal); stroke-width: 1.2; }
  .el-metal-pin { stroke: var(--el-metal); stroke-width: 4.5; }

  .el-micro {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    fill: var(--ink-muted);
  }
  .el-micro--strong { fill: var(--accent-deep); }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .el-hero {
    position: relative;
    padding-block: clamp(2.25rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    overflow: clip;
  }
  .el-hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--accent) 7%, transparent) 0%, transparent 62%);
  }
  .el-hero__wash::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 26px;
    background-image: repeating-linear-gradient(90deg, var(--el-tick) 0 1px, transparent 1px 13px);
    -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 100%);
    mask-image: linear-gradient(180deg, transparent 0%, #000 100%);
    opacity: 0.75;
  }

  .el-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 940px) { .el-hero__inner { grid-template-columns: 1fr; } }

  .el-hero__head {
    margin-block-start: clamp(1.1rem, 2.6vw, 1.75rem);
    font-size: clamp(2.1rem, 4.6vw, 3.2rem);
    line-height: 1.04;
    letter-spacing: -0.028em;
    font-weight: 500;
  }
  .el-hero__head span { display: block; }
  .el-hero__head span:last-child { color: var(--accent-deep); }

  .el-hero__lead {
    margin-block-start: clamp(1.1rem, 2.2vw, 1.6rem);
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 52ch;
  }
  .el-hero__markers { margin-block-start: var(--sp-6); display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .el-hero__markers li {
    font-size: var(--step--2);
    letter-spacing: 0.07em;
    padding: 0.4em 0.7em;
    border: 1px solid color-mix(in oklab, var(--accent) 32%, transparent);
    color: var(--accent-deep);
    background: color-mix(in oklab, var(--surface-raise) 72%, transparent);
  }
  .el-hero__combcap { display: block; margin-block-end: var(--sp-3); }
  .el-hero__fig .figure-note { margin-block-start: var(--sp-3); }
  .el-hero__figcap { margin-block-start: var(--sp-2); max-inline-size: 54ch; }

  /* The section draws itself once, like a continuity test. */
  @keyframes el-draw { to { stroke-dashoffset: 0; } }
  @keyframes el-seat { from { opacity: 0; } to { opacity: 1; } }
  :global(html.js) .el-body:not(.el-body--static) {
    stroke-dasharray: 3600;
    stroke-dashoffset: 3600;
    animation: el-draw 1500ms var(--ease-glide) 160ms both;
  }
  :global(html.js) .el-term {
    opacity: 0;
    animation: el-seat 220ms linear both;
    animation-delay: calc(1080ms + var(--i) * 90ms);
  }
  :global(html.js) .el-tick--metal {
    opacity: 0;
    animation: el-seat 180ms linear both;
    animation-delay: calc(1080ms + var(--i) * 90ms);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .el-body:not(.el-body--static) { stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
    :global(html.js) .el-term,
    :global(html.js) .el-tick--metal { opacity: 1; animation: none; }
  }

  .el-strip {
    position: relative;
    margin-block-start: clamp(1.75rem, 4vw, 3rem);
    padding-block-start: var(--sp-4);
    border-block-start: var(--rule-strong);
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-6);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .el-strip li { padding-block: 0.3rem; }
  :global(html[lang='zh']) .el-strip,
  :global(html[lang='th']) .el-strip,
  :global(html[lang='ar']) .el-strip,
  :global(html[lang='fa']) .el-strip,
  :global(html[lang='ur']) .el-strip {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--step--1);
  }

  /* ── 01 The index ────────────────────────────────────────────────────── */
  .el-index { margin-block-start: clamp(1.75rem, 4vw, 2.75rem); }
  .el-index__cols {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--sp-5);
    padding-block-end: var(--sp-3);
  }
  .el-index__cols span:first-child { grid-column: 2; }
  @media (max-width: 860px) { .el-index__cols { display: none; } }

  .el-index__rows { border-block-start: var(--rule-strong); }
  .el-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--sp-5);
    align-items: baseline;
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    position: relative;
  }
  /* The comb returns as a group divider every fifth row. */
  .el-row[data-group='true'] {
    border-block-start: var(--hair) solid transparent;
    background-image: repeating-linear-gradient(90deg, var(--el-tick) 0 1px, transparent 1px 13px);
    background-repeat: no-repeat;
    background-size: 100% 7px;
    background-position: 0 0;
    padding-block-start: calc(var(--sp-4) + 0.6rem);
  }
  .el-row::after {
    content: '';
    position: absolute;
    inset-block-end: -1px;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: var(--hair-strong);
    background: var(--accent);
    transition: inline-size var(--dur-3) var(--ease-mech);
  }
  .el-row:hover::after, .el-row:focus-within::after { inline-size: 100%; }
  .el-row__n { font-size: var(--step--2); color: var(--accent-deep); }
  .el-row__name { font-size: var(--step-0); font-weight: var(--weight-medium); line-height: 1.35; }
  .el-row__feat { font-size: var(--step--1); line-height: 1.55; color: var(--ink-muted); }
  @media (max-width: 860px) {
    .el-row { grid-template-columns: 2.5rem minmax(0, 1fr); gap: var(--sp-4) var(--sp-4); }
    .el-row__feat { grid-column: 2; }
  }

  /* ── 02 Flow length ──────────────────────────────────────────────────── */
  .el-wall__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 900px) { .el-wall__grid { grid-template-columns: 1fr; } }
  .el-wall__copy .el-h3 { margin-block-start: var(--sp-4); }
  .el-wall__body {
    margin-block-start: var(--sp-4);
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 44ch;
  }
  .el-wall__note { margin-block-start: var(--sp-5); max-inline-size: 44ch; }

  .el-flow .t-label { display: block; margin-block-end: var(--sp-3); }
  .el-cav { fill: none; stroke: color-mix(in oklab, var(--ink) 12%, transparent); stroke-width: 17; stroke-linejoin: round; stroke-linecap: butt; }
  .el-melt {
    fill: none;
    stroke: var(--accent);
    stroke-width: 17;
    stroke-linejoin: round;
    stroke-linecap: butt;
    opacity: 0.9;
  }
  :global(html.js) .el-flow .el-melt {
    stroke-dasharray: 2300;
    stroke-dashoffset: 2300;
    transition: stroke-dashoffset 2600ms var(--ease-glide) 200ms;
  }
  :global(html.js) .el-flow[data-reveal='in'] .el-melt { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .el-flow .el-melt { stroke-dasharray: none; stroke-dashoffset: 0; }
  }
  .el-flow .figure-note { margin-block-start: var(--sp-3); }

  .el-ladder { margin-block-start: clamp(1.75rem, 4vw, 2.75rem); }
  .el-ladder__cols,
  .el-ladder li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--sp-5);
  }
  .el-ladder__cols { padding-block-end: var(--sp-3); }
  .el-ladder ol { border-block-start: var(--rule-strong); }
  .el-ladder li {
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: baseline;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .el-ladder__r { font-size: var(--step-1); color: var(--accent-deep); }
  @media (max-width: 640px) {
    .el-ladder__cols, .el-ladder li { grid-template-columns: 1fr; gap: var(--sp-2); }
  }

  /* ── 03 Weld line ────────────────────────────────────────────────────── */
  .el-weld__pair {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 860px) { .el-weld__pair { grid-template-columns: 1fr; } }
  .el-weld__cap { grid-column: 1 / -1; justify-content: center; }
  @media (max-width: 860px) { .el-weld__cap { justify-content: start; } }

  .el-case { border-block-start: var(--rule-strong); padding-block-start: var(--sp-4); }
  .el-case__tag { display: block; margin-block-end: var(--sp-4); color: var(--ink-muted); }
  .el-case--fix .el-case__tag { color: var(--accent-deep); }
  .el-case__h {
    margin-block-start: var(--sp-4);
    font-size: var(--step-1);
    line-height: 1.25;
    letter-spacing: var(--track-head);
    font-weight: var(--weight-medium);
  }
  .el-case__note {
    margin-block-start: var(--sp-3);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .el-plan { fill: none; stroke: var(--accent-deep); stroke-width: 1.3; }
  .el-plan-in { fill: none; stroke: var(--accent); stroke-width: 0.8; opacity: 0.5; }
  .el-plan-core { fill: none; stroke: var(--accent-deep); stroke-width: 1.1; }
  .el-zone { fill: color-mix(in oklab, var(--accent) 16%, transparent); stroke: none; }
  .el-weldline { fill: none; stroke: var(--ink); stroke-width: 1.1; stroke-dasharray: 4 3; }
