---
/**
 * ELECTRICAL & ELECTRONICS — the pitch-comb chapter.
 *
 * Organising device: a fine tick array at fixed spacing, one tick per contact
 * position. It is the connector's own geometry used as the chapter's rule, its
 * divider and its diagram scale bar.
 *
 * One colour rule governs the whole chapter and it is enforced by a single
 * custom property: --el-metal is copper, and it is used ONLY where the subject
 * is a real metal terminal, contact or insert. Everything else — structure,
 * flow, steel, annotation — is insulation indigo on cool near-white.
 *
 * The argument the page turns on: an electrical part is a tolerance problem in
 * an insulating disguise. Where the melt can reach, and where the flows meet,
 * decide whether it is any good. It closes by naming the approvals Metal Form
 * does not hold, because in this sector that is the strongest thing to say.
 */
import type { Locale } from '../../i18n/locales.ts';
import TechNote from '../TechNote.astro';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;

/* ── Hero: the catalogue — eight ways of one connector, one to a cell ─────
   The opening is an index rather than a single object. Each cell is one
   contact position drawn in section, and the grid's own repeat IS the pitch:
   cell to cell is the centre distance, which is why the dimension under the
   first two cells needs no scale of its own to be read. */
const WAYS = Array.from({ length: 8 }, (_, i) => i);
/* One way in section: outer wall, draughted pocket, floor, on a 120×220 field. */
const WAY_BODY = 'M8 168 V48 H41 L45 124 H75 L79 48 H112 V168 Z';

/* ── 02: one cavity, folded four times. The melt front runs this path. ───── */
const FLOW_PATH = 'M90 55 H610 V115 H90 V175 H610 V235 H90';
/* Ratio marks sit at the end of each pass, alternating sides. */
const FLOW_MARKS = [
  { x: 624, y: 59, anchor: 'start' },
  { x: 76, y: 119, anchor: 'end' },
  { x: 624, y: 179, anchor: 'start' },
  { x: 76, y: 239, anchor: 'end' },
];
const FLOW_SCALE = Array.from({ length: 27 }, (_, i) => 90 + i * 20);

/* ── 06: two adjacent ways at high magnification. ─────────────────────────
   Pitch 160 units, shoulder stepping in between y142 and y160. */
const MAG_C = [140, 300];
const MAG_BODY = (() => {
  let d = 'M40 270 V70';
  for (const c of MAG_C) {
    d +=
      ` H${c - 34} L${c - 30} 82 V142 H${c - 20} V160 H${c - 30} V220` +
      ` H${c + 30} V160 H${c + 20} V142 H${c + 30} V82 L${c + 34} 70`;
  }
  return `${d} H400 V270 Z`;
})();

/* ── 04: four states of one insert tool, on one baseline. ─────────────────
   Cavity closes onto the top face of the terminal — that face is the
   shut-off, and the whole section is about what it has to absorb. */
const INS_CORE = 'M20 215 V145 H93 V175 H107 V145 H180 V215 Z';
const INS_CAVITY = 'M20 55 V145 H70 V93 H130 V145 H180 V55 Z';
---

<article class="el">

  {/* ═══ HERO — an index of ways, all at one pitch ══════════════════════ */}
  <header class="el-hero ground--steel mat mat--milled" data-tex="comb">
    <div class="el-hero__mat mat mat--milled" aria-hidden="true"></div>

    {/* One hatch, referenced by all eight cells. */}
    <svg class="el-defs" data-nomirror aria-hidden="true" focusable="false">
      <defs>
        <pattern id="el-hatch-hero" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <line x1="0" y1="0" x2="0" y2="9" class="el-hatch" />
        </pattern>
      </defs>
    </svg>

    <div class="shell--wide el-hero__inner">
      <p class="eyebrow">{content.hero.kicker}</p>

      <div class="el-hero__grid">
        <h1 class="el-hero__head">
          {content.hero.headline.map((line: string, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>
        <div class="el-hero__side">
          <p class="el-hero__lead">{content.hero.lead}</p>
          {content.hero.markers && (
            <ul class="badges el-hero__markers">
              {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
            </ul>
          )}
        </div>
      </div>

      {/* The catalogue. Eight cells, numbered, at a fixed centre distance —
          the index and the pitch comb are the same object. */}
      <figure class="el-cat">
        <div class="el-cat__head">
          <p class="t-label el-cat__label">{b.masthead.combLabel}</p>
          <ul class="el-cat__key">
            <li><span class="el-key el-key--metal" aria-hidden="true"></span>{b.masthead.marks.terminal}</li>
            <li><span class="el-key el-key--wall" aria-hidden="true"></span>{b.masthead.marks.wall}</li>
          </ul>
        </div>

        <ol class="el-cat__grid">
          {WAYS.map((i: number) => (
            <li class="el-cat__cell" style={`--i:${i}`}>
              <span class="el-cat__n t-mono">{String(i + 1).padStart(2, '0')}</span>
              <svg viewBox="0 0 120 220" data-nomirror aria-hidden="true" focusable="false">
                <line x1="60" y1="30" x2="60" y2="212" class="el-cl" />
                <path d={WAY_BODY} fill="url(#el-hatch-hero)" class="el-body" />
                {/* The only copper on the page: a real terminal. */}
                <g class="el-term">
                  <rect x="52" y="66" width="16" height="76" class="el-metal" />
                  <line x1="60" y1="142" x2="60" y2="204" class="el-metal-pin" />
                </g>
              </svg>
            </li>
          ))}
        </ol>

        {/* The dimension is simply reading the grid: two cells, one pitch. */}
        <p class="el-cat__pitch"><span class="t-mono">{b.masthead.marks.pitch}</span></p>

        <figcaption class="figure-note el-cat__note">{common.schematic}</figcaption>
        <p class="el-hero__figcap t-fine">{b.masthead.caption}</p>
      </figure>

      <ul class="caps el-hero__caps">
        {b.masthead.items.map((item: string) => (
          <li class="cap"><span class="cap__v">{item}</span></li>
        ))}
      </ul>
    </div>
  </header>

  {/* ═══ 01 · THE INDEX ═════════════════════════════════════════════════ */}
  <section class="el-sec el-parts" id="el-parts">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.parts.index} · {b.parts.kicker}</p>
        <h2 class="el-h2">{b.parts.heading}</h2>
        <p class="el-head__body">{b.parts.body}</p>
      </div>

      <div class="el-index">
        <p class="el-index__cols t-label">
          <span>{b.parts.colName}</span><span>{b.parts.colFeature}</span>
        </p>
        <ol class="el-index__rows">
          {b.parts.rows.map((row: any, i: number) => (
            <li class="el-row" data-group={i > 0 && i % 5 === 0 ? 'true' : 'false'}>
              <span class="el-row__n t-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="el-row__name">{row.name}</span>
              <span class="el-row__feat">{row.feature}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="el-close">{b.parts.close}</p>
    </div>
  </section>

  {/* ═══ 02 · FLOW LENGTH OVER WALL ═════════════════════════════════════ */}
  <section class="el-sec el-wall" id="el-wall">
    <div class="shell--wide el-wall__grid">
      <div class="el-wall__copy">
        <p class="eyebrow">{b.wall.index} · {b.wall.kicker}</p>
        <h2 class="el-h3">{b.wall.heading}</h2>
        <p class="el-wall__body">{b.wall.body}</p>
        <p class="el-wall__body">{b.wall.body2}</p>
        <p class="el-wall__note t-fine">{b.wall.note}</p>
      </div>

      <figure class="el-flow" data-reveal>
        <p class="t-label">{b.wall.ladderLabel}</p>
        <svg viewBox="0 0 700 300" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <marker id="el-arw-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {/* The cavity, empty. */}
          <path d={FLOW_PATH} class="el-cav" />
          {/* The melt front, advancing. */}
          <path d={FLOW_PATH} class="el-melt" />

          {/* Wall dimension across the channel at the gate end. */}
          <line x1="68" y1="47" x2="68" y2="63" class="el-dim" marker-start="url(#el-arw-flow)" marker-end="url(#el-arw-flow)" />
          <text x="60" y="59" text-anchor="end" class="el-micro">{b.wall.marks.wall}</text>

          {/* Gate. */}
          <rect x="84" y="49" width="12" height="12" class="el-gate" />
          <text x="90" y="36" text-anchor="middle" class="el-micro">{b.wall.marks.gate}</text>

          {/* Last to fill. */}
          <circle cx="90" cy="235" r="3" class="el-dot" />
          <path d="M90 235 V268" class="el-leader" />
          <text x="96" y="266" class="el-micro">{b.wall.marks.last}</text>

          {/* Ratio marks at the end of each pass. */}
          {b.wall.ladder.map((rung: any, i: number) => (
            <text
              x={FLOW_MARKS[i].x}
              y={FLOW_MARKS[i].y}
              text-anchor={FLOW_MARKS[i].anchor}
              class="el-micro el-micro--strong"
            >{rung.ratio}</text>
          ))}

          {/* Pitch comb, reused as the scale bar. */}
          {FLOW_SCALE.map((x: any) => <line x1={x} y1="284" x2={x} y2="292" class="el-tick" />)}
          <line x1="90" y1="292" x2="610" y2="292" class="el-rule" />
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
        <p class="el-figcap t-fine">{b.wall.caption}</p>
      </figure>
    </div>

    <div class="shell--wide">
      <TechNote locale={locale} kind="detail">
        <div class="el-ladder">
          <p class="el-ladder__cols t-label">
            <span>{b.wall.colRatio}</span><span>{b.wall.colVerdict}</span>
          </p>
          <ol>
            {b.wall.ladder.map((rung: any) => (
              <li>
                <span class="t-mono el-ladder__r">{rung.ratio}</span>
                <span>{rung.verdict}</span>
              </li>
            ))}
          </ol>
        </div>
      </TechNote>
      <p class="el-close">{b.wall.close}</p>
    </div>
  </section>

  {/* ═══ 03 · THE WELD LINE MAP ═════════════════════════════════════════ */}
  <section class="el-sec el-weld" id="el-weld">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.weld.index} · {b.weld.kicker}</p>
        <h2 class="el-h2">{b.weld.heading}</h2>
        <p class="el-head__body">{b.weld.body}</p>
      </div>

      <TechNote locale={locale} kind="detail">
        <div class="el-weld__pair" data-reveal>
          {/* CASE A — the fronts meet under the latch root. */}
          <figure class="el-case">
            <p class="el-case__tag t-label">{b.weld.cases[0].tag}</p>
            <svg viewBox="0 0 340 240" data-nomirror role="img" aria-label={common.schematic}>
              <rect x="30" y="30" width="280" height="170" class="el-plan" />
              <rect x="44" y="44" width="252" height="142" class="el-plan-in" />
              <rect x="140" y="30" width="60" height="28" class="el-zone" />
              <circle cx="100" cy="130" r="16" class="el-plan-core" />
              <circle cx="240" cy="130" r="16" class="el-plan-core" />
  
              <rect x="38" y="124" width="12" height="12" class="el-gate" />
              <rect x="290" y="124" width="12" height="12" class="el-gate" />
  
              <path d="M170 58 V200" class="el-weldline" />
              <path d="M170 30 V58" class="el-weldline el-weldline--hot" />
              <path d="M116 130 H154" class="el-weldline" />
              <path d="M224 130 H186" class="el-weldline" />
  
              <text x="40" y="112" class="el-micro">{b.weld.marks.gate}</text>
              <text x="206" y="48" class="el-micro">{b.weld.marks.latch}</text>
              <text x="100" y="168" text-anchor="middle" class="el-micro">{b.weld.marks.core}</text>
              <text x="176" y="222" class="el-micro">{b.weld.marks.weld}</text>
            </svg>
            <h3 class="el-case__h">{b.weld.cases[0].title}</h3>
            <p class="el-case__note">{b.weld.cases[0].note}</p>
          </figure>
  
          {/* CASE B — one gate at the base; the seams fall in plain wall. */}
          <figure class="el-case el-case--fix">
            <p class="el-case__tag t-label">{b.weld.cases[1].tag}</p>
            <svg viewBox="0 0 340 240" data-nomirror role="img" aria-label={common.schematic}>
              <rect x="30" y="30" width="280" height="170" class="el-plan" />
              <rect x="44" y="44" width="252" height="142" class="el-plan-in" />
              <rect x="140" y="30" width="60" height="28" class="el-zone" />
              <circle cx="100" cy="130" r="16" class="el-plan-core" />
              <circle cx="240" cy="130" r="16" class="el-plan-core" />
  
              <rect x="164" y="194" width="12" height="12" class="el-gate" />
  
              <path d="M92 116 L70 88" class="el-weldline" />
              <path d="M248 116 L270 88" class="el-weldline" />
  
              {/* Last to fill moves to the two top corners. */}
              <path d="M44 62 V44 H62" class="el-corner" />
              <path d="M296 62 V44 H278" class="el-corner" />
  
              <text x="178" y="216" class="el-micro">{b.weld.marks.gate}</text>
              <text x="206" y="48" class="el-micro">{b.weld.marks.latch}</text>
              <text x="100" y="168" text-anchor="middle" class="el-micro">{b.weld.marks.core}</text>
              <text x="64" y="80" text-anchor="end" class="el-micro">{b.weld.marks.weld}</text>
            </svg>
            <h3 class="el-case__h">{b.weld.cases[1].title}</h3>
            <p class="el-case__note">{b.weld.cases[1].note}</p>
          </figure>
  
          <figcaption class="figure-note el-weld__cap">{b.weld.caption}</figcaption>
        </div>
      </TechNote>

      <TechNote locale={locale} kind="reasoning">
        <div class="el-levers">
          <h3 class="el-h5">{b.weld.leversHeading}</h3>
          <ol class="el-levers__list">
            {b.weld.levers.map((lever: string, i: number) => (
              <li><span class="t-mono">{String(i + 1).padStart(2, '0')}</span>{lever}</li>
            ))}
          </ol>
        </div>
      </TechNote>

      <p class="el-close">{b.weld.close}</p>
    </div>
  </section>

  {/* ═══ 04 · INSERT MOULDING — four stepped states ═════════════════════ */}
  <section class="el-sec el-ins" id="el-insert" data-stepper data-step="0" data-tex="comb">
    <div class="shell--wide el-head">
      <p class="eyebrow">{b.insert.index} · {b.insert.kicker}</p>
      <h2 class="el-h2">{b.insert.heading}</h2>
      <p class="el-head__body">{b.insert.body}</p>
    </div>

    <div class="shell--wide el-ins__grid">
      <figure class="el-ins__fig">
        <svg viewBox="0 0 860 250" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="el-hatch-ins" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="8" class="el-hatch" />
            </pattern>
            <marker id="el-arw-ins" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {[0, 1, 2, 3].map((f: any) => (
            <g transform={`translate(${f * 220} 0)`} class="el-frame" data-frame={f}>
              {/* Core — fixed in every frame. */}
                <path d={INS_CORE} fill="url(#el-hatch-ins)" class="el-steel" />
  
                {/* Cavity — raised while the tool is open. */}
                <g transform={f === 0 || f === 3 ? 'translate(0 -46)' : 'translate(0 0)'}>
                  <path d={INS_CAVITY} fill="url(#el-hatch-ins)" class="el-steel" />
                </g>
  
                {/* Moulded polymer, from the shot onward. */}
                {(f === 2 || f === 3) && (
                  <g transform={f === 3 ? 'translate(0 -34)' : 'translate(0 0)'}>
                    <rect x="70" y="93" width="23" height="52" class="el-poly" />
                    <rect x="107" y="93" width="23" height="52" class="el-poly" />
                  </g>
                )}
  
                {/* The terminal persists across all four frames. */}
                <rect
                  x="93" y="93" width="14" height="82"
                  class="el-metal"
                  transform={f === 3 ? 'translate(0 -34)' : 'translate(0 0)'}
                />
  
                {/* Shut-off contact, marked only at close. */}
                {f === 1 && (
                  <>
                    <line x1="84" y1="93" x2="93" y2="93" class="el-shut" />
                    <line x1="107" y1="93" x2="116" y2="93" class="el-shut" />
                  </>
                )}
  
                {/* Melt entering. */}
                {f === 2 && (
                  <>
                    <line x1="40" y1="119" x2="68" y2="119" class="el-dim" marker-end="url(#el-arw-ins)" />
                    <text x="36" y="115" text-anchor="end" class="el-micro">{b.insert.marks.melt}</text>
                  </>
                )}
  
                {/* Ejection. */}
                {f === 3 && (
                  <>
                    <line x1="80" y1="215" x2="80" y2="115" class="el-dim" marker-end="url(#el-arw-ins)" />
                    <line x1="120" y1="215" x2="120" y2="115" class="el-dim" marker-end="url(#el-arw-ins)" />
                    <text x="100" y="240" text-anchor="middle" class="el-micro">{b.insert.marks.eject}</text>
                  </>
                )}
  
                {f === 0 && (
                  <>
                    <circle cx="150" cy="70" r="2.6" class="el-dot" />
                    <path d="M150 70 L166 118" class="el-leader" />
                    <text x="170" y="122" class="el-micro">{b.insert.marks.cavity}</text>
                    <path d="M100 218 V230" class="el-leader" />
                    <text x="100" y="242" text-anchor="middle" class="el-micro">{b.insert.marks.core}</text>
                  </>
                )}
  
                <text x="100" y="14" text-anchor="middle" class="el-micro el-micro--strong">
                  {String(f + 1).padStart(2, '0')}
                </text>
              </g>
            ))}
          </svg>
          <figcaption class="figure-note">{common.schematic}</figcaption>
          <p class="el-figcap t-fine">{b.insert.caption}</p>
      </figure>

      <ol class="el-ins__steps">
        {b.insert.stages.map((stage: any, i: number) => (
          <li class="el-ins__step" data-station-step={i}>
            <span class="t-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{stage.label}</h3>
            <p>{stage.note}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="shell--wide">
      <p class="el-close">{b.insert.close}</p>
      <p class="el-caveat">{b.insert.boundaryNote}</p>
    </div>
  </section>

  {/* ═══ 05 · THE MATERIAL TABLE ════════════════════════════════════════ */}
  <section class="el-sec el-resin" id="el-resin">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.resin.index} · {b.resin.kicker}</p>
        <h2 class="el-h2">{b.resin.heading}</h2>
        <p class="el-head__body">{b.resin.body}</p>
      </div>

      <TechNote locale={locale} kind="reasoning">
        <div class="el-table__scroll">
          <table class="el-table">
            <thead>
              <tr>{b.resin.columns.map((col: string) => <th scope="col">{col}</th>)}</tr>
            </thead>
            <tbody>
              {b.resin.rows.map((row: any) => (
                <tr>
                  <th scope="row" class="t-mono el-table__grade">{row.grade}</th>
                  <td class="t-mono el-table__num">{row.shrink}</td>
                  <td class="el-table__use">{row.use}</td>
                  <td class="el-table__con">{row.consequence}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </TechNote>

      <p class="el-caveat">{b.resin.note}</p>
      <p class="el-close">{b.resin.close}</p>
    </div>
  </section>

  {/* ═══ 06 · PITCH, MAGNIFIED ══════════════════════════════════════════ */}
  <section class="el-sec el-pitch" id="el-pitch">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.pitch.index} · {b.pitch.kicker}</p>
        <h2 class="el-h2">{b.pitch.heading}</h2>
        <p class="el-head__body">{b.pitch.body}</p>
      </div>

      <figure class="el-mag" data-reveal>
        <svg viewBox="0 0 700 400" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="el-hatch-mag" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="9" class="el-hatch" />
            </pattern>
            <marker id="el-arw-mag" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {/* Main view: two adjacent ways. */}
          {MAG_C.map((c: any) => <line x1={c} y1="52" x2={c} y2="336" class="el-cl" />)}
          <path d={MAG_BODY} fill="url(#el-hatch-mag)" class="el-body el-body--static" />

          {MAG_C.map((c: any) => (
            <g>
              <rect x={c - 14} y="84" width="28" height="128" class="el-metal" />
              <path d={`M${c - 14} 150 L${c - 22} 162 L${c - 22} 174 L${c - 14} 168 Z`} class="el-metal" />
              <line x1={c} y1="212" x2={c} y2="300" class="el-metal-pin" />
            </g>
          ))}

          <line x1={MAG_C[0]} y1="322" x2={MAG_C[1]} y2="322" class="el-dim" marker-start="url(#el-arw-mag)" marker-end="url(#el-arw-mag)" />
          <text x={(MAG_C[0] + MAG_C[1]) / 2} y="315" text-anchor="middle" class="el-micro">{b.pitch.marks.pitch}</text>

          {/* Core-pin callout on the pocket wall it forms. */}
          <circle cx="330" cy="190" r="2.6" class="el-dot" />
          <path d="M330 190 L378 312" class="el-leader" />
          <rect x="368" y="303" width="20" height="18" class="el-tagbg" />
          <text x="378" y="316" text-anchor="middle" class="el-micro el-micro--strong">{b.pitch.marks.c}</text>

          {/* Detail frame and its leaders out to the enlargement. */}
          <rect x="100" y="128" width="76" height="62" class="el-detail" />
          <text x="100" y="122" class="el-micro">{b.pitch.detailLabel}</text>
          <path d="M176 128 L440 62" class="el-leader" />
          <path d="M176 190 L440 298" class="el-leader" />

          {/* Enlargement. */}
          <rect x="440" y="60" width="250" height="240" class="el-detail el-detail--solid" />
          <path d="M460 80 H570 V150 H535 V182 H570 V280 H460 Z" fill="url(#el-hatch-mag)" class="el-body el-body--static" />
          <rect x="600" y="90" width="45" height="190" class="el-metal" />
          <path d="M600 152 L533 184 L533 208 L600 194 Z" class="el-metal" />

          <circle cx="552" cy="166" r="2.6" class="el-dot" />
          <path d="M552 166 L500 120" class="el-leader" />
          <rect x="484" y="111" width="20" height="18" class="el-tagbg" />
          <text x="494" y="124" text-anchor="middle" class="el-micro el-micro--strong">{b.pitch.marks.a}</text>

          <circle cx="560" cy="192" r="2.6" class="el-dot" />
          <path d="M560 192 L505 242" class="el-leader" />
          <rect x="495" y="233" width="20" height="18" class="el-tagbg" />
          <text x="505" y="246" text-anchor="middle" class="el-micro el-micro--strong">{b.pitch.marks.b}</text>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
        <p class="el-figcap t-fine">{b.pitch.caption}</p>
      </figure>

      <TechNote locale={locale} kind="detail">
        <dl class="el-callouts">
          {b.pitch.callouts.map((call: any) => (
            <div>
              <dt><span class="el-callouts__mark t-mono">{call.mark}</span>{call.name}</dt>
              <dd>{call.note}</dd>
            </div>
          ))}
        </dl>
      </TechNote>
      <p class="el-figcap t-fine el-mag__note">{b.pitch.detailNote}</p>

      <TechNote locale={locale} kind="reasoning">
        <div class="el-steel">
          <h3 class="el-h5">{b.pitch.steelHeading}</h3>
          <p class="el-steel__body">{b.pitch.steelBody}</p>
          <TechNote locale={locale} kind="reasoning">
            <div class="el-table__scroll">
              <table class="el-table el-table--steel">
                <thead>
                  <tr>{b.pitch.steelColumns.map((col: string) => <th scope="col">{col}</th>)}</tr>
                </thead>
                <tbody>
                  {b.pitch.steelRows.map((row: any) => (
                    <tr>
                      <th scope="row" class="t-mono el-table__grade">{row.grade}</th>
                      <td class="t-mono el-table__num">{row.hardness}</td>
                      <td class="el-table__con">{row.use}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </TechNote>
          <p class="el-caveat">{b.pitch.steelNote}</p>
        </div>
      </TechNote>

      <p class="el-close">{b.pitch.close}</p>
    </div>
  </section>

  {/* ═══ 07 · SECOND SOURCE — the orthogonal rail ═══════════════════════ */}
  <section class="el-sec el-source" id="el-source">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.source.index} · {b.source.kicker}</p>
        <h2 class="el-h2">{b.source.heading}</h2>
        <p class="el-head__body">{b.source.body}</p>
      </div>

      <TechNote locale={locale} kind="reasoning">
        <div class="el-rail" data-reveal>
          <p class="t-label el-rail__cap">{b.source.railLabel}</p>
          <div class="el-rail__spine" aria-hidden="true"></div>
          <ol class="el-rail__stages">
            {b.source.stages.map((stage: any, i: number) => (
              <li class="el-stage" style={`--i:${i}`}>
                <span class="el-stage__drop" aria-hidden="true"></span>
                <span class="el-stage__n t-mono">{String(i + 1).padStart(2, '0')}</span>
                <h3>{stage.title}</h3>
                <p>{stage.note}</p>
              </li>
            ))}
          </ol>
        </div>
      </TechNote>

      <p class="el-close">{b.source.close}</p>
      <p class="el-caveat">{b.source.warranty}</p>
    </div>
  </section>

  {/* ═══ 08 · THE BOUNDARY ══════════════════════════════════════════════ */}
  <section class="el-sec el-bound" id="el-boundary">
    <div class="el-comb" aria-hidden="true"></div>
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.boundary.index} · {b.boundary.kicker}</p>
        <h2 class="el-h2 el-bound__h">{b.boundary.heading}</h2>
        <p class="el-head__body">{b.boundary.body}</p>
      </div>

      <div class="el-bound__cols">
        <section class="el-bound__col">
          <h3 class="el-h5">{b.boundary.doHeading}</h3>
          <ul>{b.boundary.doList.map((item: string) => <li>{item}</li>)}</ul>
        </section>
        <section class="el-bound__col el-bound__col--not">
          <h3 class="el-h5">{b.boundary.dontHeading}</h3>
          <ul>{b.boundary.dontList.map((item: string) => <li>{item}</li>)}</ul>
        </section>
      </div>

      <p class="el-close el-close--wide">{b.boundary.close}</p>

      {/* Layer three: the technical depth, folded away until it is wanted. */}
      <div class="el-panels">
        <h3 class="t-label el-panels__h">{b.panels.heading}</h3>
        {b.panels.items.map((panel: any, i: number) => (
          <div class="disc" data-open="false">
            <h4>
              <button class="disc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                <span>{panel.title}</span>
                <span class="disc__sign" aria-hidden="true"></span>
              </button>
            </h4>
            <div class="disc__panel">
              <div class="disc__inner">
                <div>
                  <ul class="el-panel__list">
                    {panel.bullets.map((bullet: string) => <li>{bullet}</li>)}
                  </ul>
                  {panel.source && <p class="el-panel__src t-fine">{panel.source}</p>}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</article>

<style>
  /* ═══ Chapter scope ═════════════════════════════════════════════════════
     Insulation indigo on cool near-white. Copper — --el-metal — appears only
     where the subject is a real metal terminal, contact or insert. Nothing
     decorative is ever copper, and that single constraint is the identity of
     this chapter. */
  .el {
    --el-metal: var(--signal);
    --el-hair: 1.1;
    --el-tick: color-mix(in oklab, var(--ink) 30%, transparent);
    /* This wrapper — not the hero — is `main > :first-child`, so the layout's
       header clearance lands here. Taken off and given to the hero instead:
       the hero is the element that carries the steel, and a clearance on the
       wrapper would put a band of near-white page above it with the header in
       its light state sitting on top of that. */
    padding-block-start: 0;
  }

  .el-h2 {
    font-size: clamp(1.7rem, 3.4vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.024em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 21ch;
  }
  .el-h3 {
    font-size: clamp(1.45rem, 2.6vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 20ch;
  }
  .el-h5 { font-size: var(--step-1); letter-spacing: var(--track-head); max-inline-size: 34ch; }

  .el-sec { padding-block: var(--section-y); border-block-start: var(--rule); position: relative; }

  .el-head { max-inline-size: 74ch; }
  .el-head__body {
    margin-block-start: var(--sp-5);
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 68ch;
  }

  .el-close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-0);
    line-height: 1.6;
    max-inline-size: 64ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }
  .el-close--wide { max-inline-size: 78ch; }

  .el-caveat {
    margin-block-start: var(--sp-5);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-muted);
    max-inline-size: 74ch;
    padding-inline-start: var(--sp-4);
    border-inline-start: var(--rule);
  }

  .el-figcap { margin-block-start: var(--sp-3); max-inline-size: 62ch; }

  /* ── Drawing conventions, shared by every figure ─────────────────────── */
  .el svg { inline-size: 100%; block-size: auto; }
  .el-hatch { stroke: var(--accent); stroke-width: 0.6; opacity: 0.34; }
  .el-body { stroke: var(--accent-deep); stroke-width: var(--el-hair); }
  .el-rule { stroke: var(--ink); stroke-width: 1; opacity: 0.5; }
  .el-tick { stroke: var(--el-tick); stroke-width: 0.9; }
  .el-cl { stroke: var(--accent); stroke-width: 0.7; stroke-dasharray: 10 3 2 3; opacity: 0.55; }
  .el-dim { stroke: var(--ink-muted); stroke-width: 0.9; }
  .el-arwhead { fill: none; stroke: var(--ink-muted); stroke-width: 1.1; }
  .el-leader { fill: none; stroke: var(--ink-muted); stroke-width: 0.8; }
  .el-dot { fill: var(--ink-muted); }
  .el-gate { fill: var(--accent-deep); }
  .el-steel { stroke: var(--accent-deep); stroke-width: var(--el-hair); }
  .el-poly { fill: var(--accent-wash); stroke: var(--accent); stroke-width: 0.9; }
  .el-shut { stroke: var(--accent); stroke-width: 2.4; }
  .el-detail { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; stroke-dasharray: 5 3; }
  .el-detail--solid { stroke-dasharray: none; opacity: 0.6; }
  .el-tagbg { fill: var(--surface-raise); }

  /* Copper. Metal only. */
  .el-metal { fill: color-mix(in oklab, var(--el-metal) 26%, transparent); stroke: var(--el-metal); stroke-width: 1.2; }
  .el-metal-pin { stroke: var(--el-metal); stroke-width: 4.5; }

  .el-micro {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    fill: var(--ink-muted);
  }
  .el-micro--strong { fill: var(--accent-deep); }

  /* ── Hero: an index of ways on steel ─────────────────────────────────────
     `ground--steel` remaps the whole token set for this band, so nothing
     below names a colour. Three variables have to be re-derived here rather
     than inherited: a custom property resolves its own var() against the
     element it is DECLARED on, and `--el-metal` / `--el-tick` were declared
     on `.el` against the light palette (`--rule`, site-wide, against the
     brand-neutral one on :root). Restated as their own definitions, not as
     values, so the ground still decides what colour they come out. */
  .el-hero {
    position: relative;
    /* Header clearance, taken off `.el` above. The site header is in its
       light state over this band and overlays it. */
    padding-block: calc(4.25rem + clamp(2rem, 5vw, 4rem)) clamp(2.25rem, 5vw, 3.5rem);
    overflow: clip;
    --el-metal: var(--signal);
    --el-tick: color-mix(in oklab, var(--ink) 30%, transparent);
    --rule: var(--hair) solid var(--line);
    --tex-opacity: 0.085;
  }
  /* `.mat--milled` and `[data-tex]` both draw on ::before and there is only
     one of those. The comb takes the hero's, so the milled finish gets a
     layer of its own; the mat's sizing is stood down on the hero so the comb
     tiles against the element rather than against a 140px grain square.
     Nothing here declares a background: the ground owns that. */
  .el-hero.mat--milled::before { background-size: auto; mix-blend-mode: normal; }
  .el-hero__mat {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Neither isolated nor lifted, or the milled layer would blend against
       its own empty box instead of against the steel underneath it. */
    z-index: auto;
    isolation: auto;
  }

  /* Definitions only — referenced by every cell, occupies no space. */
  .el .el-defs { position: absolute; inline-size: 0; block-size: 0; overflow: hidden; }

  .el-hero__inner { position: relative; }

  /* The copy sits above the catalogue and does not outweigh it: the statement
     takes one column, the lead and the verified capability take the other. */
  .el-hero__grid {
    margin-block-start: clamp(1.1rem, 2.6vw, 1.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: end;
  }
  .el-hero__head {
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1.05;
    letter-spacing: -0.028em;
    font-weight: 500;
  }
  .el-hero__head span { display: block; }
  .el-hero__head span:last-child { color: var(--accent-deep); }

  .el-hero__lead {
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 52ch;
  }
  .el-hero__markers { margin-block-start: var(--sp-5); }
  /* The system keys its dark relief off `.on-steel`; a chapter ground is not
     that class, so the badges are told directly. */
  .el-hero .badge { box-shadow: var(--relief-dark); }
  .el-hero__figcap { margin-block-start: var(--sp-2); max-inline-size: 62ch; }
  .el-hero__caps { margin-block-start: clamp(2rem, 4.5vw, 3.25rem); }

  /* ── The catalogue ───────────────────────────────────────────────────────
     Eight cells, numbered, one contact position each. The grid's repeat is
     the pitch, so the dimension under the first two cells is not a separate
     drawing — it is reading the index itself. */
  .el-cat {
    --cells: 8;
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
  }
  .el-cat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-6);
    padding-block-end: var(--sp-3);
  }
  .el-cat__key { display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-5); }
  .el-cat__key li {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--step--2);
    line-height: 1.4;
    color: var(--ink-muted);
  }
  .el-key {
    flex: none;
    inline-size: 1.15rem;
    block-size: 0.6rem;
    border: var(--hair) solid currentColor;
  }
  .el-key--metal { color: var(--el-metal); background: color-mix(in oklab, var(--el-metal) 26%, transparent); }
  .el-key--wall { color: var(--accent); background-image: var(--tex-hatch); }

  .el-cat__grid {
    display: grid;
    grid-template-columns: repeat(var(--cells), minmax(0, 1fr));
    gap: var(--hair);
    background: var(--line);
    border: var(--rule);
  }
  .el-cat__cell {
    background: var(--surface-raise);
    padding-block: var(--sp-4) var(--sp-3);
    padding-inline: var(--sp-3);
    min-inline-size: 0;
  }
  .el-cat__n {
    display: block;
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    color: var(--accent-deep);
  }
  .el-cat__cell svg { margin-block-start: var(--sp-3); }

  .el-cat__pitch {
    position: relative;
    inline-size: calc(200% / var(--cells));
    margin-block-start: 1.05rem;
    padding-block-start: var(--sp-2);
    border-block-start: var(--hair) solid var(--accent);
    display: grid;
    justify-items: center;
  }
  /* Extension ticks, running back up to the two cells being measured. */
  .el-cat__pitch::before,
  .el-cat__pitch::after {
    content: '';
    position: absolute;
    inset-block-start: -0.55rem;
    inline-size: var(--hair);
    block-size: 0.55rem;
    background: var(--accent);
  }
  .el-cat__pitch::before { inset-inline-start: 0; }
  .el-cat__pitch::after { inset-inline-end: 0; }
  .el-cat__pitch span { font-size: var(--step--2); letter-spacing: 0.14em; color: var(--accent-deep); }
  .el-cat__note { margin-block-start: var(--sp-4); }

  /* Each section draws itself once and its terminal then seats — a continuity
     test walking along the pitch, one way at a time. */
  @keyframes el-draw { to { stroke-dashoffset: 0; } }
  @keyframes el-seat { from { opacity: 0; } to { opacity: 1; } }
  :global(html.js) .el-cat .el-body {
    stroke-dasharray: 640;
    stroke-dashoffset: 640;
    animation: el-draw 620ms var(--ease-glide) both;
    animation-delay: calc(140ms + var(--i) * 70ms);
  }
  :global(html.js) .el-term {
    opacity: 0;
    animation: el-seat 200ms linear both;
    animation-delay: calc(600ms + var(--i) * 70ms);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .el-cat .el-body { stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
    :global(html.js) .el-term { opacity: 1; animation: none; }
  }

  /* ── 01 The index ────────────────────────────────────────────────────── */
  .el-index { margin-block-start: clamp(1.75rem, 4vw, 2.75rem); }
  .el-index__cols {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--sp-5);
    padding-block-end: var(--sp-3);
  }
  .el-index__cols span:first-child { grid-column: 2; }

  .el-index__rows { border-block-start: var(--rule-strong); }
  .el-row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--sp-5);
    align-items: baseline;
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    position: relative;
  }
  /* The comb returns as a group divider every fifth row. */
  .el-row[data-group='true'] {
    border-block-start: var(--hair) solid transparent;
    background-image: repeating-linear-gradient(90deg, var(--el-tick) 0 1px, transparent 1px 13px);
    background-repeat: no-repeat;
    background-size: 100% 7px;
    background-position: 0 0;
    padding-block-start: calc(var(--sp-4) + 0.6rem);
  }
  .el-row::after {
    content: '';
    position: absolute;
    inset-block-end: -1px;
    inset-inline-start: 0;
    inline-size: 0;
    block-size: var(--hair-strong);
    background: var(--accent);
    transition: inline-size var(--dur-3) var(--ease-mech);
  }
  .el-row:hover::after, .el-row:focus-within::after { inline-size: 100%; }
  .el-row__n { font-size: var(--step--2); color: var(--accent-deep); }
  .el-row__name { font-size: var(--step-0); font-weight: var(--weight-medium); line-height: 1.35; }
  .el-row__feat { font-size: var(--step--1); line-height: 1.55; color: var(--ink-muted); }

  /* ── 02 Flow length ──────────────────────────────────────────────────── */
  .el-wall__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: start;
  }
  .el-wall__copy .el-h3 { margin-block-start: var(--sp-4); }
  .el-wall__body {
    margin-block-start: var(--sp-4);
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 44ch;
  }
  .el-wall__note { margin-block-start: var(--sp-5); max-inline-size: 44ch; }

  .el-flow .t-label { display: block; margin-block-end: var(--sp-3); }
  .el-cav { fill: none; stroke: color-mix(in oklab, var(--ink) 12%, transparent); stroke-width: 17; stroke-linejoin: round; stroke-linecap: butt; }
  .el-melt {
    fill: none;
    stroke: var(--accent);
    stroke-width: 17;
    stroke-linejoin: round;
    stroke-linecap: butt;
    opacity: 0.9;
  }
  :global(html.js) .el-flow .el-melt {
    stroke-dasharray: 2300;
    stroke-dashoffset: 2300;
    transition: stroke-dashoffset 2600ms var(--ease-glide) 200ms;
  }
  :global(html.js) .el-flow[data-reveal='in'] .el-melt { stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .el-flow .el-melt { stroke-dasharray: none; stroke-dashoffset: 0; }
  }
  .el-flow .figure-note { margin-block-start: var(--sp-3); }

  .el-ladder { margin-block-start: clamp(1.75rem, 4vw, 2.75rem); }
  .el-ladder__cols,
  .el-ladder li {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: var(--sp-5);
  }
  .el-ladder__cols { padding-block-end: var(--sp-3); }
  .el-ladder ol { border-block-start: var(--rule-strong); }
  .el-ladder li {
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: baseline;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .el-ladder__r { font-size: var(--step-1); color: var(--accent-deep); }

  /* ── 03 Weld line ────────────────────────────────────────────────────── */
  .el-weld__pair {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
