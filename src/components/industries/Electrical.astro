---
/**
 * ELECTRICAL & ELECTRONICS — the pitch-comb chapter.
 *
 * Organising device: a fine tick array at fixed spacing, one tick per contact
 * position. It is the connector's own geometry used as the chapter's rule, its
 * divider and its diagram scale bar.
 *
 * One colour rule governs the whole chapter and it is enforced by a single
 * custom property: --el-metal is copper, and it is used ONLY where the subject
 * is a real metal terminal, contact or insert. Everything else — structure,
 * flow, steel, annotation — is insulation indigo on cool near-white.
 *
 * The argument the page turns on: an electrical part is a tolerance problem in
 * an insulating disguise. Where the melt can reach, and where the flows meet,
 * decide whether it is any good. It closes by naming the approvals Metal Form
 * does not hold, because in this sector that is the strongest thing to say.
 */
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { content, common } = Astro.props;
const b = content.blocks as any;

/* ── Hero: an eight-way connector body, drawn in section ──────────────────
   Pitch 58 units between ways; the comb above it carries one copper tick per
   way and a fine ink tick at every half-division. */
const H_X0 = 40;
const H_X1 = 560;
const H_PITCH = 58;
const H_C = Array.from({ length: 8 }, (_, i) => 97 + i * H_PITCH);

const HERO_BODY = (() => {
  let d = `M${H_X0} 300 V120`;
  for (const c of H_C) {
    d += ` H${c - 22} L${c - 18} 130 V250 H${c + 18} V130 L${c + 22} 120`;
  }
  return `${d} H${H_X1} V300 Z`;
})();
const HERO_COMB = Array.from({ length: 37 }, (_, i) =>
  Number((H_X0 + (i * (H_X1 - H_X0)) / 36).toFixed(2)),
);

/* ── 02: one cavity, folded four times. The melt front runs this path. ───── */
const FLOW_PATH = 'M90 55 H610 V115 H90 V175 H610 V235 H90';
/* Ratio marks sit at the end of each pass, alternating sides. */
const FLOW_MARKS = [
  { x: 624, y: 59, anchor: 'start' },
  { x: 76, y: 119, anchor: 'end' },
  { x: 624, y: 179, anchor: 'start' },
  { x: 76, y: 239, anchor: 'end' },
];
const FLOW_SCALE = Array.from({ length: 27 }, (_, i) => 90 + i * 20);

/* ── 06: two adjacent ways at high magnification. ─────────────────────────
   Pitch 160 units, shoulder stepping in between y142 and y160. */
const MAG_C = [140, 300];
const MAG_BODY = (() => {
  let d = 'M40 270 V70';
  for (const c of MAG_C) {
    d +=
      ` H${c - 34} L${c - 30} 82 V142 H${c - 20} V160 H${c - 30} V220` +
      ` H${c + 30} V160 H${c + 20} V142 H${c + 30} V82 L${c + 34} 70`;
  }
  return `${d} H400 V270 Z`;
})();

/* ── 04: four states of one insert tool, on one baseline. ─────────────────
   Cavity closes onto the top face of the terminal — that face is the
   shut-off, and the whole section is about what it has to absorb. */
const INS_CORE = 'M20 215 V145 H93 V175 H107 V145 H180 V215 Z';
const INS_CAVITY = 'M20 55 V145 H70 V93 H130 V145 H180 V55 Z';
---

<article class="el">

  {/* ═══ HERO — the pitch comb, and a body in section ═══════════════════ */}
  <header class="el-hero">
    <div class="el-hero__wash" aria-hidden="true"></div>

    <div class="shell--wide el-hero__inner">
      <div class="el-hero__copy">
        <p class="eyebrow">{content.hero.kicker}</p>
        <h1 class="el-hero__head">
          {content.hero.headline.map((line: string, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>
        <p class="el-hero__lead">{content.hero.lead}</p>
        {content.hero.markers && (
          <ul class="el-hero__markers">
            {content.hero.markers.map((m: string) => <li class="t-mono">{m}</li>)}
          </ul>
        )}
      </div>

      <figure class="el-hero__fig">
        <p class="t-label el-hero__combcap">{b.masthead.combLabel}</p>
        <svg viewBox="0 0 700 400" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="el-hatch-hero" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="9" class="el-hatch" />
            </pattern>
            <marker id="el-arw-hero" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {/* Pitch comb — fine ink ticks throughout, copper only at a real way. */}
          {HERO_COMB.map((x: any) => <line x1={x} y1="78" x2={x} y2="90" class="el-tick" />)}
          <line x1={H_X0} y1="90" x2={H_X1} y2="90" class="el-rule" />
          {H_C.map((c: any, i: number) => (
            <line x1={c} y1="62" x2={c} y2="90" class="el-tick--metal" style={`--i:${i}`} />
          ))}

          {/* Centre lines for the two ways carrying the pitch dimension. */}
          <line x1={H_C[0]} y1="96" x2={H_C[0]} y2="372" class="el-cl" />
          <line x1={H_C[1]} y1="96" x2={H_C[1]} y2="372" class="el-cl" />

          {/* The moulded body, in section. Draws itself once on load. */}
          <path d={HERO_BODY} fill="url(#el-hatch-hero)" class="el-body" />

          {/* Terminals — the only copper on the page that is not a tick. */}
          {H_C.map((c: any, i: number) => (
            <g class="el-term" style={`--i:${i}`}>
              <rect x={c - 7} y="136" width="14" height="108" class="el-metal" />
              <line x1={c} y1="244" x2={c} y2="336" class="el-metal-pin" />
            </g>
          ))}

          {/* Pitch dimension. */}
          <line x1={H_C[0]} y1="364" x2={H_C[1]} y2="364" class="el-dim" marker-start="url(#el-arw-hero)" marker-end="url(#el-arw-hero)" />
          <text x={(H_C[0] + H_C[1]) / 2} y="357" text-anchor="middle" class="el-micro">{b.masthead.marks.pitch}</text>

          {/* Leader callouts. */}
          <circle cx={H_C[7]} cy="170" r="2.6" class="el-dot" />
          <path d={`M${H_C[7]} 170 H600`} class="el-leader" />
          <text x="606" y="174" class="el-micro">{b.masthead.marks.terminal}</text>
          <circle cx="540" cy="280" r="2.6" class="el-dot" />
          <path d="M540 280 H600" class="el-leader" />
          <text x="606" y="284" class="el-micro">{b.masthead.marks.wall}</text>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
        <p class="el-hero__figcap t-fine">{b.masthead.caption}</p>
      </figure>
    </div>

    <div class="shell--wide">
      <ul class="el-strip">
        {b.masthead.items.map((item: string) => <li class="t-mono">{item}</li>)}
      </ul>
    </div>
  </header>

  {/* ═══ 01 · THE INDEX ═════════════════════════════════════════════════ */}
  <section class="el-sec el-parts" id="el-parts">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.parts.index} · {b.parts.kicker}</p>
        <h2 class="el-h2">{b.parts.heading}</h2>
        <p class="el-head__body">{b.parts.body}</p>
      </div>

      <div class="el-index">
        <p class="el-index__cols t-label">
          <span>{b.parts.colName}</span><span>{b.parts.colFeature}</span>
        </p>
        <ol class="el-index__rows">
          {b.parts.rows.map((row: any, i: number) => (
            <li class="el-row" data-group={i > 0 && i % 5 === 0 ? 'true' : 'false'}>
              <span class="el-row__n t-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="el-row__name">{row.name}</span>
              <span class="el-row__feat">{row.feature}</span>
            </li>
          ))}
        </ol>
      </div>

      <p class="el-close">{b.parts.close}</p>
    </div>
  </section>

  {/* ═══ 02 · FLOW LENGTH OVER WALL ═════════════════════════════════════ */}
  <section class="el-sec el-wall" id="el-wall">
    <div class="shell--wide el-wall__grid">
      <div class="el-wall__copy">
        <p class="eyebrow">{b.wall.index} · {b.wall.kicker}</p>
        <h2 class="el-h3">{b.wall.heading}</h2>
        <p class="el-wall__body">{b.wall.body}</p>
        <p class="el-wall__body">{b.wall.body2}</p>
        <p class="el-wall__note t-fine">{b.wall.note}</p>
      </div>

      <figure class="el-flow" data-reveal>
        <p class="t-label">{b.wall.ladderLabel}</p>
        <svg viewBox="0 0 700 300" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <marker id="el-arw-flow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {/* The cavity, empty. */}
          <path d={FLOW_PATH} class="el-cav" />
          {/* The melt front, advancing. */}
          <path d={FLOW_PATH} class="el-melt" />

          {/* Wall dimension across the channel at the gate end. */}
          <line x1="68" y1="47" x2="68" y2="63" class="el-dim" marker-start="url(#el-arw-flow)" marker-end="url(#el-arw-flow)" />
          <text x="60" y="59" text-anchor="end" class="el-micro">{b.wall.marks.wall}</text>

          {/* Gate. */}
          <rect x="84" y="49" width="12" height="12" class="el-gate" />
          <text x="90" y="36" text-anchor="middle" class="el-micro">{b.wall.marks.gate}</text>

          {/* Last to fill. */}
          <circle cx="90" cy="235" r="3" class="el-dot" />
          <path d="M90 235 V268" class="el-leader" />
          <text x="96" y="266" class="el-micro">{b.wall.marks.last}</text>

          {/* Ratio marks at the end of each pass. */}
          {b.wall.ladder.map((rung: any, i: number) => (
            <text
              x={FLOW_MARKS[i].x}
              y={FLOW_MARKS[i].y}
              text-anchor={FLOW_MARKS[i].anchor}
              class="el-micro el-micro--strong"
            >{rung.ratio}</text>
          ))}

          {/* Pitch comb, reused as the scale bar. */}
          {FLOW_SCALE.map((x: any) => <line x1={x} y1="284" x2={x} y2="292" class="el-tick" />)}
          <line x1="90" y1="292" x2="610" y2="292" class="el-rule" />
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
        <p class="el-figcap t-fine">{b.wall.caption}</p>
      </figure>
    </div>

    <div class="shell--wide">
      <div class="el-ladder">
        <p class="el-ladder__cols t-label">
          <span>{b.wall.colRatio}</span><span>{b.wall.colVerdict}</span>
        </p>
        <ol>
          {b.wall.ladder.map((rung: any) => (
            <li>
              <span class="t-mono el-ladder__r">{rung.ratio}</span>
              <span>{rung.verdict}</span>
            </li>
          ))}
        </ol>
      </div>
      <p class="el-close">{b.wall.close}</p>
    </div>
  </section>

  {/* ═══ 03 · THE WELD LINE MAP ═════════════════════════════════════════ */}
  <section class="el-sec el-weld" id="el-weld">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.weld.index} · {b.weld.kicker}</p>
        <h2 class="el-h2">{b.weld.heading}</h2>
        <p class="el-head__body">{b.weld.body}</p>
      </div>

      <div class="el-weld__pair" data-reveal>
        {/* CASE A — the fronts meet under the latch root. */}
        <figure class="el-case">
          <p class="el-case__tag t-label">{b.weld.cases[0].tag}</p>
          <svg viewBox="0 0 340 240" data-nomirror role="img" aria-label={common.schematic}>
            <rect x="30" y="30" width="280" height="170" class="el-plan" />
            <rect x="44" y="44" width="252" height="142" class="el-plan-in" />
            <rect x="140" y="30" width="60" height="28" class="el-zone" />
            <circle cx="100" cy="130" r="16" class="el-plan-core" />
            <circle cx="240" cy="130" r="16" class="el-plan-core" />

            <rect x="38" y="124" width="12" height="12" class="el-gate" />
            <rect x="290" y="124" width="12" height="12" class="el-gate" />

            <path d="M170 58 V200" class="el-weldline" />
            <path d="M170 30 V58" class="el-weldline el-weldline--hot" />
            <path d="M116 130 H154" class="el-weldline" />
            <path d="M224 130 H186" class="el-weldline" />

            <text x="40" y="112" class="el-micro">{b.weld.marks.gate}</text>
            <text x="206" y="48" class="el-micro">{b.weld.marks.latch}</text>
            <text x="100" y="168" text-anchor="middle" class="el-micro">{b.weld.marks.core}</text>
            <text x="176" y="222" class="el-micro">{b.weld.marks.weld}</text>
          </svg>
          <h3 class="el-case__h">{b.weld.cases[0].title}</h3>
          <p class="el-case__note">{b.weld.cases[0].note}</p>
        </figure>

        {/* CASE B — one gate at the base; the seams fall in plain wall. */}
        <figure class="el-case el-case--fix">
          <p class="el-case__tag t-label">{b.weld.cases[1].tag}</p>
          <svg viewBox="0 0 340 240" data-nomirror role="img" aria-label={common.schematic}>
            <rect x="30" y="30" width="280" height="170" class="el-plan" />
            <rect x="44" y="44" width="252" height="142" class="el-plan-in" />
            <rect x="140" y="30" width="60" height="28" class="el-zone" />
            <circle cx="100" cy="130" r="16" class="el-plan-core" />
            <circle cx="240" cy="130" r="16" class="el-plan-core" />

            <rect x="164" y="194" width="12" height="12" class="el-gate" />

            <path d="M92 116 L70 88" class="el-weldline" />
            <path d="M248 116 L270 88" class="el-weldline" />

            {/* Last to fill moves to the two top corners. */}
            <path d="M44 62 V44 H62" class="el-corner" />
            <path d="M296 62 V44 H278" class="el-corner" />

            <text x="178" y="216" class="el-micro">{b.weld.marks.gate}</text>
            <text x="206" y="48" class="el-micro">{b.weld.marks.latch}</text>
            <text x="100" y="168" text-anchor="middle" class="el-micro">{b.weld.marks.core}</text>
            <text x="64" y="80" text-anchor="end" class="el-micro">{b.weld.marks.weld}</text>
          </svg>
          <h3 class="el-case__h">{b.weld.cases[1].title}</h3>
          <p class="el-case__note">{b.weld.cases[1].note}</p>
        </figure>

        <figcaption class="figure-note el-weld__cap">{b.weld.caption}</figcaption>
      </div>

      <div class="el-levers">
        <h3 class="el-h5">{b.weld.leversHeading}</h3>
        <ol class="el-levers__list">
          {b.weld.levers.map((lever: string, i: number) => (
            <li><span class="t-mono">{String(i + 1).padStart(2, '0')}</span>{lever}</li>
          ))}
        </ol>
      </div>

      <p class="el-close">{b.weld.close}</p>
    </div>
  </section>

  {/* ═══ 04 · INSERT MOULDING — four stepped states ═════════════════════ */}
  <section class="el-sec el-ins" id="el-insert" data-stepper data-step="0">
    <div class="shell--wide el-head">
      <p class="eyebrow">{b.insert.index} · {b.insert.kicker}</p>
      <h2 class="el-h2">{b.insert.heading}</h2>
      <p class="el-head__body">{b.insert.body}</p>
    </div>

    <div class="shell--wide el-ins__grid">
      <figure class="el-ins__fig">
        <svg viewBox="0 0 860 250" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="el-hatch-ins" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="8" class="el-hatch" />
            </pattern>
            <marker id="el-arw-ins" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {[0, 1, 2, 3].map((f: any) => (
            <g transform={`translate(${f * 220} 0)`} class="el-frame" data-frame={f}>
              {/* Core — fixed in every frame. */}
              <path d={INS_CORE} fill="url(#el-hatch-ins)" class="el-steel" />

              {/* Cavity — raised while the tool is open. */}
              <g transform={f === 0 || f === 3 ? 'translate(0 -46)' : 'translate(0 0)'}>
                <path d={INS_CAVITY} fill="url(#el-hatch-ins)" class="el-steel" />
              </g>

              {/* Moulded polymer, from the shot onward. */}
              {(f === 2 || f === 3) && (
                <g transform={f === 3 ? 'translate(0 -34)' : 'translate(0 0)'}>
                  <rect x="70" y="93" width="23" height="52" class="el-poly" />
                  <rect x="107" y="93" width="23" height="52" class="el-poly" />
                </g>
              )}

              {/* The terminal persists across all four frames. */}
              <rect
                x="93" y="93" width="14" height="82"
                class="el-metal"
                transform={f === 3 ? 'translate(0 -34)' : 'translate(0 0)'}
              />

              {/* Shut-off contact, marked only at close. */}
              {f === 1 && (
                <>
                  <line x1="84" y1="93" x2="93" y2="93" class="el-shut" />
                  <line x1="107" y1="93" x2="116" y2="93" class="el-shut" />
                </>
              )}

              {/* Melt entering. */}
              {f === 2 && (
                <>
                  <line x1="40" y1="119" x2="68" y2="119" class="el-dim" marker-end="url(#el-arw-ins)" />
                  <text x="36" y="115" text-anchor="end" class="el-micro">{b.insert.marks.melt}</text>
                </>
              )}

              {/* Ejection. */}
              {f === 3 && (
                <>
                  <line x1="80" y1="215" x2="80" y2="115" class="el-dim" marker-end="url(#el-arw-ins)" />
                  <line x1="120" y1="215" x2="120" y2="115" class="el-dim" marker-end="url(#el-arw-ins)" />
                  <text x="100" y="240" text-anchor="middle" class="el-micro">{b.insert.marks.eject}</text>
                </>
              )}

              {f === 0 && (
                <>
                  <circle cx="150" cy="70" r="2.6" class="el-dot" />
                  <path d="M150 70 L166 118" class="el-leader" />
                  <text x="170" y="122" class="el-micro">{b.insert.marks.cavity}</text>
                  <path d="M100 218 V230" class="el-leader" />
                  <text x="100" y="242" text-anchor="middle" class="el-micro">{b.insert.marks.core}</text>
                </>
              )}

              <text x="100" y="14" text-anchor="middle" class="el-micro el-micro--strong">
                {String(f + 1).padStart(2, '0')}
              </text>
            </g>
          ))}
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
        <p class="el-figcap t-fine">{b.insert.caption}</p>
      </figure>

      <ol class="el-ins__steps">
        {b.insert.stages.map((stage: any, i: number) => (
          <li class="el-ins__step" data-station-step={i}>
            <span class="t-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3>{stage.label}</h3>
            <p>{stage.note}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="shell--wide">
      <p class="el-close">{b.insert.close}</p>
      <p class="el-caveat">{b.insert.boundaryNote}</p>
    </div>
  </section>

  {/* ═══ 05 · THE MATERIAL TABLE ════════════════════════════════════════ */}
  <section class="el-sec el-resin" id="el-resin">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.resin.index} · {b.resin.kicker}</p>
        <h2 class="el-h2">{b.resin.heading}</h2>
        <p class="el-head__body">{b.resin.body}</p>
      </div>

      <div class="el-table__scroll">
        <table class="el-table">
          <thead>
            <tr>{b.resin.columns.map((col: string) => <th scope="col">{col}</th>)}</tr>
          </thead>
          <tbody>
            {b.resin.rows.map((row: any) => (
              <tr>
                <th scope="row" class="t-mono el-table__grade">{row.grade}</th>
                <td class="t-mono el-table__num">{row.shrink}</td>
                <td class="el-table__use">{row.use}</td>
                <td class="el-table__con">{row.consequence}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="el-caveat">{b.resin.note}</p>
      <p class="el-close">{b.resin.close}</p>
    </div>
  </section>

  {/* ═══ 06 · PITCH, MAGNIFIED ══════════════════════════════════════════ */}
  <section class="el-sec el-pitch" id="el-pitch">
    <div class="shell--wide">
      <div class="el-head">
        <p class="eyebrow">{b.pitch.index} · {b.pitch.kicker}</p>
        <h2 class="el-h2">{b.pitch.heading}</h2>
        <p class="el-head__body">{b.pitch.body}</p>
      </div>

      <figure class="el-mag" data-reveal>
        <svg viewBox="0 0 700 400" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="el-hatch-mag" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="9" class="el-hatch" />
            </pattern>
            <marker id="el-arw-mag" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 1 L9 5 L0 9" class="el-arwhead" />
            </marker>
          </defs>

          {/* Main view: two adjacent ways. */}
