---
/**
 * HOME APPLIANCES — chapter.
 *
 * Large format. Few elements per screen, each very large, the scale itself
 * doing the arguing. Everything is drawn as an architect draws an elevation:
 * orthographic, hairline, no perspective, no shading.
 *
 * The signature motif is THE DIMENSIONED GAP — a hairline dimension line with
 * fine arrow terminators bracketing a tiny distance between two very large
 * panels, with a mono numeral sitting in the break of the line. It appears at
 * three scales: the hero, the section dividers, and the full-width gap band.
 *
 * The spine: what is actually moulded → wall against flow → why the panel bows
 * → what the buyer is judged on → what the machine is asked for → which tool →
 * one tool one plant → where our scope stops.
 */
import IndustryMark from '../IndustryMark.astro';
import TechNote from '../TechNote.astro';
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;
const publicProcessNotes = new Set([0, 3, 4, 5]);
const showUnsupportedPressRanges = false;
const showUnsupportedCycleBreakdown = false;

/* ── 01 · exploded elevation ──────────────────────────────────────────────
   Six layers of a refrigerator door, separated along one horizontal axis.
   Centres are fixed; the stepper adds the separation. */
const LAYER_CX = [46, 116, 186, 256, 326, 396];

/* ── 02 · flow band ───────────────────────────────────────────────────────
   One panel, three nominal walls. Flow length scales with wall at a constant
   L/T, so the fill zone per gate widens and the gate count falls. */
const FX0 = 110;
const FX1 = 1352;
const FW = FX1 - FX0;
const FLOW = (b.flow.lanes as any[]).map((lane: any, i: number) => {
  const n = Number(lane.gates);
  return { lane, n, zone: FW / n, y: 96 + i * 90, t: 10 + i * 5, i };
});

/* ── 04 · tolerance stack ─────────────────────────────────────────────────
   Four contributors laid end to end. Widths are relative only: the argument is
   that the sum is longer than any one of them, not what any of them measures. */
const STACK_W = [74, 96, 62, 86];
const STACK_X0 = 120;
const STACK_TOTAL = STACK_W.reduce((a, n) => a + n, 0);
---

{/* ═══ HERO — STACKED ═══════════════════════════════════════════════════════
    The chapter opens on a saturated bed of its own accent. The statement runs
    the full width of the page across the top; the panel is drawn full-bleed
    beneath it, at a scale no side column could ever have held. That is the
    argument of this vertical made as a composition: the part is large. */}
<header class="app-hero ground--tint mat mat--milled" data-tex="mesh">

  {/* The hero's own terminator. A marker's contents take their tokens from
      where the marker is DEFINED, not from where it is used — so the arrow
      that sits on the tint bed has to be defined on the tint bed. The shared
      sheet for the rest of the chapter stays on the light ground below. */}
  <svg class="app-defs" aria-hidden="true" focusable="false" data-nomirror>
    <defs>
      <marker id="app-arw-tint" viewBox="0 0 10 10" refX="9.4" refY="5"
        markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 1.9 L10 5 L0 8.1 z" class="app-arwhead" />
      </marker>
    </defs>
  </svg>

  {/* The masthead runs the full width and is ruled off — the chapter opens
      like a drawing sheet, not like a card. */}
  <div class="shell--wide app-hero__inner">
    <div class="app-hero__mast">
      <div class="app-hero__stamp" aria-hidden="true">
        <IndustryMark industry="appliances" />
      </div>
      <p class="eyebrow">{content.hero.kicker}</p>
    </div>

    <h1 class="app-hero__head">
      {content.hero.headline.map((line: string, i: number) => (
        <span style={`--l:${i}`}>{line}</span>
      ))}
    </h1>

    {/* The lead sits under the statement, not in a column beside it. The
        verified capability sits beside the lead, set to be read. */}
    <div class="app-hero__under">
      <p class="app-hero__lead">{content.hero.lead}</p>
      {content.hero.markers && (
        <ul class="badges app-hero__markers">
          {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
        </ul>
      )}
    </div>
  </div>

  {/* Full bleed. The drawing is wider than the measure ever was. */}
  <figure class="app-hero__fig" data-reveal>
    <svg viewBox="0 0 1200 505" data-nomirror role="img" aria-label={common.schematic}>
      {/* Cabinet outline */}
      <rect x="20" y="20" width="1160" height="400" class="app-ln app-ln--faint" />
      {/* Two door panels, and the gap between them */}
      <rect x="32" y="32" width="560" height="376" class="app-ln" />
      <rect x="608" y="32" width="560" height="376" class="app-ln" />
      {/* Handles */}
      <path d="M552 96 v250 M648 96 v250" class="app-ln app-ln--thin" />
      {/* Shelf lines, so the panel reads as an appliance and not a rectangle */}
      <path d="M32 150 h560 M608 150 h560 M32 268 h560 M608 268 h560" class="app-ln app-ln--faint" />
      {/* Centre line */}
      <path d="M600 0 v505" class="app-cl" />

      <g class="app-dimgrp">
        {/* The gap: extension lines, dimension line broken for the numeral */}
        <path d="M592 226 v-58 M608 226 v-58" class="app-ext" />
        <path d="M380 196 h90" class="app-ln app-dim" style="--len:100" />
        <path d="M530 196 h58" class="app-ln app-dim" style="--len:70" marker-end="url(#app-arw-tint)" />
        <path d="M770 196 h-158" class="app-ln app-dim" style="--len:180" marker-end="url(#app-arw-tint)" />
        <text x="500" y="201" text-anchor="middle" class="app-num">{b.heroFig.gapValue}</text>
        <text x="366" y="201" text-anchor="end" class="app-micro">{b.heroFig.gapLabel}</text>

        {/* The span, at the other extreme of scale */}
        <path d="M20 424 v44 M1180 424 v44" class="app-ext" />
        <path d="M20 452 h520" class="app-ln app-dim" style="--len:540" marker-start="url(#app-arw-tint)" />
        <path d="M1180 452 h-520" class="app-ln app-dim" style="--len:540" marker-start="url(#app-arw-tint)" />
        <text x="600" y="457" text-anchor="middle" class="app-num">{b.heroFig.spanValue}</text>
        <text x="600" y="488" text-anchor="middle" class="app-micro">{b.heroFig.spanLabel}</text>
      </g>
    </svg>
    <figcaption class="figure-note">
      <span>{common.schematic}</span>
      <span class="app-hero__capnote">{b.heroFig.note}</span>
    </figcaption>
  </figure>
</header>

<article class="app">

  {/* Shared drawing defs for every band below the hero. They live here, on the
      chapter's own light ground, because a marker, a pattern and a gradient
      all resolve `var(--…)` where they are defined. Inside the tinted hero
      they would have taken the inverse token set and painted every arrowhead,
      hatch fill and thermal gradient near-white on a near-white page. */}
  <svg class="app-defs" aria-hidden="true" focusable="false" data-nomirror>
    <defs>
      <marker id="app-arw" viewBox="0 0 10 10" refX="9.4" refY="5"
        markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 1.9 L10 5 L0 8.1 z" class="app-arwhead" />
      </marker>
      <marker id="app-arw-a" viewBox="0 0 10 10" refX="9.4" refY="5"
        markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 1.9 L10 5 L0 8.1 z" class="app-arwhead app-arwhead--a" />
      </marker>
      <pattern id="app-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="9" class="app-hatchline" />
      </pattern>
      <linearGradient id="app-thermal" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="var(--accent)" />
        <stop offset="45%" stop-color="var(--accent)" />
        <stop offset="100%" stop-color="var(--signal)" />
      </linearGradient>
    </defs>
  </svg>

  {/* ═══ 01 · WHAT IS ACTUALLY MOULDED ════════════════════════════════════ */}
  <section class="app-proc" id="process" data-stepper>
    <div class="shell--wide app-proc__head">
      <p class="eyebrow">{b.process.index} · {b.process.kicker}</p>
      <h2 class="app-h2">{b.process.heading}</h2>
      <p class="t-lead app-proc__lead">{b.process.body}</p>
    </div>

    <div class="shell--wide app-proc__grid">
      <figure class="app-proc__fig">
        <p class="t-label app-proc__figlabel">{b.process.figHeading}</p>
        <svg viewBox="0 0 490 370" data-nomirror role="img" aria-label={common.schematic}>
          {/* Assembly axis */}
          <path d="M14 170 h462" class="app-cl" />

          {LAYER_CX.map((cx: number, i: number) => (
            <g class="app-layer" data-layer={i} style={`--i:${i}`}>
              {i === 0 && (
                <>
                  <path d={`M${cx - 6} 40 h12 v260 h-12 z`} class="app-ln" />
                  <path d={`M${cx - 6} 40 h-16 M${cx - 6} 300 h-16`} class="app-ln app-ln--thin" />
                </>
              )}
              {i === 1 && (
                <>
                  <rect x={cx - 16} y="44" width="32" height="252" class="app-hatchfill" />
                  <rect x={cx - 16} y="44" width="32" height="252" class="app-ln app-ln--thin" />
                </>
              )}
              {i === 2 && (
                <path
                  d={`M${cx + 9} 44 h-14 v40 h-9 v26 h9 v58 h-9 v26 h9 v106 h14`}
                  class="app-ln"
                />
              )}
              {i === 3 && (
                <>
                  <path d={`M${cx + 11} 70 v46 h-22 v-46`} class="app-ln" />
                  <path d={`M${cx + 11} 158 v46 h-22 v-46`} class="app-ln" />
                  <path d={`M${cx + 11} 246 v46 h-22 v-46`} class="app-ln" />
                </>
              )}
              {i === 4 && (
                <>
                  <path d={`M${cx - 7} 70 h14 v170 h-14 z`} class="app-ln" />
                  <path d={`M${cx - 3} 82 h6 v146 h-6 z`} class="app-ln app-ln--thin" />
                  <rect x={cx - 3} y="140" width="6" height="30" class="app-solid" />
                </>
              )}
              {i === 5 && (
                <>
                  <path d={`M${cx - 4} 92 h8 v156 h-8 z`} class="app-ln" />
                  <path d={`M${cx + 4} 92 l12 -12`} class="app-ln app-ln--thin" />
                </>
              )}
              <circle cx={cx} cy="306" r="2" class="app-dot" />
              <path d={`M${cx} 306 v26`} class="app-ln app-ln--thin" />
              <text x={cx} y="348" text-anchor="middle" class="app-micro">{b.process.rows[i].short}</text>
            </g>
          ))}
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <TechNote locale={locale} kind="reasoning">
        <ol class="app-proc__rows">
          {b.process.rows.map((r: any, i: number) => (
            <li class="app-prow" data-station-step={i}>
              <span class="app-prow__i t-mono">{r.index}</span>
              <span class="app-prow__n">{r.name}</span>
              <span class="badge app-prow__p">{r.process}</span>
              {publicProcessNotes.has(i) && <span class="app-prow__note">{r.note}</span>}
            </li>
          ))}
        </ol>
      </TechNote>
    </div>

    <div class="shell--wide app-proc__foot">
      <p class="app-proc__close">{b.process.close}</p>
      <p class="app-proc__src t-fine">{b.process.sourceNote}</p>
    </div>
  </section>

  {/* Divider — the motif at its smallest scale. */}
  <div class="app-div" aria-hidden="true">
    <svg viewBox="0 0 1200 44" data-nomirror>
      <path d="M8 10 v24 M1192 10 v24" class="app-ext" />
      <path d="M8 22 h500" class="app-ln app-dim-static" marker-start="url(#app-arw)" />
      <path d="M1192 22 h-500" class="app-ln app-dim-static" marker-start="url(#app-arw)" />
      <text x="600" y="27" text-anchor="middle" class="app-num">{b.flow.index}</text>
    </svg>
  </div>

  {/* ═══ 02 · WALL AND FLOW — full-bleed band ═════════════════════════════ */}
  <section class="app-flow" id="flow">
    <div class="shell--wide app-flow__head">
      <p class="eyebrow">{b.flow.index} · {b.flow.kicker}</p>
      <h2 class="app-h2">{b.flow.heading}</h2>
      <p class="t-lead app-flow__lead">{b.flow.body}</p>
    </div>

    <figure class="app-flow__fig" data-reveal>
      <p class="t-label app-flow__figlabel">{b.flow.figLabel}</p>
      <div class="scroller app-flow__scroll">
        <svg viewBox="0 0 1440 320" data-nomirror role="img" aria-label={b.flow.figLabel}>
          <text x="96" y="34" text-anchor="end" class="app-micro">{b.flow.wallLabel}</text>
          <text x="1366" y="34" class="app-micro">{b.flow.gatesLabel}</text>

          {FLOW.map((L: any) => (
            <g class="app-lane" style={`--i:${L.i}`}>
              {/* The panel, edge on. Thickness is the nominal wall. */}
              <rect x={FX0} y={L.y - L.t / 2} width={FW} height={L.t} class="app-ln app-panelfill" />

              {/* One fill zone per gate, with its reach bracketed. */}
              {Array.from({ length: L.n }).map((_: any, g: number) => {
                const cx = FX0 + L.zone * (g + 0.5);
                const yr = L.y - L.t / 2 - 26;
                return (
                  <g>
                    <path d={`M${cx} ${yr + 6} v${L.t / 2 + 14}`} class="app-ln app-gate" marker-end="url(#app-arw-a)" />
                    <path
                      d={`M${cx - L.zone / 2 + 7} ${yr} h${L.zone - 14}`}
                      class="app-ln app-reach"
                      marker-start="url(#app-arw)"
                      marker-end="url(#app-arw)"
                    />
                  </g>
                );
              })}

              {/* Weld lines, where two fronts meet. */}
              {Array.from({ length: L.n - 1 }).map((_: any, w: number) => {
                const wx = FX0 + L.zone * (w + 1);
                return <path d={`M${wx} ${L.y - L.t / 2 - 9} v${L.t + 18}`} class="app-weld" />;
              })}

              <text x="96" y={L.y + 5} text-anchor="end" class="app-num app-num--sm">{L.lane.wall}</text>
              <text x="1366" y={L.y + 5} class="app-num app-num--sm">{L.lane.gates}</text>
              {L.i === 0 && (
                <text x="96" y={L.y - L.t / 2 - 22} text-anchor="end" class="app-micro">{b.flow.reachLabel}</text>
              )}
            </g>
          ))}
        </svg>
      </div>
      <figcaption class="figure-note">{common.schematic}</figcaption>
    </figure>

    <div class="shell--wide app-flow__notes">
      {b.flow.lanes.map((lane: any) => (
        <div class="app-flow__note">
          <p class="t-label">{lane.name}</p>
          <p>{lane.note}</p>
        </div>
      ))}
    </div>

    <div class="shell--wide app-flow__weld">
      <h3 class="app-h3">{b.flow.weldHeading}</h3>
      <TechNote locale={locale} kind="detail">
        <p class="app-flow__weldbody">{b.flow.weldBody}</p>
      </TechNote>
      <p class="app-flow__warn">{b.flow.weldWarn}</p>
    </div>

    <div class="shell--wide app-flow__foot">
      <p class="app-flow__boundary">{b.flow.boundaryNote}</p>
      <p class="app-flow__close">{b.flow.close}</p>
      <p class="t-fine app-fine">{b.flow.sourceNote}</p>
    </div>
  </section>

  {/* ═══ 03 · THE WARPAGE STUDY ═══════════════════════════════════════════ */}
  <section class="app-warp" id="warp" data-stepper>
    <div class="shell--wide app-warp__head">
      <p class="eyebrow">{b.warp.index} · {b.warp.kicker}</p>
      <h2 class="app-h2">{b.warp.heading}</h2>
      <p class="t-lead app-warp__lead">{b.warp.body}</p>
    </div>

    <div class="shell--wide app-warp__grid">
      <figure class="app-warp__fig">
        {/* Dense annotation: below the stacking breakpoint the drawing keeps a
            legible minimum width and scrolls inside its own box. */}
        <div class="scroller app-figscroll">
        <svg viewBox="0 0 900 400" data-nomirror role="img" aria-label={common.schematic}>
          {/* The two tool halves */}
          <g class="app-plate">
            <rect x="40" y="10" width="820" height="48" class="app-ln app-ln--faint" />
            <rect x="40" y="88" width="820" height="48" class="app-ln app-ln--faint" />
            <text x="76" y="39" class="app-micro">{b.warp.figLabels.cavity}</text>
            <text x="76" y="117" class="app-micro">{b.warp.figLabels.core}</text>
          </g>

          {/* Temperature marks: cold cavity, warm core. */}
          <g class="app-temp">
            {[220, 450, 680].map((tx: number) => (
              <path d={`M${tx} 22 v14`} class="app-temp--cold" />
            ))}
            {[220, 450, 680].map((tx: number) => (
              <path d={`M${tx} 100 v14`} class="app-temp--warm" />
            ))}
          </g>

          {/* The panel, flat and bowed. Both are drawn; the scroll decides
              which one is the truth. */}
          <path d="M60 58 h780 v30 h-780 z" class="app-ln app-panelfill app-panel--flat" />
          <path d="M60 58 q390 -46 780 0 v30 q-390 -46 -780 0 z" class="app-ln app-panelfill app-panel--bow" />

          {/* Deviation across the span */}
          <g class="app-warp__dev">
            <path d="M60 58 h780" class="app-ref" />
            <path d="M450 58 v-23" class="app-ln app-dim-static" marker-start="url(#app-arw)" marker-end="url(#app-arw)" />
            <text x="466" y="52" class="app-micro">{b.warp.figLabels.bow}</text>
          </g>

          {/* Serpentine cooling circuit */}
          <path
            d="M100 196 h700 v40 h-700 v40 h700 v40 h-700"
            class="app-serp"
          />
          <path d="M60 196 h34" class="app-ln app-ln--thin" marker-end="url(#app-arw-a)" />
          <path d="M100 316 h-40" class="app-ln app-ln--thin" marker-end="url(#app-arw-a)" />
          <text x="52" y="200" text-anchor="end" class="app-micro">{b.warp.figLabels.inlet}</text>
          <text x="52" y="320" text-anchor="end" class="app-micro">{b.warp.figLabels.outlet}</text>

          {/* Deep core with a baffle */}
          <rect x="826" y="190" width="48" height="140" class="app-ln app-ln--thin" />
          <path d="M850 196 v128" class="app-ln app-ln--thin" />
          <path d="M838 200 v112" class="app-ln app-ln--thin" marker-end="url(#app-arw-a)" />
          <path d="M862 312 v-112" class="app-ln app-ln--thin" marker-end="url(#app-arw-a)" />
          <path d="M826 356 h48" class="app-ext" />
        </svg>
        </div>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <ol class="app-warp__steps">
        {b.warp.stages.map((s: any, i: number) => (
          <li class="app-wstep" data-station-step={i}>
            <span class="app-wstep__i t-mono">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="app-wstep__h">{s.label}</h3>
            <p>{s.note}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="shell--wide app-warp__foot">
      <TechNote locale={locale} kind="detail">
        <div class="app-warp__cool">
          <h3 class="app-h4">{b.warp.coolingHeading}</h3>
          <p>{b.warp.coolingBody}</p>
        </div>
      </TechNote>
      <div class="app-warp__closebox">
        <p class="app-warp__close">{b.warp.close}</p>
        <p class="t-fine app-fine">{b.warp.sourceNote}</p>
      </div>
    </div>
  </section>

  {/* Divider */}
  <div class="app-div" aria-hidden="true">
    <svg viewBox="0 0 1200 44" data-nomirror>
      <path d="M8 10 v24 M1192 10 v24" class="app-ext" />
      <path d="M8 22 h500" class="app-ln app-dim-static" marker-start="url(#app-arw)" />
      <path d="M1192 22 h-500" class="app-ln app-dim-static" marker-start="url(#app-arw)" />
      <text x="600" y="27" text-anchor="middle" class="app-num">{b.fit.index}</text>
    </svg>
  </div>

  {/* ═══ 04 · GAP AND FLUSH — the motif at full width ═════════════════════
      The chapter's second and last textured surface: structural mesh, run
      very quiet, so the band reads as panel rather than as page. */}
  <section class="app-fit" id="fit" data-tex="mesh">
    <div class="shell--wide app-fit__head">
      <p class="eyebrow">{b.fit.index} · {b.fit.kicker}</p>
      <h2 class="app-h2 app-fit__h">{b.fit.heading}</h2>
    </div>

    <figure class="app-fit__band" data-reveal>
      <svg viewBox="0 0 1440 260" preserveAspectRatio="xMidYMax meet" data-nomirror role="img" aria-label={common.schematic}>
        <rect x="-40" y="70" width="746" height="230" class="app-ln app-panelfill" />
        <rect x="734" y="70" width="746" height="230" class="app-ln app-panelfill" />
        <path d="M-40 104 h746 M734 104 h746" class="app-ln app-ln--faint" />

        <g class="app-dimgrp">
          <path d="M706 70 v-48 M734 70 v-48" class="app-ext" />
          <path d="M430 44 h130" class="app-ln app-dim" style="--len:140" />
          <path d="M640 44 h62" class="app-ln app-dim" style="--len:70" marker-end="url(#app-arw)" />
          <path d="M1010 44 h-272" class="app-ln app-dim" style="--len:290" marker-end="url(#app-arw)" />
          <text x="600" y="49" text-anchor="middle" class="app-num app-num--lg">{b.fit.gapValue}</text>
        </g>
      </svg>
      <figcaption class="figure-note">
        <span>{common.schematic}</span>
        <span class="app-fit__capnote">{b.fit.gapCaption}</span>
      </figcaption>
    </figure>

    <div class="shell--narrow app-fit__measure">
      <p class="app-fit__lead">{b.fit.body}</p>
    </div>

    <div class="shell--wide app-fit__stack">
      <div class="app-fit__stackhead">
        <h3 class="app-h3">{b.fit.stackHeading}</h3>
        <p>{b.fit.stackBody}</p>
      </div>

      <figure class="app-fit__stackfig" data-reveal>
        <svg viewBox="0 0 1000 300" data-nomirror role="img" aria-label={common.schematic}>
          {/* The opening the stack has to live inside */}
          <rect x="60" y="18" width="880" height="120" class="app-ln" />
          <rect x="96" y="34" width="808" height="88" class="app-ln app-ln--faint" />
          <path d="M96 130 h808" class="app-ln app-ln--thin" />
          <path d="M60 156 h880" class="app-ref" />

          {/* Contributors, laid end to end */}
          {STACK_W.map((w: number, i: number) => {
            const x = STACK_X0 + STACK_W.slice(0, i).reduce((a: any, n: number) => a + n, 0);
            const ly = i % 2 === 0 ? 214 : 232;
            return (
              <g class="app-stackseg" style={`--i:${i}`}>
                <rect x={x} y="182" width={w} height="13" class="app-ln app-panelfill" />
                <path d={`M${x} 176 v25 M${x + w} 176 v25`} class="app-ext" />
                <path d={`M${x + w / 2} 195 v${ly - 205}`} class="app-ln app-ln--thin" />
                <text x={x + w / 2} y={ly} text-anchor="middle" class="app-micro">{b.fit.stackItems[i].short}</text>
              </g>
            );
          })}

          {/* The accumulation */}
          <rect x={STACK_X0} y="256" width={STACK_TOTAL} height="15" class="app-stacktotal" />
          <path d={`M${STACK_X0} 250 v27 M${STACK_X0 + STACK_TOTAL} 250 v27`} class="app-ext" />
          <text x={STACK_X0 + STACK_TOTAL + 16} y="268" class="app-micro">{b.fit.stackTotal}</text>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
