<style>
  /* ═══ Chapter scope ══════════════════════════════════════════════════════
     Architectural. Cool light greys, a calm slate accent, a warm brass signal
     reserved for one meaning only: heat. Everything is hairline and square. */

  .app-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Type ─────────────────────────────────────────────────────────────── */
  .app-h2 {
    font-size: clamp(2rem, 4.6vw, 3.9rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 20ch;
  }
  .app-h3 {
    font-size: var(--step-3);
    line-height: 1.14;
    letter-spacing: var(--track-head);
    max-inline-size: 24ch;
  }
  .app-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); }

  /* ── Drawing conventions ──────────────────────────────────────────────── */
  .app-ln { fill: none; stroke: var(--accent-deep); stroke-width: 1.3; stroke-linejoin: miter; }
  .app-ln--thin { stroke-width: 0.9; }
  .app-ln--faint { stroke: var(--ink-muted); stroke-width: 0.9; opacity: 0.5; }
  .app-panelfill { fill: color-mix(in oklab, var(--accent) 7%, transparent); }
  .app-solid { fill: var(--accent-deep); stroke: none; }
  .app-dot { fill: var(--accent); stroke: none; }
  .app-cl {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 0.8;
    stroke-dasharray: 14 4 2 4;
    opacity: 0.4;
  }
  .app-ext { fill: none; stroke: var(--ink-muted); stroke-width: 0.8; opacity: 0.75; }
  .app-ref { fill: none; stroke: var(--ink-muted); stroke-width: 0.8; stroke-dasharray: 6 5; opacity: 0.65; }
  .app-arwhead { fill: var(--ink-muted); stroke: none; }
  .app-arwhead--a { fill: var(--accent); }
  .app-hatchline { stroke: var(--ink-muted); stroke-width: 0.7; opacity: 0.4; }
  .app-hatchfill { fill: url(#app-hatch); stroke: none; }
  .app-micro {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--ink-muted);
  }
  .app-num {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.04em;
    fill: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }
  .app-num--sm { font-size: 12px; fill: var(--ink-muted); }
  .app-num--lg { font-size: 22px; }

  /* ── Hero — the STACKED opening ─────────────────────────────────────────
     The chapter opens on `ground--tint`, which remaps the entire token set —
     ink, muted ink, rules, accent, signal, buttons, focus ring — so there is
     deliberately no colour declared here and no background of its own.
     `mat--milled` gives the bed a machined finish; `data-tex="mesh"` gives it
     the structural grid of a large panel.

     There is no `padding-block-start` either: the hero is `main > :first-child`
     and the chapter layout clears the overlaid header for it, at zero
     specificity, so the tint runs up behind the header instead of starting
     below it. */
  .app-hero {
    position: relative;
    padding-block-end: clamp(2.5rem, 5vw, 4.5rem);
    overflow: clip;
    --tex-opacity: 0.085;
  }
  /* Both `.mat` and `[data-tex]` promote every direct child to a positioned
     layer. The definitions sheet has to stay out of flow. */
  .app-hero > .app-defs { position: absolute; z-index: 0; }
  /* They also both paint this element's ::before. The chapter's own material
     is the layer that has to survive, and it is not a blended finish. */
  .app-hero::before { mix-blend-mode: normal; }

  .app-hero__inner { position: relative; }

  /* The masthead: mark and kicker on one line, ruled off across the full
     width. A drawing sheet opens with a title block, not with a card. */
  .app-hero__mast {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block-end: clamp(0.9rem, 1.8vw, 1.4rem);
    border-block-end: var(--rule);
  }
  .app-hero__stamp {
    inline-size: clamp(2.75rem, 4.5vw, 4rem);
    color: var(--accent-deep);
    flex: none;
  }
  .app-hero__mast .eyebrow { min-inline-size: 0; }

  /* The statement runs the full width of the chapter. No measure cap: this is
     the one line on the page that is allowed to be the page. */
  .app-hero__head {
    margin-block-start: clamp(1.5rem, 4vw, 3.25rem);
    font-size: clamp(2.55rem, 8vw, 7.1rem);
    line-height: 0.95;
    letter-spacing: var(--track-mega);
    font-weight: 500;
    text-wrap: balance;
    max-inline-size: none;
  }
  :global(html[lang='zh']) .app-hero__head,
  :global(html[lang='th']) .app-hero__head,
  :global(html[lang='ar']) .app-hero__head,
  :global(html[lang='fa']) .app-hero__head,
  :global(html[lang='ur']) .app-hero__head { line-height: 1.16; }
  :global(html[lang='ur']) .app-hero__head { line-height: 1.7; }
  .app-hero__head span { display: block; }
  .app-hero__head span:last-child { color: var(--accent-deep); }

  /* The lead sits under the statement, ruled off from it, with the verified
     capability beside it rather than in a column of its own. */
  .app-hero__under {
    margin-block-start: clamp(1.75rem, 3.6vw, 3rem);
    padding-block-start: clamp(1.1rem, 2.2vw, 1.8rem);
    border-block-start: var(--rule-strong);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) {
    .app-hero__under {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.5rem, 5vw, 2.25rem);
    }
  }
  .app-hero__lead {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
    max-inline-size: 54ch;
  }
  .app-hero__markers { align-content: start; gap: 0.55rem; }
  /* The relief token is measured against a near-white page; on the tint bed
     the badge takes the dark one. */
  .app-hero__markers .badge { box-shadow: var(--relief-dark); }

  /* Full bleed, and wider than the measure ever was. */
  .app-hero__fig {
    position: relative;
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }
  .app-hero__fig svg { display: block; inline-size: 100%; block-size: auto; }
  .app-hero__fig .figure-note {
    inline-size: min(100% - var(--gutter) * 2, var(--shell-wide));
    margin-inline: auto;
    margin-block-start: var(--sp-5);
    padding-block-start: var(--sp-4);
    border-block-start: var(--rule);
    flex-wrap: wrap;
  }
  .app-hero__capnote { text-transform: none; letter-spacing: 0.02em; opacity: 0.85; }

  /* ── A dense drawing on a narrow viewport ───────────────────────────────
     Below the stacking breakpoint the annotation on these two figures is too
     small to read at container width, so they keep a legible minimum and
     scroll inside their own box — never by pushing the page. */
  .app-figscroll { min-inline-size: 0; max-inline-size: 100%; }
  @media (max-width: 1000px) {
    .app-warp__fig .app-figscroll svg { min-inline-size: 40rem; }
    .app-mach__tonfig .app-figscroll svg { min-inline-size: 46rem; }
  }

  /* Dimension lines draw themselves in from their extension lines. */
  .app-dim { stroke: var(--ink-muted); stroke-width: 0.9; }
  .app-dim-static { stroke: var(--ink-muted); stroke-width: 0.9; }
  :global(html.js) .app-hero__fig[data-reveal] .app-dimgrp,
  :global(html.js) .app-fit__band[data-reveal] .app-dimgrp { opacity: 0; }
  :global(html.js) .app-hero__fig[data-reveal] .app-dim,
  :global(html.js) .app-fit__band[data-reveal] .app-dim {
    stroke-dasharray: var(--len, 400);
    stroke-dashoffset: var(--len, 400);
  }
  :global(html.js) .app-hero__fig[data-reveal='in'] .app-dimgrp,
  :global(html.js) .app-fit__band[data-reveal='in'] .app-dimgrp {
    opacity: 1;
    transition: opacity var(--dur-4) var(--ease-out) 200ms;
  }
  :global(html.js) .app-hero__fig[data-reveal='in'] .app-dim,
  :global(html.js) .app-fit__band[data-reveal='in'] .app-dim {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1000ms var(--ease-out) 260ms;
  }

  /* ── Divider: the motif at its smallest scale ─────────────────────────── */
  .app-div {
    inline-size: min(100% - var(--gutter) * 2, var(--shell-wide));
    margin-inline: auto;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }
  .app-div svg { inline-size: 100%; block-size: auto; }

  /* ── 01 · What is actually moulded ────────────────────────────────────── */
  .app-proc { padding-block: var(--section-y); border-block-start: var(--rule); }
  .app-proc__lead { margin-block-start: var(--sp-6); max-inline-size: 58ch; }

  .app-proc__grid {
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .app-proc__grid { grid-template-columns: minmax(0, 1fr); } }

  .app-proc__fig {
    position: sticky;
    inset-block-start: clamp(5rem, 12vh, 7.5rem);
  }
  @media (max-width: 1000px) { .app-proc__fig { position: static; } }
  .app-proc__figlabel { display: block; margin-block-end: var(--sp-4); }
  .app-proc__fig svg { inline-size: 100%; block-size: auto; }
  .app-proc__fig .figure-note { margin-block-start: var(--sp-4); }

  .app-layer {
    opacity: 0.32;
    transform: translateX(calc((var(--i) * var(--sep, 0) * 1px) * var(--dir)));
    transition: opacity var(--dur-4) var(--ease-out), transform var(--dur-6) var(--ease-out);
  }
  .app-proc[data-step='1'] { --sep: 2; }
  .app-proc[data-step='2'] { --sep: 4; }
  .app-proc[data-step='3'] { --sep: 7; }
  .app-proc[data-step='4'] { --sep: 10; }
  .app-proc[data-step='5'] { --sep: 12; }
  .app-proc:not([data-step]) .app-layer { opacity: 1; }
  .app-proc[data-step='0'] .app-layer[data-layer='0'],
  .app-proc[data-step='1'] .app-layer[data-layer='1'],
  .app-proc[data-step='2'] .app-layer[data-layer='2'],
  .app-proc[data-step='3'] .app-layer[data-layer='3'],
  .app-proc[data-step='4'] .app-layer[data-layer='4'],
  .app-proc[data-step='5'] .app-layer[data-layer='5'] { opacity: 1; }

  .app-proc__rows { border-block-start: var(--rule-strong); }
  .app-prow {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) minmax(0, 14rem);
    gap: var(--sp-3) var(--sp-5);
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
    border-block-end: var(--rule);
    align-items: baseline;
    opacity: 0.56;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .app-proc:not([data-step]) .app-prow { opacity: 1; }
  .app-proc[data-step='0'] .app-prow[data-station-step='0'],
  .app-proc[data-step='1'] .app-prow[data-station-step='1'],
  .app-proc[data-step='2'] .app-prow[data-station-step='2'],
  .app-proc[data-step='3'] .app-prow[data-station-step='3'],
  .app-proc[data-step='4'] .app-prow[data-station-step='4'],
  .app-proc[data-step='5'] .app-prow[data-station-step='5'] { opacity: 1; }
  @media (max-width: 1000px) {
    .app-prow { grid-template-columns: 2.5rem minmax(0, 1fr); opacity: 1; }
    .app-prow__p { grid-column: 2; }
  }
  .app-prow__i { font-size: var(--step--1); color: var(--accent-deep); }
  .app-prow__n { font-size: var(--step-1); letter-spacing: var(--track-head); }
  /* Which of the four processes a row is, is verified capability and the
     whole argument of the section — so it is a badge, not a tracked-out
     11px strip that a buyer reads as build metadata and skips. */
  .app-prow__p {
    justify-self: end;
    align-self: baseline;
    min-inline-size: 0;
    overflow-wrap: break-word;
  }
  @media (max-width: 1000px) { .app-prow__p { justify-self: start; } }
  .app-prow__note {
    grid-column: 2 / -1;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
    max-inline-size: 62ch;
  }
  @media (max-width: 1000px) { .app-prow__note { grid-column: 2; } }

  .app-proc__foot { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .app-proc__close {
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 60ch;
    padding-inline-start: var(--sp-6);
    border-inline-start: var(--hair-strong) solid var(--accent);
  }
  .app-proc__src { margin-block-start: var(--sp-5); max-inline-size: 60ch; }

  /* ── 02 · Wall and flow — the full-bleed band ─────────────────────────── */
  .app-flow {
    padding-block: var(--section-y);
    background: var(--surface-sunk);
    border-block: var(--rule);
  }
  .app-flow__lead { margin-block-start: var(--sp-6); max-inline-size: 58ch; }

  .app-flow__fig { margin-block-start: clamp(2.5rem, 6vw, 5rem); }
  .app-flow__figlabel {
    display: block;
    inline-size: min(100% - var(--gutter) * 2, var(--shell-wide));
    margin-inline: auto;
    margin-block-end: var(--sp-5);
  }
  .app-flow__scroll { overflow-x: auto; contain: paint; min-inline-size: 0; max-inline-size: 100%; padding-inline: var(--gutter); }
  .app-flow__fig svg { inline-size: 100%; min-inline-size: 44rem; block-size: auto; }
  .app-flow__fig .figure-note {
    inline-size: min(100% - var(--gutter) * 2, var(--shell-wide));
    margin-inline: auto;
    margin-block-start: var(--sp-4);
  }

  .app-panel--flat, .app-panel--bow { transition: opacity var(--dur-5) var(--ease-out); }
  .app-gate { stroke: var(--accent); stroke-width: 1.2; }
  .app-reach { stroke: var(--ink-muted); stroke-width: 0.8; }
  .app-weld {
    fill: none;
    stroke: var(--signal);
    stroke-width: 1.1;
    stroke-dasharray: 5 3;
  }

  .app-flow__notes {
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    border-block-start: var(--rule-strong);
  }
  @media (max-width: 1000px) { .app-flow__notes { grid-template-columns: minmax(0, 1fr); } }
  .app-flow__note {
    padding-block: var(--sp-5) var(--sp-6);
    padding-inline: var(--col-pad) var(--sp-6);
    border-inline-end: var(--rule);
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }
  .app-flow__note:first-child { padding-inline-start: 0; }
  .app-flow__note:last-child { border-inline-end: 0; }
  @media (max-width: 1000px) {
    .app-flow__note { border-inline-end: 0; border-block-end: var(--rule); padding-inline: 0; }
  }
  .app-flow__note p:last-child {
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
  }

  .app-flow__weld {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .app-flow__weld { grid-template-columns: minmax(0, 1fr); } }
  .app-flow__weldbody { font-size: var(--step-0); line-height: 1.62; max-inline-size: 62ch; }
  .app-flow__warn {
    grid-column: 2;
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 58ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: var(--hair-strong) solid var(--signal);
  }
  @media (max-width: 1000px) { .app-flow__warn { grid-column: 1; } }

  .app-flow__foot { margin-block-start: clamp(2.5rem, 5vw, 4rem); display: grid; gap: var(--sp-6); }
  .app-flow__boundary {
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-muted);
    max-inline-size: 70ch;
  }
  .app-flow__close {
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 60ch;
    padding-inline-start: var(--sp-6);
    border-inline-start: var(--hair-strong) solid var(--accent);
  }

  /* ── 03 · The warpage study ───────────────────────────────────────────── */
  .app-warp { padding-block: var(--section-y-loose); }
  .app-warp__lead { margin-block-start: var(--sp-6); max-inline-size: 58ch; }

  .app-warp__grid {
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .app-warp__grid { grid-template-columns: minmax(0, 1fr); } }
  .app-warp__fig {
    position: sticky;
    inset-block-start: clamp(5rem, 12vh, 7.5rem);
  }
  @media (max-width: 1000px) { .app-warp__fig { position: static; } }
  .app-warp__fig svg { inline-size: 100%; block-size: auto; }
  .app-warp__fig .figure-note { margin-block-start: var(--sp-4); }

  .app-plate { transition: opacity var(--dur-5) var(--ease-out); }
  .app-temp { opacity: 0; transition: opacity var(--dur-5) var(--ease-out); }
  .app-temp--cold { stroke: var(--accent); stroke-width: 2.4; }
  .app-temp--warm { stroke: var(--signal); stroke-width: 2.4; }
  .app-panel--bow { opacity: 0.14; }
  .app-warp__dev { opacity: 0; transition: opacity var(--dur-5) var(--ease-out); }
  .app-serp {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    transition: stroke var(--dur-5) var(--ease-out);
  }
  .app-warp[data-step='1'] .app-serp,
  .app-warp[data-step='2'] .app-serp { stroke: url(#app-thermal); }
  .app-warp[data-step='1'] .app-temp,
  .app-warp[data-step='2'] .app-temp { opacity: 1; }
  .app-warp[data-step='2'] .app-panel--flat { opacity: 0.12; }
  .app-warp[data-step='2'] .app-panel--bow { opacity: 1; }
  .app-warp[data-step='2'] .app-plate { opacity: 0.3; }
  .app-warp[data-step='2'] .app-warp__dev { opacity: 1; }
  .app-warp:not([data-step]) .app-temp,
  .app-warp:not([data-step]) .app-warp__dev { opacity: 1; }
  .app-warp:not([data-step]) .app-panel--bow { opacity: 0.5; }

  .app-warp__steps { display: grid; border-block-start: var(--rule-strong); }
  .app-wstep {
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block-end: var(--rule);
    display: grid;
    gap: var(--sp-3);
    opacity: 0.5;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .app-warp:not([data-step]) .app-wstep { opacity: 1; }
  .app-warp[data-step='0'] .app-wstep[data-station-step='0'],
  .app-warp[data-step='1'] .app-wstep[data-station-step='1'],
  .app-warp[data-step='2'] .app-wstep[data-station-step='2'] { opacity: 1; }
  @media (max-width: 1000px) { .app-wstep { opacity: 1; } }
  .app-wstep__i { font-size: var(--step--2); letter-spacing: 0.14em; color: var(--accent-deep); }
  .app-wstep__h { font-size: var(--step-2); letter-spacing: var(--track-head); }
  .app-wstep p { font-size: var(--step--1); line-height: 1.62; color: var(--ink-muted); }

  .app-warp__foot {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .app-warp__foot { grid-template-columns: minmax(0, 1fr); } }
  .app-warp__cool p {
    margin-block-start: var(--sp-4);
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-muted);
    max-inline-size: 58ch;
  }
  .app-warp__close {
    font-size: var(--step-0);
    line-height: 1.62;
    max-inline-size: 60ch;
    padding-inline-start: var(--sp-6);
    border-inline-start: var(--hair-strong) solid var(--accent);
  }
  .app-warp__closebox .t-fine { margin-block-start: var(--sp-5); max-inline-size: 58ch; }

  /* ── 04 · Gap and flush ─────────────────────────────────────────────────
     The chapter's second and last textured surface. Run at roughly half the
     mesh default: on a near-white sunk band the grid has to be felt as panel
     rather than seen as graph paper. */
  .app-fit {
    padding-block: var(--section-y);
    background: var(--surface-sunk);
    border-block: var(--rule);
    overflow: clip;
    --tex-opacity: 0.045;
  }
  .app-fit__h { max-inline-size: 17ch; }

  .app-fit__band { margin-block-start: clamp(2.5rem, 6vw, 5rem); }
  .app-fit__band svg { inline-size: 100%; block-size: auto; }
  .app-fit__band .figure-note {
    inline-size: min(100% - var(--gutter) * 2, var(--shell-wide));
    margin-inline: auto;
    margin-block-start: var(--sp-4);
    flex-wrap: wrap;
  }
  .app-fit__capnote { text-transform: none; letter-spacing: 0.02em; opacity: 0.85; }

  .app-fit__measure { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .app-fit__lead {
    font-size: var(--step-1);
    line-height: 1.55;
    max-inline-size: 52ch;
  }

  .app-fit__stack { margin-block-start: clamp(3rem, 7vw, 6rem); }
  .app-fit__stackhead p {
    margin-block-start: var(--sp-5);
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 62ch;
  }
  .app-fit__stackfig { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .app-fit__stackfig svg { inline-size: 100%; block-size: auto; }
  .app-fit__stackfig .figure-note { margin-block-start: var(--sp-4); }
  .app-stacktotal { fill: color-mix(in oklab, var(--accent) 26%, transparent); stroke: var(--accent-deep); stroke-width: 1.2; }

  /* Two real columns, then a real stack. `auto-fit` put four contributors in
     four 253px slivers at 1100px and only widened them below 1000px, which is
     the responsive curve upside down. Two columns hold their measure at every
     width the grid exists at, and the grid stops existing at 1000px. */
  .app-fit__items {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    border-block-start: var(--rule-strong);
  }
  .app-fit__item {
    padding-block: var(--sp-5) var(--sp-6);
    padding-inline: var(--col-pad) var(--sp-5);
    border-inline-end: var(--rule);
    display: grid;
    gap: var(--sp-2);
    align-content: start;
  }
  /* The divider sits between the pair; the item that starts a row drops its
     leading gutter so the grid stays flush with the shell, and the second row
     gets the rule the container only gives the first. */
  .app-fit__item:nth-child(2n) { border-inline-end: 0; }
  .app-fit__item:nth-child(2n + 1) { padding-inline-start: 0; }
  .app-fit__item:nth-child(n + 3) { border-block-start: var(--rule); }
  @media (max-width: 1000px) {
    .app-fit__items { grid-template-columns: minmax(0, 1fr); }
    .app-fit__item { border-inline-end: 0; padding-inline: 0; }
    .app-fit__item:nth-child(n + 2) { border-block-start: var(--rule); }
  }
  .app-fit__item dt { font-size: var(--step-0); font-weight: var(--weight-medium); }
  .app-fit__item dd { font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); max-inline-size: 52ch; }

  .app-fit__foot { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .app-fit__fails { display: grid; border-block-start: var(--rule); }
  .app-fit__fails li {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }
  @media (max-width: 1000px) { .app-fit__fails li { grid-template-columns: minmax(0, 1fr); } }
  .app-fit__close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 60ch;
    padding-inline-start: var(--sp-6);
    border-inline-start: var(--hair-strong) solid var(--accent);
  }

  /* ── 05 · Tonnage and cycle ───────────────────────────────────────────── */
  .app-mach { padding-block: var(--section-y); }
  .app-mach__lead { margin-block-start: var(--sp-6); max-inline-size: 60ch; }

  .app-mach__ton {
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
  }
  @media (max-width: 1000px) { .app-mach__ton { grid-template-columns: minmax(0, 1fr); align-items: start; } }
  .app-mach__tonfig svg { inline-size: 100%; block-size: auto; }
  .app-mach__tonfig .figure-note { margin-block-start: var(--sp-4); }
  .app-clamp { stroke: var(--accent); }
  .app-band { fill: none; stroke-width: 3; }
  .app-band--a { stroke: color-mix(in oklab, var(--ink-muted) 60%, transparent); }
  .app-band--b { stroke: var(--accent); }

  /* Press class as a capability module: the class is the value, the parts it
     covers are the qualification under it. Two bands stack rather than share
     a track, so a long class never breaks across three lines. */
  .app-mach__caps { margin-block-start: var(--sp-5); grid-template-columns: minmax(0, 1fr); }
  .app-mach__caps .cap[data-band='1'] .cap__v { color: var(--accent-deep); }

  .app-mach__deflect {
    margin-block-start: clamp(3rem, 6vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .app-mach__deflect { grid-template-columns: minmax(0, 1fr); } }
  .app-mach__deflect p {
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 62ch;
  }

  .app-mach__cycle { margin-block-start: clamp(3rem, 7vw, 6rem); }
  .app-bar { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .app-bar__name {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    align-items: baseline;
    margin-block-end: var(--sp-3);
  }
    /* `.t-label` is already --ink-muted, which sits close to the readability
     floor; a 0.7 multiplier on top of it takes it under. Colour, not opacity. */
  .app-bar__unit { color: var(--ink-muted); }
  .app-bar__track {
    display: flex;
    block-size: clamp(2.4rem, 4vw, 3.4rem);
    border: var(--rule);
    background: var(--surface-raise);
  }
  .app-bar__seg {
    flex: 0 0 calc(var(--w) * 1%);
    padding-inline-start: var(--col-pad);
