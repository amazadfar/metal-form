---
/**
 * MARINE & OFFSHORE — the forensic chapter.
 *
 * Structure: a narrative in four movements. A worn part ARRIVES with no
 * drawing; it is MEASURED; it is MODELLED; it is TOOLED. Every section carries
 * a tag saying which movement it belongs to, and section 03 runs all four as
 * discrete states of one continuous drawing.
 *
 * Signature motif: THE DUAL OUTLINE. The sample as found is drawn in a soft,
 * irregular stroke; the recovered nominal is drawn over it as a precise dashed
 * line; measurement points mark where the two are reconciled and drop to a
 * datum. Every figure on the page uses that one convention.
 *
 * The commercial argument is inverted against the rest of the book: this is the
 * chapter that argues for LESS tool, honestly sized, and earns its credibility
 * by naming its own limits in a full section rather than in small print.
 */
import type { Locale } from '../../i18n/locales.ts';
import TechNote from '../TechNote.astro';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;

/* ── Hero: a skin fitting in elevation, as it arrives ─────────────────────── */
const H_NOM_HEAD = 'M186 236 Q360 176 534 236 L534 258 L186 258 Z';
const H_NOM_TUBE = 'M300 258 L300 348 L420 348 L420 258';
const H_WORN_HEAD = 'M182 241 Q356 176 528 230 L537 240 L520 236 L533 261 L184 258 Z';
const H_WORN_TUBE = 'M298 261 L297 352 L422 350 L419 259';
const H_CRACK = 'M302 257 l-9 10 l6 6 l-8 10';
const H_PTS = [
  { x: 186, y: 258 },
  { x: 300, y: 348 },
  { x: 420, y: 348 },
  { x: 534, y: 258 },
];
const H_MARKS = [
  { x: 300, y: 258 },
  { x: 420, y: 258 },
  { x: 360, y: 206 },
];

/* ── Sequence: the same fitting in section, four states ───────────────────── */
const S_NOM_L = 'M240 170 L396 170 L396 360 L352 360 L352 218 Q352 200 334 200 L240 200 Z';
const S_NOM_R = 'M640 170 L484 170 L484 360 L528 360 L528 218 Q528 200 546 200 L640 200 Z';
const S_WORN_L = 'M238 174 L250 186 L264 172 L394 168 L399 361 L350 363 L355 203 L241 199 Z';
const S_WORN_R = 'M642 172 L486 169 L481 362 L530 361 L525 202 L639 200 Z';
const S_CRACK = 'M352 200 l-10 12 l7 6 l-10 11';
const S_PTS = [
  { x: 240, y: 200 },
  { x: 352, y: 200 },
  { x: 396, y: 360 },
  { x: 484, y: 360 },
  { x: 528, y: 200 },
  { x: 640, y: 200 },
];

/* ── Section 02: the junction that cracks, magnified ──────────────────────── */
const J_NOM = 'M40 60 L300 60 L300 300 L200 300 L200 130 Q200 100 170 100 L40 100 Z';
const J_WORN = 'M38 63 L296 57 L303 302 L198 304 L203 101 L39 98 Z';
const J_CRACK = 'M200 100 l-16 14 l11 8 l-15 12';
const J_PTS = [
  { x: 40, y: 60 }, { x: 300, y: 60 }, { x: 300, y: 300 },
  { x: 200, y: 300 }, { x: 200, y: 130 }, { x: 170, y: 100 },
];

/* ── Section 01: the chain of custody, read backwards ─────────────────────── */
const CHAIN_X = [24, 196, 368, 540, 712];

/* ── Section 06: where each volume band sits on the capital curve ─────────── */
const PLOT_DOTS = [
  { x: 120, y: 228 },
  { x: 232, y: 198 },
  { x: 344, y: 160 },
  { x: 472, y: 98 },
];
---

<article class="mar">

  {/* ═══ HERO — STACKED · the statement, then the sheet ═════════════════
      The chapter opens on steel: the ground class carries ink, rules, accent,
      signal, focus and buttons, so nothing here restates a colour. The swell
      is the sector's own material and sits on the hero and on one other
      surface only. ═══════════════════════════════════════════════════════ */}
  <header class="mar-hero ground--steel mat mat--milled" data-tex="wave">
    <div class="mar-hero__bleed" aria-hidden="true">
      <svg viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid slice" data-nomirror>
        <defs>
          <linearGradient id="mar-sky" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.11" />
            <stop offset="58%" stop-color="var(--accent)" stop-opacity="0.025" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect width="1400" height="700" fill="url(#mar-sky)" />
        {Array.from({ length: 8 }).map((_: any, i: number) => (
          <line x1="0" y1={96 + i * 74} x2="1400" y2={96 + i * 74} class="mar-survey" />
        ))}
      </svg>
    </div>

    {/* The statement runs the full width of the chapter, not down one column. */}
    <div class="shell--wide mar-hero__top">
      <p class="eyebrow">{content.hero.kicker}</p>
      <h1 class="mar-hero__head">
        {content.hero.headline.map((line: string, i: number) => (
          <span style={`--l:${i}`}>{line}</span>
        ))}
      </h1>
      <div class="mar-hero__under">
        <p class="mar-hero__lead">{content.hero.lead}</p>
        {content.hero.markers && (
          <ul class="badges mar-hero__markers">
            {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
          </ul>
        )}
      </div>
    </div>

    {/* The sheet, full-bleed and wider than any text column on the page. The
        datum runs off both edges: the part is measured against the page. */}
    <figure class="mar-hero__fig" data-reveal>
      <div class="mar-hero__plate">
        <svg viewBox="0 124 1080 288" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <marker id="mar-hero-arrow" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0.5 1 L9 5 L0.5 9" class="mar-head" />
            </marker>
          </defs>

          {/* the datum, run past the part in both directions */}
          <line x1="0" y1="372" x2="1080" y2="372" class="mar-datum" />
          <line x1="348" y1="364" x2="348" y2="380" class="mar-datum" />
          <line x1="732" y1="364" x2="732" y2="380" class="mar-datum" />
          <text x="348" y="392" class="mar-micro">{b.opening.figure.datumStart}</text>
          <text x="732" y="392" text-anchor="end" class="mar-micro">{b.opening.figure.datumEnd}</text>

          <g transform="translate(180 0)">
            {/* centre line */}
            <line x1="360" y1="136" x2="360" y2="392" class="mar-cl" />

            {/* overall dimension, unknown until it is recovered */}
            <g class="mar-dimgroup">
              <line x1="186" y1="232" x2="186" y2="146" class="mar-ext" />
              <line x1="534" y1="232" x2="534" y2="146" class="mar-ext" />
              <line x1="186" y1="152" x2="534" y2="152" class="mar-dim"
                marker-start="url(#mar-hero-arrow)" marker-end="url(#mar-hero-arrow)" />
              <text x="360" y="142" text-anchor="middle" class="mar-micro">{b.opening.figure.dim}</text>
            </g>

            {/* the sample, as found */}
            <g class="mar-hero__worn">
              <path d={H_WORN_HEAD} class="mar-worn" />
              <path d={H_WORN_TUBE} class="mar-worn" />
              <path d={H_CRACK} class="mar-crack" />
            </g>

            {/* the recovered nominal, drawn over it */}
            <g class="mar-hero__nom">
              <path d={H_NOM_HEAD} class="mar-nom" />
              <path d={H_NOM_TUBE} class="mar-nom" />
              {Array.from({ length: 5 }).map((_: any, i: number) => (
                <line x1="300" y1={278 + i * 15} x2="420" y2={272 + i * 15} class="mar-thread" />
              ))}
            </g>

            {/* measurement points dropping to the datum */}
            <g class="mar-hero__pts">
              {H_PTS.map((p: any, i: number) => (
                <g style={`--i:${i}`} class="mar-drop">
                  <line x1={p.x} y1={p.y} x2={p.x} y2="372" class="mar-lead" />
                  <line x1={p.x} y1="366" x2={p.x} y2="378" class="mar-tick" />
                  <circle cx={p.x} cy={p.y} r="3" class="mar-pt" />
                </g>
              ))}
              {H_MARKS.map((p: any, i: number) => (
                <circle cx={p.x} cy={p.y} r="3" class="mar-pt mar-drop" style={`--i:${i + 4}`} />
              ))}
            </g>
          </g>
        </svg>
      </div>

      <figcaption class="shell--wide mar-hero__figmeta">
        <div class="mar-legend">
          <p class="t-label mar-legend__h">{b.opening.legendHeading}</p>
          <ul>
            {b.opening.legend.map((item: any) => (
              <li>
                <span class:list={['mar-legend__sw', `mar-legend__sw--${item.key}`]} aria-hidden="true"></span>
                {item.label}
              </li>
            ))}
          </ul>
        </div>
        <p class="figure-note">{common.schematic}</p>
      </figcaption>
    </figure>

    <div class="shell--wide">
      <nav class="mar-mvs" aria-label={b.opening.movementsLabel}>
        <p class="t-label mar-mvs__h">{b.opening.movementsLabel}</p>
        <ol>
          {b.opening.movements.map((m: any, i: number) => (
            <li style={`--i:${i}`}><span class="t-mono">{m.num}</span>{m.label}</li>
          ))}
        </ol>
      </nav>
    </div>
  </header>

  {/* ═══ 01 · ARRIVAL ═══════════════════════════════════════════════════ */}
  <section class="mar-sec mar-arr" id="arrival">
    <div class="shell--wide">
      <p class="mar-mv"><span class="mar-mv__bar" aria-hidden="true"></span>{b.arrival.movement}</p>
      <div class="mar-head">
        <p class="eyebrow">{b.arrival.index} · {b.arrival.kicker}</p>
        <h2 class="mar-h2">{b.arrival.heading}</h2>
        <p class="t-lead mar-head__lead">{b.arrival.body}</p>
      </div>

      <figure class="mar-fig" data-reveal>
        <p class="t-label mar-fig__cap">{b.arrival.chainHeading}</p>
        <svg viewBox="0 0 880 220" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <marker id="mar-chain-arrow" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="8" markerHeight="8" orient="auto-start-reverse">
              <path d="M0.5 1 L9 5 L0.5 9" class="mar-head" />
            </marker>
          </defs>

          {b.arrival.chain.map((node: any, i: number) => (
            <g class:list={['mar-node', i === 4 && 'mar-node--alive']} style={`--i:${i}`}>
              <rect x={CHAIN_X[i]} y="44" width="132" height="56" class="mar-node__box" />
              {i < 4 && (
                <line x1={CHAIN_X[i] + 18} y1="88" x2={CHAIN_X[i] + 114} y2="56" class="mar-node__strike" />
              )}
              <text x={CHAIN_X[i] + 66} y="77" text-anchor="middle" class="mar-micro mar-node__t">{node.label}</text>
              {i < 4 && (
                <line x1={CHAIN_X[i] + 138} y1="72" x2={CHAIN_X[i] + 190} y2="72"
                  class="mar-node__link" marker-end="url(#mar-chain-arrow)" />
              )}
            </g>
          ))}

          <path d="M778 108 C778 172 660 182 430 182 C200 182 90 172 90 112"
            class="mar-return" marker-end="url(#mar-chain-arrow)" />
          <text x="430" y="206" text-anchor="middle" class="mar-micro mar-return__t">{b.arrival.chainReturn}</text>
        </svg>
        <p class="mar-fig__note t-fine">{b.arrival.chainNote}</p>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <div class="mar-arr__grid">
        <dl class="mar-terms">
          {b.arrival.chain.map((node: any) => (
            <div><dt class="t-mono">{node.label}</dt><dd>{node.note}</dd></div>
          ))}
        </dl>

        <div class="mar-arr__side">
          <div class="mar-term">
            <p class="t-label">{b.arrival.term.name}</p>
            <p>{b.arrival.term.meaning}</p>
          </div>
          <h3 class="mar-h4">{b.arrival.survivesHeading}</h3>
          <dl class="mar-survive">
            {b.arrival.survives.map((item: any) => (
              <div><dt>{item.name}</dt><dd>{item.note}</dd></div>
            ))}
          </dl>
        </div>
      </div>

      <TechNote locale={locale} kind="detail">
        <div class="mar-ip">
          <h3 class="mar-h4">{b.arrival.ipHeading}</h3>
          <ul class="mar-ticks">
            {b.arrival.ip.map((item: string) => <li>{item}</li>)}
          </ul>
        </div>
      </TechNote>
    </div>
  </section>

  {/* ═══ 02 · MEASUREMENT ═══════════════════════════════════════════════ */}
  <section class="mar-sec mar-meas" id="measurement">
    <div class="shell--wide">
      <p class="mar-mv"><span class="mar-mv__bar" aria-hidden="true"></span>{b.measurement.movement}</p>
      <div class="mar-head">
        <p class="eyebrow">{b.measurement.index} · {b.measurement.kicker}</p>
        <h2 class="mar-h2">{b.measurement.heading}</h2>
        <p class="t-lead mar-head__lead">{b.measurement.body}</p>
      </div>

      <TechNote locale={locale} kind="reasoning">
        <div class="mar-meas__grid">
          <figure class="mar-fig mar-fig--tall" data-reveal>
            <p class="t-label mar-fig__cap">{b.measurement.figureCaption}</p>
            <svg viewBox="0 0 520 350" data-nomirror role="img" aria-label={common.schematic}>
              <path d={J_WORN} class="mar-worn" />
              <path d={J_CRACK} class="mar-crack" />
              <path d={J_NOM} class="mar-nom" />
              {J_PTS.map((p: any, i: number) => (
                <circle cx={p.x} cy={p.y} r="3" class="mar-pt mar-drop" style={`--i:${i}`} />
              ))}
              {/* radius leader with a dot at the anchor */}
              <circle cx="176" cy="112" r="2.2" class="mar-anchor" />
              <line x1="176" y1="112" x2="112" y2="160" class="mar-leader" />
              <text x="106" y="164" text-anchor="end" class="mar-micro">{b.measurement.figureLabels.radius}</text>
              {/* datum */}
              <line x1="200" y1="300" x2="200" y2="326" class="mar-lead" />
              <line x1="300" y1="300" x2="300" y2="326" class="mar-lead" />
              <line x1="24" y1="326" x2="496" y2="326" class="mar-datum" />
            </svg>
            <ul class="mar-legend__inline">
              <li><span class="mar-legend__sw mar-legend__sw--worn" aria-hidden="true"></span>{b.measurement.figureLabels.worn}</li>
              <li><span class="mar-legend__sw mar-legend__sw--nominal" aria-hidden="true"></span>{b.measurement.figureLabels.nominal}</li>
            </ul>
            <figcaption class="figure-note">{common.schematic}</figcaption>
          </figure>
  
          <div class="mar-methods">
            <h3 class="mar-h4">{b.measurement.methodsHeading}</h3>
            <ol>
              {b.measurement.methods.map((m: string, i: number) => (
                <li><span class="t-mono">{String(i + 1).padStart(2, '0')}</span><p>{m}</p></li>
              ))}
            </ol>
          </div>
        </div>
      </TechNote>

      <p class="t-label mar-tbl__cap">{b.measurement.tableCaption}</p>
      <TechNote locale={locale} kind="reasoning">
        <div class="mar-tbl__scroll">
          <table class="mar-tbl">
            <thead>
              <tr>
                {b.measurement.columns.map((col: string) => <th scope="col">{col}</th>)}
              </tr>
            </thead>
            <tbody>
              {b.measurement.rows.map((row: any) => (
                <tr>
                  <th scope="row">{row.shows}</th>
                  <td class="mar-tbl__is">{row.is}</td>
                  <td>{row.means}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </TechNote>

      <TechNote locale={locale} kind="reasoning">
        <div class="mar-caveat">
          <h3 class="mar-h4">{b.measurement.caveatHeading}</h3>
          <p>{b.measurement.caveat}</p>
        </div>
      </TechNote>
    </div>
  </section>

  {/* ═══ 03 · THE SEQUENCE — four states of one drawing ═════════════════ */}
  <section class="mar-sec mar-seq" id="sequence" data-stepper data-step="0">
    <div class="shell--wide">
      <p class="mar-mv"><span class="mar-mv__bar" aria-hidden="true"></span>{b.sequence.movement}</p>
      <div class="mar-head">
        <p class="eyebrow">{b.sequence.index} · {b.sequence.kicker}</p>
        <h2 class="mar-h2">{b.sequence.heading}</h2>
        <p class="t-lead mar-head__lead">{b.sequence.body}</p>
      </div>
    </div>

    <div class="shell--wide mar-seq__grid">
      <div class="mar-seq__figwrap">
      <figure class="mar-seq__fig">
        <svg viewBox="0 0 880 480" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="mar-seq-hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="9" class="mar-hatchline" />
            </pattern>
            <pattern id="mar-seq-core" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
              <line x1="0" y1="0" x2="0" y2="5" class="mar-hatchline" />
            </pattern>
            <marker id="mar-seq-arrow" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0.5 1 L9 5 L0.5 9" class="mar-head" />
            </marker>
          </defs>

          {/* ── state 3 · the tool ── */}
          <g class="mar-g mar-g--tool">
            <rect x="140" y="76" width="600" height="124" class="mar-steel" fill="url(#mar-seq-hatch)" />
            <rect x="140" y="200" width="600" height="204" class="mar-steel" fill="url(#mar-seq-hatch)" />
            <path d={S_NOM_L} class="mar-void" />
            <path d={S_NOM_R} class="mar-void" />
            <rect x="396" y="170" width="88" height="234" class="mar-steel" fill="url(#mar-seq-core)" />
            <line x1="112" y1="200" x2="768" y2="200" class="mar-parting" />
            <line x1="150" y1="200" x2="222" y2="200" class="mar-runner" />
            <path d="M222 200 L240 193 L240 207 Z" class="mar-gate" />
            <line x1="640" y1="170" x2="640" y2="200" class="mar-weld" />
            <line x1="300" y1="392" x2="300" y2="210" class="mar-eject" marker-end="url(#mar-seq-arrow)" />
            <line x1="580" y1="392" x2="580" y2="210" class="mar-eject" marker-end="url(#mar-seq-arrow)" />
            <text x="150" y="112" class="mar-micro">{b.sequence.figureLabels.cavity}</text>
            <text x="150" y="330" class="mar-micro">{b.sequence.figureLabels.core}</text>
            <text x="150" y="188" class="mar-micro">{b.sequence.figureLabels.gate}</text>
            <text x="652" y="188" class="mar-micro">{b.sequence.figureLabels.weld}</text>
          </g>

          {/* ── state 0 · as found ── */}
          <g class="mar-g mar-g--worn">
            <path d={S_WORN_L} class="mar-worn" />
            <path d={S_WORN_R} class="mar-worn" />
            <path d={S_CRACK} class="mar-crack" />
            <text x="150" y="162" class="mar-micro">{b.sequence.figureLabels.found}</text>
          </g>

          {/* ── state 1 · measured ── */}
          <g class="mar-g mar-g--meas">
            {/* the other samples, offset — the disagreement is the wear */}
            <g class="mar-ghost" transform="translate(-6 4)">
              <path d={S_WORN_L} class="mar-worn" />
              <path d={S_WORN_R} class="mar-worn" />
            </g>
            <g class="mar-ghost" transform="translate(5 -3)">
              <path d={S_WORN_L} class="mar-worn" />
              <path d={S_WORN_R} class="mar-worn" />
            </g>

            <line x1="440" y1="112" x2="440" y2="440" class="mar-cl" />
            <line x1="150" y1="400" x2="730" y2="400" class="mar-datum" />

            {S_PTS.map((p: any, i: number) => (
              <g class="mar-drop" style={`--i:${i}`}>
                <line x1={p.x} y1={p.y} x2={p.x} y2="400" class="mar-lead" />
                <line x1={p.x} y1="394" x2={p.x} y2="406" class="mar-tick" />
                <circle cx={p.x} cy={p.y} r="3" class="mar-pt" />
              </g>
            ))}

            {/* datum feature symbol on the seating face */}
            <path d="M300 200 L292 213 L308 213 Z" class="mar-datum-sym" />
            <line x1="300" y1="213" x2="300" y2="226" class="mar-datum-sym" />
            <rect x="286" y="226" width="28" height="20" class="mar-datum-box" />
            <text x="300" y="240" text-anchor="middle" class="mar-micro">{b.sequence.figureLabels.datum}</text>

            {/* overall and bore dimensions */}
            <line x1="240" y1="166" x2="240" y2="126" class="mar-ext" />
            <line x1="640" y1="166" x2="640" y2="126" class="mar-ext" />
            <line x1="240" y1="132" x2="640" y2="132" class="mar-dim"
              marker-start="url(#mar-seq-arrow)" marker-end="url(#mar-seq-arrow)" />
            <line x1="396" y1="364" x2="396" y2="438" class="mar-ext" />
            <line x1="484" y1="364" x2="484" y2="438" class="mar-ext" />
            <line x1="396" y1="432" x2="484" y2="432" class="mar-dim"
              marker-start="url(#mar-seq-arrow)" marker-end="url(#mar-seq-arrow)" />
          </g>

          {/* ── state 2 · modelled ── */}
          <g class="mar-g mar-g--nom">
            <path d={S_NOM_L} class="mar-nom" />
            <path d={S_NOM_R} class="mar-nom" />
            <circle cx="340" cy="209" r="2.2" class="mar-anchor" />
            <line x1="340" y1="209" x2="286" y2="262" class="mar-leader" />
            <text x="280" y="266" text-anchor="end" class="mar-micro">{b.sequence.figureLabels.radius}</text>
            <text x="656" y="162" class="mar-micro">{b.sequence.figureLabels.nominal}</text>
          </g>
        </svg>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
      </div>

      <ol class="mar-seq__steps">
        {b.sequence.stations.map((st: any, i: number) => (
