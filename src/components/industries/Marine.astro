<style>
  /* ═══ Marine chapter scope ══════════════════════════════════════════════
     Salt-bleached ground, harbour navy ink, one teal instrument colour.
     Every figure obeys one drawing convention: the sample as found in a soft
     irregular stroke, the recovered nominal precise and dashed over it, and a
     measurement point wherever the two are reconciled. */
  /* The layout puts the header clearance on `main > :first-child`, which in
     this chapter is the article rather than the hero. It is taken off here and
     put on the hero instead, so the steel ground runs up behind the bar rather
     than starting below it on a strip of near-white page. The class is doubled
     so it outranks the layout rule whatever scoping strategy is in force. */
  .mar.mar { --mar-refract: 3px; padding-block-start: 0; }

  .mar-h2 {
    font-size: clamp(1.85rem, 3.9vw, 3.1rem);
    line-height: 1.07;
    letter-spacing: -0.026em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 20ch;
  }
  .mar-h3 { font-size: var(--step-2); letter-spacing: var(--track-head); line-height: 1.2; max-inline-size: 26ch; }
  .mar-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); line-height: 1.25; }

  /* ── The drawing language, shared by every figure on the page ─────────── */
  .mar-worn {
    fill: none;
    stroke: var(--ink-muted);
    stroke-width: 2.1;
    stroke-linejoin: round;
    stroke-linecap: round;
    opacity: 0.62;
  }
  .mar-crack { fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; opacity: 0.8; }
  .mar-nom {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 8 3.5;
    stroke-linejoin: miter;
  }
  .mar-nom--faint { opacity: 0.42; stroke-width: 1; }
  .mar-nom--wet { stroke: var(--signal); opacity: 0.85; }
  .mar-thread { stroke: var(--accent); stroke-width: 0.8; opacity: 0.5; }
  .mar-pt { fill: var(--signal); stroke: var(--surface); stroke-width: 1.2; }
  .mar-anchor { fill: var(--accent); }
  .mar-leader { stroke: var(--accent); stroke-width: 0.7; }
  .mar-lead { stroke: var(--accent); stroke-width: 0.6; opacity: 0.55; }
  .mar-tick { stroke: var(--accent); stroke-width: 1.1; }
  .mar-datum { stroke: var(--accent); stroke-width: 1.2; }
  .mar-datum-sym { fill: var(--accent); stroke: var(--accent); stroke-width: 1; }
  .mar-datum-box { fill: none; stroke: var(--accent); stroke-width: 1; }
  .mar-cl { stroke: var(--accent); stroke-width: 0.7; stroke-dasharray: 12 3 2 3; opacity: 0.55; }
  .mar-ext { stroke: var(--ink-muted); stroke-width: 0.6; opacity: 0.6; }
  .mar-dim { stroke: var(--ink-muted); stroke-width: 0.9; }
  .mar-head { fill: none; stroke: var(--ink-muted); stroke-width: 1.2; }
  .mar-hatchline { stroke: var(--ink-muted); stroke-width: 0.7; opacity: 0.42; }
  .mar-steel { stroke: var(--ink-muted); stroke-width: 0.9; }
  .mar-void { fill: var(--surface-raise); stroke: none; }
  .mar-parting { stroke: var(--ink); stroke-width: 1.3; }
  .mar-runner { stroke: var(--signal); stroke-width: 2.4; stroke-linecap: round; }
  .mar-gate { fill: var(--signal); stroke: none; }
  .mar-weld { stroke: var(--signal); stroke-width: 2.6; stroke-dasharray: 3 3; }
  .mar-eject { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 5 4; }
  .mar-micro {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--ink-muted);
  }
  .mar-micro--wet { fill: var(--signal); }
  .mar-micro--band { fill: var(--accent); }
  :global(html[lang='zh']) .mar-micro,
  :global(html[lang='th']) .mar-micro,
  :global(html[lang='ar']) .mar-micro,
  :global(html[lang='fa']) .mar-micro,
  :global(html[lang='ur']) .mar-micro {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: 12px;
  }

  /* Measurement points settle in rather than appear. */
  @keyframes mar-settle { from { opacity: 0; transform: translateY(-9px); } to { opacity: 1; transform: none; } }
  :global(html.js) [data-reveal='in'] .mar-drop {
    animation: mar-settle 520ms var(--ease-out) both;
    animation-delay: calc(180ms + var(--i) * 70ms);
  }

  /* ── Movement tag: the page announcing which act it is in ─────────────── */
  .mar-mv {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--accent-deep);
  }
  :global(html[lang='zh']) .mar-mv,
  :global(html[lang='th']) .mar-mv,
  :global(html[lang='ar']) .mar-mv,
  :global(html[lang='fa']) .mar-mv,
  :global(html[lang='ur']) .mar-mv {
    font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--step--1);
  }
  .mar-mv__bar { inline-size: var(--sp-8); block-size: var(--hair-strong); background: var(--accent); flex: none; }

  .mar-sec { padding-block: var(--section-y) var(--section-y-loose); border-block-start: var(--rule); }
  .mar-head { max-inline-size: 74ch; margin-block-start: var(--sp-6); }
  .mar-head .eyebrow { margin-block-end: var(--sp-2); }
  .mar-head__lead { margin-block-start: var(--sp-5); max-inline-size: 62ch; }

  /* ── Hero — STACKED ────────────────────────────────────────────────────
     The statement runs the full width of the chapter and the sheet sits
     full-bleed under it. No colour is set here: `ground--steel` on the header
     has already remapped ink, rules, accent, signal, focus and the buttons. */
  .mar-hero {
    position: relative;
    /* The layout's clearance value, moved off the article and onto the ground
       that has to sit behind the header. */
    padding-block-start: calc(4.25rem + clamp(2rem, 5vw, 4rem));
    padding-block-end: clamp(3rem, 8vw, 6.5rem);
    overflow: clip;
    --tex-opacity: 0.085;
  }
  /* `.mat--milled` (base.css) and `[data-tex]` (chapters.css) both own the
     ::before layer, and the swell is this chapter's material, so it takes it.
     The milled sizing and blend are released rather than tiling the swell into
     a 140px stamp. Doubled class so the reset lands whatever the scoping. */
  .mar-hero.mar-hero::before { background-size: auto; mix-blend-mode: normal; }

  .mar-hero__bleed { position: absolute; inset: 0; pointer-events: none; }
  .mar-hero__bleed svg { inline-size: 100%; block-size: 100%; }
  .mar-survey { stroke: var(--accent); stroke-width: 0.8; opacity: 0.14; }

  .mar-hero__top { position: relative; }

  .mar-hero__head {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2.2rem, 5.6vw, 4.9rem);
    line-height: 1.0;
    letter-spacing: -0.032em;
    font-weight: 500;
    text-wrap: balance;
  }
  .mar-hero__head span { display: block; }
  .mar-hero__head span:last-child { color: var(--accent-deep); }
  :global(html[lang='zh']) .mar-hero__head,
  :global(html[lang='th']) .mar-hero__head,
  :global(html[lang='ar']) .mar-hero__head,
  :global(html[lang='fa']) .mar-hero__head,
  :global(html[lang='ur']) .mar-hero__head {
    line-height: 1.2;
    letter-spacing: 0;
  }

  /* The lead sits under the statement, alongside the verified capability
     rather than in a column of its own. */
  .mar-hero__under {
    margin-block-start: clamp(1.5rem, 3.5vw, 2.75rem);
    padding-block-start: clamp(1.25rem, 2.5vw, 2rem);
    border-block-start: var(--rule);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) {
    .mar-hero__under { grid-template-columns: minmax(0, 1fr); gap: clamp(1.5rem, 6vw, 2.5rem); }
  }
  .mar-hero__lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 58ch;
  }
  .mar-hero__markers { align-content: start; }
  /* The badge carries its own border and mark; on steel it needs the dark
     relief rather than the light one. */
  .mar-hero .badge { box-shadow: var(--relief-dark); }

  /* The sheet. Wider than any text column on the page: at full width the
     drawing runs the whole chapter, and on a narrow viewport it holds a
     legible size and the surplus datum is cropped symmetrically rather than
     being allowed to push the page sideways. */
  .mar-hero__fig { margin-block-start: clamp(2rem, 5vw, 3.75rem); }
  .mar-hero__plate {
    overflow: clip;
    display: grid;
    justify-items: center;
    min-inline-size: 0;
    max-inline-size: 100%;
  }
  .mar-hero__plate svg {
    display: block;
    inline-size: 100%;
    /* Below this the drawing would be too small to read, so it holds its size
       and the surplus datum is cropped evenly at both edges instead. */
    min-inline-size: 52rem;
    block-size: auto;
  }
  .mar-hero__figmeta {
    margin-block-start: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-7);
  }
  .mar-hero__figmeta .figure-note { margin-block-start: 0; }

  .mar-legend__h { display: block; margin-block-end: var(--sp-3); }
  .mar-legend ul { display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-6); }
  .mar-legend li,
  .mar-legend__inline li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
  .mar-legend__inline { display: flex; flex-wrap: wrap; gap: var(--sp-5); margin-block-start: var(--sp-4); }
  .mar-legend__sw { inline-size: 1.6rem; block-size: 0; flex: none; }
  .mar-legend__sw--worn { border-block-start: 2.4px solid color-mix(in oklab, var(--ink-muted) 65%, transparent); }
  .mar-legend__sw--nominal { border-block-start: 1.6px dashed var(--accent); }
  .mar-legend__sw--point {
    block-size: 0.55rem; inline-size: 0.55rem;
    background: var(--signal);
    border-radius: 50%;
    border-block-start: 0;
  }

  .mar-mvs { margin-block-start: clamp(2.5rem, 6vw, 4.5rem); padding-block-start: var(--sp-6); border-block-start: var(--rule-strong); }
  .mar-mvs__h { display: block; margin-block-end: var(--sp-4); }
  .mar-mvs ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0;
  }
  .mar-mvs li {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-3) var(--sp-6);
    padding-inline-end: var(--sp-5);
    padding-inline-start: var(--col-pad);
    border-inline-end: var(--rule);
    font-size: var(--step--1);
    line-height: 1.4;
  }
  .mar-mvs li:first-child { padding-inline-start: 0; }
  .mar-mvs li:last-child { border-inline-end: 0; }
  .mar-mvs li span { font-size: var(--step--2); letter-spacing: 0.18em; color: var(--accent-deep); }
  @media (max-width: 700px) { .mar-mvs li { border-inline-end: 0; border-block-end: var(--rule); padding-block: var(--sp-3); } }

  /* ── Figures ──────────────────────────────────────────────────────────── */
  .mar-fig {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    background: var(--surface-raise);
    border: var(--rule);
    padding: var(--sp-6) var(--sp-6) var(--sp-10);
  }
  .mar-fig svg { inline-size: 100%; block-size: auto; display: block; }
  .mar-fig__cap { display: block; margin-block-end: var(--sp-5); }
  .mar-fig__note { margin-block-start: var(--sp-5); max-inline-size: 56ch; }
  .mar-fig .figure-note { margin-block-start: var(--sp-5); }
  .mar-fig--tall { margin-block-start: 0; }

  /* ── 01 Arrival ───────────────────────────────────────────────────────── */
  .mar-node__box { fill: none; stroke: var(--ink-muted); stroke-width: 1.1; stroke-dasharray: 6 4; opacity: 0.55; }
  .mar-node__strike { stroke: var(--ink-muted); stroke-width: 1; opacity: 0.45; }
  .mar-node__t { opacity: 0.6; }
  .mar-node__link { stroke: var(--ink-muted); stroke-width: 0.9; opacity: 0.5; }
  .mar-node--alive .mar-node__box { stroke: var(--accent); stroke-dasharray: none; stroke-width: 1.6; opacity: 1; fill: var(--accent-wash); }
  .mar-node--alive .mar-node__t { opacity: 1; fill: var(--accent-deep); }
  .mar-return { fill: none; stroke: var(--signal); stroke-width: 1.6; }
  .mar-return__t { fill: var(--signal); }

  .mar-arr__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .mar-arr__grid { grid-template-columns: minmax(0, 1fr); } }

  .mar-terms { border-block-start: var(--rule-strong); }
  .mar-terms > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: baseline;
  }
  @media (max-width: 560px) { .mar-terms > div { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; } }
  .mar-terms dt { font-size: var(--step--2); letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent-deep); }
  .mar-terms dd { font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }

  .mar-arr__side { display: grid; gap: var(--sp-6); align-content: start; }
  .mar-term {
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
  }
  .mar-term p:last-child { margin-block-start: var(--sp-3); font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); max-inline-size: 48ch; }

  .mar-survive { border-block-start: var(--rule); }
  .mar-survive > div { padding-block: var(--sp-4); border-block-end: var(--rule); display: grid; gap: 0.3rem; }
  .mar-survive dt { font-size: var(--step-0); font-weight: var(--weight-medium); }
  .mar-survive dd { font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }

  .mar-ip { margin-block-start: clamp(2.5rem, 5vw, 4rem); padding-block-start: var(--sp-6); border-block-start: var(--rule); }

  .mar-ticks { margin-block-start: var(--sp-5); display: grid; gap: var(--sp-4); }
  .mar-ticks--two {
    grid-template-columns: repeat(auto-fit, minmax(min(21rem, 100%), 1fr));
    gap: var(--sp-4) clamp(1.5rem, 4vw, 3.5rem);
  }
  .mar-ticks li {
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    padding-inline-start: var(--sp-5);
    position: relative;
    max-inline-size: 62ch;
  }
  .mar-ticks li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.72em;
    inline-size: 0.7rem;
    block-size: var(--hair-strong);
    background: var(--accent);
  }

  /* ── 02 Measurement ───────────────────────────────────────────────────── */
  .mar-meas__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .mar-meas__grid { grid-template-columns: minmax(0, 1fr); } }

  .mar-methods ol { margin-block-start: var(--sp-5); border-block-start: var(--rule-strong); }
  .mar-methods li {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: baseline;
  }
  .mar-methods li span { font-size: var(--step--2); letter-spacing: 0.16em; color: var(--accent-deep); }
  .mar-methods li p { font-size: var(--step--1); line-height: 1.62; color: var(--ink-muted); }

  .mar-tbl__cap { display: block; margin-block: clamp(2.5rem, 5vw, 4rem) var(--sp-4); }
  .mar-tbl__scroll { overflow-x: auto; contain: paint; min-inline-size: 0; max-inline-size: 100%; }
  .mar-tbl { inline-size: 100%; min-inline-size: 46rem; border-collapse: collapse; font-size: var(--step--1); }
  .mar-tbl th, .mar-tbl td { text-align: start; vertical-align: top; }
  .mar-tbl thead th {
    padding-block: 0 var(--sp-4);
    padding-inline: 0 var(--sp-5);
    border-block-end: var(--rule-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-weight: var(--weight-regular);
  }
  :global(html[lang='zh']) .mar-tbl thead th,
  :global(html[lang='th']) .mar-tbl thead th,
  :global(html[lang='ar']) .mar-tbl thead th,
  :global(html[lang='fa']) .mar-tbl thead th,
  :global(html[lang='ur']) .mar-tbl thead th {
    font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--step--1);
  }
  .mar-tbl tbody th {
    padding-block: var(--sp-4);
    padding-inline: 0 var(--sp-5);
    border-block-end: var(--rule);
    font-weight: var(--weight-medium);
    inline-size: 30%;
  }
  .mar-tbl tbody td { padding-block: var(--sp-4); padding-inline: 0 var(--sp-5); border-block-end: var(--rule); color: var(--ink-muted); line-height: 1.6; }
  .mar-tbl tbody td.mar-tbl__is { color: var(--accent-deep); inline-size: 24%; }

  .mar-caveat {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    padding-inline-start: var(--sp-6);
    border-inline-start: 2px solid var(--signal);
    max-inline-size: 74ch;
  }
  .mar-caveat p { margin-block-start: var(--sp-4); font-size: var(--step-0); line-height: 1.62; }

  /* ── 03 The sequence ──────────────────────────────────────────────────── */
  .mar-seq { background: var(--surface-sunk); }
  .mar-seq__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .mar-seq__fig {
    margin: 0;
    position: sticky;
    inset-block-start: clamp(4.5rem, 10vh, 6.5rem);
    background: var(--surface-raise);
    border: var(--rule);
    padding: var(--sp-5) var(--sp-5) var(--sp-8);
  }
  .mar-seq__fig svg { inline-size: 100%; block-size: auto; display: block; }
  .mar-seq__fig .figure-note { margin-block-start: var(--sp-5); }

  /* Single column: the wrapper drops out so the figure sticks against the
     whole section rather than against a box its own height. */
  @media (max-width: 1000px) {
    .mar-seq__grid { display: block; }
    .mar-seq__figwrap { display: contents; }
    .mar-seq__fig svg { max-block-size: 42vh; }
    .mar-seq__steps { margin-block-start: var(--sp-6); }
  }

  .mar-g { transition: opacity var(--dur-4) var(--ease-out); }
  .mar-g--worn { opacity: 1; }
  .mar-g--meas, .mar-g--nom, .mar-g--tool { opacity: 0; }
  .mar-seq[data-step='1'] .mar-g--meas { opacity: 1; }
  .mar-seq[data-step='2'] .mar-g--meas { opacity: 0.5; }
  .mar-seq[data-step='3'] .mar-g--meas { opacity: 0.26; }
  .mar-seq[data-step='2'] .mar-g--nom { opacity: 1; }
  .mar-seq[data-step='3'] .mar-g--nom { opacity: 1; }
  .mar-seq[data-step='3'] .mar-g--tool { opacity: 1; }
  .mar-seq[data-step='2'] .mar-g--worn { opacity: 0.3; }
  .mar-seq[data-step='3'] .mar-g--worn { opacity: 0.14; }
  .mar-ghost { opacity: 0.34; }
  /* Without script the drawing renders as one composite plate, fully legible. */
  :global(html:not(.js)) .mar-g--meas,
  :global(html:not(.js)) .mar-g--nom,
  :global(html:not(.js)) .mar-g--tool { opacity: 1; }
  :global(html:not(.js)) .mar-g--worn { opacity: 0.3; }

  .mar-seq__steps { display: grid; }
  .mar-seq__step {
    display: grid;
    gap: var(--sp-3);
    align-content: center;
    min-block-size: 62vh;
    padding-block: var(--sp-6);
    padding-inline-start: var(--sp-6);
    border-inline-start: var(--rule);
    opacity: 0.4;
    transition: opacity var(--dur-4) var(--ease-out), border-color var(--dur-4) var(--ease-out);
  }
  .mar-seq[data-step='0'] .mar-seq__step[data-station-step='0'],
  .mar-seq[data-step='1'] .mar-seq__step[data-station-step='1'],
  .mar-seq[data-step='2'] .mar-seq__step[data-station-step='2'],
  .mar-seq[data-step='3'] .mar-seq__step[data-station-step='3'] {
    opacity: 1;
    border-inline-start-color: var(--accent);
  }
  :global(html:not(.js)) .mar-seq__step { opacity: 1; }
  @media (max-width: 1000px) { .mar-seq__step { min-block-size: 48vh; } }
  .mar-seq__num { font-size: var(--step--2); letter-spacing: 0.18em; color: var(--accent-deep); }
  .mar-seq__step p:last-child { font-size: var(--step--1); line-height: 1.65; color: var(--ink-muted); max-inline-size: 48ch; }

  .mar-close {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 62ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
  }

  /* ── 04 Environment ───────────────────────────────────────────────────── */
  .mar-env__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .mar-env__grid { grid-template-columns: minmax(0, 1fr); } }
  .mar-fig--zone { margin-block-start: 0; }
  .mar-zone--a { fill: color-mix(in oklab, var(--accent) 4%, transparent); }
  .mar-zone--b { fill: color-mix(in oklab, var(--accent) 11%, transparent); }
  .mar-zone--c { fill: color-mix(in oklab, var(--accent) 24%, transparent); }
  .mar-wl { stroke: var(--accent); stroke-width: 1.4; }
  .mar-refract { transform: translateX(var(--mar-refract)); }
  @keyframes mar-breathe {
    0%, 100% { transform: translateX(calc((var(--mar-refract) * -1) * var(--dir))); }
    50% { transform: translateX(var(--mar-refract)); }
  }
  :global(html.js) .mar-refract { animation: mar-breathe 14s var(--ease-in-out) infinite; }

  .mar-loads { display: grid; }
  .mar-load { padding-block: var(--sp-6); border-block-end: var(--rule); }
  .mar-load:first-child { padding-block-start: 0; }
  .mar-load__name {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    font-size: var(--step-2);
    letter-spacing: var(--track-head);
  }
  .mar-load__name span { font-size: var(--step--2); letter-spacing: 0.16em; color: var(--accent-deep); }
  .mar-load__cells {
    margin-block-start: var(--sp-5);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr) minmax(0, 1.25fr);
    gap: clamp(1rem, 2.5vw, 2rem);
  }
  @media (max-width: 1000px) { .mar-load__cells { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); } }
  .mar-load__cells .t-label { display: block; margin-block-end: var(--sp-2); color: var(--ink-muted); }
  .mar-load__cells p + p { font-size: var(--step--1); line-height: 1.62; }
  .mar-load__demand p + p { color: var(--accent-deep); }

  .mar-evidence {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    padding: var(--sp-6);
    background: var(--surface-raise);
    border: var(--rule);
    border-inline-start: 2px solid var(--signal);
    max-inline-size: 84ch;
  }
  .mar-evidence p { margin-block-start: var(--sp-4); font-size: var(--step--1); line-height: 1.68; color: var(--ink-muted); }

  /* ── 05 Larger geometry ───────────────────────────────────────────────── */
  .mar-fig--wide { padding-block-end: var(--sp-9); }
  .mar-geo .mar-ticks { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .mar-geo__cols {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
  }
  @media (max-width: 1000px) { .mar-geo__cols { grid-template-columns: minmax(0, 1fr); } }
  .mar-note { padding-block-start: var(--sp-5); border-block-start: var(--rule-strong); }
  .mar-note p { margin-block-start: var(--sp-4); font-size: var(--step--1); line-height: 1.68; color: var(--ink-muted); }
  .mar-note--trade { border-block-start-color: var(--accent); }
  .mar-note--trade p { color: var(--ink); }

  /* ── 06 Economics — the one inverted section ──────────────────────────── */
  .mar-econ {
    /* The chapter's one other textured surface. Felt, not read. Colour comes
       from `ground--steel` on the section itself — ink, muted ink, rules,
       strong rules, accent, signal, focus ring and the buttons are all
       remapped there, so nothing is restated here. */
    --tex-opacity: 0.06;
  }
  .mar-econ__intro {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .mar-econ__intro { grid-template-columns: minmax(0, 1fr); } }
  .mar-econ__ask { font-size: var(--step-1); line-height: 1.5; color: var(--signal-ink); max-inline-size: 46ch; }

  .mar-arith { margin-block-start: clamp(2.5rem, 5vw, 4rem); max-inline-size: 34rem; }
  .mar-arith dl { margin-block-start: var(--sp-5); border-block-start: var(--rule-strong); }
  .mar-arith dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--sp-5);
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: baseline;
  }
  .mar-arith dl > div:last-child dd { color: var(--signal-ink); font-size: var(--step-2); }
  .mar-arith dt { font-size: var(--step--1); color: var(--ink-muted); }
  .mar-arith dd { font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .mar-arith__note { margin-block-start: var(--sp-5); max-inline-size: 52ch; }

  .mar-vol {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
