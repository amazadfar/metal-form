---
/**
 * TOYS & CONSUMER GOODS — the productisation chapter.
 *
 * Written for a brand owner or an OEM buyer deciding where to put six figures
 * of tooling capex. Not a toy page: no primary colour, no playful shape, no
 * retail register. Warm paper, hairline drawings, mono numbers.
 *
 * The whole page is built on ONE VERTICAL AXIS and returns to it deliberately:
 * the hero holds an exploded part stack on that axis; the intake diagram
 * converges four routes onto it; consolidation collapses three parts along it;
 * the amortisation rail descends it; the programme is counted down it in shots.
 *
 * The argument: the unit cost is fixed the week the tool is specified, then
 * paid on every shot for years. So the useful conversation happens before steel.
 */
import type { Locale } from '../../i18n/locales.ts';
import TechNote from '../TechNote.astro';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;

/* ── Exploded stack geometry ───────────────────────────────────────────────
   Six components of one illustrative consumer product, each a section profile
   held apart on a single vertical axis at x = 170. Leader anchors are the
   trailing extreme of each part. */
const STACK = [
  { y: 44,  ax: 270, ay: 53,  h: 18 },
  { y: 110, ax: 198, ay: 117, h: 13 },
  { y: 150, ax: 186, ay: 157, h: 14 },
  { y: 196, ax: 256, ay: 208, h: 29 },
  { y: 272, ax: 270, ay: 289, h: 34 },
  { y: 352, ax: 234, ay: 357, h: 9 },
];

/* ── The hero plate ───────────────────────────────────────────────────────
   The opening is stacked: the statement runs the full width of the chapter and
   the assembly sits on a plate beneath it that is wider than any text column
   on the page. The stack keeps its single vertical axis; what the extra width
   buys is the drawing's own annotation — leaders that run the sheet, item
   balloons ranged on a legend rule, and specs with room to translate.

   One scale and one offset map the geometry above onto the plate, so the
   drawing of record above stays the drawing of record. */
const SHEET_S = 1.06;
const SHEET_X = 260 - 170 * SHEET_S;   /* the axis lands at x = 260 */
const SHEET_Y = 8;
const RANGE_X = 850;                   /* the legend rule the balloons range on */
/** Extra explosion distance per item, in drawing units. The plate is taller
 *  than the old column, so the stack is held further apart on it. */
const EXPLODE = 38;
const spread = (i: number) => i * EXPLODE;
const px = (x: number) => +(SHEET_X + x * SHEET_S).toFixed(1);
const py = (y: number) => +(SHEET_Y + y * SHEET_S).toFixed(1);

/* Amortisation rail. Bar ends fall as annual volume rises; the shape is the
   argument and there is no currency anywhere near it. */
const RUNG_END = [580, 420, 250, 158, 118];

/* VDI reference row: profile amplitude and the draft the grade owes, both
   exaggerated so the coupling is visible at this size. */
const GRADE_AMP = [2, 3, 4.5, 6.5, 10, 14];
const GRADE_DRAFT = [1, 1.5, 2, 3, 4.5, 6];

/** Deterministic EDM-texture profile — same drawing on every build. */
function profile(amp: number, seed: number): string {
  const pts: string[] = [];
  for (let i = 0; i <= 28; i++) {
    const x = 10 + i * 5;
    const n = Math.sin((i + seed) * 2.399) * 0.62 + Math.sin((i + seed) * 5.117) * 0.38;
    pts.push(`${x} ${(48 - n * amp).toFixed(1)}`);
  }
  return `M${pts.join(' L')} L150 96 L10 96 Z`;
}
---

<article class="tys">

  {/* ═══ HERO — STACKED ═════════════════════════════════════════════════
       The statement runs the full width of the chapter; the exploded stack
       sits on a plate below it that bleeds to both edges of the page. */}
  <header class="tys-hero" data-tex="mesh">
    <div class="tys-hero__bleed" aria-hidden="true">
      <svg viewBox="0 0 1400 700" preserveAspectRatio="xMidYMid slice" data-nomirror>
        <defs>
          <linearGradient id="tys-paper" x1="0" y1="0" x2="0.4" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.07" />
            <stop offset="70%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect width="1400" height="700" fill="url(#tys-paper)" />
      </svg>
    </div>

    <div class="shell--wide tys-hero__top">
      <p class="eyebrow">{content.hero.kicker}</p>
      <h1 class="tys-hero__head">
        {content.hero.headline.map((line: string, i: number) => (
          <span style={`--l:${i}`}>{line}</span>
        ))}
      </h1>

      <div class="tys-hero__under">
        <p class="tys-hero__lead">{content.hero.lead}</p>
        <p class="tys-hero__thesis">{b.stack.thesis}</p>
      </div>

      {content.hero.markers && (
        <ul class="badges tys-hero__markers">
          {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
        </ul>
      )}
    </div>

    {/* The plate. Full-bleed, ruled top and bottom, and the only thing on the
        page that is allowed to be this wide. */}
    <div class="tys-hero__sheet">
      <div class="shell--wide">
        <figure class="tys-hero__fig tys-fig" data-reveal>
          {/* Below the plate's own width the drawing scrolls inside this box
              rather than shrinking its annotation out of legibility. */}
          <div class="scroller tys-sheet__scroll">
          <svg viewBox="0 0 1240 630" data-nomirror role="img" aria-label={common.schematic}>
            <defs>
              <pattern id="tys-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="0.75" opacity="0.34" />
              </pattern>
            </defs>

            {/* Sheet registration and the rule the item balloons range on. */}
            <g class="tys-tick" aria-hidden="true">
              <path d="M16 46 V16 H46" />
              <path d="M1194 16 H1224 V46" />
              <path d="M1224 584 V614 H1194" />
              <path d="M46 614 H16 V584" />
            </g>
            <line x1={RANGE_X} y1="30" x2={RANGE_X} y2="600" class="tys-range" />

            <g transform={`translate(${SHEET_X} ${SHEET_Y}) scale(${SHEET_S})`}>
              {/* The axis the whole chapter is built on. */}
              <line x1="170" y1="12" x2="170" y2="566" class="tys-cl" />

              {/* 1 · upper shell */}
              <g class="tys-part" style="--i:0">
                <g transform={`translate(170 ${STACK[0].y + spread(0)})`}>
                  <path d="M-100 18 V8 Q-100 0 -92 0 H92 Q100 0 100 8 V18 H92 V10 Q92 8 84 8 H-84 Q-92 8 -92 10 V18 Z" class="tys-ln tys-hf" />
                </g>
              </g>
              {/* 2 · lens */}
              <g class="tys-part" style="--i:1">
                <g transform={`translate(170 ${STACK[1].y + spread(1)})`}>
                  <path d="M-28 12 V6 Q0 -4 28 6 V12 Z" class="tys-ln tys-glass" />
                </g>
              </g>
              {/* 3 · button */}
              <g class="tys-part" style="--i:2">
                <g transform={`translate(170 ${STACK[2].y + spread(2)})`}>
                  <path d="M-16 14 V6 H-9 V0 H9 V6 H16 V14 Z" class="tys-ln tys-hf" />
                </g>
              </g>
              {/* 4 · chassis, cored bosses and ribs */}
              <g class="tys-part" style="--i:3">
                <g transform={`translate(170 ${STACK[3].y + spread(3)})`}>
                  <path d="M-86 0 H86 V7 H-86 Z" class="tys-ln tys-hf" />
                  <path d="M-46 7 h6 v22 h-6 z" class="tys-ln tys-hf" />
                  <path d="M-34 7 h6 v22 h-6 z" class="tys-ln tys-hf" />
                  <path d="M28 7 h6 v22 h-6 z" class="tys-ln tys-hf" />
                  <path d="M40 7 h6 v22 h-6 z" class="tys-ln tys-hf" />
                  <path d="M-10 7 h5 v14 h-5 z" class="tys-ln tys-hf" />
                  <path d="M5 7 h5 v14 h-5 z" class="tys-ln tys-hf" />
                </g>
              </g>
              {/* 5 · lower shell */}
              <g class="tys-part" style="--i:4">
                <g transform={`translate(170 ${STACK[4].y + spread(4)})`}>
                  <path d="M-100 0 V26 Q-100 34 -92 34 H92 Q100 34 100 26 V0 H92 V24 Q92 26 84 26 H-84 Q-92 26 -92 24 V0 Z" class="tys-ln tys-hf" />
                </g>
              </g>
              {/* 6 · hinged lid, land drawn between the two strips */}
              <g class="tys-part" style="--i:5">
                <g transform={`translate(170 ${STACK[5].y + spread(5)})`}>
                  <path d="M-64 0 H-4 V9 H-64 Z" class="tys-ln tys-hf" />
                  <path d="M-4 3.5 H4 V5.5 H-4 Z" class="tys-ln tys-sig" />
                  <path d="M4 0 H64 V9 H4 Z" class="tys-ln tys-hf" />
                </g>
              </g>
            </g>

            {/* Leaders and item balloons — drawing convention, not decoration.
                On the plate they run the width of the sheet. */}
            {b.stack.parts.map((part: any, i: number) => (
              <g class="tys-lead" style={`--i:${i}`}>
                <circle cx={px(STACK[i].ax)} cy={py(STACK[i].ay + spread(i))} r="2.6" class="tys-dot" />
                <line x1={px(STACK[i].ax)} y1={py(STACK[i].ay + spread(i))} x2={RANGE_X - 15} y2={py(STACK[i].ay + spread(i))} class="tys-leader" />
                <circle cx={RANGE_X} cy={py(STACK[i].ay + spread(i))} r="14" class="tys-balloon" />
                <text x={RANGE_X} y={py(STACK[i].ay + spread(i)) + 5} text-anchor="middle" class="tys-num tys-num--plate">{part.no}</text>
                <text x={RANGE_X + 28} y={py(STACK[i].ay + spread(i)) + 5} class="tys-spec tys-spec--plate">{part.spec}</text>
              </g>
            ))}
          </svg>
          </div>

          {/* Title strip along the foot of the plate. */}
          <div class="tys-sheet__strip">
            <p class="t-label tys-hero__figlabel">{b.stack.figureLabel}</p>
            <ul class="tys-hero__meta">
              {b.stack.meta.map((m: string) => <li class="t-mono">{m}</li>)}
            </ul>
          </div>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>
      </div>
    </div>

    {/* Parts list — the drawing's own legend, set as a datasheet. */}
    <div class="shell--wide tys-parts">
      <p class="t-label tys-parts__cap">{b.stack.partsLabel}</p>
      <ol class="tys-parts__list">
        {b.stack.parts.map((part: any) => (
          <li class="tys-parts__row">
            <span class="tys-parts__no t-mono">{part.no}</span>
            <span class="tys-parts__name">{part.name}</span>
            <span class="tys-parts__spec t-mono">{part.spec}</span>
            <span class="tys-parts__note">{part.note}</span>
          </li>
        ))}
      </ol>
      <p class="tys-parts__caption t-fine">{b.stack.caption}</p>

      {/* On record. Set to be read, not tracked out at 11px as build metadata. */}
      <div class="tys-proof">
        <span class="t-label tys-proof__cap">{b.stack.proofLabel}</span>
        <ul class="caps caps--tight">
          {b.stack.proof.map((p: string) => (
            <li class="cap"><span class="cap__v">{p}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </header>

  {/* ═══ 01 · INTAKE ════════════════════════════════════════════════════ */}
  <section class="tys-intake" id="intake">
    <div class="shell--wide">
      <div class="tys-head">
        <p class="eyebrow">{b.intake.index} · {b.intake.kicker}</p>
        <h2 class="tys-h2">{b.intake.heading}</h2>
        <p class="t-lead">{b.intake.body}</p>
      </div>

      <figure class="tys-fig tys-intake__fig" data-reveal>
        <p class="t-label">{b.intake.lanesLabel}</p>
        <svg viewBox="0 0 900 320" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <marker id="tys-arw" viewBox="0 0 9 9" refX="8" refY="4.5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L9 4.5 L0 9 Z" fill="currentColor" />
            </marker>
          </defs>

          {[46, 118, 190, 262].map((y: any, i: number) => (
            <g class="tys-lane" style={`--i:${i}`}>
              <circle cx="30" cy={y} r="11" class="tys-balloon" />
              <text x="30" y={y + 3.8} text-anchor="middle" class="tys-num">{b.intake.lanes[i].no}</text>
              <path
                d={i === 0 ? 'M52 46 H330 C440 46 470 160 560 160'
                  : i === 1 ? 'M52 118 H360 C450 118 490 160 560 160'
                  : i === 2 ? 'M52 190 H360 C450 190 490 160 560 160'
                  : 'M52 262 H330 C440 262 470 160 560 160'}
                class="tys-track"
              />
            </g>
          ))}

          <path d="M560 160 H672" class="tys-track tys-track--heavy" marker-end="url(#tys-arw)" />
          <rect x="678" y="148" width="24" height="24" class="tys-node" />
          <text x="690" y="132" text-anchor="middle" class="tys-caplabel">{b.intake.nodeLabel}</text>
          <line x1="690" y1="176" x2="690" y2="312" class="tys-cl" />
        </svg>
        <figcaption class="figure-note">{b.intake.figureNote}</figcaption>
      </figure>

      <TechNote locale={locale} kind="detail">
        <ol class="tys-lanes">
          {b.intake.lanes.map((lane: any, i: number) => (
            <li class="tys-lanes__item" style={`--reveal-delay:${i * 90}ms`} data-reveal>
              <span class="tys-lanes__no t-mono">{lane.no}</span>
              <h3 class="tys-h5">{lane.name}</h3>
              <p class="tys-lanes__action">{lane.action}</p>
              <p class="tys-lanes__need t-small">{lane.need}</p>
            </li>
          ))}
        </ol>
      </TechNote>

      <p class="tys-close">{b.intake.close}</p>
    </div>
  </section>

  {/* ═══ 02 · CONSOLIDATION ═════════════════════════════════════════════
       The chapter's one idea, and the page's contrast anchor: a light chapter
       still needs one band that is not paper. */}
  <section class="tys-cons tys-dark on-steel" id="consolidation" data-tex="mesh">
    <div class="shell--wide">
      <div class="tys-head">
        <p class="eyebrow">{b.consolidate.index} · {b.consolidate.kicker}</p>
        <h2 class="tys-h2">{b.consolidate.heading}</h2>
        <p class="t-lead">{b.consolidate.body}</p>
        <p class="tys-head__sub t-small">{b.consolidate.body2}</p>
      </div>

      <figure class="tys-fig tys-cons__fig" data-reveal>
        <svg viewBox="0 0 780 300" data-nomirror role="img" aria-label={common.schematic}>
          <defs>
            <pattern id="tys-hatch-b" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="0.75" opacity="0.34" />
            </pattern>
            <marker id="tys-arw-b" viewBox="0 0 9 9" refX="8" refY="4.5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L9 4.5 L0 9 Z" fill="currentColor" />
            </marker>
          </defs>

          {/* As drawn — three mouldings and a pin on the axis */}
          <line x1="170" y1="30" x2="170" y2="240" class="tys-cl" />
          <g class="tys-was">
            <path d="M100 60 H240 V70 H100 Z" class="tys-ln tys-hfb" />
            <path d="M136 108 H204 V116 H136 Z" class="tys-ln tys-sig" />
            <path d="M100 156 V212 H240 V156 H230 V202 H110 V156 Z" class="tys-ln tys-hfb" />
            <path d="M272 62 V150" class="tys-assy" marker-end="url(#tys-arw-b)" />
          </g>
          <text x="170" y="264" text-anchor="middle" class="tys-caplabel">{b.consolidate.beforeLabel}</text>

          {/* Transition */}
          <path d="M330 138 H436" class="tys-track tys-track--heavy" marker-end="url(#tys-arw-b)" />
          <text x="383" y="124" text-anchor="middle" class="tys-caplabel">{b.consolidate.transitionLabel}</text>

          {/* As tooled — one moulding with a living hinge */}
          <line x1="596" y1="30" x2="596" y2="240" class="tys-cl" />
          <g class="tys-now">
            <path d="M532 76 H652 V86 H532 Z" class="tys-ln tys-hfb" />
            <path d="M652 81 Q674 84 674 98 Q674 112 656 115" class="tys-ln tys-hinge" />
            <path d="M532 114 V172 H656 V114 H646 V162 H542 V114 Z" class="tys-ln tys-hfb" />
          </g>
          <text x="596" y="264" text-anchor="middle" class="tys-caplabel">{b.consolidate.afterLabel}</text>
        </svg>
        <figcaption class="figure-note">{b.consolidate.figureNote}</figcaption>
      </figure>

      {/* The count collapsing is the argument. */}
      <div class="tys-count">
          <div class="tys-count__col">
            <h3 class="t-label">{b.consolidate.before.heading}</h3>
            <dl>
              {b.consolidate.before.rows.map((r: any) => (
                <div><dt class="t-mono">{r.value}</dt><dd>{r.label}</dd></div>
              ))}
            </dl>
          </div>
          <div class="tys-count__col tys-count__col--after">
            <h3 class="t-label">{b.consolidate.after.heading}</h3>
            <dl>
              {b.consolidate.after.rows.map((r: any) => (
                <div><dt class="t-mono">{r.value}</dt><dd>{r.label}</dd></div>
              ))}
            </dl>
          </div>
          <div class="tys-count__col tys-count__col--wide">
            <h3 class="t-label">{b.consolidate.consequenceHeading}</h3>
            <ul class="tys-ticks">
              {b.consolidate.consequences.map((c: string) => <li>{c}</li>)}
            </ul>
          </div>
        </div>

      <TechNote locale={locale} kind="why">
        <div class="tys-caution">
          <h3 class="tys-h5">{b.consolidate.cautionHeading}</h3>
          <p>{b.consolidate.caution}</p>
        </div>
      </TechNote>
    </div>
  </section>

  {/* ═══ 03 · AMORTISATION RAIL ═════════════════════════════════════════ */}
  <section class="tys-vol" id="volume" data-stepper data-step="0">
    <div class="shell--wide">
      <div class="tys-head">
        <p class="eyebrow">{b.volume.index} · {b.volume.kicker}</p>
        <h2 class="tys-h2">{b.volume.heading}</h2>
        <p class="t-lead">{b.volume.body}</p>
      </div>

              <div class="tys-vol__grid">
          <figure class="tys-fig tys-vol__fig">
            <p class="t-label">{b.volume.railLabel}</p>
            <svg viewBox="0 0 640 470" data-nomirror role="img" aria-label={common.schematic}>
              <defs>
                <pattern id="tys-hatch-c" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <line x1="0" y1="0" x2="0" y2="8" stroke="currentColor" stroke-width="0.8" opacity="0.28" />
                </pattern>
              </defs>
  
              {/* One continuous stepped rail. Not a chart widget. */}
              <path
                d="M100 40 H580 V120 H420 V200 H250 V280 H158 V360 H118 V440 H100 Z"
                class="tys-rail"
              />
  
              {[0, 1, 2, 3, 4].map((i: number) => (
                <rect
                  x="100" y={40 + i * 80} width={RUNG_END[i] - 100} height="80"
                  class="tys-band" data-r={i}
                />
              ))}
  
              {/* Volume axis */}
              <line x1="100" y1="30" x2="100" y2="450" class="tys-axis" />
              {[0, 1, 2, 3, 4].map((i: number) => (
                <g>
                  <line x1="94" y1={80 + i * 80} x2="106" y2={80 + i * 80} class="tys-axis" />
                  <text x="90" y={84 + i * 80} text-anchor="end" class="tys-spec">{b.volume.rungs[i].volume}</text>
                </g>
              ))}
  
              {/* The flip. A dash-dot line and a square node, nothing more. */}
              <line x1="24" y1="200" x2="616" y2="200" class="tys-flip" />
              <rect x="243" y="193" width="14" height="14" class="tys-node tys-node--flip" />
              <text x="612" y="192" text-anchor="end" class="tys-caplabel">{b.volume.flipLabel}</text>
            </svg>
            <p class="t-fine tys-vol__axis">{b.volume.axisLabel}</p>
            <figcaption class="figure-note">{b.volume.figureNote}</figcaption>
          </figure>
  
          <ol class="tys-rungs">
            {b.volume.rungs.map((rung: any, i: number) => (
              <li class="tys-rung" data-station-step={i} data-r={i}>
                <span class="tys-rung__v t-mono">{rung.volume}</span>
                <h3 class="tys-h5">{rung.title}</h3>
                <p>{rung.note}</p>
              </li>
            ))}
          </ol>
        </div>
      

      <TechNote locale={locale} kind="reasoning">
        <div class="tys-vol__foot">
          <div class="tys-flipblock">
            <h3 class="tys-h5">{b.volume.flipHeading}</h3>
            <p>{b.volume.flip}</p>
          </div>
          <div class="tys-model">
            <h3 class="t-label">{b.volume.modelHeading}</h3>
            <p>{b.volume.model}</p>
          </div>
        </div>
      </TechNote>

      <p class="tys-close">{b.volume.close}</p>
    </div>
  </section>

  {/* ═══ 04 · THE MISTAKES LEDGER ═══════════════════════════════════════ */}
  <section class="tys-led" id="ledger">
    <div class="shell--wide">
      <div class="tys-head">
        <p class="eyebrow">{b.ledger.index} · {b.ledger.kicker}</p>
        <h2 class="tys-h2">{b.ledger.heading}</h2>
        <p class="t-lead">{b.ledger.body}</p>
      </div>

      <div class="tys-led__cols">
        <span class="t-label">{b.ledger.drawnLabel}</span>
        <span class="t-label tys-led__cols--b">{b.ledger.fixedLabel}</span>
      </div>

      <ol class="tys-led__list">
        {b.ledger.items.map((item: any, i: number) => (
          <li class="tys-led__row" data-reveal>
            <div class="tys-led__id">
              <span class="t-mono">{item.no}</span>
              <h3 class="tys-h5">{item.title}</h3>
            </div>

            <figure class="tys-fig tys-led__fig">
