<style>
  /* ═══ TOYS & CONSUMER GOODS ══════════════════════════════════════════════
     Warm paper, graphite ink, one controlled tangerine accent used only
     structurally. Chroma is permitted in exactly one place: the colour-drift
     strip, where colour is the engineering subject rather than decoration. */

  .tys-h2 {
    font-size: clamp(1.95rem, 4.1vw, 3.35rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 500;
    margin-block-start: var(--sp-5);
    max-inline-size: 19ch;
  }
  .tys-h4 { font-size: var(--step-2); letter-spacing: var(--track-head); line-height: 1.2; max-inline-size: 24ch; }
  .tys-h5 { font-size: var(--step-1); letter-spacing: var(--track-head); line-height: 1.25; }

  .tys-head { max-inline-size: 74ch; }
  .tys-head .t-lead { margin-block-start: var(--sp-5); }
  .tys-head__sub { margin-block-start: var(--sp-4); color: var(--ink-muted); max-inline-size: 66ch; }

  .tys-close {
    margin-block-start: clamp(2rem, 4.5vw, 3.25rem);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 66ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }

  /* ── Shared drawing conventions ───────────────────────────────────────── */
  .tys-fig svg { inline-size: 100%; block-size: auto; color: var(--accent-deep); display: block; }
  .tys-ln { fill: none; stroke: var(--accent-deep); stroke-width: 1.4; stroke-linejoin: round; }
  .tys-hf { fill: url(#tys-hatch); }
  .tys-hfb { fill: url(#tys-hatch-b); }
  .tys-glass { fill: color-mix(in oklab, var(--signal) 14%, transparent); }
  .tys-sig { stroke: var(--signal); fill: color-mix(in oklab, var(--signal) 18%, transparent); }
  .tys-acc { stroke: var(--accent); fill: color-mix(in oklab, var(--accent) 14%, transparent); }
  .tys-hinge { stroke: var(--signal); stroke-width: 2.2; fill: none; }
  .tys-cl { stroke: var(--ink-muted); stroke-width: 0.8; stroke-dasharray: 10 3 2 3; opacity: 0.5; }
  .tys-axis { stroke: var(--ink-muted); stroke-width: 1; }
  .tys-leader { stroke: var(--accent); stroke-width: 0.9; }
  .tys-dot { fill: var(--accent); }
  .tys-balloon { fill: var(--surface); stroke: var(--accent); stroke-width: 1.1; }
  .tys-num {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }
  .tys-spec {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.05em;
    fill: var(--ink-muted);
  }
  .tys-micro { font-family: var(--font-mono); font-size: 8px; fill: var(--ink-muted); }
  .tys-caplabel {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--ink-muted);
  }
  .tys-track { fill: none; stroke: var(--accent-deep); stroke-width: 1.2; opacity: 0.55; }
  .tys-track--heavy { stroke-width: 2.4; opacity: 1; stroke: var(--accent); }
  .tys-node { fill: var(--accent); stroke: none; }
  .tys-node--flip { fill: var(--signal); }
  .tys-dim { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; }
  .tys-dim--on { stroke: var(--accent); }
  .tys-block { stroke: var(--signal); stroke-width: 2; }
  .tys-sinkline { fill: none; stroke: var(--signal); stroke-width: 1.2; }
  .tys-assy { fill: none; stroke: var(--ink-muted); stroke-width: 1.2; stroke-dasharray: 5 4; }
  .tys-ghost { fill: none; stroke: var(--signal); stroke-width: 1.2; stroke-dasharray: 6 4; }
  .tys-weld { stroke: var(--signal); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .tys-flow { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 9 5; }
  .tys-chip { fill: color-mix(in oklab, var(--accent) 70%, var(--surface)); stroke: var(--accent-deep); }
  .tys-chipref { fill: var(--accent); stroke: var(--accent-deep); }
  .tys-rail { fill: url(#tys-hatch-c); stroke: var(--accent-deep); stroke-width: 1.4; }
  .tys-flip { stroke: var(--signal); stroke-width: 1; stroke-dasharray: 12 3 2 3; }

  /* ── Hero — STACKED ───────────────────────────────────────────────────
     One statement across the whole width, then a plate that bleeds to both
     edges of the page. Nothing in the opening sits in a column. */
  .tys-hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2.5rem, 6vw, 4.5rem);
    overflow: clip;
    /* Structural mesh — a large panel and its ribbing. Warm, and pitched to be
       felt rather than seen. */
    --tex-ink: var(--accent-deep);
    --tex-opacity: 0.055;
  }
  .tys-hero__bleed { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .tys-hero__bleed svg { inline-size: 100%; block-size: 100%; }

  .tys-hero__top { position: relative; }

  .tys-hero__head {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2.4rem, 6vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.038em;
    font-weight: 500;
    max-inline-size: 28ch;
  }
  .tys-hero__head span { display: block; text-wrap: balance; }
  .tys-hero__head span:last-child { color: var(--accent-deep); }

  /* Lead and thesis run under the statement as a footing, divided by a rule
     that has air on both sides of it. */
  .tys-hero__under {
    margin-block-start: clamp(1.75rem, 4vw, 3rem);
    padding-block-start: var(--sp-5);
    border-block-start: var(--rule-strong);
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }
  .tys-hero__under > * { padding-inline: var(--col-pad); min-inline-size: 0; }
  .tys-hero__under > :first-child { padding-inline-start: 0; }
  .tys-hero__under > :last-child { padding-inline-end: 0; }
  .tys-hero__under > * + * { border-inline-start: var(--rule); }
  @media (max-width: 1000px) {
    .tys-hero__under {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-5);
    }
    .tys-hero__under > * { padding-inline: 0; }
    .tys-hero__under > * + * { border-inline-start: 0; padding-block-start: var(--sp-5); border-block-start: var(--rule); }
  }

  .tys-hero__lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 52ch;
  }
  .tys-hero__thesis {
    font-size: var(--step-0);
    line-height: 1.62;
    max-inline-size: 54ch;
  }
  .tys-hero__markers { margin-block-start: clamp(1.5rem, 3vw, 2.25rem); }

  /* The plate. */
  .tys-hero__sheet {
    position: relative;
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    padding-block: clamp(1.5rem, 3.2vw, 2.75rem);
    border-block: var(--rule);
    background: color-mix(in oklab, var(--surface-raise) 62%, transparent);
  }
  .tys-sheet__scroll { min-inline-size: 0; max-inline-size: 100%; }
  @media (max-width: 900px) {
    /* The plate keeps a legible width and scrolls inside its own box. */
    .tys-hero__fig svg { min-inline-size: 56rem; }
  }
  .tys-tick { fill: none; stroke: var(--ink-muted); stroke-width: 1; opacity: 0.45; }
  .tys-range { stroke: var(--line); stroke-width: 1; }
  .tys-num--plate { font-size: 14px; }
  .tys-spec--plate { font-size: 15px; letter-spacing: 0.04em; }

  .tys-sheet__strip {
    margin-block-start: var(--sp-4);
    padding-block-start: var(--sp-3);
    border-block-start: var(--rule);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-6);
  }
  .tys-hero__figlabel { display: block; }
  .tys-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }
  .tys-hero__fig .figure-note { margin-block-start: var(--sp-3); }

  /* Assembly motion: each part travels a short distance along the axis and
     seats with a hard stop. Nothing floats, nothing drifts. */
  @keyframes tys-seat {
    from { opacity: 0; transform: translateY(-18px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes tys-leadin { from { opacity: 0; } to { opacity: 1; } }
  :global(html.js) .tys-hero__fig[data-reveal='in'] .tys-part {
    animation: tys-seat 420ms var(--ease-mech) both;
    animation-delay: calc(var(--i) * 70ms);
  }
  :global(html.js) .tys-hero__fig[data-reveal='in'] .tys-lead {
    animation: tys-leadin 300ms var(--ease-out) both;
    animation-delay: calc(360ms + var(--i) * 70ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .tys-part, .tys-lead { animation: none !important; opacity: 1 !important; transform: none !important; }
  }

  /* ── Parts list ───────────────────────────────────────────────────────── */
  .tys-parts { position: relative; margin-block-start: clamp(2.5rem, 6vw, 4.5rem); }
  .tys-parts__cap { display: block; margin-block-end: var(--sp-4); }
  .tys-parts__list { border-block-start: var(--rule-strong); }
  .tys-parts__row {
    display: grid;
    grid-template-columns: 2.2rem 11rem 11rem minmax(0, 1fr);
    gap: var(--sp-5);
    align-items: baseline;
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
  }
  @media (max-width: 1000px) {
    .tys-parts__row { grid-template-columns: 2.2rem minmax(0, 1fr); gap: var(--sp-3) var(--sp-4); }
    .tys-parts__spec { grid-column: 2; }
    .tys-parts__note { grid-column: 2; }
  }
  .tys-parts__no { color: var(--accent-deep); font-size: var(--step--1); }
  .tys-parts__name { font-size: var(--step-0); font-weight: var(--weight-medium); }
  .tys-parts__spec { font-size: var(--step--2); letter-spacing: 0.06em; color: var(--ink-muted); }
  .tys-parts__note { font-size: var(--step--1); line-height: 1.55; color: var(--ink-muted); }
  .tys-parts__caption { margin-block-start: var(--sp-4); max-inline-size: 70ch; }

  .tys-proof {
    margin-block-start: clamp(1.75rem, 4vw, 3rem);
    padding-block-start: var(--sp-5);
    border-block-start: var(--rule-strong);
  }
  .tys-proof__cap { display: block; margin-block-end: var(--sp-4); }

  /* ── 01 Intake ────────────────────────────────────────────────────────── */
  .tys-intake { padding-block: var(--section-y); border-block-start: var(--rule); }
  .tys-intake__fig { margin-block-start: clamp(2rem, 5vw, 3.25rem); }
  .tys-intake__fig .t-label { display: block; margin-block-end: var(--sp-4); }
  .tys-intake__fig .figure-note { margin-block-start: var(--sp-3); }

  .tys-lane { opacity: 1; }
  :global(html.js) .tys-intake__fig .tys-track {
    stroke-dasharray: 720;
    stroke-dashoffset: 720;
  }
  :global(html.js) .tys-intake__fig[data-reveal='in'] .tys-track {
    transition: stroke-dashoffset var(--dur-6) var(--ease-out);
    transition-delay: calc(var(--i, 4) * 110ms);
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .tys-intake__fig .tys-track { stroke-dashoffset: 0 !important; }
  }

  .tys-lanes {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-block-start: var(--rule-strong);
  }
  @media (max-width: 1000px) {
    .tys-lanes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tys-lanes__item:nth-child(2n) { border-inline-end: 0; }
    .tys-lanes__item:nth-child(2n+1) { padding-inline-start: 0; }
  }
  @media (max-width: 640px) { .tys-lanes { grid-template-columns: minmax(0, 1fr); } }
  .tys-lanes__item {
    padding-block: var(--sp-5) var(--sp-6);
    padding-inline: var(--col-pad) var(--sp-5);
    border-inline-end: var(--rule);
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    min-inline-size: 0;
  }
  .tys-lanes__item:first-child { padding-inline-start: 0; }
  .tys-lanes__item:last-child { border-inline-end: 0; }
  @media (max-width: 640px) {
    .tys-lanes__item { border-inline-end: 0; border-block-end: var(--rule); padding-inline: 0; }
  }
  .tys-lanes__no { font-size: var(--step--2); letter-spacing: 0.14em; color: var(--accent-deep); }
  .tys-lanes__action { font-size: var(--step--1); line-height: 1.55; }
  .tys-lanes__need { color: var(--ink-muted); }

  /* ── The two inverted bands ───────────────────────────────────────────
     `.on-steel` does the whole token flip — ink, muted ink, rules, accent,
     signal, focus and buttons — so none of that is restated here. The only
     thing this class changes is the bed itself, moved off the neutral steel
     and onto this chapter's own warm inverse. */
  .tys-dark {
    background: var(--inverse);
    --surface: var(--inverse);
    --surface-sunk: color-mix(in oklab, var(--inverse) 82%, #000000);
    --surface-raise: color-mix(in oklab, var(--inverse) 88%, #FFFFFF);
    --tex-ink: var(--inverse-ink);
  }

  /* ── 02 Consolidation — the page's contrast anchor ────────────────────── */
  .tys-cons { padding-block: var(--section-y-loose); --tex-opacity: 0.04; }
  .tys-cons__fig { margin-block-start: clamp(2rem, 5vw, 3.5rem); }
  .tys-cons__fig .figure-note { margin-block-start: var(--sp-4); }
  :global(html.js) .tys-cons__fig[data-reveal='in'] .tys-now {
    animation: tys-seat 460ms var(--ease-mech) both;
    animation-delay: 300ms;
  }
  @media (prefers-reduced-motion: reduce) { .tys-now { animation: none !important; opacity: 1 !important; } }

  .tys-count {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 0.7fr) minmax(0, 1.6fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block-start: var(--sp-6);
    border-block-start: var(--rule-strong);
  }
  @media (max-width: 1000px) {
    .tys-count { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .tys-count__col--wide { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) { .tys-count { grid-template-columns: minmax(0, 1fr); } }
  .tys-count__col h3 { display: block; margin-block-end: var(--sp-4); }
  .tys-count__col dl { display: grid; }
  .tys-count__col dl > div {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: baseline;
    padding-block: var(--sp-3);
    border-block-end: var(--rule);
  }
  .tys-count__col dt { font-size: var(--step-3); line-height: 1; color: var(--ink-muted); }
  .tys-count__col dd { font-size: var(--step--2); line-height: 1.45; color: var(--ink-muted); }
  .tys-count__col--after dt { color: var(--accent-deep); }
  .tys-count__col--after dd { color: var(--ink); }

  .tys-ticks { display: grid; gap: var(--sp-3); }
  .tys-ticks li {
    font-size: var(--step--1);
    line-height: 1.55;
    padding-inline-start: var(--sp-5);
    position: relative;
  }
  .tys-ticks li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.7em;
    inline-size: 0.7rem;
    block-size: 1px;
    background: var(--accent);
  }

  .tys-caution {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
    max-inline-size: 70ch;
  }
  .tys-caution p { margin-block-start: var(--sp-3); font-size: var(--step--1); line-height: 1.62; color: var(--ink-muted); }

  /* ── 03 Amortisation ──────────────────────────────────────────────────── */
  .tys-vol { padding-block: var(--section-y); }
  .tys-vol__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .tys-vol__grid { grid-template-columns: minmax(0, 1fr); } }
  .tys-vol__fig {
    position: sticky;
    inset-block-start: clamp(5rem, 11vh, 7rem);
    min-inline-size: 0;
  }
  @media (max-width: 1000px) { .tys-vol__fig { position: static; } }
  .tys-vol__fig .t-label { display: block; margin-block-end: var(--sp-4); }
  .tys-vol__axis { margin-block-start: var(--sp-3); }
  .tys-vol__fig .figure-note { margin-block-start: var(--sp-2); }

  .tys-band { fill: var(--accent); opacity: 0; transition: opacity var(--dur-3) var(--ease-out); }
  .tys-vol[data-step='0'] .tys-band[data-r='0'],
  .tys-vol[data-step='1'] .tys-band[data-r='1'],
  .tys-vol[data-step='2'] .tys-band[data-r='2'],
  .tys-vol[data-step='3'] .tys-band[data-r='3'],
  .tys-vol[data-step='4'] .tys-band[data-r='4'] { opacity: 0.14; }

  .tys-rungs { border-block-start: var(--rule-strong); }
  .tys-rung {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--sp-2) var(--sp-5);
    padding-block: var(--sp-5);
    border-block-end: var(--rule);
    opacity: 0.55;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  @media (max-width: 620px) { .tys-rung { grid-template-columns: minmax(0, 1fr); } }
  .tys-vol[data-step='0'] .tys-rung[data-r='0'],
  .tys-vol[data-step='1'] .tys-rung[data-r='1'],
  .tys-vol[data-step='2'] .tys-rung[data-r='2'],
  .tys-vol[data-step='3'] .tys-rung[data-r='3'],
  .tys-vol[data-step='4'] .tys-rung[data-r='4'] { opacity: 1; }
  @media (max-width: 1000px) { .tys-rung { opacity: 1; } }
  .tys-rung__v { grid-row: span 2; font-size: var(--step-0); color: var(--accent-deep); }
  @media (max-width: 620px) { .tys-rung__v { grid-row: auto; } }
  .tys-rung p { font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }

  .tys-vol__foot {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .tys-vol__foot { grid-template-columns: minmax(0, 1fr); } }
  .tys-flipblock {
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
  }
  .tys-flipblock p { margin-block-start: var(--sp-3); font-size: var(--step--1); line-height: 1.62; }
  .tys-model { padding: var(--sp-6); background: var(--surface-raise); border: var(--rule); }
  .tys-model p { margin-block-start: var(--sp-4); font-size: var(--step--2); line-height: 1.68; color: var(--ink-muted); }

  /* ── 04 Ledger ────────────────────────────────────────────────────────── */
  .tys-led { padding-block: var(--section-y); background: var(--surface-sunk); border-block: var(--rule); }
  .tys-led__cols {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: 12rem minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--sp-6);
  }
  .tys-led__cols span:first-child { grid-column: 2; }
  .tys-led__cols--b { grid-column: 3; }
  @media (max-width: 1000px) { .tys-led__cols { display: none; } }

  .tys-led__list { margin-block-start: var(--sp-3); border-block-start: var(--rule-strong); }
  .tys-led__row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 15rem) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
    padding-block: var(--sp-7);
    border-block-end: var(--rule);
  }
  @media (max-width: 1000px) {
    .tys-led__row { grid-template-columns: minmax(0, 1fr); gap: var(--sp-5); }
    .tys-led__fig { max-inline-size: 22rem; }
  }
  .tys-led__id { display: grid; gap: var(--sp-2); align-content: start; }
  .tys-led__id span { font-size: var(--step--2); letter-spacing: 0.14em; color: var(--accent-deep); }
  .tys-led__fig { background: var(--surface-raise); border: var(--rule); padding: var(--sp-3); }
  .tys-led__copy { display: grid; gap: var(--sp-3); }
  .tys-led__drawn {
    font-size: var(--step-0);
    line-height: 1.5;
    color: var(--ink-muted);
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid color-mix(in oklab, var(--signal) 60%, transparent);
  }
  .tys-led__fixed {
    font-size: var(--step-0);
    line-height: 1.5;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }
  .tys-led__cost { color: var(--ink-muted); line-height: 1.62; max-inline-size: 70ch; }
  .tys-led__note { margin-block-start: var(--sp-5); }

  /* ── 05 Detail ────────────────────────────────────────────────────────── */
  .tys-det { padding-block: var(--section-y); }
  .tys-det__tabs { margin-block-start: clamp(2rem, 5vw, 3.5rem); }
  .tys-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: var(--rule);
  }
  .tys-tab {
    flex: 1 1 12rem;
    padding-block: 0.9rem;
    padding-inline: 1rem;
    background: var(--surface);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-muted);
    text-align: start;
    transition: background-color var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .tys-tab:hover { background: var(--accent-wash); color: var(--accent-deep); }
    /* White on the raw accent measured 4.42:1 — under the floor by a whisker,
     which is still under it. The deeper variant clears it. */
  .tys-tab[aria-selected='true'] { background: var(--accent-deep); color: var(--surface-raise); }

  .tys-det__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    border: var(--rule);
    border-block-start: 0;
    background: var(--surface-raise);
    align-items: start;
  }
