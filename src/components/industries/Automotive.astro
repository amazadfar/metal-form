<style>
  /* ═══════════════════════════════════════════════════════════════════════
     AUTOMOTIVE — graphite on drawing paper.
     Amber (--signal) appears only on balloons, dimension figures and active
     states. Everything structural is a hairline.
     ═══════════════════════════════════════════════════════════════════════ */

  /* These four are mixed from --ink and --surface, and a custom property is
     substituted against the element it is declared on. The sheet re-declares
     them so they resolve against the steel ground it carries rather than
     against the light one the rest of the chapter runs on. */
  .av,
  .av-sheet {
    --av-ink-soft: color-mix(in oklab, var(--ink) 62%, var(--surface));
    --av-frame: color-mix(in oklab, var(--ink) 34%, transparent);
    --av-tick: color-mix(in oklab, var(--ink) 20%, transparent);
    --av-tick-major: color-mix(in oklab, var(--ink) 42%, transparent);
  }
  .av {
    /* Height of the site header, which overlays this chapter because it opens
       on steel. The chapter layout pads `main > :first-child` to clear it, but
       here that first child is the article rather than the ground, so the
       clearance is handed to the sheet below and the steel runs up behind the
       header instead of leaving a pale strip above it. */
    --av-clear: 4.25rem;
    padding-block-start: 0;
  }

  .av-defs {
    position: absolute;
    inline-size: 0;
    block-size: 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* ── Shared drawing conventions ───────────────────────────────────────── */
  .av-hatch { stroke: color-mix(in oklab, var(--ink) 46%, transparent); stroke-width: 0.7; fill: none; }
  .av-hatch--dash { stroke-dasharray: 3 3; }
  .av-hatch--part { stroke: color-mix(in oklab, var(--accent) 70%, transparent); stroke-width: 0.8; }

  .av-ln { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linejoin: miter; }
  .av-ln--fine { stroke-width: 0.9; stroke: var(--av-ink-soft); }
  .av-solid { fill: var(--ink); stroke: none; }
  .av-fill-steel { fill: url(#av-h-steel); }
  .av-fill-part { fill: url(#av-h-part); }
  .av-hid { fill: none; stroke: var(--av-ink-soft); stroke-width: 0.9; stroke-dasharray: 6 4; }
  .av-cl { fill: none; stroke: color-mix(in oklab, var(--accent) 60%, transparent); stroke-width: 0.7; stroke-dasharray: 10 3 2 3; }
  .av-cut { fill: none; stroke: var(--ink); stroke-width: 2; }
  .av-ext { fill: none; stroke: var(--av-ink-soft); stroke-width: 0.7; }
  .av-dim { fill: none; stroke: var(--signal); stroke-width: 0.9; }
  .av-arw { fill: var(--signal); stroke: none; }
  .av-ground { fill: none; stroke: var(--line); stroke-width: 1; }
  .av-part-ln { fill: none; stroke: var(--ink); stroke-width: 1; stroke-dasharray: 14 4 2 4; }
  .av-cutface { fill: none; stroke: var(--ink); stroke-width: 2; }

  /* Drawing annotation reads over hatch, so it carries a paper-coloured halo —
     the drawing-office equivalent of breaking the hatch around a figure. */
  .av-mi {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    fill: var(--ink-muted);
    stroke: var(--surface-raise);
    stroke-width: 3px;
    paint-order: stroke fill;
  }
  .av-fig {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    fill: var(--signal);
    stroke: var(--surface-raise);
    stroke-width: 3.5px;
    paint-order: stroke fill;
  }

  /* ── The balloon. The only place amber lives. ─────────────────────────── */
  .av-bln__c { fill: var(--surface); stroke: var(--signal); stroke-width: 1.3; }
  .av-bln__t {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    fill: var(--signal);
    font-variant-numeric: tabular-nums;
  }
  .av-ldr { fill: none; stroke: var(--signal); stroke-width: 0.9; }
  .av-anchor { fill: var(--signal); stroke: none; }

  .av-bal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    flex: none;
    border: var(--hair) solid var(--signal);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--signal-ink);
    background: transparent;
  }
  .av-bal--sm { inline-size: 1.85rem; block-size: 1.85rem; }

  /* ── Section head: balloon, leader, kicker ────────────────────────────── */
  .av-kick { display: flex; align-items: center; gap: var(--sp-3); }
  .av-lead {
    inline-size: var(--sp-7);
    block-size: var(--hair);
    background: var(--line);
    flex: none;
  }
  .av-head { max-inline-size: 74ch; }
  .av-head .t-lead { margin-block-start: var(--sp-5); max-inline-size: 68ch; }

  .av-h2 {
    margin-block-start: var(--sp-5);
    font-size: clamp(1.85rem, 3.8vw, 3.05rem);
    line-height: 1.07;
    letter-spacing: -0.028em;
    font-weight: 500;
    max-inline-size: 22ch;
  }
  .av-h2--big { max-inline-size: 14ch; font-size: clamp(2.2rem, 5vw, 4rem); }
  .av-h3 { font-size: var(--step-3); line-height: 1.15; letter-spacing: var(--track-head); max-inline-size: 24ch; }
  .av-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); }

  .av-sec { padding-block: var(--section-y); border-block-start: var(--rule); position: relative; }

  .av-close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 66ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: var(--hair-strong) solid var(--signal);
  }
  .av-source { margin-block-start: var(--sp-5); max-inline-size: 70ch; }

  /* ── Sheet frame + tick rulers ────────────────────────────────────────── */
  .av-sheet__frame {
    position: absolute;
    inset: clamp(0.75rem, 2vw, 2rem);
    border: var(--hair) solid var(--av-frame);
    pointer-events: none;
  }
  .av-sheet__frame--close { inset-block-end: clamp(0.75rem, 2vw, 2rem); }
  /* On the opening sheet the border and both rulers begin below the overlaid
     header, so the frame reads as a frame rather than as a line cut in half. */
  .av-sheet > .av-sheet__frame { inset-block-start: calc(var(--av-clear) + clamp(0.75rem, 2vw, 2rem)); }
  .av-sheet > .av-sheet__ruler--block,
  .av-sheet > .av-sheet__ruler--inline { inset-block-start: var(--av-clear); }

  .av-sheet__ruler { position: absolute; pointer-events: none; }
  .av-sheet__ruler--block {
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 12px;
    background-image:
      linear-gradient(90deg, var(--av-tick) 0 1px, transparent 1px),
      linear-gradient(90deg, var(--av-tick-major) 0 1px, transparent 1px);
    background-size: 12px 6px, 60px 12px;
    background-repeat: repeat-x;
  }
  .av-sheet__ruler--inline {
    inset-inline-start: 0;
    inset-block: 0;
    inline-size: 12px;
    background-image:
      linear-gradient(180deg, var(--av-tick) 0 1px, transparent 1px),
      linear-gradient(180deg, var(--av-tick-major) 0 1px, transparent 1px);
    background-size: 6px 12px, 12px 60px;
    background-repeat: repeat-y;
  }

  /* ── Sheet header ─────────────────────────────────────────────────────────
     The chapter opens on steel: `ground--steel` remaps the whole token set and
     `mat--milled` puts a surface-ground finish and a cast grain on it, so the
     drawing that follows is a blueprint rather than a line drawing on paper.
     No background is declared here — the ground class owns it.               */
  .av-sheet {
    position: relative;
    /* The overlaid header is cleared by the sheet itself, so the steel runs
       up behind it. */
    padding-block: calc(var(--av-clear) + clamp(3rem, 7vw, 6rem)) clamp(3rem, 7vw, 6rem);
    overflow: clip;
    --tex-opacity: 0.06;
  }
  /* `.mat--milled` and `[data-tex]` are both implemented on ::before, so an
     element carrying both keeps only one of them: the chapter texture wins the
     background and the milled finish is lost. The grain is what stops a large
     dark field reading as a flat digital rectangle, so the sheet clears what
     the milled rule left behind on that layer and composes the finish onto its
     own second one. Both are the shared tokens — no treatment is restated. */
  .av-sheet::before { background-size: auto; mix-blend-mode: normal; }
  .av-sheet::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--tex-grain), var(--tex-mill);
    background-size: 140px 140px, auto;
    opacity: 0.5;
    mix-blend-mode: overlay;
  }

  /* ── The plate archetype ──────────────────────────────────────────────────
     Copy against a framed plate at a deliberately uneven ratio. The plate is
     the drawing AND its parts list — a document, not a picture in the second
     column — and the title block runs the full width of the sheet beneath
     both, the way a title block runs the width of a drawing.                 */
  .av-sheet__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    grid-template-areas:
      'copy  plate'
      'title title'
      'note  note';
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  .av-sheet__copy { grid-area: copy; }
  .av-sheet__plate { grid-area: plate; }
  .av-title { grid-area: title; }
  .av-sheet__note { grid-area: note; }

  .av-sheet__plate {
    padding: clamp(1rem, 2.4vw, 2rem);
    box-shadow: var(--relief-dark);
  }
  .av-sheet__list { margin-block-start: clamp(1.5rem, 3vw, 2.25rem); }
  /* The balloon punches out of the plate, not out of the ground behind it. */
  .av-sheet .av-bln__c { fill: var(--surface-raise); }
  /* Section hatch on the plate comes from the sheet's own pattern, so it is
     drawn in the steel ground's ink rather than the light ground's. */
  .av-sheet .av-fill-steel { fill: url(#av-h-steel-sheet); }

  @media (max-width: 1000px) {
    .av-sheet__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'copy' 'plate' 'title' 'note';
    }
  }

  .av-sheet__head {
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    font-size: clamp(2.1rem, 3.9vw, 3.5rem);
    line-height: 1.03;
    letter-spacing: -0.032em;
    font-weight: 500;
  }
  .av-sheet__head span { display: block; }
  .av-sheet__head span:last-child { color: var(--av-ink-soft); }

  .av-sheet__orient {
    margin-block-start: var(--sp-5);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    max-inline-size: 46ch;
    line-height: 1.7;
  }
  :global(html[lang='zh']) .av-sheet__orient,
  :global(html[lang='th']) .av-sheet__orient,
  :global(html[lang='ar']) .av-sheet__orient,
  :global(html[lang='fa']) .av-sheet__orient,
  :global(html[lang='ur']) .av-sheet__orient {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--step--1);
  }

  .av-sheet__lead {
    margin-block-start: var(--sp-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 48ch;
  }
  .av-sheet__pivot {
    margin-block-start: var(--sp-6);
    font-size: var(--step-0);
    line-height: 1.6;
    max-inline-size: 50ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: var(--hair-strong) solid var(--signal);
  }

  .av-sheet__fig svg { inline-size: 100%; block-size: auto; }
  .av-sheet__fig .figure-note { margin-block-start: var(--sp-4); }

  /* The sheet draws itself the way it would be drawn: construction and centre
     lines first, then the outline, then the dimensions, then the balloons
     arriving along their leaders. Strokes travel along their own length —
     nothing floats, nothing fades up from nowhere. */
  .av-sheet__fig { --reveal-y: 0px; }
  :global(html.js) .av-sheet__fig .av-cl,
  :global(html.js) .av-sheet__fig .av-hid,
  :global(html.js) .av-sheet__fig .av-part-ln { opacity: 0; }
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-cl,
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-hid,
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-part-ln {
    opacity: 1;
    transition: opacity var(--dur-4) var(--ease-out);
  }
  :global(html.js) .av-sheet__fig .av-ln,
  :global(html.js) .av-sheet__fig .av-cut,
  :global(html.js) .av-sheet__fig .av-ext,
  :global(html.js) .av-sheet__fig .av-dim {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-ln,
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-cut {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1100ms var(--ease-out) 200ms;
  }
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-ext,
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-dim {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 700ms var(--ease-out) 800ms;
  }
  :global(html.js) .av-sheet__fig .av-bln { opacity: 0; }
  :global(html.js) .av-sheet__fig[data-reveal='in'] .av-bln {
    opacity: 1;
    transition: opacity var(--dur-3) var(--ease-out);
    transition-delay: calc(1050ms + var(--i) * 120ms);
  }

  .av-sheet__list-h { display: block; margin-block-end: var(--sp-4); }
  .av-parts { border-block-start: var(--rule-strong); }
  .av-parts__row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
    align-items: start;
  }
  /* Both parts lists live inside a narrow column — the plate on the sheet, the
     copy column in the warp band — so the pair stacks well before the page
     does, rather than becoming two gutters. */
  @media (max-width: 1200px) { .av-parts__row { grid-template-columns: minmax(0, 1fr); gap: var(--sp-2); } }
  .av-parts__row dt { display: flex; align-items: center; gap: var(--sp-3); }
  .av-parts__name { font-size: var(--step--1); font-weight: var(--weight-medium); }
  .av-parts__row dd { font-size: var(--step--1); line-height: 1.55; color: var(--ink-muted); }
  .av-parts--tight { margin-block-start: var(--sp-6); }

  .av-title__h { display: block; margin-block-end: var(--sp-4); }
  /* The shared capability module carries the structure; the sheet only asks
     for the drawing-office frame and a monospaced field value. */
  .av-title__grid { border-color: var(--av-frame); }
  .av-title .cap__v {
    font-family: var(--font-mono);
    font-size: var(--step-0);
    letter-spacing: 0.02em;
  }
  .av-sheet__note { max-inline-size: 52ch; line-height: 1.6; }

  /* ── 01 Component register ────────────────────────────────────────────── */
  .av-map { --station: 0; }
  .av-map__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .av-map__grid { grid-template-columns: minmax(0, 1fr); } }

  .av-map__fig {
    position: sticky;
    inset-block-start: clamp(4.5rem, 10vh, 7rem);
    background: var(--surface-raise);
    border: var(--hair) solid var(--av-frame);
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }
  @media (max-width: 1000px) { .av-map__fig { position: static; } }
  .av-map__fig svg { inline-size: 100%; block-size: auto; }
  .av-map__fig .figure-note { margin-block-start: var(--sp-3); }

  .av-vbln { --d: max(calc(var(--b) - var(--station)), calc(var(--station) - var(--b))); }
  :global(html.js) .av-vbln {
    opacity: calc(0.3 + 0.7 * (1 - min(1, var(--d))));
    transition: opacity var(--dur-3) var(--ease-out);
  }
  :global(html.js) .av-vbln .av-ldr {
    stroke-dasharray: 380;
    stroke-dashoffset: calc(380px * min(1, var(--d)));
    transition: stroke-dashoffset var(--dur-4) var(--ease-out);
  }

  .av-reg__zone + .av-reg__zone { margin-block-start: var(--sp-8); }
  .av-reg__zh { padding-block-end: var(--sp-3); border-block-end: var(--rule-strong); }
  .av-reg__zh h3 { display: block; color: var(--ink); }
  .av-reg__zh p { margin-block-start: var(--sp-2); max-inline-size: 52ch; }

  .av-reg__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    padding-inline-start: var(--sp-4);
    border-block-end: var(--rule);
    align-items: start;
    --d: max(calc(var(--b) - var(--station)), calc(var(--station) - var(--b)));
  }
  .av-reg__row::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block: var(--sp-4);
    inline-size: var(--hair-strong);
    background: var(--signal);
    opacity: 0.28;
  }
  :global(html.js) .av-reg__row {
    opacity: calc(0.46 + 0.54 * (1 - min(1, var(--d))));
    transition: opacity var(--dur-3) var(--ease-out);
  }
  :global(html.js) .av-reg__row::before {
    opacity: calc(1 - min(1, var(--d)));
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .av-reg__name { font-size: var(--step-0); font-weight: var(--weight-medium); line-height: 1.3; }
  .av-reg__note { margin-block-start: var(--sp-2); font-size: var(--step--1); line-height: 1.58; color: var(--ink-muted); }
  /* The material designation is verified capability, so it is a badge with a
     mark and a readable size rather than an 11px tracked-out stamp. */
  .av-reg__mat { margin-block-start: var(--sp-3); }
  .av-reg__mat .badge { font-family: var(--font-mono); letter-spacing: 0.02em; }

  /* ── 02 Material rail ─────────────────────────────────────────────────── */
  .av-mat__rail-h { display: block; margin-block-start: clamp(2rem, 4vw, 3rem); margin-block-end: var(--sp-4); }
  .av-rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16rem, 21rem);
    overflow-x: auto; contain: paint; min-inline-size: 0; max-inline-size: 100%;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--gutter);
    padding-inline: var(--gutter);
    border-block: var(--hair-strong) solid var(--av-frame);
    background: var(--surface-raise);
  }
  .av-rail:focus-visible { outline: var(--focus); outline-offset: calc(var(--focus-offset) * -1); }
  .av-rail__item {
    scroll-snap-align: start;
    padding-block: var(--sp-6) var(--sp-7);
    padding-inline: var(--sp-5);
    border-inline-end: var(--rule);
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }
  .av-rail__item:last-child { border-inline-end: 0; }
  .av-swatch svg { inline-size: 100%; block-size: auto; color: var(--ink); }
  .av-rail__code { font-size: var(--step-1); letter-spacing: 0.02em; color: var(--ink); }
  .av-rail__name { font-size: var(--step--1); color: var(--ink-muted); }
  .av-rail__spec { margin-block-start: var(--sp-3); border-block-start: var(--rule); }
  .av-rail__spec > div { padding-block: var(--sp-3); border-block-end: var(--rule); display: grid; gap: var(--sp-1); }
  .av-rail__spec dd { font-size: var(--step--1); line-height: 1.55; }
  .av-rail__tool { color: var(--ink); }
  .av-rail__foot {
    margin-block-start: var(--sp-4);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
  }
  .av-rail__hint { margin-block-start: var(--sp-4); letter-spacing: 0.1em; text-transform: uppercase; }
  :global(html[lang='zh']) .av-rail__hint,
  :global(html[lang='th']) .av-rail__hint,
  :global(html[lang='ar']) .av-rail__hint,
  :global(html[lang='fa']) .av-rail__hint,
  :global(html[lang='ur']) .av-rail__hint { text-transform: none; letter-spacing: 0; }

  .av-mat__notes {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    border-block-start: var(--rule-strong);
    padding-block-start: var(--sp-6);
  }
  .av-mat__notes li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: start;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  /* ── 03 Inside the tool ───────────────────────────────────────────────── */
  /* The second — and last — textured surface in the chapter. Section hatch on
     the band that cuts the tool open. Felt, not read. */
  .av-tool { background: var(--surface-sunk); --tex-opacity: 0.045; }
  .av-tool__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .av-tool__grid { grid-template-columns: minmax(0, 1fr); } }

  .av-tool__fig {
    position: sticky;
    inset-block-start: clamp(4.5rem, 10vh, 7rem);
    background: var(--surface-raise);
    border: var(--hair) solid var(--av-frame);
    padding: clamp(0.75rem, 2vw, 1.5rem);
  }
  @media (max-width: 1000px) { .av-tool__fig { position: static; } }
  .av-tool__fig svg { inline-size: 100%; block-size: auto; }
  .av-tool__fig .figure-note { margin-block-start: var(--sp-3); }

  .av-pl { fill: none; stroke: var(--ink); stroke-width: 1.8; }
  .av-shut { fill: none; stroke: var(--ink); stroke-width: 2.4; }
  .av-wear { fill: none; stroke: var(--signal); stroke-width: 2.2; }
  .av-rod { fill: none; stroke: var(--ink); stroke-width: 1.2; }
  .av-cool { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-dasharray: 7 4; }
  .av-vent { fill: none; stroke: var(--ink); stroke-width: 3; }
  .av-face { fill: none; stroke: var(--signal); stroke-width: 2.2; }
  .av-detail { fill: none; stroke: var(--av-ink-soft); stroke-width: 0.9; stroke-dasharray: 5 4; }

  :global(html.js) .av-tool .av-sub { opacity: 0.12; transition: opacity var(--dur-3) var(--ease-out); }
  :global(html.js) .av-tool[data-step='0'] .av-sub[data-sub='0'],
  :global(html.js) .av-tool[data-step='1'] .av-sub[data-sub='1'],
  :global(html.js) .av-tool[data-step='2'] .av-sub[data-sub='2'],
  :global(html.js) .av-tool[data-step='3'] .av-sub[data-sub='3'],
  :global(html.js) .av-tool[data-step='4'] .av-sub[data-sub='4'],
  :global(html.js) .av-tool[data-step='5'] .av-sub[data-sub='5'] { opacity: 1; }

  /* Mechanism travel: the slide runs out along its cam, the lifter along its own. */
  :global(html.js) .av-slide,
  :global(html.js) .av-lifter { transition: transform var(--dur-4) var(--ease-mech); }
  :global(html.js) .av-tool[data-step='1'] .av-slide { transform: translateX(34px); }
  :global(html.js) .av-tool[data-step='1'] .av-lifter { transform: translate(13px, -38px); }

  .av-steps { border-block-start: var(--rule-strong); }
  .av-step {
    padding-block: var(--sp-6);
    border-block-end: var(--rule);
  }
  :global(html.js) .av-step { opacity: 0.44; transition: opacity var(--dur-3) var(--ease-out); }
  :global(html.js) .av-tool[data-step='0'] .av-step:nth-child(1),
