---
/**
 * AUTOMOTIVE & HEAVY VEHICLES — the drawing-sheet chapter.
 *
 * This page is composed as engineering documentation rather than as a web page.
 * It opens on a full drawing sheet — inset border, tick rulers, orthographic
 * assembly, title block carrying the verified facts as drawing fields — and it
 * closes on a revision block.
 *
 * The signature motif is the BALLOON-AND-LEADER CALLOUT. Every annotation on the
 * page arrives as a numbered circle at the end of a drawn leader with a short
 * horizontal landing, exactly as a part is ballooned on an assembly drawing.
 * The balloon carries a number and nothing else — the names live in the parts
 * list beside the drawing, which is both the correct convention and the only way
 * a drawing survives translation into nine languages.
 *
 * Amber is rationed to balloons, dimension figures and active states. Everything
 * else is graphite on paper.
 *
 * The argument the page turns on is in the sheet header: a passenger-car maker
 * retools with the model cycle, a heavy-vehicle builder runs the same tool for a
 * decade. That inverts which savings are real.
 */
import type { Locale } from '../../i18n/locales.ts';
import TechNote from '../TechNote.astro';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;

/* ── Drawing geometry ─────────────────────────────────────────────────────
   Coordinates are the component's own, not content: they belong to the
   drawing, never to the translator. */

/** Hero sheet balloons: circle, landing end, anchor dot. */
const SHEET_BALLOONS = [
  { cx: 556, cy: 96, ax: 452, ay: 146 },
  { cx: 556, cy: 168, ax: 400, ay: 210 },
  { cx: 200, cy: 400, ax: 276, ay: 221 },
  { cx: 108, cy: 400, ax: 58, ay: 227 },
];

/** Component-register balloons on the vehicle elevation, in register order. */
const VEHICLE = [
  { bx: 292, by: 44, ax: 216, ay: 160 },
  { bx: 112, by: 44, ax: 140, ay: 190 },
  { bx: 242, by: 336, ax: 176, ay: 172 },
  { bx: 180, by: 336, ax: 150, ay: 200 },
  { bx: 352, by: 44, ax: 300, ay: 224 },
  { bx: 428, by: 336, ax: 350, ay: 231 },
  { bx: 44, by: 44, ax: 62, ay: 150 },
  { bx: 490, by: 336, ax: 390, ay: 252 },
  { bx: 56, by: 336, ax: 66, ay: 204 },
  { bx: 172, by: 44, ax: 150, ay: 148 },
  { bx: 232, by: 44, ax: 186, ay: 138 },
  { bx: 118, by: 336, ax: 104, ay: 208 },
  { bx: 304, by: 336, ax: 232, ay: 236 },
  { bx: 366, by: 336, ax: 270, ay: 232 },
  { bx: 496, by: 44, ax: 450, ay: 219 },
];

/** Balloons for the six mould subsystems, in step order. */
const TOOL_BALLOONS = [
  { cx: 40, cy: 300, ax: 170, ay: 224 },
  { cx: 720, cy: 150, ax: 540, ay: 210 },
  { cx: 720, cy: 96, ax: 386, ay: 150 },
  { cx: 40, cy: 100, ax: 150, ay: 136 },
  { cx: 40, cy: 200, ax: 236, ay: 222 },
  { cx: 720, cy: 330, ax: 500, ay: 210 },
];

/** Anisotropic-shrinkage balloons. */
const WARP_BALLOONS = [
  { cx: 54, cy: 214, ax: 100, ay: 120 },
  { cx: 340, cy: 214, ax: 388, ay: 120 },
  { cx: 520, cy: 214, ax: 462, ay: 152 },
  { cx: 330, cy: 30, ax: 360, ay: 55 },
];

/** Leader geometry: short horizontal landing at the balloon, then a straight run. */
function leader(p: { cx?: number; cy?: number; bx?: number; by?: number; ax: number; ay: number }, r: number) {
  const cx = p.cx ?? p.bx ?? 0;
  const cy = p.cy ?? p.by ?? 0;
  const dir = p.ax >= cx ? 1 : -1;
  const land = cx + dir * (r + 14);
  return `M${cx + dir * r} ${cy} H${land} L${p.ax} ${p.ay}`;
}

/* ── Register: four zones flattened to one balloon sequence ─────────────── */
const zones = (b.parts?.zones ?? []) as any[];
let acc = 0;
const zoneBlocks = zones.map((z: any) => {
  const start = acc;
  const items = (z.items ?? []) as any[];
  acc += items.length;
  return { name: z.name, note: z.note, items, start };
});
const partItems = zoneBlocks.flatMap((z: any) => z.items);

/* Cumulative tolerance envelope, per grade. Half-band added by each part. */
const ENVELOPE = [11, 6];
const toolSteps = (b.tool?.steps ?? []) as any[];
const lifeMarkers = (b.life?.markers ?? []) as any[];
const routeItems = (b.routes?.items ?? []) as any[];
const grades = (b.fit?.grades ?? []) as any[];

/* The two letters on the cutting plane are the first half of the section mark
   the content already carries ("A–A" → "A"), so the cut and the view it names
   can never disagree and neither is left hard-coded in the template. */
const sectionLetter = String(b.sheet?.sectionMark ?? '').split(/[-–—/\s]+/).filter(Boolean)[0] ?? '';
---

<article class="av">

  {/* ── Shared drawing definitions. One set of ids for the whole chapter. ── */}
  <svg class="av-defs" data-nomirror aria-hidden="true" focusable="false">
    <defs>
      <pattern id="av-h-a" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V10" class="av-hatch" />
      </pattern>
      <pattern id="av-h-b" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V7" class="av-hatch" />
      </pattern>
      <pattern id="av-h-c" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
        <path d="M0 0 V5" class="av-hatch" />
      </pattern>
      <pattern id="av-h-d" width="13" height="13" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V13" class="av-hatch" />
      </pattern>
      <pattern id="av-h-e" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V8 M0 0 H8" class="av-hatch" />
      </pattern>
      <pattern id="av-h-f" width="15" height="15" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
        <path d="M0 0 V15" class="av-hatch" />
      </pattern>
      <pattern id="av-h-g" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V9" class="av-hatch av-hatch--dash" />
      </pattern>
      <pattern id="av-h-h" width="17" height="17" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
        <path d="M0 0 V17" class="av-hatch" />
      </pattern>
      {/* Steel is hatched at +45°, the moulded part at −45°, as a section is drawn. */}
      <pattern id="av-h-steel" width="11" height="11" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <path d="M0 0 V11" class="av-hatch" />
      </pattern>
      <pattern id="av-h-part" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
        <path d="M0 0 V6" class="av-hatch av-hatch--part" />
      </pattern>
      <marker id="av-arw-e" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 1 L9 5 L0 9" class="av-arw" />
      </marker>
      <marker id="av-arw-s" viewBox="0 0 10 10" refX="1" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M10 1 L1 5 L10 9" class="av-arw" />
      </marker>
    </defs>
  </svg>

  {/* ═══ SHEET HEADER ══════════════════════════════════════════════════════ */}
  <header class="av-sheet ground--steel mat mat--milled" data-tex="hatch">
    <div class="av-sheet__frame" aria-hidden="true"></div>
    <div class="av-sheet__ruler av-sheet__ruler--block" aria-hidden="true"></div>
    <div class="av-sheet__ruler av-sheet__ruler--inline" aria-hidden="true"></div>

    <div class="shell--wide av-sheet__inner">
      <div class="av-sheet__copy">
        <p class="av-kick">
          <span class="av-bal">{b.sheet.index}</span>
          <span class="av-lead" aria-hidden="true"></span>
          <span class="t-label">{content.hero.kicker}</span>
        </p>

        {/* The orientation line is a sheet field, so it sits with the sheet
            number rather than under the statement. */}
        <p class="av-sheet__orient t-mono">{b.sheet.orientation}</p>

        <h1 class="av-sheet__head">
          {content.hero.headline.map((line: string, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>

        <p class="av-sheet__lead">{content.hero.lead}</p>
        <p class="av-sheet__pivot">{b.sheet.pivot}</p>
      </div>

      {/* ── The plate ───────────────────────────────────────────────────────
           The drawing is not a picture in the right-hand column: it is a
           document, framed, with its own parts list under a rule, handed to
           the reader on the chapter's steel. ─────────────────────────────── */}
      <div class="av-sheet__plate plate plate--tick">
        <figure class="av-sheet__fig" data-reveal>
          <svg viewBox="0 0 600 440" data-nomirror role="img" aria-label={b.sheet.figureLabel}>
            {/* A pattern resolves its tokens where it is DEFINED, not where it
                is used. The chapter's shared set sits on the light ground, so
                the section hatch taken from there would be drawn in near-black
                on this steel plate and disappear. The sheet keeps its own copy
                inside the ground, which inherits the remapped ink — the same
                token, resolved in the right place, no colour restated. */}
            <defs>
              <pattern id="av-h-steel-sheet" width="11" height="11" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <path d="M0 0 V11" class="av-hatch" />
              </pattern>
            </defs>

            {/* ── Front elevation ───────────────────────────────────────── */}
            <g transform="translate(60 60)">
              <path d="M0 150 h230 v34 h-230 z" class="av-ln" />
              <path d="M18 150 v-92" class="av-ln" />
              <path d="M76 150 v-92" class="av-ln" />
              <circle cx="47" cy="48" r="29" class="av-ln" />
              <circle cx="47" cy="48" r="13" class="av-ln" />
              <path d="M76 150 v-44 l70 44 z" class="av-ln" />
              <circle cx="180" cy="167" r="8" class="av-ln" />
              <circle cx="210" cy="167" r="8" class="av-ln" />
              {/* External undercut — a groove in the end face, formed by a slide */}
              <path d="M230 156 h-18 v10 h18" class="av-ln" />
              {/* Gate mark on the end face */}
              <path d="M0 161 l-9 6 l9 6 z" class="av-solid" />
              {/* Hidden detail — the bore behind the cut plane */}
              <path d="M34 58 v92 M60 58 v92" class="av-hid" />
              {/* Centre lines */}
              <path d="M47 8 v196" class="av-cl" />
              <path d="M4 48 h90" class="av-cl" />
              <path d="M168 167 h54 M180 153 v28 M210 153 v28" class="av-cl" />
              {/* Cutting plane */}
              <path d="M47 2 v14 M47 190 v14" class="av-cut" />
              <text x="56" y="12" class="av-mi">{sectionLetter}</text>
              <text x="56" y="212" class="av-mi">{sectionLetter}</text>
              {/* Overall dimension */}
              <path d="M0 188 v22 M230 188 v22" class="av-ext" />
              <path d="M0 204 H230" class="av-dim" marker-start="url(#av-arw-s)" marker-end="url(#av-arw-e)" />
              <text x="115" y="199" text-anchor="middle" class="av-fig">{b.sheet.dimWidth}</text>
            </g>

            {/* ── Section A–A ───────────────────────────────────────────── */}
            <g transform="translate(370 60)">
              <path d="M0 150 h150 v34 h-150 z" class="av-ln av-fill-steel" />
              <path d="M18 40 h16 v110 h-16 z" class="av-ln av-fill-steel" />
              <path d="M60 40 h16 v110 h-16 z" class="av-ln av-fill-steel" />
              <path d="M-16 150 H166" class="av-part-ln" />
              <path d="M47 20 v180" class="av-cl" />
              <path d="M34 56 v28 M60 56 v28" class="av-ext" />
              <path d="M34 70 H60" class="av-dim" marker-start="url(#av-arw-s)" marker-end="url(#av-arw-e)" />
              <text x="47" y="50" text-anchor="middle" class="av-fig">{b.sheet.dimBore}</text>
              <text x="75" y="212" text-anchor="middle" class="av-mi">{b.sheet.sectionMark}</text>
            </g>

            {/* ── Balloons ─────────────────────────────────────────────── */}
            {SHEET_BALLOONS.map((p: any, i: number) => (
              <g class="av-bln" style={`--i:${i}`}>
                <path d={leader(p, 13)} class="av-ldr" />
                <circle cx={p.ax} cy={p.ay} r="2.8" class="av-anchor" />
                <circle cx={p.cx} cy={p.cy} r="13" class="av-bln__c" />
                <text x={p.cx} y={p.cy + 3.8} text-anchor="middle" class="av-bln__t">
                  {b.sheet.balloons[i]?.n}
                </text>
              </g>
            ))}
          </svg>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>

        {/* ── Parts list, on the plate under the drawing ──────────────────── */}
        <div class="av-sheet__list">
          <p class="t-label av-sheet__list-h">{b.sheet.legendLabel}</p>
          <dl class="av-parts">
            {b.sheet.balloons.map((item: any) => (
              <div class="av-parts__row">
                <dt><span class="av-bal av-bal--sm">{item.n}</span><span class="av-parts__name">{item.label}</span></dt>
                <dd>{item.note}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>

      {/* ── Title block ─────────────────────────────────────────────────────
           A drawing's title block runs the width of the sheet, and it carries
           the verified capability of this shop. Set as capability fields so a
           buyer reads them, not as an 11px stamp strip. ─────────────────── */}
      <div class="av-title">
        <p class="t-label av-title__h">{b.sheet.titleBlockLabel}</p>
        <dl class="caps caps--tight av-title__grid">
          {b.sheet.fields.map((f: any) => (
            <div class="cap">
              <dt class="cap__k">{f.k}</dt>
              <dd class="cap__v">{f.v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <p class="av-sheet__note t-fine">{b.sheet.borderNote}</p>
    </div>
  </header>

  {/* ═══ 01 · COMPONENT REGISTER ══════════════════════════════════════════ */}
  <section class="av-sec av-map" id="register" data-stepper>
    <div class="shell--wide">
      <div class="av-head">
        <p class="av-kick">
          <span class="av-bal">{b.parts.index}</span>
          <span class="av-lead" aria-hidden="true"></span>
          <span class="t-label">{b.parts.kicker}</span>
        </p>
        <h2 class="av-h2">{b.parts.heading}</h2>
        <p class="t-lead">{b.parts.body}</p>
      </div>

      <div class="av-map__grid">
        <figure class="av-map__fig">
          <svg viewBox="0 0 560 380" data-nomirror role="img" aria-label={b.parts.figureLabel}>
            <g class="av-veh">
              <path d="M20 288 H540" class="av-ground" />
              {/* Cab */}
              <path d="M70 218 v-72 l18 -34 h118 v106 z" class="av-ln" />
              <path d="M92 142 l12 -22 h96 v22 z" class="av-ln av-ln--fine" />
              <path d="M112 218 v-68 h56 v68" class="av-ln av-ln--fine" />
              {/* Mirror */}
              <path d="M88 132 l-28 -12 M60 120 v34" class="av-ln av-ln--fine" />
              <path d="M52 146 h12 v26 h-12 z" class="av-ln av-ln--fine" />
              {/* Marker lamp */}
              <path d="M70 196 h-10 v18 h10" class="av-ln av-ln--fine" />
              {/* Engine bay, hidden */}
              <path d="M96 156 h100 v60 h-100 z" class="av-hid" />
              {/* Intake stack */}
              <path d="M208 130 h14 v88 h-14 z" class="av-ln av-ln--fine" />
              {/* Body */}
              <path d="M220 118 h284 v100 h-284 z" class="av-ln" />
              {/* Chassis rails */}
              <path d="M74 218 H496 M74 230 H496 M74 218 v12 M496 218 v12" class="av-ln av-ln--fine" />
              {/* Tank */}
              <path d="M240 234 h84 v34 h-84 z" class="av-ln av-ln--fine" />
              {/* Arches */}
              <path d="M100 218 a36 36 0 0 1 72 0" class="av-ln av-ln--fine" />
              <path d="M352 218 a38 38 0 0 1 76 0" class="av-ln av-ln--fine" />
              <path d="M424 218 a38 38 0 0 1 76 0" class="av-ln av-ln--fine" />
              {/* Wheels */}
              {[136, 390, 462].map((x: any) => (
                <g>
                  <circle cx={x} cy="252" r="34" class="av-ln" />
                  <circle cx={x} cy="252" r="15" class="av-ln av-ln--fine" />
                  <path d={`M${x - 26} 252 h52 M${x} 226 v52`} class="av-cl" />
                </g>
              ))}
            </g>

            {partItems.map((item: any, i: number) => {
              const p = VEHICLE[i] ?? VEHICLE[0];
              return (
                <g class="av-bln av-vbln" style={`--b:${i}`}>
                  <path d={leader(p, 12)} class="av-ldr" />
                  <circle cx={p.ax} cy={p.ay} r="2.6" class="av-anchor" />
                  <circle cx={p.bx} cy={p.by} r="12" class="av-bln__c" />
                  <text x={p.bx} y={p.by + 3.6} text-anchor="middle" class="av-bln__t">{item.n}</text>
                </g>
              );
            })}
          </svg>
          <figcaption class="figure-note">{common.schematic}</figcaption>
        </figure>

        <div class="av-reg">
          {zoneBlocks.map((zone: any) => (
            <section class="av-reg__zone">
              <header class="av-reg__zh">
                <h3 class="t-label">{zone.name}</h3>
                <p class="t-fine">{zone.note}</p>
              </header>
              <ol class="av-reg__rows">
                {zone.items.map((item: any, j: number) => (
                  <li
                    class="av-reg__row"
                    data-station-step={zone.start + j}
                    style={`--b:${zone.start + j}`}
                  >
                    <span class="av-bal av-bal--sm">{item.n}</span>
                    <div class="av-reg__body">
                      <h4 class="av-reg__name">{item.name}</h4>
                      <p class="av-reg__note">{item.note}</p>
                      <p class="av-reg__mat"><span class="badge">{item.material}</span></p>
                    </div>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </div>

      <p class="av-close">{b.parts.close}</p>
    </div>
  </section>

  {/* ═══ 02 · MATERIAL RAIL — breaks the vertical rhythm ══════════════════ */}
  <section class="av-sec av-mat" id="material">
    <div class="shell--wide">
      <div class="av-head">
        <p class="av-kick">
          <span class="av-bal">{b.materials.index}</span>
          <span class="av-lead" aria-hidden="true"></span>
          <span class="t-label">{b.materials.kicker}</span>
        </p>
        <h2 class="av-h2">{b.materials.heading}</h2>
        <p class="t-lead">{b.materials.body}</p>
      </div>
      <p class="t-label av-mat__rail-h">{b.materials.railLabel}</p>
    </div>

    <div class="av-rail" tabindex="0" role="group" aria-label={b.materials.railLabel}>
      {b.materials.items.map((m: any, i: number) => (
        <article class="av-rail__item" style={`--i:${i}`}>
          <div class="av-swatch">
            <svg viewBox="0 0 200 90" data-nomirror aria-hidden="true" focusable="false">
              <path d="M10 14 h180 v62 h-180 z" class="av-ln" style={`fill:url(#av-h-${m.hatch})`} />
              <path d="M10 14 H190" class="av-cutface" />
            </svg>
          </div>
          <p class="av-rail__code t-mono">{m.code}</p>
          <p class="av-rail__name">{m.name}</p>
          <dl class="av-rail__spec">
            <div><dt class="t-label">{b.materials.headings.shrink}</dt><dd class="t-mono">{m.shrink}</dd></div>
            <div><dt class="t-label">{b.materials.headings.use}</dt><dd>{m.use}</dd></div>
            <div><dt class="t-label">{b.materials.headings.tool}</dt><dd class="av-rail__tool">{m.tool}</dd></div>
          </dl>
        </article>
      ))}
    </div>

    <div class="shell--wide">
      <div class="av-rail__foot">
        <p class="figure-note">{common.schematic}</p>
        <p class="av-rail__hint t-fine">{common.a11y.scrollForMore}</p>
      </div>
      <TechNote locale={locale} kind="reasoning" class="av-mat__note">
      <ol class="av-mat__notes">
        {b.materials.notes.map((n: string, i: number) => (
          <li><span class="av-bal av-bal--sm">{String(i + 1).padStart(2, '0')}</span><span>{n}</span></li>
        ))}
      </ol>
      </TechNote>
      <p class="av-source t-fine">{b.materials.sourceNote}</p>
    </div>
  </section>

  {/* ═══ 03 · INSIDE THE TOOL ═════════════════════════════════════════════ */}
  <section class="av-sec av-tool" id="tool" data-stepper data-tex="hatch">
    <div class="shell--wide">
      <div class="av-head">
        <p class="av-kick">
          <span class="av-bal">{b.tool.index}</span>
          <span class="av-lead" aria-hidden="true"></span>
          <span class="t-label">{b.tool.kicker}</span>
        </p>
        <h2 class="av-h2">{b.tool.heading}</h2>
        <p class="t-lead">{b.tool.body}</p>
      </div>

      <div class="av-tool__grid">
        <figure class="av-tool__fig">
          <svg viewBox="0 0 760 480" data-nomirror role="img" aria-label={b.tool.figureLabel}>
            {/* Base assembly — always legible */}
            <g class="av-asm">
              <path d="M80 70 h600 v154 h-180 v-30 h-240 v30 h-180 z" class="av-ln av-fill-steel" />
              <path d="M80 378 h600 v-154 h-194 v-18 h-212 v18 h-194 z" class="av-ln av-fill-steel" />
              <path d="M80 378 h56 v70 h-56 z" class="av-ln av-fill-steel" />
              <path d="M624 378 h56 v70 h-56 z" class="av-ln av-fill-steel" />
              <path d="M260 224 v-30 h240 v30 h-14 v-18 h-212 v18 z" class="av-ln av-fill-part" />
              <path d="M380 30 v420" class="av-cl" />
            </g>

            {/* 01 The split */}
            <g class="av-sub" data-sub="0">
              <path d="M40 224 H720" class="av-pl" />
              <path d="M256 194 H206 M256 224 H206" class="av-ext" />
              <path d="M212 194 V224" class="av-dim" marker-start="url(#av-arw-s)" marker-end="url(#av-arw-e)" />
              <path d="M260 224 v-14 M500 224 v-14" class="av-shut" />
            </g>

            {/* 02 The mechanisms */}
            <g class="av-sub" data-sub="1">
              <g class="av-slide">
