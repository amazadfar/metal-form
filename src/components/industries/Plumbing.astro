            <section class="plm-calc__col plm-calc__col--out">
              <h3 class="t-label">{b.economics.outputsHeading}</h3>
              <dl>
                {(b.economics.outputs ?? []).map((r: any) => (
                  <div><dt>{r.k}</dt><dd class="t-mono">{r.v}</dd></div>
                ))}
