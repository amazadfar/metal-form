---
/**
 * PLUMBING & CONSTRUCTION — the catalogue chapter.
 *
 * Structural identity: a parts catalogue. A persistent drawing-sheet rail runs
 * the whole page carrying the section index; every band inside it is a grid, a
 * ledger row or a table row. There is not a card on the page, because a fitting
 * manufacturer does not think in cards — they think in a matrix of part numbers
 * against diameters, and that matrix is the product.
 *
 * The argument: one geometry becomes ninety part numbers, and the tooling
 * decision is which of them get their own mould base and which share a frame.
 * Everything after that — mechanism, thread, resin, agreement, arithmetic —
 * is the engineering that decides whether the answer holds.
 *
 * Colour logic, enforced in every drawing: accent is polymer, signal is metal.
 * Motion logic: indexing, not animating. Things arrive in discrete steps.
 */
import type { Locale } from '../../i18n/locales.ts';
import TechNote from '../TechNote.astro';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;

/* ── Orthographic fitting silhouettes ──────────────────────────────────────
   One 120 × 100 frame, one line weight, one nominal bore, so the twelve read
   at true relative scale against each other. `o` is the polymer outline,
   `d` the internal detail, `m` the metal insert. */
const G: Record<string, { o: string; d?: string; m?: string }> = {
  el90: {
    o: 'M34 92 V26 H94 V54 H62 V92 Z',
    d: 'M34 78 H62 M80 26 V54',
  },
  el45: {
    o: 'M34 90 V48 L68 16 L86 34 L62 58 V90 Z',
    d: 'M34 78 H62',
  },
  teeEq: {
    o: 'M18 32 H102 V60 H74 V92 H46 V60 H18 Z',
    d: 'M32 32 V60 M88 32 V60 M46 80 H74',
  },
  teeRd: {
    o: 'M18 32 H102 V60 H70 V86 H50 V60 H18 Z',
    d: 'M32 32 V60 M88 32 V60 M50 76 H70',
  },
  socket: {
    o: 'M22 34 H98 V66 H22 Z',
    d: 'M60 34 V66 M38 34 V66 M82 34 V66',
  },
  socketRd: {
    o: 'M22 32 H60 V40 H98 V60 H60 V68 H22 Z',
    d: 'M40 32 V68 M80 40 V60',
  },
  cap: {
    o: 'M28 34 H72 a16 16 0 0 1 0 32 H28 Z',
    d: 'M44 34 V66',
  },
  adM: {
    o: 'M22 34 H58 V66 H22 Z',
    d: 'M38 34 V66',
    m: 'M58 38 H96 V62 H58 Z M60 38 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 M60 62 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4 l3 4 l3 -4',
  },
  adF: {
    o: 'M22 34 H62 V66 H22 Z M62 28 H80 L92 34 V66 L80 72 H62 Z',
    d: 'M38 34 V66',
    m: 'M66 40 h20 M66 47 h20 M66 53 h20 M66 60 h20',
  },
  union: {
    o: 'M18 38 H46 V62 H18 Z M74 38 H102 V62 H74 Z M46 28 H74 V72 H46 Z',
    d: 'M57 44 h6 v12 h-6 z M46 50 H74',
  },
  wall: {
    o: 'M40 92 V34 H84 V58 H64 V92 Z M84 24 H100 V68 H84 Z',
    d: 'M40 80 H64 M92 32 m-3.5 0 a3.5 3.5 0 1 0 7 0 a3.5 3.5 0 1 0 -7 0 M92 60 m-3.5 0 a3.5 3.5 0 1 0 7 0 a3.5 3.5 0 1 0 -7 0',
  },
  valve: {
    o: 'M20 40 H100 V70 H20 Z M50 40 V26 H70 V40 M44 18 H76 V26 H44 Z',
    d: 'M60 55 m-14 0 a14 14 0 1 0 28 0 a14 14 0 1 0 -28 0 M34 40 V70 M86 40 V70',
  },
};

const plate = (b.plate?.cells ?? []) as any[];

/* ── Range matrix arithmetic ───────────────────────────────────────────────
   Counted from the matrix itself so the copy and the drawing cannot drift. */
const MX = (b.range?.matrix ?? []) as number[][];
const FLAT = MX.flat();
const dedicated = FLAT.filter((v) => v === 1).length;
const frameCells = FLAT.filter((v) => v === 2).length;
const positions = dedicated + frameCells;
const frames = (b.range?.frames ?? []).length;
const A = b.range?.arith ?? {};
const STRAT: Record<string, Array<{ k: string; v: string }>> = {
  split: [
    { k: A.positions, v: String(positions) },
    { k: A.bases, v: String(positions) },
    { k: A.inserts, v: '0' },
  ],
  family: [
    { k: A.positions, v: String(positions) },
    { k: A.dedicated, v: String(dedicated) },
    { k: A.frames, v: String(frames) },
    { k: A.bases, v: String(dedicated + frames) },
    { k: A.inserts, v: String(frameCells) },
  ],
};
const views = (b.range?.views ?? []) as any[];
const diameters = (b.range?.diameters ?? []) as string[];

/* ── Drawing helpers ───────────────────────────────────────────────────────
   Geometry only. Nothing here produces human-readable text. */
function zig(x0: number, y0: number, x1: number, y1: number, n: number, amp: number) {
  const dx = (x1 - x0) / n;
  const dy = (y1 - y0) / n;
  let d = `M${x0} ${y0}`;
  for (let i = 0; i < n; i++) {
    const mx = (x0 + dx * (i + 0.5)).toFixed(1);
    const my = (y0 + dy * (i + 0.5) + amp).toFixed(1);
    const ex = (x0 + dx * (i + 1)).toFixed(1);
    const ey = (y0 + dy * (i + 1)).toFixed(1);
    d += ` L${mx} ${my} L${ex} ${ey}`;
  }
  return d;
}

const SLOTS = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * Math.PI * 2;
  return {
    x1: (140 + Math.cos(a) * 34).toFixed(1),
    y1: (150 + Math.sin(a) * 34).toFixed(1),
    x2: (140 + Math.cos(a) * 84).toFixed(1),
    y2: (150 + Math.sin(a) * 84).toFixed(1),
  };
});

const PINION = Array.from({ length: 16 }, (_, i) => {
  const a = (i / 16) * Math.PI * 2;
  return {
    x1: (132 + Math.cos(a) * 44).toFixed(1),
    y1: (150 + Math.sin(a) * 44).toFixed(1),
    x2: (132 + Math.cos(a) * 52).toFixed(1),
    y2: (150 + Math.sin(a) * 52).toFixed(1),
  };
});

/* Cavity-to-cavity bore spread. Synthetic and labelled as a schematic: a real
   distribution belongs to a real tool, not to a web page. */
const BORES = [80, 82.5, 83, 84, 84.5, 85, 86, 81, 83.5, 85.5, 87, 82, 84];

const TAPER = zig(36, 108, 252, 134, 18, 12);
const PARALLEL = zig(36, 112, 236, 112, 17, 12);
const CORE_TOP = zig(210, 126, 340, 126, 10, -10);
const CORE_BOT = zig(210, 174, 340, 174, 10, 10);
const RACK_TEETH = zig(56, 202, 188, 202, 8, -9);

const threadFigs = (b.thread?.figures ?? []) as any[];
const mechs = (b.mechanism?.options ?? []) as any[];
const collapsible = mechs[0] ?? {};
const unscrewing = mechs[1] ?? {};
---

<article class="plm">

  {/* ═══ HERO — the index ═════════════════════════════════════════════════
       The opening is a catalogue sheet, not a statement with a drawing beside
       it. A masthead title block sits above; under it the twelve fitting types
       are ruled into one numbered grid with a caption rail at its head. The
       reader's first impression of this chapter is a range, which is the
       chapter's whole argument. Hatch — section hatch, cut steel — carries the
       ground behind it. ═══════════════════════════════════════════════════ */}
  <header class="plm-hero" data-tex="hatch">
    <div class="shell--wide">

      {/* Title block. Copy sits above the index and does not dominate it. */}
      <div class="plm-mast">
        <p class="eyebrow plm-mast__eb">{content.hero.kicker}</p>
        <h1 class="plm-hero__head">
          {content.hero.headline.map((line: any) => <span>{line}</span>)}
        </h1>
        <div class="plm-mast__side">
          <p class="plm-hero__lead">{content.hero.lead}</p>
          {content.hero.markers && (
            <ul class="badges plm-hero__markers">
              {content.hero.markers.map((m: any) => <li class="badge">{m}</li>)}
            </ul>
          )}
        </div>
      </div>

      {/* The index. One sheet, one border, twelve numbered cells. */}
      <div class="plm-sheet">
        <div class="plm-sheet__rail">
          <p class="t-label">{b.plate.label}</p>
          <ul class="plm-key">
            <li><span class="plm-key__sw plm-key__sw--poly"></span>{b.plate.keyPolymer}</li>
            <li><span class="plm-key__sw plm-key__sw--metal"></span>{b.plate.keyMetal}</li>
          </ul>
        </div>

        <div class="plm-plate" data-reveal style="--reveal-y:0px">
          {plate.map((c: any, i: number) => (
            <figure class="plm-cell" style={`--i:${i}`}>
              <span class="plm-cell__i t-mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <svg viewBox="0 0 120 100" data-nomirror aria-hidden="true">
                <path d={G[c.id]?.o ?? ''} class="plm-g plm-g--o" />
                {G[c.id]?.d && <path d={G[c.id].d} class="plm-g plm-g--d" />}
                {G[c.id]?.m && <path d={G[c.id].m} class="plm-g plm-g--m" />}
              </svg>
              <figcaption class="plm-cell__cap">
                <span class="plm-cell__name">{c.name}</span>
                <span class="plm-cell__meta">
                  <span class="t-mono">{c.code}</span>
                  <span class="t-mono">{c.range}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="plm-plate__foot">
        <p class="plm-plate__note">{b.plate.note}</p>
        <p class="figure-note">{common.schematic}</p>
      </div>
    </div>
  </header>

  {/* ═══ 01 · THE RANGE ═══════════════════════════════════════════════════ */}
  <section class="plm-band plm-band--anchor on-steel" id="plm-range" data-tex="hatch">
    <div class="shell--wide plm-band__inner">
      <div class="plm-rail"><p class="plm-rail__i t-mono">{b.range.index}</p></div>
      <div class="plm-band__body">
        <div class="plm-head">
          <p class="eyebrow">{b.range.kicker}</p>
          <h2 class="plm-h2">{b.range.heading}</h2>
          <p class="t-lead">{b.range.body}</p>
          <p class="plm-head__sub t-small">{b.range.body2}</p>
        </div>

        <div class="plm-strat" data-tabs>
          <div class="plm-strat__tabs" role="tablist" aria-label={b.range.tabsLabel}>
            {views.map((v: any) => (
              <button
                class="plm-strat__tab"
                type="button"
                role="tab"
                data-tab={v.id}
                aria-selected="false"
                id={`plm-tab-${v.id}`}
                aria-controls={`plm-panel-${v.id}`}
              >{v.name}</button>
            ))}
          </div>

          {views.map((v: any) => (
            <div
              class="plm-strat__panel"
              data-panel={v.id}
              role="tabpanel"
              id={`plm-panel-${v.id}`}
              aria-labelledby={`plm-tab-${v.id}`}
              hidden
            >
              <p class="plm-strat__hl">{v.headline}</p>
              <p class="plm-strat__note">{v.note}</p>
              <dl class="caps plm-strat__caps">
                {(STRAT[v.id] ?? []).map((row: any) => (
                  <div class="cap cap--fig">
                    <dt class="cap__k">{row.k}</dt>
                    <dd class="cap__v">{row.v}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}

          <p class="t-label plm-mx__cap">{b.range.matrixLabel}</p>
          <div class="plm-mx__scroll">
            <table class="plm-mx">
              <thead>
                <tr>
                  <th scope="col" class="plm-mx__corner">{b.range.typeColumn}</th>
                  {diameters.map((d: string, ci: number) => (
                    <th scope="col" class="t-mono" style={`--c:${ci}`}>{d}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {MX.map((row: number[], ri: number) => (
                  <tr>
                    <th scope="row">{plate[ri]?.name}</th>
                    {row.map((s: number, ci: number) => (
                      <td data-s={s} style={`--c:${ci}`}>
                        {s > 0 && <span class="plm-mx__m" aria-hidden="true"></span>}
                        <span class="vh">
                          {s === 1 ? b.range.legend.dedicated : s === 2 ? b.range.legend.frame : b.range.legend.absent}
                        </span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <ul class="plm-mx__key">
            <li><span class="plm-mx__m plm-mx__m--ded"></span>{b.range.legend.dedicated}</li>
            <li><span class="plm-mx__m plm-mx__m--fr"></span>{b.range.legend.frame}</li>
          </ul>

          <div class="plm-frames">
            <p class="t-label">{b.range.framesLabel}</p>
            <ol class="plm-frames__list">
              {(b.range.frames ?? []).map((f: any) => (
                <li><span class="plm-frames__n">{f.name}</span><span class="t-mono">{f.span}</span></li>
              ))}
            </ol>
          </div>
        </div>

        <TechNote locale={locale} kind="detail">
          <div class="plm-notes">
            {(b.range.notes ?? []).map((n: any, i: number) => (
              <div class="plm-notes__item" data-reveal style={`--reveal-delay:${i * 90}ms`}>
                <h3 class="plm-h5">{n.heading}</h3>
                <p>{n.body}</p>
              </div>
            ))}
          </div>
        </TechNote>

        <p class="plm-close">{b.range.close}</p>
      </div>
    </div>
  </section>

  {/* ═══ 02 · MECHANISM ═══════════════════════════════════════════════════ */}
  <section class="plm-band plm-band--sunk" id="plm-mechanism">
    <div class="shell--wide plm-band__inner">
      <div class="plm-rail"><p class="plm-rail__i t-mono">{b.mechanism.index}</p></div>
      <div class="plm-band__body">
        <div class="plm-head">
          <p class="eyebrow">{b.mechanism.kicker}</p>
          <h2 class="plm-h2">{b.mechanism.heading}</h2>
          <p class="t-lead">{b.mechanism.body}</p>
        </div>

        <TechNote locale={locale} kind="reasoning">
          <div class="plm-mech">
            {/* ── Collapsible core ──────────────────────────────────────── */}
            <figure class="plm-mech__col" data-reveal>
              <h3 class="plm-h4">{collapsible.name}</h3>
              <p class="plm-mech__sum">{collapsible.summary}</p>
              <svg viewBox="0 0 490 300" data-nomirror role="img" aria-label={collapsible.figureLabel} class="plm-dwg">
                <defs>
                  <pattern id="plm-cc-h" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="7" stroke="var(--accent-deep)" stroke-width="0.8" opacity="0.4" />
                  </pattern>
                  <marker id="plm-cc-a" markerWidth="9" markerHeight="8" refX="8.5" refY="4" orient="auto">
                    <path d="M0 0 L9 4 L0 8 Z" fill="var(--accent)" />
                  </marker>
                </defs>
  
                {/* Plan section — looking along the core axis. */}
                <circle cx="140" cy="150" r="84" class="plm-l" />
                <circle cx="140" cy="150" r="68" class="plm-phantom" />
                <circle cx="140" cy="150" r="32" style="fill:url(#plm-cc-h)" class="plm-l" />
                {SLOTS.map((s: any) => (
                  <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class="plm-l plm-l--thin" />
                ))}
                <line x1="244" y1="150" x2="232" y2="150" class="plm-arw" marker-end="url(#plm-cc-a)" />
                <line x1="36" y1="150" x2="48" y2="150" class="plm-arw" marker-end="url(#plm-cc-a)" />
                <line x1="140" y1="46" x2="140" y2="58" class="plm-arw" marker-end="url(#plm-cc-a)" />
                <line x1="140" y1="254" x2="140" y2="242" class="plm-arw" marker-end="url(#plm-cc-a)" />
                <line x1="56" y1="150" x2="224" y2="150" class="plm-cl" />
                <line x1="140" y1="66" x2="140" y2="234" class="plm-cl" />
  
                {/* Side section — pin, sleeve, flanges and the head space. */}
                <line x1="390" y1="26" x2="390" y2="286" class="plm-cl" />
                <rect x="380" y="46" width="20" height="160" style="fill:url(#plm-cc-h)" class="plm-l" />
                <rect x="356" y="206" width="68" height="20" style="fill:url(#plm-cc-h)" class="plm-l" />
                <rect x="350" y="66" width="30" height="110" style="fill:url(#plm-cc-h)" class="plm-l" />
                <rect x="400" y="66" width="30" height="110" style="fill:url(#plm-cc-h)" class="plm-l" />
                <rect x="332" y="176" width="48" height="16" style="fill:url(#plm-cc-h)" class="plm-l" />
                <rect x="400" y="176" width="48" height="16" style="fill:url(#plm-cc-h)" class="plm-l" />
                <line x1="358" y1="72" x2="358" y2="170" class="plm-phantom" />
                <line x1="368" y1="72" x2="368" y2="170" class="plm-phantom" />
                <line x1="412" y1="72" x2="412" y2="170" class="plm-phantom" />
                <line x1="422" y1="72" x2="422" y2="170" class="plm-phantom" />
                <line x1="332" y1="192" x2="310" y2="192" class="plm-l plm-l--thin" />
                <line x1="332" y1="206" x2="310" y2="206" class="plm-l plm-l--thin" />
                <line x1="316" y1="186" x2="316" y2="192" class="plm-arw" marker-end="url(#plm-cc-a)" />
                <line x1="316" y1="212" x2="316" y2="206" class="plm-arw" marker-end="url(#plm-cc-a)" />
                <line x1="390" y1="240" x2="390" y2="278" class="plm-arw" marker-end="url(#plm-cc-a)" />
  
                {/* Item balloons. Legend sits in HTML beside the drawing. */}
                <g class="plm-bal">
                  <line x1="199" y1="91" x2="240" y2="54" /><circle cx="199" cy="91" r="2.4" class="plm-bal__dot" />
                  <circle cx="250" cy="46" r="10" /><text x="250" y="50">1</text>
                </g>
                <g class="plm-bal">
                  <line x1="128" y1="138" x2="52" y2="58" /><circle cx="128" cy="138" r="2.4" class="plm-bal__dot" />
                  <circle cx="42" cy="50" r="10" /><text x="42" y="54">2</text>
                </g>
                <g class="plm-bal">
                  <line x1="69" y1="176" x2="26" y2="232" /><circle cx="69" cy="176" r="2.4" class="plm-bal__dot" />
                  <circle cx="18" cy="242" r="10" /><text x="18" y="246">3</text>
                </g>
                <g class="plm-bal">
                  <line x1="316" y1="199" x2="330" y2="262" /><circle cx="316" cy="199" r="2.4" class="plm-bal__dot" />
                  <circle cx="340" cy="270" r="10" /><text x="340" y="274">4</text>
                </g>
              </svg>
              <ol class="plm-leg">
                {(collapsible.legend ?? []).map((l: any) => (
                  <li><span class="plm-leg__n t-mono">{l.n}</span><span>{l.text}</span></li>
                ))}
              </ol>
              <figcaption class="figure-note">{common.schematic}</figcaption>
            </figure>
  
            {/* ── Unscrewing core ───────────────────────────────────────── */}
            <figure class="plm-mech__col" data-reveal style="--reveal-delay:120ms">
              <h3 class="plm-h4">{unscrewing.name}</h3>
              <p class="plm-mech__sum">{unscrewing.summary}</p>
              <svg viewBox="0 0 490 300" data-nomirror role="img" aria-label={unscrewing.figureLabel} class="plm-dwg">
                <defs>
                  <pattern id="plm-us-h" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="7" stroke="var(--accent-deep)" stroke-width="0.8" opacity="0.4" />
                  </pattern>
                  <pattern id="plm-us-h2" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)">
                    <line x1="0" y1="0" x2="0" y2="7" stroke="var(--accent)" stroke-width="0.8" opacity="0.28" />
                  </pattern>
                  <marker id="plm-us-a" markerWidth="9" markerHeight="8" refX="8.5" refY="4" orient="auto">
                    <path d="M0 0 L9 4 L0 8 Z" fill="var(--accent)" />
                  </marker>
                </defs>
  
                <line x1="30" y1="150" x2="360" y2="150" class="plm-cl" />
  
                {/* Moulded part, held against rotation. */}
                <rect x="216" y="86" width="140" height="30" style="fill:url(#plm-us-h2)" class="plm-l plm-l--thin" />
                <rect x="216" y="184" width="140" height="30" style="fill:url(#plm-us-h2)" class="plm-l plm-l--thin" />
  
                {/* Core shaft and thread form. */}
                <rect x="92" y="126" width="248" height="48" style="fill:url(#plm-us-h)" class="plm-l" />
                <path d={CORE_TOP} class="plm-l" />
                <path d={CORE_BOT} class="plm-l" />
  
                {/* Pinion. */}
                <circle cx="132" cy="150" r="44" class="plm-l" />
                {PINION.map((t: any) => (
                  <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="plm-l plm-l--thin" />
                ))}
  
                {/* Rack. */}
                <rect x="40" y="202" width="156" height="26" style="fill:url(#plm-us-h)" class="plm-l" />
                <path d={RACK_TEETH} class="plm-l" />
  
                <path d="M72 118 Q132 62 192 118" class="plm-arw" fill="none" marker-end="url(#plm-us-a)" />
                <line x1="376" y1="150" x2="452" y2="150" class="plm-arw" marker-end="url(#plm-us-a)" />
  
                <g class="plm-bal">
