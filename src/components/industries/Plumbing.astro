        </TechNote>

        <p class="plm-close">{b.economics.close}</p>
      </div>
    </div>
  </section>

  {/* ═══ 07 · BOUNDARY — the one inversion on the page ════════════════════ */}
  <section class="plm-band plm-band--inv on-steel on-steel--deep" id="plm-boundary">
