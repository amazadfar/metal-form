      <div class="plm-band__body">
        <div class="plm-head">
          <p class="eyebrow">{b.boundary.kicker}</p>
          <h2 class="plm-h2">{b.boundary.heading}</h2>
          <p class="t-lead">{b.boundary.body}</p>
        </div>

                  <div class="plm-split plm-split--bound">
            <section>
              <h3 class="plm-h5">{b.boundary.supplyHeading}</h3>
              <ul class="plm-list plm-list--can">
                {(b.boundary.supply ?? []).map((i: string) => <li>{i}</li>)}
              </ul>
            </section>
            <section>
              <h3 class="plm-h5">{b.boundary.customerHeading}</h3>
              <ul class="plm-list plm-list--cannot">
                {(b.boundary.customer ?? []).map((i: string) => <li>{i}</li>)}
              </ul>
            </section>
          </div>
        

        <p class="plm-statement">{b.boundary.statement}</p>
      </div>
    </div>
  </section>

  {/* ═══ 08 · CONTINUITY AND START ════════════════════════════════════════ */}
  <section class="plm-band" id="plm-start">
    <div class="shell--wide plm-band__inner">
      <div class="plm-rail"><p class="plm-rail__i t-mono">{b.start.index}</p></div>
      <div class="plm-band__body">
        <div class="plm-head">
          <p class="eyebrow">{b.start.kicker}</p>
          <h2 class="plm-h2">{b.start.heading}</h2>
          <p class="t-lead">{b.start.body}</p>
        </div>

        {/* The audit. Staggered off the grid — the one place the page asks
            rather than explains. */}
        <TechNote locale={locale} kind="detail">
          <div class="plm-audit">
            <h3 class="t-label plm-audit__h">{b.start.auditHeading}</h3>
            <ol class="plm-audit__list">
              {(b.start.audit ?? []).map((a: any, i: number) => (
                <li id={`plm-q${i + 1}`} data-reveal style={`--reveal-delay:${i * 70}ms`}>
                  <span class="plm-audit__n t-mono">{String(i + 1).padStart(2, '0')}</span>
                  <p class="plm-audit__q">{a.q}</p>
                  <p class="plm-audit__c">{a.c}</p>
                </li>
              ))}
            </ol>
          </div>
        </TechNote>

        <div class="plm-third">
          <h3 class="plm-h5">{b.start.positionHeading}</h3>
          <ul class="plm-list plm-list--can">
            {(b.start.position ?? []).map((i: string) => <li>{i}</li>)}
          </ul>
        </div>

        <div class="plm-ledger">
          <section class="plm-ledger__col">
            <h3 class="plm-h4">{b.start.sendHeading}</h3>
            <ul>{(b.start.send ?? []).map((i: string) => <li>{i}</li>)}</ul>
          </section>
          <section class="plm-ledger__col plm-ledger__col--out">
            <h3 class="plm-h4">{b.start.getHeading}</h3>
            <ul>{(b.start.get ?? []).map((i: string) => <li>{i}</li>)}</ul>
          </section>
        </div>

        <div class="plm-facts">
          <p class="t-label">{b.start.factsLabel}</p>
          <ul class="badges plm-facts__list">
            {(b.start.facts ?? []).map((f: any) => <li class="badge">{f}</li>)}
          </ul>
          {b.start.note ? <p class="plm-facts__note">{b.start.note}</p> : null}
        </div>

        {/* Layer three: the depth, folded away until it is wanted. */}
        <div class="plm-panels">
          <h3 class="t-label plm-panels__h">{b.panels.heading}</h3>
          {(b.panels.items ?? []).map((panel: any, i: number) => (
            <div class="disc" data-open="false">
              <h4>
                <button class="disc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span>{panel.title}</span>
                  <span class="disc__sign" aria-hidden="true"></span>
                </button>
              </h4>
              <div class="disc__panel">
                <div class="disc__inner">
                  <div>
                    <ul class="plm-panel__list">
                      {(panel.bullets ?? []).map((bl: any) => <li>{bl}</li>)}
                    </ul>
                    {panel.source && <p class="plm-src t-fine">{panel.source}</p>}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</article>

<style>
  /* ═══ PLUMBING CHAPTER SCOPE ════════════════════════════════════════════
     A parts catalogue. Structural neutrals, deep teal-blue for polymer,
     restrained brass for metal, hairlines carrying every division.
     Two colours, one grid, no cards, no shadows. */
  .plm {
    --plm-rail: clamp(3rem, 5.5vw, 5.5rem);
    --plm-gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .plm-h2 {
    font-size: clamp(1.72rem, 3.1vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
    margin-block-start: var(--sp-4);
    max-inline-size: 24ch;
  }
  .plm-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); font-weight: 500; }
  .plm-h5 { font-size: var(--step-0); letter-spacing: var(--track-head); font-weight: 500; }

  /* ── Shared drawing conventions ──────────────────────────────────────── */
  .plm-dwg { inline-size: 100%; block-size: auto; color: var(--accent-deep); }
  .plm-l { fill: none; stroke: var(--accent-deep); stroke-width: 1.5; stroke-linejoin: round; }
  .plm-l--thin { stroke-width: 0.85; }
  .plm-phantom { fill: none; stroke: var(--accent); stroke-width: 0.9; stroke-dasharray: 5 4; opacity: 0.7; }
  .plm-cl { stroke: var(--ink-muted); stroke-width: 0.7; stroke-dasharray: 10 3 1.5 3; opacity: 0.65; }
  .plm-arw { stroke: var(--accent); stroke-width: 1.3; fill: none; }
  .plm-seal { fill: color-mix(in oklab, var(--ink) 22%, transparent); stroke: var(--ink); stroke-width: 1.1; }
  .plm-fuse { fill: color-mix(in oklab, var(--signal) 34%, transparent); stroke: var(--signal); stroke-width: 0.8; }
  .plm-spread { fill: none; stroke: var(--accent); stroke-width: 0.8; opacity: 0.28; }
  .plm-oval { fill: none; stroke: var(--ink); stroke-width: 1.6; stroke-dasharray: 7 4; }

  .plm-bal line { stroke: var(--ink-muted); stroke-width: 0.8; }
  .plm-bal circle { fill: var(--surface); stroke: var(--ink); stroke-width: 1.1; }
  .plm-bal .plm-bal__dot { fill: var(--ink); stroke: none; }
  .plm-bal text {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--ink);
    text-anchor: middle;
  }

  /* ── Hero: the index ─────────────────────────────────────────────────────
     The opening is a catalogue sheet. A title block runs across the top and is
     ruled off; under it the twelve types sit in one bordered, numbered grid
     with a caption rail at its head. The copy is above the index, not beside
     it, and the index — not the headline — is what the reader meets first.

     Section hatch sits under the whole opening. It is set well below the
     threshold at which a reader could describe it: felt, not seen. */
  .plm-hero {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.25rem, 5vw, 3.75rem);
    --tex-ink: var(--accent-deep);
    --tex-opacity: 0.07;
  }

  /* Title block. Kicker across the top, statement and qualification beneath,
     divided by a rule that is cleared on both sides. */
  .plm-mast {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: end;
    padding-block-end: clamp(1.25rem, 3vw, 2rem);
    border-block-end: var(--rule-strong);
  }
  .plm-mast__eb { grid-column: 1 / -1; margin-block-end: clamp(1rem, 2.4vw, 1.75rem); }
  .plm-hero__head {
    grid-column: 1;
    padding-inline-end: var(--col-pad);
    font-size: clamp(1.8rem, 3.15vw, 2.85rem);
    line-height: 1.06;
    letter-spacing: -0.026em;
    font-weight: 500;
  }
  .plm-hero__head span { display: block; }
  .plm-hero__head span:last-child { color: var(--accent-deep); }
  .plm-mast__side {
    grid-column: 2;
    padding-inline-start: var(--col-pad);
    border-inline-start: var(--rule);
    align-self: end;
  }
  .plm-hero__lead {
    font-size: var(--step-0);
    line-height: 1.55;
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }
  .plm-hero__markers { margin-block-start: var(--sp-5); }
  @media (max-width: 1000px) {
    .plm-mast { grid-template-columns: minmax(0, 1fr); }
    .plm-hero__head { padding-inline-end: 0; }
    .plm-mast__side {
      grid-column: 1;
      margin-block-start: clamp(1.25rem, 3.5vw, 1.75rem);
      padding-block-start: clamp(1.25rem, 3.5vw, 1.75rem);
      padding-inline-start: 0;
      border-inline-start: 0;
      border-block-start: var(--rule);
    }
  }

  /* The sheet carries one border; the grid inside it carries only hairlines. */
  .plm-sheet {
    margin-block-start: clamp(1.5rem, 3.5vw, 2.5rem);
    border: var(--rule);
    /* Raised off the hatched ground, so the index reads as a sheet laid on
       cut steel rather than as more of the same near-white. */
    background: var(--surface-raise);
  }
  .plm-sheet__rail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-6);
    padding-block: var(--sp-4);
    padding-inline: var(--sp-4);
    border-block-end: var(--rule-strong);
  }
  .plm-plate {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
  }
  @media (max-width: 1080px) { .plm-plate { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 720px)  { .plm-plate { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 520px)  { .plm-plate { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .plm-cell {
    background: var(--surface-raise);
    padding-block: var(--sp-3) var(--sp-4);
    padding-inline: var(--sp-4);
    min-block-size: 10rem;
    min-inline-size: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--sp-3);
    align-content: stretch;
  }
  /* Each cell is numbered, as a catalogue cell is. */
  .plm-cell__i {
    display: block;
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    color: var(--accent);
    padding-block-end: var(--sp-2);
    border-block-end: var(--rule);
    font-variant-numeric: tabular-nums;
  }
  .plm-cell svg { inline-size: 100%; block-size: auto; max-block-size: 5.25rem; align-self: center; }
  .plm-g { fill: none; stroke-linejoin: round; }
  .plm-g--o { stroke: var(--accent-deep); stroke-width: 1.5; }
  .plm-g--d { stroke: var(--accent); stroke-width: 0.9; opacity: 0.65; }
  .plm-g--m { stroke: var(--signal); stroke-width: 1.3; }
  .plm-cell__cap { display: grid; gap: 0.15rem; }
  .plm-cell__name { font-size: var(--step--1); line-height: 1.3; font-weight: var(--weight-medium); }
  .plm-cell__meta {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    font-size: var(--step--2);
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }

  /* Indexed arrival: cells land one at a time in reading order, hard, no fade. */
  :global(html.js) .plm-plate[data-reveal] { opacity: 1; transform: none; transition: none; }
  :global(html.js) .plm-plate[data-reveal] .plm-cell { opacity: 0; }
  :global(html.js) .plm-plate[data-reveal='in'] .plm-cell {
    animation: plm-index 1ms steps(1, end) both;
    animation-delay: calc(var(--i) * 70ms);
  }
  @keyframes plm-index { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .plm-plate[data-reveal] .plm-cell { opacity: 1; animation: none; }
  }

  .plm-plate__foot {
    margin-block-start: var(--sp-5);
    display: grid;
    gap: var(--sp-3);
  }
  .plm-plate__note {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
    max-inline-size: 66ch;
  }
  .plm-key { display: flex; flex-wrap: wrap; gap: var(--sp-6); font-size: var(--step--2); color: var(--ink-muted); }
  .plm-key li { display: flex; align-items: center; gap: 0.5rem; }
  .plm-key__sw { inline-size: 1.4rem; block-size: 2px; flex: none; }
  .plm-key__sw--poly { background: var(--accent-deep); }
  .plm-key__sw--metal { background: var(--signal); }

  /* ── The page's drawing-sheet rail ───────────────────────────────────── */
  .plm-band { border-block-start: var(--rule); }
  .plm-band--sunk { background: var(--surface-sunk); }

  /* The chapter's contrast anchor. This is a light chapter, so it earns its
     presence with one dark plate rather than by being quiet: the range — the
     argument the whole page rests on — is set on steel. `.on-steel` carries
     the entire token flip, so nothing is restated here, and the hatch that
     opened the chapter carries through it at a lower weight. */
  .plm-band--anchor {
    border-block-start: 0;
    --tex-opacity: 0.05;
  }
  .plm-band__inner { display: grid; grid-template-columns: var(--plm-rail) minmax(0, 1fr); }
  .plm-rail { border-inline-end: var(--rule); padding-block: var(--section-y-tight) var(--sp-8); }
  .plm-rail:first-child { padding-inline-start: 0; }
  .plm-rail__i {
    position: sticky;
    inset-block-start: clamp(4.5rem, 10vh, 6.5rem);
    display: block;
    font-size: var(--step-2);
    line-height: 1;
    color: var(--accent-deep);
    font-variant-numeric: tabular-nums;
  }
  .plm-band__body {
    padding-block: var(--section-y-tight) var(--section-y);
    padding-inline-start: clamp(1.25rem, 3vw, 3rem);
    min-inline-size: 0;
  }
  @media (max-width: 1000px) {
    .plm-band__inner { grid-template-columns: minmax(0, 1fr); }
    .plm-rail { border-inline-end: 0; border-block-end: var(--rule); padding-block: var(--sp-6) var(--sp-3); }
    .plm-rail__i { position: static; }
    .plm-band__body { padding-inline-start: 0; padding-block-start: var(--sp-6); }
  }

  .plm-head { max-inline-size: 74ch; }
  .plm-head .t-lead { margin-block-start: var(--sp-5); }
  .plm-head__sub { margin-block-start: var(--sp-4); color: var(--ink-muted); max-inline-size: 64ch; }

  .plm-close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    font-size: var(--step-0);
    line-height: 1.6;
    max-inline-size: 66ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }
  .plm-src { margin-block-start: var(--sp-4); max-inline-size: 68ch; }

  /* ── 01 Strategy toggle and range matrix ─────────────────────────────── */
  .plm-strat { margin-block-start: clamp(2rem, 4vw, 3rem); }
  .plm-strat__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: var(--rule);
  }
  .plm-strat__tab {
    flex: 1 1 12rem;
    padding-block: 0.8rem;
    padding-inline: 0.9rem;
    background: var(--surface);
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    color: var(--ink-muted);
    text-align: start;
    transition: background-color var(--dur-1) steps(1, end), color var(--dur-1) steps(1, end);
  }
  .plm-strat__tab:hover { color: var(--accent-deep); }
  .plm-strat__tab[aria-selected='true'] { background: var(--accent); color: var(--surface); }

  .plm-strat__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-areas: 'hl note' 'figs figs';
    gap: clamp(1.25rem, 3vw, 2.25rem);
    padding: clamp(1.25rem, 2.6vw, 2rem);
    border: var(--rule);
    border-block-start: 0;
    align-items: start;
  }
  .plm-strat__panel[hidden] { display: none; }
  @media (max-width: 1000px) {
    .plm-strat__panel {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'hl' 'note' 'figs';
    }
  }
  .plm-strat__hl {
    grid-area: hl;
    font-size: var(--step-1);
    line-height: 1.35;
    letter-spacing: var(--track-head);
    max-inline-size: 44ch;
  }
  .plm-strat__note { grid-area: note; font-size: var(--step--1); line-height: 1.6; color: var(--ink-muted); }
  /* The tooling arithmetic is the most persuasive material on this page. It is
     set as the shared capability module rather than as a mono ledger strip. */
  .plm-strat__caps {
    grid-area: figs;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
  }
  .plm-strat__caps .cap__v { font-size: clamp(1.7rem, 3vw, 2.4rem); }
  @media (max-width: 560px) {
    .plm-strat__caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .plm-mx__cap { display: block; margin-block: var(--sp-7) var(--sp-4); }
  .plm-mx__scroll { overflow-x: auto; contain: paint; min-inline-size: 0; max-inline-size: 100%; }
  .plm-mx { inline-size: 100%; min-inline-size: 40rem; border-collapse: collapse; }
  .plm-mx th, .plm-mx td { text-align: start; }
  .plm-mx thead th {
    padding-block-end: var(--sp-3);
    border-block-end: var(--rule-strong);
    font-size: var(--step--2);
    font-weight: var(--weight-regular);
    color: var(--ink-muted);
    letter-spacing: 0.06em;
  }
  .plm-mx thead th:not(.plm-mx__corner) { inline-size: 3.1rem; }
  .plm-mx__corner { min-inline-size: 12rem; }
  .plm-mx tbody th {
    padding-block: var(--sp-3);
    padding-inline-end: var(--sp-5);
    border-block-end: var(--rule);
    font-size: var(--step--1);
    font-weight: var(--weight-regular);
  }
  .plm-mx tbody td { padding: var(--sp-3) 0; border-block-end: var(--rule); }
  .plm-mx__m {
    display: block;
    inline-size: 0.62rem;
    block-size: 0.62rem;
    background: var(--accent);
    border: 1.4px solid var(--accent);
    transition: background-color 1ms steps(1, end), border-color 1ms steps(1, end);
    transition-delay: calc(var(--c, 0) * 30ms);
  }
  /* The family reading: dedicated stays solid, the tail opens up. */
  .plm-strat[data-active='family'] .plm-mx td[data-s='2'] .plm-mx__m { background: transparent; }
  .plm-mx__key { margin-block-start: var(--sp-5); display: flex; flex-wrap: wrap; gap: var(--sp-6); font-size: var(--step--2); color: var(--ink-muted); }
  .plm-mx__key li { display: flex; align-items: center; gap: 0.55rem; }
  .plm-mx__m--fr { background: transparent; }
  /* In the one-tool-per-part-number reading every position is a tool, so the
     key follows the matrix rather than contradicting it. */
  .plm-strat:not([data-active='family']) .plm-mx__key .plm-mx__m--fr { background: var(--accent); }

  .plm-frames { margin-block-start: var(--sp-6); }
  .plm-frames__list {
    margin-block-start: var(--sp-3);
    display: grid;
