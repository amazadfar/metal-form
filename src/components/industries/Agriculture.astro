            <g class="agr-call">
              <circle cx="298" cy="234" r="3" class="agr-call__dot" />
              <line x1="298" y1="234" x2="244" y2="82" class="agr-call__lead" />
              <circle cx="240" cy="70" r="12" class="agr-call__ring" />
              <text x="240" y="75" text-anchor="middle" class="agr-micro" font-size="13">{b.labyrinth.calls[0].n}</text>
            </g>
            <g class="agr-call">
              <circle cx="628" cy="186" r="3" class="agr-call__dot" />
              <line x1="628" y1="186" x2="694" y2="82" class="agr-call__lead" />
              <circle cx="698" cy="70" r="12" class="agr-call__ring" />
              <text x="698" y="75" text-anchor="middle" class="agr-micro" font-size="13">{b.labyrinth.calls[1].n}</text>
            </g>
            <g class="agr-call">
              <circle cx="826" cy="210" r="3" class="agr-call__dot" />
              <line x1="826" y1="210" x2="792" y2="360" class="agr-call__lead" />
              <circle cx="789" cy="372" r="12" class="agr-call__ring" />
              <text x="789" y="377" text-anchor="middle" class="agr-micro" font-size="13">{b.labyrinth.calls[2].n}</text>
            </g>
          </svg>
        </div>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>

      <div class="agr-lab__cols">
        <dl class="agr-params">
          {b.labyrinth.params.map((p: any) => (
