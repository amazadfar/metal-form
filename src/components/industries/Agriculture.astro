            {/* b — flow path width, at the first crest */}
            <line x1="166" y1="234" x2="166" y2="286" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
            <line x1="166" y1="290" x2="166" y2="338" class="agr-ext" />
