---
/**
 * AGRICULTURE & IRRIGATION — chapter.
 *
 * Architecture: MAGNIFICATION. The page is one continuous zoom. A field block,
 * a lateral, a single emitter, the labyrinth inside it, and finally one tooth
 * drawn large enough to be architecture. Every section is a further step in,
 * and the transition between scales is the spine.
 *
 * The signature motif is the labyrinth flow path: one continuous stroke,
 * generated rather than hand-drawn, so the same geometry can appear at five
 * magnifications on one page. It is traced with stroke-dashoffset at every
 * scale, and in the closing section it is straightened into the plain line the
 * process rail hangs from.
 *
 * Colour discipline: green is a plotter-pen colour and carries the drawing.
 * Blue appears only where water actually is — the flow path, the bead that
 * travels it, the drops under the lateral, the pressure curves. Nothing else on
 * the page is coloured at all.
 */
import type { Locale } from '../../i18n/locales.ts';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { content, common } = Astro.props;
const b = content.blocks as any;

const r = (v: number) => Math.round(v * 10) / 10;

/**
 * The dentate labyrinth, generated. Teeth alternate from both walls; the water
 * threads between them. Returns the two wall profiles and the flow centreline,
 * so one geometry serves the hero, the magnification rail and the detail plate.
 */
function laby(n: number, pitch: number, x0: number, cy: number, half: number, tooth: number) {
  const bw = pitch * 0.42;
  const apexT = cy - half + tooth;
  const apexB = cy + half - tooth;
  let top = `M${x0} ${cy - half}`;
  let bot = `M${x0} ${cy + half}`;
  const pts: Array<[number, number]> = [];
  for (let i = 0; i < n; i++) {
    const xc = x0 + pitch * (i + 0.5);
    top += ` L${r(xc - bw)} ${cy - half} L${r(xc)} ${r(apexT)} L${r(xc + bw)} ${cy - half}`;
    pts.push([xc, cy + tooth / 2]);
    if (i < n - 1) {
      const xb = xc + pitch / 2;
      bot += ` L${r(xb - bw)} ${cy + half} L${r(xb)} ${r(apexB)} L${r(xb + bw)} ${cy + half}`;
      pts.push([xb, cy - tooth / 2]);
    }
  }
  top += ` L${r(x0 + n * pitch)} ${cy - half}`;
  bot += ` L${r(x0 + n * pitch)} ${cy + half}`;

  const q = pitch * 0.26;
  let px = x0 - pitch * 0.55;
  let py = cy;
  let flow = `M${r(px)} ${r(py)}`;
  for (const [x, y] of pts) {
    flow += ` C${r(px + q)} ${r(py)} ${r(x - q)} ${r(y)} ${r(x)} ${r(y)}`;
    px = x; py = y;
  }
  const xe = x0 + n * pitch + pitch * 0.55;
  flow += ` C${r(px + q)} ${r(py)} ${r(xe - q)} ${cy} ${r(xe)} ${cy}`;
  return { top, bot, flow, apexT, apexB };
}

/** The same stroke, amplitude decayed to nothing — the motif straightened. */
function straighten(n: number, pitch: number, x0: number, cy: number, amp: number) {
  const q = pitch * 0.26;
  let px = x0;
  let py = cy;
  let d = `M${x0} ${cy}`;
  for (let i = 1; i <= n; i++) {
    const x = x0 + pitch * i;
    const y = cy + amp * (1 - i / n) * (i % 2 ? 1 : -1);
    d += ` C${r(px + q)} ${r(py)} ${r(x - q)} ${r(y)} ${r(x)} ${r(y)}`;
    px = x; py = y;
  }
  return `${d} L${r(px + pitch * 1.4)} ${cy}`;
}

/** Balanced H-pattern feed: alternate horizontal and vertical splits. */
function hRunner(cx: number, cy: number, dx: number, dy: number, levels: number) {
  const segs: Array<[number, number, number, number]> = [];
  const tips: Array<[number, number]> = [];
  const walk = (x: number, y: number, ddx: number, ddy: number, d: number) => {
    if (d === levels) { tips.push([x, y]); return; }
    if (d % 2 === 0) {
      segs.push([x - ddx, y, x + ddx, y]);
      walk(x - ddx, y, ddx / 2, ddy, d + 1);
      walk(x + ddx, y, ddx / 2, ddy, d + 1);
    } else {
      segs.push([x, y - ddy, x, y + ddy]);
      walk(x, y - ddy, ddx, ddy / 2, d + 1);
      walk(x, y + ddy, ddx, ddy / 2, d + 1);
    }
  };
  walk(cx, cy, dx, dy, 0);
  return { segs, tips };
}

/* ── Geometry instances ────────────────────────────────────────────────────
   Each figure gets its own parameters so stroke weight stays honest at every
   magnification instead of being scaled up with a transform. */
const HERO = laby(6, 82, 60, 96, 44, 56);
const HERO_TRUE = laby(4, 24, 262, 262, 9, 12);
const MAG_EMIT = laby(4, 92, 186, 220, 38, 50);
const MAG_LAB = laby(4, 138, 100, 200, 74, 96);
const DETAIL = laby(5, 132, 100, 210, 76, 100);
const STRAIGHT = straighten(8, 72, 40, 60, 34);
const PLATE = hRunner(300, 180, 150, 90, 4);
const DEAD = 9;

/* Seasonal demand: one hump, drawn from an exponential so the shoulders are
   soft. Deliberately undated — the season is a different month in every market. */
const SEASON = 'M' + Array.from({ length: 61 }, (_, i) => {
  const t = i / 60;
  const y = 210 - 132 * Math.exp(-Math.pow(t - 0.54, 2) / (2 * 0.135 * 0.135));
  return `${r(40 + 680 * t)} ${r(y)}`;
}).join(' L');

/** q = k·p^m, normalised so every curve passes through nominal. */
function expCurve(m: number) {
  return 'M' + Array.from({ length: 41 }, (_, i) => {
    const t = i / 40;
    const q = m === 0 ? 1 : Math.pow(t, m);
    return `${r(50 + 300 * t)} ${r(190 - 150 * q)}`;
  }).join(' L');
}
const CURVES = [
  { id: 'm0', d: expCurve(0) },
  { id: 'm05', d: expCurve(0.5) },
  { id: 'm1', d: expCurve(1) },
];
---

<article class="agr">

  {/* Shared drawing defs: hatch patterns and one reversible arrowhead. */}
  <svg class="agr-defs" width="1" height="1" aria-hidden="true" focusable="false" data-nomirror>
    <defs>
      <pattern id="agr-hatch" patternUnits="userSpaceOnUse" width="9" height="9" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="9" stroke="var(--accent)" stroke-width="0.9" opacity="0.5" />
      </pattern>
      <pattern id="agr-hatch-fine" patternUnits="userSpaceOnUse" width="5" height="5" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="5" stroke="var(--accent)" stroke-width="0.7" opacity="0.5" />
      </pattern>
      <pattern id="agr-hatch-peak" patternUnits="userSpaceOnUse" width="8" height="8" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="8" stroke="var(--accent-deep)" stroke-width="0.8" opacity="0.32" />
      </pattern>
      <marker id="agr-arrow" markerWidth="7" markerHeight="7" refX="6.4" refY="3.5" orient="auto-start-reverse">
        <path d="M0 0 L7 3.5 L0 7 z" fill="currentColor" />
      </marker>
      <marker id="agr-arrow-w" markerWidth="7" markerHeight="7" refX="6.4" refY="3.5" orient="auto-start-reverse">
        <path d="M0 0 L7 3.5 L0 7 z" fill="var(--signal)" />
      </marker>
      <marker id="agr-arrow-rail" markerUnits="userSpaceOnUse" markerWidth="15" markerHeight="15" refX="13" refY="7.5" orient="auto">
        <path d="M0 0 L15 7.5 L0 15 z" fill="currentColor" />
      </marker>
    </defs>
  </svg>

  {/* ═══ HERO — PLATE: the drawing sheet, handed over ══════════════════════
       The chapter opens on a saturated bed mixed from its own accent, and the
       figure is framed as a document — border, corner tick, its own inner
       padding — sitting on that bed rather than floating beside the copy. */}
  <header class="agr-hero ground--tint mat mat--milled" data-tex="wave">
    <div class="agr-hero__bleed" aria-hidden="true">
      <svg viewBox="0 0 1400 620" preserveAspectRatio="xMidYMid slice" data-nomirror>
        {/* The sheet wash lives inside the tinted hero, not in the chapter-wide
            defs block. A `var()` in a <stop> resolves against the stop's own
            ancestors, and the shared defs sit outside `ground--tint` — so this
            wash was being mixed from the light-page accent while every other
            mark in the same drawing took the ground's remapped one. */}
        <defs>
          <linearGradient id="agr-sheet" x1="0" y1="0" x2="0.3" y2="1">
            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.07" />
            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
          </linearGradient>
        </defs>
        <rect width="1400" height="620" fill="url(#agr-sheet)" />
        {Array.from({ length: 15 }).map((_: any, i: number) => (
          <line
            x1="0" y1={44 + i * 40} x2="1400" y2={44 + i * 40}
            stroke="var(--accent)" stroke-width="0.8" opacity={i % 4 === 0 ? 0.16 : 0.07}
          />
        ))}
        {Array.from({ length: 15 }).map((_: any, i: number) =>
          Array.from({ length: 24 }).map((_: any, j: any) => (
            <circle cx={40 + j * 58} cy={44 + i * 40} r="1.5" fill="var(--accent)" opacity="0.1" />
          ))
        )}
      </svg>
    </div>

    <div class="shell--wide agr-hero__inner">
      <div class="agr-hero__copy">
        <p class="eyebrow">{content.hero.kicker}</p>
        <h1 class="agr-hero__head">
          {content.hero.headline.map((line: string, i: number) => (
            <span style={`--l:${i}`}>{line}</span>
          ))}
        </h1>
        <p class="agr-hero__lead">{content.hero.lead}</p>
        {content.hero.markers && (
          <ul class="badges agr-hero__markers">
            {content.hero.markers.map((m: string) => <li class="badge">{m}</li>)}
          </ul>
        )}
      </div>

      {/* The plate. Two registers of the same object, framed as a sheet: the
          fan lines carry the magnification between them. */}
      <figure class="agr-hero__plate plate plate--tick" data-reveal>
        <div class="scroller agr-hero__scroll">
          <svg viewBox="0 0 620 328" data-nomirror role="img" aria-label={common.schematic}>
            {/* Drawing-frame corner ticks around the magnified register */}
            <path d="M44 52 V36 H72 M540 36 H568 V52 M44 148 V164 H72 M540 164 H568 V148" class="agr-tick" />
            <path d={HERO.top} class="agr-wall" />
            <path d={HERO.bot} class="agr-wall" />
            <path d={HERO.flow} class="agr-flow" pathLength="1" />
            <path d={HERO.flow} class="agr-bead" pathLength="1" />
            <text x="44" y="28" class="agr-micro" font-size="9">{b.scale.overture.magLabel}</text>

            {/* Magnification fan */}
            <path d="M250 238 L44 168 M370 238 L568 168" class="agr-fan" />

            {/* The same part, small */}
            <rect x="250" y="240" width="120" height="44" class="agr-body" />
            <path d={HERO_TRUE.top} class="agr-wall agr-wall--hair" />
            <path d={HERO_TRUE.bot} class="agr-wall agr-wall--hair" />
            <path d={HERO_TRUE.flow} class="agr-flow agr-flow--hair" pathLength="1" />
            <circle cx="364" cy="262" r="4" class="agr-outlet" />
            <text x="386" y="266" class="agr-micro" font-size="9">{b.scale.overture.trueLabel}</text>

            {/* Millimetre rule under it */}
            <line x1="250" y1="294" x2="370" y2="294" class="agr-rule" />
            {Array.from({ length: 27 }).map((_: any, i: number) => (
              <line
                x1={r(250 + i * (120 / 26))} y1="294"
                x2={r(250 + i * (120 / 26))} y2={i % 5 === 0 ? 304 : 300}
                class="agr-rule"
              />
            ))}
            <text x="250" y="318" class="agr-micro" font-size="8">{b.scale.overture.ruleLabel}</text>
          </svg>
        </div>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
    </div>

    <div class="shell--wide">
      <p class="agr-hero__note t-fine">{b.scale.overture.note}</p>
    </div>
  </header>

  {/* ═══ 01 · MAGNIFICATION SEQUENCE ═══════════════════════════════════════ */}
  <section class="agr-mag" id="scale" data-stepper data-step="0">
    <div class="shell--wide">
      <div class="agr-head">
        <div class="agr-head__idx"><span class="t-mono">{b.scale.index}</span></div>
        <div class="agr-head__copy">
          <p class="eyebrow eyebrow--plain">{b.scale.kicker}</p>
          <h2 class="agr-h2">{b.scale.heading}</h2>
          <p class="t-lead agr-lead">{b.scale.body}</p>
        </div>
      </div>

      <div class="agr-mag__grid">
        <div class="agr-mag__stage">
          <figure class="agr-mag__fig">
            <svg viewBox="0 0 760 400" data-nomirror role="img" aria-label={common.schematic}>

              {/* ── 0 · Field block ─────────────────────────────────────── */}
              <g class="agr-frame" data-frame="0">
                <line x1="70" y1="46" x2="70" y2="356" class="agr-main" />
                {Array.from({ length: 10 }).map((_: any, i: number) => (
                  <line x1="70" y1={60 + i * 32} x2="700" y2={60 + i * 32} class="agr-lat" />
                ))}
                {Array.from({ length: 10 }).map((_: any, i: number) =>
                  Array.from({ length: 11 }).map((_: any, j: any) => (
                    <circle cx={110 + j * 54} cy={60 + i * 32} r="1.7" class="agr-seed" />
                  ))
                )}
                <rect x="430" y="172" width="132" height="32" class="agr-loc" />
              </g>

              {/* ── 1 · Lateral ─────────────────────────────────────────── */}
              <g class="agr-frame" data-frame="1">
                <line x1="30" y1="168" x2="730" y2="168" class="agr-wall" />
                <line x1="30" y1="232" x2="730" y2="232" class="agr-wall" />
                <line x1="30" y1="200" x2="730" y2="200" class="agr-cl" />
                {[120, 260, 400, 540, 680].map((c: any) => (
                  <g>
                    <rect x={c - 30} y="206" width="60" height="26" class="agr-body" />
                    <line x1={c} y1="232" x2={c} y2="252" class="agr-drop" />
                    <circle cx={c} cy="262" r="4.2" class="agr-outlet" />
                  </g>
                ))}
                <line x1="120" y1="300" x2="260" y2="300" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
                <line x1="120" y1="238" x2="120" y2="306" class="agr-ext" />
                <line x1="260" y1="238" x2="260" y2="306" class="agr-ext" />
                <text x="190" y="292" text-anchor="middle" class="agr-micro" font-size="13">{b.scale.marks.s}</text>
                <rect x="360" y="198" width="80" height="44" class="agr-loc" />
              </g>

              {/* ── 2 · One emitter ─────────────────────────────────────── */}
              <g class="agr-frame" data-frame="2">
                <rect x="110" y="120" width="540" height="200" class="agr-body" />
                {Array.from({ length: 7 }).map((_: any, i: number) => (
                  <line x1="122" y1={142 + i * 26} x2="162" y2={142 + i * 26} class="agr-grille" />
                ))}
                <path d={MAG_EMIT.top} class="agr-wall" />
                <path d={MAG_EMIT.bot} class="agr-wall" />
                <path d={MAG_EMIT.flow} class="agr-flow" pathLength="1" />
                <circle cx="610" cy="220" r="20" class="agr-wall" fill="none" />
                <circle cx="610" cy="220" r="7" class="agr-outlet" />
                <line x1="110" y1="352" x2="650" y2="352" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
                <line x1="110" y1="326" x2="110" y2="358" class="agr-ext" />
                <line x1="650" y1="326" x2="650" y2="358" class="agr-ext" />
                <text x="380" y="344" text-anchor="middle" class="agr-micro" font-size="12">{b.scale.marks.emitter}</text>
                <rect x="200" y="170" width="160" height="100" class="agr-loc" />
              </g>

              {/* ── 3 · The labyrinth ───────────────────────────────────── */}
              <g class="agr-frame" data-frame="3">
                <path d={MAG_LAB.top} class="agr-wall" />
                <path d={MAG_LAB.bot} class="agr-wall" />
                <path d={MAG_LAB.flow} class="agr-flow" pathLength="1" />
                <path d={MAG_LAB.flow} class="agr-bead" pathLength="1" />
                <rect x="240" y="110" width="134" height="180" class="agr-loc" />
              </g>

              {/* ── 4 · One tooth, in section ───────────────────────────── */}
              <g class="agr-frame" data-frame="4">
                <path
                  d="M60 110 L260 110 L380 300 L500 110 L700 110 L700 74 L60 74 Z"
                  class="agr-steel"
                />
                <path d="M60 340 L700 340 L700 368 L60 368 Z" class="agr-steel" />
                <path d="M540 110 L660 300 L700 235" class="agr-ghost" />
                <path d="M60 240 C180 240 260 320 380 320 C500 320 580 240 700 240" class="agr-flow agr-flow--wide" pathLength="1" />

                {/* b — the passage */}
                <line x1="380" y1="300" x2="380" y2="340" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
                <text x="398" y="326" class="agr-micro" font-size="16">{b.scale.marks.b}</text>

                {/* h — tooth height */}
                <line x1="380" y1="300" x2="586" y2="300" class="agr-ext" />
                <line x1="380" y1="110" x2="586" y2="110" class="agr-ext" />
                <line x1="566" y1="110" x2="566" y2="300" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
                <text x="582" y="212" class="agr-micro" font-size="16">{b.scale.marks.h}</text>

                {/* s — spacing to the next crest */}
                <line x1="380" y1="300" x2="380" y2="30" class="agr-ext" />
                <line x1="660" y1="300" x2="660" y2="30" class="agr-ext" />
                <line x1="380" y1="46" x2="660" y2="46" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
                <text x="520" y="36" text-anchor="middle" class="agr-micro" font-size="16">{b.scale.marks.s}</text>

                {/* θ — crest angle */}
                <path d="M342.6 240.9 A70 70 0 0 1 417.4 240.9" class="agr-arc" />
                <circle cx="380" cy="222" r="14" class="agr-clear" />
                <text x="380" y="228" text-anchor="middle" class="agr-micro" font-size="16">{b.scale.marks.theta}</text>
              </g>

              {/* Scale bar — geometry only; the value is set in HTML below. */}
              <line x1="60" y1="388" x2="180" y2="388" class="agr-rule" />
              <line x1="60" y1="382" x2="60" y2="394" class="agr-rule" />
              <line x1="180" y1="382" x2="180" y2="394" class="agr-rule" />
            </svg>

            <div class="badge agr-mag__readout" aria-hidden="true">
              <span class="t-label">{b.scale.scaleLabel}</span>
              <span class="agr-mag__vals t-mono">
                {b.scale.steps.map((s: any, i: number) => <span data-i={i}>{s.scale}</span>)}
              </span>
            </div>
            <figcaption class="figure-note">{common.schematic}</figcaption>
          </figure>
        </div>

        <ol class="agr-mag__steps" aria-label={b.scale.stepsLabel}>
          {b.scale.steps.map((s: any, i: number) => (
            <li class="agr-step" data-station-step={i}>
              {/* The scale used to be an 11px tracked-out mono chip. It carries
                  the whole magnification argument, so it is set with the shared
                  capability-module vocabulary instead. The `__n` in the class
                  is load-bearing: it is what the shared stepper dims. */}
              <span class="cap__k agr-step__n">{s.scale}</span>
              <h3 class="cap__v agr-step__h">{s.label}</h3>
              <p class="agr-step__p">{s.note}</p>
            </li>
          ))}
        </ol>
      </div>

      <p class="agr-src t-fine">{b.scale.sourceNote}</p>
      <p class="agr-close">{b.scale.close}</p>
    </div>
  </section>

  {/* ═══ 02 · REPETITION — the rail that runs off both edges ═══════════════ */}
  <section class="agr-rep" id="repeat">
    <div class="agr-rep__rail" aria-hidden="true">
      <svg viewBox="0 0 1600 150" preserveAspectRatio="xMidYMid slice" data-nomirror>
        <line x1="0" y1="42" x2="1600" y2="42" class="agr-wall" />
        <line x1="0" y1="98" x2="1600" y2="98" class="agr-wall" />
        <line x1="0" y1="70" x2="1600" y2="70" class="agr-cl" />
        {Array.from({ length: 17 }).map((_: any, i: number) => (
          <g>
            <rect x={-20 + i * 100} y="74" width="52" height="24" class="agr-body" />
            <line x1={6 + i * 100} y1="98" x2={6 + i * 100} y2="122" class="agr-drop" />
            <circle cx={6 + i * 100} cy="132" r="4" class="agr-outlet" />
          </g>
        ))}
      </svg>
    </div>

    <div class="shell--wide agr-rep__inner">
      <div class="agr-head">
        <div class="agr-head__idx"><span class="t-mono">{b.repeat.index}</span></div>
        <div class="agr-head__copy">
          <p class="eyebrow eyebrow--plain">{b.repeat.kicker}</p>
          <h2 class="agr-h2">{b.repeat.heading}</h2>
          <p class="t-lead agr-lead">{b.repeat.body}</p>
          <p class="agr-rep__b2">{b.repeat.body2}</p>
        </div>
      </div>

      <p class="agr-rep__cap t-label">{b.repeat.railLabel}</p>

      <ol class="agr-rep__list">
        {b.repeat.consequences.map((c: string, i: number) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="t-mono">{String(i + 1).padStart(2, '0')}</span>
            <p>{c}</p>
          </li>
        ))}
      </ol>

      <p class="agr-src t-fine">{b.repeat.sourceNote}</p>
      <p class="agr-close">{b.repeat.close}</p>
    </div>
  </section>

  {/* ═══ 03 · THE LABYRINTH AT EXTREME MAGNIFICATION ═══════════════════════ */}
  <section class="agr-lab" id="labyrinth">
    <div class="shell--wide">
      <div class="agr-head">
