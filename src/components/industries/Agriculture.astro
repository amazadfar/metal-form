            <text x="364" y="356" text-anchor="middle" class="agr-micro" font-size="15">{b.labyrinth.marks.h}</text>

            {/* s — dentate spacing, crest to crest */}
            <line x1="430" y1="230" x2="430" y2="92" class="agr-ext" />
            <line x1="562" y1="230" x2="562" y2="92" class="agr-ext" />
            <line x1="430" y1="104" x2="562" y2="104" class="agr-dim" marker-start="url(#agr-arrow)" marker-end="url(#agr-arrow)" />
            <text x="496" y="88" text-anchor="middle" class="agr-micro" font-size="15">{b.labyrinth.marks.s}</text>

