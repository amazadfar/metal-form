</article>

<style>
  /* ═══ Chapter scope ══════════════════════════════════════════════════════
     A hydraulic drawing sheet. Almost no filled shapes: hairlines carry the
     structure, one green pen carries the drawing, one blue carries the water.
     Everything is prefixed .agr- so nothing leaks into the other twelve. */

  .agr {
    --agr-hair: 1.1;
    --agr-heavy: 1.7;
    /* This <article> is `main`'s first child, so the shared header clearance in
       chapters.css lands here — on a transparent box above a tinted hero, under
       a header that is in its light-on-dark state. That would put a strip of
       near-white page behind near-white header type. The clearance moves onto
       the hero itself, which is exactly the case the shared rule keeps at zero
       specificity for. */
    padding-block-start: 0;
  }

  .agr-defs {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    color: var(--ink-muted);
  }

  .agr-h2 {
    font-size: clamp(1.8rem, 3.4vw, 2.9rem);
    line-height: 1.08;
    letter-spacing: -0.026em;
    font-weight: 500;
    margin-block-start: var(--sp-4);
    max-inline-size: 21ch;
  }
  .agr-h3 { font-size: var(--step-2); letter-spacing: var(--track-head); max-inline-size: 26ch; }
  .agr-h4 { font-size: var(--step-1); letter-spacing: var(--track-head); }
  .agr-lead { margin-block-start: var(--sp-5); max-inline-size: 60ch; }

  /* ── Drawing conventions, shared by every figure in the chapter ────────── */
  .agr-wall { fill: none; stroke: var(--accent-deep); stroke-width: var(--agr-hair); stroke-linejoin: round; }
  .agr-wall--heavy { stroke-width: var(--agr-heavy); }
  .agr-wall--hair { stroke-width: 0.65; }
  .agr-body { fill: none; stroke: var(--accent-deep); stroke-width: var(--agr-hair); }
  .agr-main { stroke: var(--accent-deep); stroke-width: 2.2; }
  .agr-lat { stroke: var(--accent-deep); stroke-width: 0.8; opacity: 0.85; }
  .agr-seed { fill: var(--accent); opacity: 0.4; }
  .agr-grille { stroke: var(--accent-deep); stroke-width: 0.9; opacity: 0.75; }
  .agr-cl { stroke: var(--ink-muted); stroke-width: 0.7; stroke-dasharray: 10 3 2 3; opacity: 0.5; }
  .agr-tick { fill: none; stroke: var(--accent); stroke-width: 1.2; }
  .agr-rule { stroke: var(--ink-muted); stroke-width: 0.9; opacity: 0.7; }
  .agr-axis { stroke: var(--ink-muted); stroke-width: 1.1; }
  .agr-dim { stroke: var(--ink-muted); stroke-width: 0.9; color: var(--ink-muted); }
  .agr-ext { stroke: var(--ink-muted); stroke-width: 0.7; stroke-dasharray: 4 3; opacity: 0.7; }
  .agr-arc { fill: none; stroke: var(--ink-muted); stroke-width: 0.9; }
  .agr-loc { fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 7 4; }
  .agr-ghost { fill: none; stroke: var(--accent-deep); stroke-width: 0.9; opacity: 0.3; }
  .agr-steel { fill: url(#agr-hatch); stroke: var(--accent-deep); stroke-width: var(--agr-hair); }
  .agr-steel--fine { fill: url(#agr-hatch-fine); }
  .agr-clear { fill: var(--surface-raise); }
  .agr-micro {
    font-family: var(--font-mono);
    fill: var(--ink-muted);
    letter-spacing: 0.05em;
  }

  /* Water. The only other colour on the page. */
  .agr-flow { fill: none; stroke: var(--signal); stroke-width: 1.5; stroke-linecap: round; }
  .agr-flow--wide { stroke-width: 2.1; }
  .agr-flow--hair { stroke-width: 0.8; }
  .agr-drop { stroke: var(--signal); stroke-width: 1.3; opacity: 0.8; }
  .agr-outlet { fill: var(--signal); }
  .agr-bead { fill: none; stroke: var(--signal); stroke-width: 4.4; stroke-linecap: round; opacity: 0; }
  .agr-bead--wide { stroke-width: 6; }

  /* Plotter-style draw: constant velocity, once, then it stops. */
  @keyframes agr-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes agr-run { from { stroke-dashoffset: 0; opacity: 1; } to { stroke-dashoffset: -0.965; opacity: 1; } }

  :global(html.js) .agr [data-reveal] .agr-flow,
  :global(html.js) .agr [data-reveal] .agr-profile {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  :global(html.js) .agr [data-reveal='in'] .agr-flow,
  :global(html.js) .agr [data-reveal='in'] .agr-profile {
    animation: agr-draw 2200ms linear forwards;
  }
  :global(html.js) .agr [data-reveal] .agr-bead { stroke-dasharray: 0.035 0.965; }
  :global(html.js) .agr [data-reveal='in'] .agr-bead {
    animation: agr-run 2600ms linear 400ms forwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .agr-bead { display: none; }
  }

  /* ── Section head: drawing-sheet title block ───────────────────────────── */
  .agr-head {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
  }
  .agr-head__idx {
    padding-block-start: 0.35rem;
    border-block-start: var(--rule-strong);
  }
  .agr-head__idx span {
    font-size: var(--step-1);
    color: var(--accent-deep);
    letter-spacing: 0.06em;
  }
  /* Every band in this chapter is a real stack below 1000px — a 46ch paragraph
     beside anything stops being a column and starts being a gutter first. */
  @media (max-width: 1000px) {
    .agr-head { grid-template-columns: minmax(0, 1fr); gap: var(--sp-3); }
    .agr-head__idx { border-block-start: 0; padding-block-start: 0; }
  }

  .agr-src {
    margin-block-start: var(--sp-5);
    max-inline-size: 62ch;
    padding-inline-start: var(--sp-4);
    border-inline-start: var(--hair) solid var(--line);
  }
  .agr-close {
    margin-block-start: var(--sp-7);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 60ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }
  .agr-bound {
    margin-block-start: var(--sp-5);
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 66ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--signal);
  }
  .agr-bound--wide { max-inline-size: 78ch; }

  /* ── Hero — PLATE on the tint ground ──────────────────────────────────────
     The opening is a deep bed mixed from the chapter's own accent
     (`ground--tint`, chapters.css) with the drawing laid on it as a framed
     sheet. Nothing here restates a colour: the ground remaps ink, rules,
     accent, signal and both surfaces, and every rule below picks from that
     remapped set. */
  .agr-hero {
    position: relative;
    /* Own the header clearance — see the note on `.agr`. 4.25rem is the header
       block-size the shared rule in chapters.css clears. */
    padding-block: calc(4.25rem + clamp(2.5rem, 6vw, 5rem)) clamp(3rem, 7vw, 5.5rem);
    overflow: clip;
    /* The swell is the sector's own material: anything that moves fluid. Felt,
       not seen — the default 0.11 is loud against light ink on a dark bed. */
    --tex-opacity: 0.085;
  }
  /* `.mat--milled` (base.css) and `[data-tex]` (chapters.css) both render into
     ::before, and chapters.css wins the image. Only the milled layer's tiling
     and blend leak through, and a swell is one large gradient rather than a
     140px tile, so both are neutralised; the cast grain the milled surface
     would have contributed is re-laid on ::after from the same shared token. */
  .agr-hero::before { background-size: auto; mix-blend-mode: normal; }
  .agr-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--tex-grain);
    background-size: 140px 140px;
    opacity: 0.2;
    mix-blend-mode: overlay;
  }
  .agr-hero__bleed { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .agr-hero__bleed svg { inline-size: 100%; block-size: 100%; }

  /* Deliberately uneven: the sheet is the larger half, and the copy is set
     against it rather than balanced with it. */
  .agr-hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (max-width: 1000px) {
    .agr-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(2rem, 7vw, 3.25rem);
    }
  }

  /* Small type on this bed: `--ink-muted` is 3.8:1 against the tint ground, so
     anything under 24px takes full ink. */
  .agr-hero .eyebrow,
  .agr-hero__note { color: var(--ink); }

  .agr-hero__head {
    margin-block-start: clamp(1.25rem, 3vw, 1.9rem);
    font-size: clamp(2.15rem, 4.4vw, 3.4rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    font-weight: 500;
    text-wrap: balance;
  }
  .agr-hero__head span { display: block; }
  /* The setup is muted, the payload is not — the shared two-tone statement.
     The accent is a marking colour on this ground, not display type. */
  .agr-hero__head span:not(:last-child) { color: var(--ink-muted); }

  .agr-hero__lead {
    margin-block-start: var(--sp-5);
    font-size: var(--step-1);
    line-height: 1.5;
    max-inline-size: 38ch;
  }
  .agr-hero__markers { margin-block-start: var(--sp-6); }
  /* Two corrections for the dark bed, both taken from the ground's own remapped
     tokens: the light-surface relief reads as a bright hairline here, and the
     badge's 7% accent wash lands at 4.3:1 against this bed — the sunk surface
     takes it to 7.6:1 and ties the markers to the plate beside them. */
  .agr-hero .badge {
    box-shadow: var(--relief-dark);
    background: var(--surface-sunk);
  }

  /* The plate: a border, a corner tick and its own inner padding — a drawing
     that was handed to you, not a figure floated beside a headline.
     `--surface-raise` sits too close to the bed for the drawing's hairlines
     (2.3:1); the sunk surface is the darker of the two remapped surfaces and
     the whole figure reads against it. */
  .agr-hero__plate {
    background: var(--surface-sunk);
    padding-block: clamp(1.1rem, 2.2vw, 1.9rem);
    padding-inline: clamp(1.1rem, 2.2vw, 1.9rem);
  }
  .agr-hero__scroll { margin-block-end: var(--sp-4); }
  .agr-hero__plate svg { display: block; inline-size: 100%; min-inline-size: 22rem; block-size: auto; }
  .agr-hero__plate .figure-note {
    padding-block-start: var(--sp-3);
    border-block-start: var(--rule);
    color: var(--ink);
  }

  .agr-hero__note {
    position: relative;
    margin-block-start: clamp(1.75rem, 3.5vw, 3rem);
    padding-block-start: var(--sp-4);
    border-block-start: var(--rule);
    max-inline-size: 78ch;
  }
  .agr-fan { fill: none; stroke: var(--accent); stroke-width: 0.8; stroke-dasharray: 5 4; opacity: 0.7; }

  /* ── 01 Magnification ─────────────────────────────────────────────────── */
  .agr-mag {
    padding-block: var(--section-y);
    background: var(--surface-sunk);
    border-block: var(--rule);
  }
  .agr-mag__grid {
    margin-block-start: clamp(2rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .agr-mag__grid { grid-template-columns: minmax(0, 1fr); } }

  .agr-mag__stage { position: sticky; inset-block-start: clamp(5rem, 11vh, 7rem); }
  @media (max-width: 1000px) { .agr-mag__stage { position: static; } }
  .agr-mag__fig {
    background: var(--surface-raise);
    border: var(--rule);
    padding: clamp(0.9rem, 2vw, 1.5rem);
  }
  .agr-mag__fig svg { inline-size: 100%; block-size: auto; }
  .agr-mag__fig .figure-note { margin-block-start: var(--sp-3); }

  .agr-frame { opacity: 0; transition: opacity 420ms var(--ease-out); pointer-events: none; }
  .agr-mag[data-step='0'] .agr-frame[data-frame='0'],
  .agr-mag[data-step='1'] .agr-frame[data-frame='1'],
  .agr-mag[data-step='2'] .agr-frame[data-frame='2'],
  .agr-mag[data-step='3'] .agr-frame[data-frame='3'],
  .agr-mag[data-step='4'] .agr-frame[data-frame='4'] { opacity: 1; }

  /* The live scale readout, framed as a badge rather than left as a tracked-out
     label strip: it is the one value the figure beside it is currently at. */
  .agr-mag__readout {
    margin-block-start: var(--sp-4);
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-4);
  }
  .agr-mag__vals { font-size: var(--step-0); color: var(--accent-deep); }
  .agr-mag__vals span { display: none; }
  .agr-mag[data-step='0'] .agr-mag__vals span[data-i='0'],
  .agr-mag[data-step='1'] .agr-mag__vals span[data-i='1'],
  .agr-mag[data-step='2'] .agr-mag__vals span[data-i='2'],
  .agr-mag[data-step='3'] .agr-mag__vals span[data-i='3'],
  .agr-mag[data-step='4'] .agr-mag__vals span[data-i='4'] { display: inline; }
  :global(html:not(.js)) .agr-mag__readout { display: none; }

  /* The prose is never faded. Body copy on this site already sits close to the
     4.5:1 floor, so a meaningful fade takes it under; the shared stepper in
     components.css carries the active state on the marker instead. */
  .agr-mag__steps { border-block-start: var(--rule-strong); }
  .agr-step {
    padding-block: var(--sp-5) var(--sp-6);
    border-block-end: var(--rule);
  }
  .agr-step__n { display: block; }
  .agr-step__h { margin-block-start: 0.3rem; }
  .agr-step__p { margin-block-start: 0.4rem; font-size: var(--step--1); line-height: 1.58; color: var(--ink-muted); }
  /* Stacked, the shared active-step marker would sit outside the page gutter. */
  @media (max-width: 1000px) { .agr-mag__steps { padding-inline-start: var(--sp-5); } }

  /* ── 02 Repetition ────────────────────────────────────────────────────── */
  .agr-rep { position: relative; padding-block: var(--section-y); overflow: clip; }
  .agr-rep__rail {
    position: absolute;
    inset-inline: 0;
    inset-block-start: clamp(3rem, 8vw, 7rem);
    block-size: clamp(90px, 12vw, 150px);
    pointer-events: none;
    opacity: 0.5;
  }
  .agr-rep__rail svg { inline-size: 100%; block-size: 100%; }
  .agr-rep__inner { position: relative; padding-block-start: clamp(6rem, 14vw, 12rem); }
  .agr-rep__b2 {
    margin-block-start: var(--sp-5);
    font-size: var(--step-0);
    line-height: 1.62;
    max-inline-size: 58ch;
  }
  .agr-rep__cap { display: block; margin-block-start: clamp(2rem, 4vw, 3rem); max-inline-size: 46ch; }

  .agr-rep__list {
    margin-block-start: var(--sp-5);
    border-block-start: var(--rule-strong);
  }
  .agr-rep__list li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    border-block-end: var(--rule);
    align-items: baseline;
  }
  @media (max-width: 620px) { .agr-rep__list li { grid-template-columns: minmax(0, 1fr); gap: var(--sp-2); } }
  .agr-rep__list li span { font-size: var(--step--2); letter-spacing: 0.12em; color: var(--accent-deep); }
  .agr-rep__list li p { font-size: var(--step-0); line-height: 1.55; max-inline-size: 62ch; }

  /* ── 03 Labyrinth ─────────────────────────────────────────────────────── */
  .agr-lab { padding-block: var(--section-y); }
  .agr-lab__b2 {
    margin-block-start: var(--sp-5);
    font-size: var(--step-0);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 66ch;
  }
  .agr-lab__fig { margin-block-start: clamp(2rem, 5vw, 3.5rem); }
  .agr-lab__figlabel { display: block; margin-block-end: var(--sp-4); }
  .agr-lab__scroll svg { display: block; inline-size: 100%; min-inline-size: 34rem; block-size: auto; }
  .agr-lab__fig .figure-note { margin-block-start: var(--sp-4); }

  .agr-call__dot { fill: var(--accent-deep); }
  .agr-call__lead { stroke: var(--accent-deep); stroke-width: 0.8; }
  .agr-call__ring { fill: var(--surface); stroke: var(--accent-deep); stroke-width: 1.1; }

  .agr-lab__cols {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .agr-lab__cols { grid-template-columns: minmax(0, 1fr); } }

  .agr-params { border-block-start: var(--rule-strong); }
  .agr-param { padding-block: var(--sp-5); border-block-end: var(--rule); }
  .agr-param dt {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) auto;
    gap: var(--sp-4);
    align-items: baseline;
  }
  @media (max-width: 560px) { .agr-param dt { grid-template-columns: 2rem minmax(0, 1fr); } }
  .agr-param__sym { font-size: var(--step-2); color: var(--accent-deep); }
  .agr-param__name { font-size: var(--step-0); font-weight: var(--weight-medium); }
  .agr-param__val { font-size: var(--step--1); color: var(--ink-muted); white-space: nowrap; }
  .agr-param dd {
    margin-block-start: var(--sp-2);
    padding-inline-start: calc(2.2rem + var(--sp-4));
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-muted);
    max-inline-size: 58ch;
  }
  @media (max-width: 560px) { .agr-param dd { padding-inline-start: 0; } }

  .agr-calls__list { margin-block-start: var(--sp-5); display: grid; gap: var(--sp-5); }
  .agr-calls__list li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: var(--sp-4); }
  @media (max-width: 620px) { .agr-calls__list li { grid-template-columns: minmax(0, 1fr); gap: var(--sp-2); } }
  .agr-calls__n {
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--accent-deep);
  }
  .agr-calls__list h4 { font-size: var(--step-0); letter-spacing: var(--track-head); }
  .agr-calls__list p { margin-block-start: 0.25rem; font-size: var(--step--1); line-height: 1.58; color: var(--ink-muted); }

  .agr-tol {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    padding-block-start: var(--sp-6);
    border-block-start: var(--rule-strong);
  }
  .agr-tol p {
    margin-block-start: var(--sp-4);
    font-size: var(--step-0);
    line-height: 1.62;
    max-inline-size: 68ch;
  }

  .agr-dia {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block: var(--rule);
  }
  @media (max-width: 1000px) { .agr-dia { grid-template-columns: minmax(0, 1fr); } }
  .agr-dia__copy p { margin-block-start: var(--sp-4); font-size: var(--step--1); line-height: 1.62; max-inline-size: 54ch; }
  .agr-dia__key { margin-block-start: var(--sp-5); display: grid; gap: 0.5rem; }
  .agr-dia__key li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: var(--step--2);
    color: var(--ink-muted);
  }
  .agr-dia__sw { inline-size: 1.4rem; block-size: 0; flex: none; border-block-start: 1.6px solid var(--accent-deep); }
  .agr-dia__sw[data-k='0'] { border-block-start-color: var(--signal-ink); border-block-start-width: 2.2px; }
  .agr-dia__sw[data-k='2'] { border-block-start-style: dashed; }
  .agr-dia__fig svg { inline-size: 100%; block-size: auto; }
  .agr-dia__fig .figure-note { margin-block-start: var(--sp-3); }
  .agr-press { stroke: var(--ink-muted); stroke-width: 1.5; }
  .agr-membrane { fill: color-mix(in oklab, var(--ink) 10%, transparent); stroke: var(--accent-deep); stroke-width: 1.2; }
  .agr-membrane__def { fill: none; stroke: var(--accent-deep); stroke-width: 1.4; stroke-dasharray: 6 4; }

  .agr-exp { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .agr-exp__formula { margin-block-start: var(--sp-3); font-size: var(--step-2); color: var(--accent-deep); }
  .agr-exp__formula sup { font-size: 0.62em; }
  .agr-exp__tabs {
    margin-block-start: var(--sp-5);
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: var(--rule);
    inline-size: fit-content;
    max-inline-size: 100%;
  }
  .agr-exp__tab {
    padding: 0.75rem 1.15rem;
    background: var(--surface);
    font-size: var(--step--1);
    color: var(--ink-muted);
    white-space: nowrap;
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }
  .agr-exp__tab:hover { color: var(--accent-deep); background: var(--accent-wash); }
  .agr-exp__tab[aria-selected='true'] { background: var(--accent); color: var(--surface-raise); }

  .agr-exp__body {
    margin-block-start: var(--sp-5);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .agr-exp__body { grid-template-columns: minmax(0, 1fr); } }
  .agr-exp__fig svg { inline-size: 100%; block-size: auto; max-inline-size: 26rem; }
  .agr-exp__fig .figure-note { margin-block-start: var(--sp-3); }
  .agr-curve { fill: none; stroke: var(--signal); stroke-width: 1; opacity: 0.22; transition: opacity var(--dur-3) var(--ease-out), stroke-width var(--dur-3) var(--ease-out); }
  .agr-exp[data-active='m0'] .agr-curve[data-m='m0'],
  .agr-exp[data-active='m05'] .agr-curve[data-m='m05'],
