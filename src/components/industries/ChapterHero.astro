---
/**
 * A chapter opening that several industry pages build on.
 *
 * Not every one of the thirteen needs a bespoke hero mechanism — some earn their
 * distinctiveness further down the page. This gives those chapters a strong,
 * consistent opening with room for their own signature mark, and keeps the
 * brand DNA identical across all of them.
 *
 * `align` and `weight` let a chapter change the composition without forking the
 * component: the same parts, arranged differently.
 */
import type { IndustryContent } from '../../content/types.ts';

interface Props {
  hero: IndustryContent['hero'];
  /** Which side the figure sits on. */
  figure?: 'end' | 'start' | 'none';
  /** Relative width of the figure column. */
  weight?: 'even' | 'copy' | 'figure';
  /** Adds the measured grid behind the opening. */
  grid?: boolean;
  class?: string;
}
const { hero, figure = 'end', weight = 'even', grid = true, class: className = '' } = Astro.props;
---

<header
  class:list={['chero', `chero--fig-${figure}`, `chero--${weight}`, grid && 'chero--grid', className]}
>
  <div class="shell--wide chero__inner">
    <div class="chero__copy">
      <p class="eyebrow">{hero.kicker}</p>
      <h1 class="chero__head">
        {hero.headline.map((line, i) => <span style={`--l:${i}`}>{line}</span>)}
      </h1>
      <p class="chero__lead">{hero.lead}</p>
      {hero.markers && hero.markers.length > 0 && (
        <ul class="chero__markers">
          {hero.markers.map((m) => <li class="t-mono">{m}</li>)}
        </ul>
      )}
      <slot name="actions" />
    </div>

    {figure !== 'none' && (
      <div class="chero__fig"><slot name="figure" /></div>
    )}
  </div>
</header>

<style>
  .chero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
    overflow: clip;
  }
  .chero--grid::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-unit) var(--grid-unit);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 78%);
    pointer-events: none;
  }

  .chero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .chero--copy .chero__inner { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); }
  .chero--figure .chero__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  .chero--fig-none .chero__inner { grid-template-columns: minmax(0, 1fr); }
  .chero--fig-start .chero__copy { order: 2; }
  .chero--fig-start .chero__fig { order: 1; }

  @media (max-width: 940px) {
    .chero__inner,
    .chero--copy .chero__inner,
    .chero--figure .chero__inner { grid-template-columns: 1fr; }
    .chero--fig-start .chero__copy { order: 0; }
    .chero--fig-start .chero__fig { order: 0; }
  }

  .chero__head {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    font-size: clamp(2.3rem, 5.4vw, 4.5rem);
    line-height: 1.01;
    letter-spacing: -0.033em;
    font-weight: 500;
  }
  .chero__head span { display: block; }
  .chero__head span:last-child { color: var(--accent-deep); }
  .chero--fig-none .chero__head { max-inline-size: 20ch; }

  .chero__lead {
    margin-block-start: clamp(1.25rem, 2.5vw, 1.85rem);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 50ch;
  }

  .chero__markers {
    margin-block-start: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chero__markers li {
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    padding: 0.4em 0.75em;
    border: 1px solid color-mix(in oklab, var(--accent) 34%, transparent);
    color: var(--accent-deep);
    background: color-mix(in oklab, var(--surface-raise) 70%, transparent);
  }
  :global(html[lang='zh']) .chero__markers li,
  :global(html[lang='th']) .chero__markers li,
  :global(html[lang='ar']) .chero__markers li,
  :global(html[lang='fa']) .chero__markers li,
  :global(html[lang='ur']) .chero__markers li {
    font-family: var(--font-body);
    letter-spacing: 0;
    font-size: var(--step--1);
  }

  .chero__fig :global(svg) { inline-size: 100%; block-size: auto; }

  @keyframes chero-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  :global(html.js) .chero__head span {
    animation: chero-in 640ms var(--ease-out) both;
    animation-delay: calc(100ms + var(--l) * 80ms);
  }
</style>
