---
/**
 * FURNITURE & DECOR — object-led chapter.
 *
 * The other chapters draw a system, a flow or a process. This one draws
 * objects, one at a time, at generous scale, on warm paper plates — and it
 * redraws the same thing in every section: the LOAD PATH. It enters a castor
 * stem in the hero, spreads through five arms in section 02, meets a rib and a
 * boss in 03, repeats a hundred thousand times in 04, and only then turns into
 * money in 05, 06 and 07.
 *
 * The argument the page turns on is in section 05: on furniture the assembly
 * minute is usually a bigger line than the mouldings, so a fastener removed by
 * geometry is worth more than a gram of resin saved. Everything technical on
 * this page exists to make that credible.
 *
 * Every rendered string comes from the content JSON. Nine languages read this.
 */
import type { Locale } from '../../i18n/locales.ts';
import TechNote from '../TechNote.astro';
import type { Industry } from '../../config/industries.ts';
import type { IndustryContent, CommonContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  industry: Industry;
  content: IndustryContent;
  common: CommonContent;
}
const { locale, content, common } = Astro.props;
const b = content.blocks as any;
const publicLoadCallouts = b.loadpath.callouts
  .map((callout: any, originalIndex: number) => ({ callout, originalIndex }))
  .filter(({ originalIndex }: any) => originalIndex === 1 || originalIndex === 3);
const showUnsupportedRibRules = false;
const showUnsupportedCycleCounts = false;
const showUnsupportedWeldStrengthFigures = false;
const publicPanels = b.panels.items.slice(1);

/* ── Drawing helpers ─────────────────────────────────────────────────────── */
const RAD = (deg: number) => (deg * Math.PI) / 180;
const f = (n: number) => Number(n.toFixed(1));

interface StarGeo {
  cx: number; cy: number; hub: number; len: number; w1: number; w2: number; sr: number;
}
/** The five-star base, drawn in plan. Used large in 02 and tiny in the atlas. */
const STAR: StarGeo = { cx: 320, cy: 270, hub: 44, len: 186, w1: 34, w2: 22, sr: 28 };
const STAR_SM: StarGeo = { cx: 66, cy: 46, hub: 12, len: 32, w1: 10, w2: 6, sr: 7 };
const ARMS = [-90, -18, 54, 126, 198];
/** The five gaps between arms, where callout discs and leaders can live. */
const GAPS = [234, 18, 90, 162];

const pt = (a: number, r: number, g: StarGeo = STAR): [number, number] => [
  g.cx + Math.cos(RAD(a)) * r,
  g.cy + Math.sin(RAD(a)) * r,
];

/** One tapered arm, hub edge to socket, closed round the socket end. */
function armPath(a: number, g: StarGeo = STAR) {
  const c = Math.cos(RAD(a));
  const s = Math.sin(RAD(a));
  const px = -s;
  const py = c;
  const x1 = f(g.cx + c * g.hub + px * g.w1);
  const y1 = f(g.cy + s * g.hub + py * g.w1);
  const x2 = f(g.cx + c * g.len + px * g.w2);
  const y2 = f(g.cy + s * g.len + py * g.w2);
  const x3 = f(g.cx + c * g.len - px * g.w2);
  const y3 = f(g.cy + s * g.len - py * g.w2);
  const x4 = f(g.cx + c * g.hub - px * g.w1);
  const y4 = f(g.cy + s * g.hub - py * g.w1);
  return `M${x1} ${y1} L${x2} ${y2} A ${g.w2} ${g.w2} 0 0 0 ${x3} ${y3} L${x4} ${y4}`;
}

/** A circle written as a path, so stroke-dashoffset drawing works everywhere. */
const circ = (cx: number, cy: number, r: number) =>
  `M${f(cx - r)} ${f(cy)} a ${r} ${r} 0 1 0 ${r * 2} 0 a ${r} ${r} 0 1 0 ${-r * 2} 0`;

/** A hairline crack front: short, jagged, oriented across the section. */
function crackPath(x: number, y: number, deg: number) {
  const c = Math.cos(RAD(deg));
  const s = Math.sin(RAD(deg));
  const pts: Array<[number, number]> = [[-18, 0], [-10, -5], [-2, 4], [6, -4], [13, 3], [19, -1]];
  return pts
    .map(([u, v], i) => `${i === 0 ? 'M' : 'L'}${f(x + u * c - v * s)} ${f(y + u * s + v * c)}`)
    .join(' ');
}

/** A screw, drawn as head, shaft, point and three thread ticks. */
function screwPath(x: number, y: number) {
  const ticks = [14, 20, 26].map((d) => `M${x - 4} ${y + d} H${x + 4}`).join(' ');
  return `M${x - 11} ${y} H${x + 11} V${y + 8} H${x - 11} Z M${x - 4} ${y + 8} H${x + 4} V${y + 32} L${x} ${y + 40} L${x - 4} ${y + 32} Z ${ticks}`;
}

/* The four failure locations on the base: where they sit, and where the
   numbered disc that names them sits. */
const CO = [
  { anchor: pt(-90, 62), disc: pt(GAPS[0], 252), across: 0 },
  { anchor: pt(-18, 112), disc: pt(GAPS[1], 252), across: 72 },
  { anchor: pt(54, 132), disc: pt(GAPS[2], 252), across: 144 },
  { anchor: pt(126, 166), disc: pt(GAPS[3], 252), across: 216 },
];

/* Cavity ruler: 0–48 mapped across the plate. */
const CAV_X = (n: number) => f(44 + (n / 48) * 572);
const CAV_MAJOR = [0, 8, 16, 24, 32, 40, 48];
const CAV_MINOR = Array.from({ length: 25 }).map((_, i) => i * 2);
const CAV_BANDS = [[1, 2], [4, 16], [20, 46]];

/* Texture columns get progressively coarser grain; row colours are mixed from
   the chapter palette so nothing here is a hex literal. */
const MX_GRAIN = [6, 1.5, 2.6, 4.2];
const MX_OPACITY = [0, 0.5, 0.72, 1];
const MX_COLOUR = [
  'var(--surface)',
  'var(--surface-sunk)',
  'color-mix(in oklab, var(--accent) 52%, var(--surface))',
  'color-mix(in oklab, var(--signal) 58%, var(--ink))',
];
---

  {/* ═══ HERO — SPLIT: the statement carries it, the object stands on a
      full-height board beside it, and a single rule divides the two. The
      opening is the chapter's own tint — a workshop bed, not paper. ═══ */}
  <header class="fur-hero ground--tint mat mat--milled" data-tex="grain">
    <div class="shell--wide fur-hero__inner split">
      <div class="fur-hero__copy" data-split-copy>
        <p class="eyebrow">{content.hero.kicker}</p>
        <h1 class="fur-hero__head t-statement t-statement--wide">
          {content.hero.headline.map((line: string, i: number) => (
            <span class={i === 0 ? 'lead-in' : 'payload'}>{line}</span>
          ))}
        </h1>
        <p class="fur-hero__lead">{content.hero.lead}</p>
      </div>

      <figure class="fur-hero__fig" data-split-figure>
        <div class="fur-plate fur-plate--hero">
          <div class="fur-plate__head">
            <span class="t-label">{b.hero.caption}</span>
            <span class="t-mono fur-plate__no">{b.hero.plate}</span>
          </div>
          <svg viewBox="0 0 440 356" data-nomirror role="img" aria-label={common.schematic}>
            <defs>
              <pattern id="fur-floor" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="10" stroke="currentColor" stroke-width="0.7" opacity="0.4" />
              </pattern>
              <marker id="fur-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0 1 L9 5 L0 9 z" fill="var(--signal)" />
              </marker>
              <marker id="fur-tick" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                <path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--accent)" stroke-width="1.1" />
              </marker>
            </defs>

            {/* Centre lines: swivel axis, axle axis, axle height. */}
            <path d="M196 4 V344" class="fur-cl" />
            <path d="M240 150 V344" class="fur-cl" />
            <path d="M140 224 H352" class="fur-cl" />

            {/* Floor. */}
            <path d="M36 292 H414" class="fur-l fur-draw" style="--d:6" />
            <rect x="36" y="292" width="378" height="13" fill="url(#fur-floor)" stroke="none" class="fur-floorband" />

            {/* Wheel, then the yoke drawn opaque over it, as an elevation should be. */}
            <path d={circ(240, 224, 68)} class="fur-l fur-draw" style="--d:4" />
            <path d={circ(240, 224, 57)} class="fur-l fur-l--fine fur-draw" style="--d:5" />
            <path d="M152 122 H240 L266 190 A 26 26 0 0 1 214 190 Z" class="fur-fill fur-fade" />
            <path d="M152 122 H240 L266 190 A 26 26 0 0 1 214 190 Z" class="fur-l fur-draw" style="--d:3" />
            <path d={circ(240, 224, 9)} class="fur-l fur-l--fine fur-draw" style="--d:5" />

            {/* Stem, flange, raceway. */}
            <path d="M182 44 H210 V96 H182 Z" class="fur-l fur-draw" style="--d:0" />
            <path d="M182 58 l-6 4 l6 4 M210 58 l6 4 l-6 4" class="fur-l fur-l--fine fur-draw" style="--d:1" />
            <path d="M156 96 H236 V104 H156 Z" class="fur-l fur-draw" style="--d:1" />
            <path d="M150 104 H242 V122 H150 Z" class="fur-l fur-draw" style="--d:2" />
            {Array.from({ length: 8 }).map((_: any, i: number) => (
              <path d={circ(160 + i * 11, 113, 4.2)} class="fur-l fur-l--fine fur-ball" style={`--i:${i}`} />
            ))}

            {/* The load path. The reason the drawing exists. */}
            <path d="M196 6 V40" class="fur-load" marker-end="url(#fur-head)" />
            <path d="M196 40 V122 L240 224 V292" class="fur-load fur-load--route" />
            <path d="M240 318 V298" class="fur-load" marker-end="url(#fur-head)" />

            {/* Swivel offset — the dimension that makes a castor trail. */}
            <path d="M196 326 H240" class="fur-dim" marker-start="url(#fur-tick)" marker-end="url(#fur-tick)" />

            {/* Leaders. Dot at the anchor, elbow out to the margin. */}
            <path d="M182 62 L104 44" class="fur-lead" />
            <path d="M150 113 L104 100" class="fur-lead" />
            <path d="M188 160 L104 178" class="fur-lead" />
            <path d="M295 185 L388 150" class="fur-lead" />
            <circle cx="182" cy="62" r="2.6" class="fur-anchor" />
            <circle cx="150" cy="113" r="2.6" class="fur-anchor" />
            <circle cx="188" cy="160" r="2.6" class="fur-anchor" />
            <circle cx="295" cy="185" r="2.6" class="fur-anchor" />

            <text x="100" y="48" text-anchor="end" class="fur-mic">{b.hero.labels.stem}</text>
            <text x="100" y="104" text-anchor="end" class="fur-mic">{b.hero.labels.raceway}</text>
            <text x="100" y="182" text-anchor="end" class="fur-mic">{b.hero.labels.fork}</text>
            <text x="436" y="154" text-anchor="end" class="fur-mic">{b.hero.labels.tread}</text>
            <text x="204" y="22" class="fur-mic fur-mic--load">{b.hero.labels.load}</text>
            <text x="252" y="314" class="fur-mic fur-mic--load">{b.hero.labels.reaction}</text>
            <text x="218" y="346" text-anchor="middle" class="fur-mic fur-mic--dim">{b.hero.labels.offset}</text>
          </svg>
        </div>
        <figcaption class="figure-note">{common.schematic}</figcaption>
      </figure>
    </div>

    {/* The chapter's verified capability, set to be read rather than tidied
        into an 11px strip. Same strings, promoted to the shared badge. */}
    <div class="shell--wide fur-hero__foot">
      <ul class="fur-rail badges">
        {b.hero.rail.map((item: string) => <li class="badge">{item}</li>)}
      </ul>
    </div>
  </header>

  {/* ═══ 01 · THE OBJECTS — a fittings catalogue, set as editorial rows ═══ */}
  <section class="fur-band fur-objects" id="objects">
    <div class="shell--wide fur-band__grid">
      <p class="fur-band__idx t-mono">{b.objects.index}</p>
      <div class="fur-band__body">
        <p class="eyebrow">{b.objects.kicker}</p>
        <h2 class="fur-h2">{b.objects.heading}</h2>
        <p class="fur-lead">{b.objects.body}</p>

        <p class="t-label fur-objects__cap">{b.objects.listLabel}</p>
        <ol class="fur-atlas">
          {b.objects.rows.map((row: any, i: number) => (
            <li class="fur-atlas__row" data-reveal style={`--reveal-delay:${i * 40}ms`}>
              <span class="fur-atlas__no t-mono">{row.code}</span>
              <span class="fur-atlas__fig" aria-hidden="true">
                <svg viewBox="0 0 132 92" data-nomirror>
                  {i === 0 && (
                    <>
                      <path d="M60 10 H74 V26 H60 Z" class="fur-l" />
                      <path d="M52 26 H82 V36 H52 Z" class="fur-l" />
                      <path d="M53 36 H81 L90 58 A 12 12 0 0 1 66 58 Z" class="fur-fill" />
                      <path d="M53 36 H81 L90 58 A 12 12 0 0 1 66 58 Z" class="fur-l" />
                      <path d={circ(78, 58, 26)} class="fur-l" />
                      <path d={circ(78, 58, 18)} class="fur-l fur-l--fine" />
                      <path d="M14 84 H118" class="fur-l fur-l--fine" />
                    </>
                  )}
                  {i === 1 && (
                    <>
                      {ARMS.map((a: any) => <path d={armPath(a, STAR_SM)} class="fur-l" />)}
                      {ARMS.map((a: any) => {
                        const p = pt(a, STAR_SM.len, STAR_SM);
                        return <path d={circ(p[0], p[1], 4)} class="fur-l fur-l--fine" />;
                      })}
                      <path d={circ(STAR_SM.cx, STAR_SM.cy, 14)} class="fur-l" />
                      <path d={circ(STAR_SM.cx, STAR_SM.cy, 7)} class="fur-l fur-l--fine" />
                    </>
                  )}
                  {i === 2 && (
                    <>
                      <path d="M16 82 Q12 44 40 38 H92 Q112 34 116 12" class="fur-l" />
                      <path d="M25 82 Q21 50 43 45 H92 Q105 41 108 20" class="fur-l" />
                      <path d="M16 82 H25 M116 12 L108 20" class="fur-l" />
                      <path d="M46 45 V38 M62 45 V38 M78 45 V38" class="fur-l fur-l--fine" />
                    </>
                  )}
                  {i === 3 && (
                    <>
                      <path d="M20 22 H100 V72 H20 Z" class="fur-l" />
                      <path d="M48 34 H74 V46 H48 Z" class="fur-l fur-l--fine" />
                      <path d={circ(36, 60, 6)} class="fur-l fur-l--fine" />
                      <path d={circ(86, 60, 6)} class="fur-l fur-l--fine" />
                      <path d="M100 46 H120" class="fur-l" />
                      <path d={circ(124, 46, 5)} class="fur-l" />
                    </>
                  )}
                  {i === 4 && (
                    <>
                      <path d="M46 30 V78 M86 30 V78" class="fur-cl" />
                      <path d="M34 20 H98 V32 H34 Z" class="fur-l" />
                      <path d="M56 32 H76 V72 H56 Z" class="fur-l" />
                      <path d="M56 42 l-9 5 l9 5 M76 42 l9 5 l-9 5" class="fur-l fur-l--fine" />
                      <path d="M56 56 l-9 5 l9 5 M76 56 l9 5 l-9 5" class="fur-l fur-l--fine" />
                    </>
                  )}
                  {i === 5 && (
                    <>
                      <path d={circ(40, 46, 22)} class="fur-l" />
                      <path d={circ(40, 46, 7)} class="fur-l fur-l--fine" />
                      <path d="M40 39 H64 V53 H40" class="fur-l fur-l--fine" />
                      <path d="M31 30 L49 30" class="fur-l fur-l--fine" />
                      <path d="M84 38 H118 L124 44 V50 L118 56 H84 Z" class="fur-l" />
                      <path d="M94 38 V56 M102 38 V56 M110 38 V56" class="fur-l fur-l--fine" />
                    </>
                  )}
                  {i === 6 && (
                    <>
                      <path d="M22 18 H104 V30 H62 V46" class="fur-l" />
                      <path d={circ(46, 54, 18)} class="fur-l" />
                      <path d={circ(46, 54, 6)} class="fur-l fur-l--fine" />
                      <path d="M14 78 H118 M14 78 V68" class="fur-l fur-l--fine" />
                      <path d="M88 30 V62 H118" class="fur-l fur-l--fine" />
                    </>
                  )}
                  {i === 7 && (
                    <>
                      <path d="M22 24 H110 V70 H22 Z" class="fur-l" />
                      <path d="M32 32 H100 V62 H32 Z" class="fur-l fur-l--fine" />
                      <path d="M32 47 H100" class="fur-cl" />
                      <path d={circ(66, 47, 6)} class="fur-l fur-l--fine" />
                    </>
                  )}
                </svg>
              </span>
              <span class="fur-atlas__name">{row.name}</span>
              <span class="fur-atlas__note">{row.note}</span>
            </li>
          ))}
        </ol>
        <p class="figure-note fur-atlas__note-line">{common.schematic}</p>

        <p class="fur-objects__close t-small">{b.objects.close}</p>
      </div>
    </div>
  </section>

  {/* ═══ 02 · THE LOAD PATH — the technical centrepiece ═══════════════════ */}
  <section class="fur-band fur-lp" id="load-path" data-stepper data-step="0">
    <div class="shell--wide fur-band__grid">
      <p class="fur-band__idx t-mono">{b.loadpath.index}</p>
      <div class="fur-band__body">
        <p class="eyebrow">{b.loadpath.kicker}</p>
        <h2 class="fur-h2">{b.loadpath.heading}</h2>
        <p class="fur-lead">{b.loadpath.body}</p>

        <div class="fur-lp__grid">
          <figure class="fur-lp__fig">
            <div class="fur-plate">
              <div class="fur-plate__head">
                <span class="t-label">{b.loadpath.calloutsLabel}</span>
                <span class="t-mono fur-plate__no">{b.loadpath.plate}</span>
              </div>
              <svg viewBox="0 0 640 560" data-nomirror role="img" aria-label={common.schematic}>
                <defs>
                  <marker id="fur-lp-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M0 1 L9 5 L0 9 z" fill="var(--signal)" />
                  </marker>
                </defs>

                {/* Arms, then the ribs that run down them, then the sockets. */}
                {ARMS.map((a: any) => <path d={armPath(a)} class="fur-fill" />)}
                {ARMS.map((a: any) => <path d={armPath(a)} class="fur-l" />)}
                {ARMS.map((a: any) => {
                  const c = Math.cos(RAD(a));
                  const s = Math.sin(RAD(a));
                  const px = -s;
                  const py = c;
                  return [-13, 0, 13].map((o: any) => (
                    <path
                      d={`M${f(STAR.cx + c * (STAR.hub + 8) + px * o)} ${f(STAR.cy + s * (STAR.hub + 8) + py * o)} L${f(STAR.cx + c * (STAR.len - 34) + px * o)} ${f(STAR.cy + s * (STAR.len - 34) + py * o)}`}
                      class={o === 0 ? 'fur-cl' : 'fur-l fur-l--fine'}
                    />
                  ));
                })}
                {ARMS.map((a: any) => {
                  const p = pt(a, STAR.len);
                  return (
                    <>
                      <path d={circ(p[0], p[1], STAR.sr - 6)} class="fur-l" />
                      <path d={circ(p[0], p[1], 11)} class="fur-l fur-l--fine" />
                    </>
                  );
                })}

                {/* Column bore. */}
                <path d={circ(STAR.cx, STAR.cy, STAR.hub)} class="fur-fill" />
                <path d={circ(STAR.cx, STAR.cy, STAR.hub)} class="fur-l" />
                <path d={circ(STAR.cx, STAR.cy, 26)} class="fur-l" />
                <path d={circ(STAR.cx, STAR.cy, 17)} class="fur-l fur-l--fine" />

                {/* Load in at the column, out at five sockets.
                    ⊗ into the page, ⊙ out of it — the drafting convention. */}
                {ARMS.map((a: any) => {
                  const p1 = pt(a, STAR.hub);
                  const p2 = pt(a, STAR.len - 16);
                  return <path d={`M${f(p1[0])} ${f(p1[1])} L${f(p2[0])} ${f(p2[1])}`} class="fur-load fur-load--route" marker-end="url(#fur-lp-head)" />;
                })}
                <path d={circ(STAR.cx, STAR.cy, 13)} class="fur-load" />
                <path d="M311 261 L329 279 M329 261 L311 279" class="fur-load" />
                {ARMS.map((a: any) => {
                  const p = pt(a, STAR.len);
                  return (
                    <>
                      <path d={circ(p[0], p[1], 6)} class="fur-load fur-load--fine" />
                      <circle cx={f(p[0])} cy={f(p[1])} r="2.2" class="fur-load-dot" />
                    </>
                  );
                })}

                {/* The knit line at the arm-to-column transition. */}
                <path d="M290 208 L308 208 L320 215 L332 208 L350 208" class="fur-weld" />

                {/* A boss on the second arm. */}
                <path d={circ(CO[1].anchor[0], CO[1].anchor[1], 15)} class="fur-l" />
                <path d={circ(CO[1].anchor[0], CO[1].anchor[1], 7)} class="fur-l fur-l--fine" />

                {/* Four callouts. Each blooms and cracks when its step is read. */}
                {CO.map((c: any, i: number) => {
                  const dx = c.disc[0] - c.anchor[0];
                  const dy = c.disc[1] - c.anchor[1];
                  const len = Math.hypot(dx, dy);
                  const ex = f(c.disc[0] - (dx / len) * 15);
                  const ey = f(c.disc[1] - (dy / len) * 15);
                  return (
                    <g class="fur-co" data-co={i}>
                      <path d={`M${f(c.anchor[0])} ${f(c.anchor[1])} L${ex} ${ey}`} class="fur-lead" />
                      <circle cx={f(c.anchor[0])} cy={f(c.anchor[1])} r="3" class="fur-anchor" />
                      <path d={crackPath(c.anchor[0], c.anchor[1], c.across)} class="fur-crack" />
                      <path d={circ(c.disc[0], c.disc[1], 14)} class="fur-disc" />
                      <text x={f(c.disc[0])} y={f(c.disc[1] + 5)} text-anchor="middle" class="fur-mic fur-mic--disc">
                        {b.loadpath.callouts[i].n}
                      </text>
                    </g>
                  );
                })}

                <path d="M330 261 L446 76" class="fur-lead" />
                <circle cx="330" cy="261" r="3" class="fur-anchor" />
                <text x="452" y="72" class="fur-mic fur-mic--load">{b.loadpath.labels.load}</text>
                <path d="M513 196 L566 140" class="fur-lead" />
                <circle cx="513" cy="196" r="3" class="fur-anchor" />
                <text x="634" y="136" text-anchor="end" class="fur-mic fur-mic--load">{b.loadpath.labels.reaction}</text>
              </svg>
            </div>
            <figcaption class="figure-note">{common.schematic}</figcaption>
          </figure>

          <ol class="fur-lp__steps">
            {publicLoadCallouts.map(({ callout: c, originalIndex }: any) => (
              <li class="fur-lp__step" data-station-step={originalIndex}>
                <span class="fur-lp__n t-mono">{c.n}</span>
                <h3 class="fur-h5">{c.title}</h3>
                <p>{c.body}</p>
              </li>
            ))}
          </ol>
        </div>

        <p class="fur-fine">{b.loadpath.sourceNote}</p>
