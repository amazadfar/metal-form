        <p class="fur-lead">{b.supply.body}</p>

        <TechNote locale={locale} kind="reasoning">
          <div class="fur-ledger">
            <div class="fur-ledger__head">
              <span class="t-label">{b.supply.ledgerHeads.risk}</span>
              <span class="t-label">{b.supply.ledgerHeads.route}</span>
            </div>
            {b.supply.ledger.map((row: any, i: number) => (
              <div class="fur-ledger__row">
                <p class="fur-ledger__risk" data-reveal style={`--reveal-delay:${i * 60}ms`}>{row.risk}</p>
                <p class="fur-ledger__route" data-reveal style={`--reveal-delay:${i * 60 + 120}ms`}>{row.route}</p>
              </div>
            ))}
          </div>
        </TechNote>

        {/* The scope limit. Not fine print — the strongest thing on the page. */}
        <div class="fur-scope">
          <h3 class="fur-h4">{b.supply.boundary.heading}</h3>
          <p class="fur-scope__lead">{b.supply.boundary.lead}</p>
          <div class="fur-scope__cols">
            <section class="fur-scope__col">
              <h4 class="t-label">{b.supply.boundary.ours.heading}</h4>
              <ul>
                {b.supply.boundary.ours.items.map((item: string) => <li>{item}</li>)}
              </ul>
            </section>
            <section class="fur-scope__col fur-scope__col--yours">
              <h4 class="t-label">{b.supply.boundary.yours.heading}</h4>
              <ul>
                {b.supply.boundary.yours.items.map((item: string) => <li>{item}</li>)}
              </ul>
            </section>
          </div>
          <p class="fur-scope__close">{b.supply.boundary.close}</p>
        </div>

        {b.supply.response ? <p class="fur-sup__response"><span class="badge">{b.supply.response}</span></p> : null}

        {/* Layer three: depth, folded away until it is wanted. */}
        <div class="fur-panels">
          <h3 class="t-label fur-panels__h">{b.panels.heading}</h3>
        {publicPanels.map((panel: any, i: number) => (
            <div class="disc" data-open="false">
              <h4>
                <button class="disc__btn" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span>{panel.title}</span>
                  <span class="disc__sign" aria-hidden="true"></span>
                </button>
              </h4>
              <div class="disc__panel">
                <div class="disc__inner">
                  <div>
                    <ul class="fur-panel__list">
                      {panel.bullets.map((bullet: string) => <li>{bullet}</li>)}
                    </ul>
                    {panel.source && <p class="fur-fine">{panel.source}</p>}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

<style>
  /* ═══ FURNITURE CHAPTER ══════════════════════════════════════════════════
     Warm paper, hairline ink, one pigment. Objects are set down on plates at a
     consistent drawing weight; the page is a plate book, not a dashboard.
     Clay (--signal) carries load and failure. Olive-brass (--accent) carries
     everything measured. Nothing else is saturated. */

  /* No wrapper element: the hero has to BE `main > :first-child` so the shared
     header clearance lands inside the tint rather than above it. The chapter's
     one drawing token is therefore declared on the top-level bands instead. */
  .fur-hero,
  .fur-band { --fur-ink: color-mix(in oklab, var(--ink) 82%, transparent); }

  /* ── Drawing conventions, shared by every figure in the chapter ───────── */
  .fur-l { fill: none; stroke: var(--fur-ink); stroke-width: 1.35; stroke-linejoin: round; stroke-linecap: round; }
  .fur-l--fine { stroke-width: 0.85; }
  .fur-fill { fill: var(--surface-raise); stroke: none; }
  .fur-sect { stroke: none; color: var(--fur-ink); }
  .fur-cl { fill: none; stroke: var(--accent); stroke-width: 0.7; stroke-dasharray: 10 3 1.5 3; opacity: 0.55; }
  .fur-dim { fill: none; stroke: var(--accent); stroke-width: 0.9; }
  .fur-lead { fill: none; stroke: var(--accent); stroke-width: 0.7; opacity: 0.85; }
  .fur-anchor { fill: var(--accent); }
  .fur-load { fill: none; stroke: var(--signal); stroke-width: 2.1; stroke-linejoin: round; stroke-linecap: round; }
  .fur-load--route { stroke-width: 2.3; }
  .fur-load--fine { stroke-width: 1.2; }
  .fur-load-dot { fill: var(--signal); }
  .fur-weld { fill: none; stroke: var(--signal); stroke-width: 1.2; stroke-dasharray: 4 3; }
  .fur-flex { fill: none; stroke: var(--signal); stroke-width: 1.1; stroke-dasharray: 7 5; opacity: 0.8; }
  .fur-crack { fill: none; stroke: var(--signal); stroke-width: 1.5; stroke-linecap: round; }
  .fur-disc { fill: var(--surface-raise); stroke: var(--signal); stroke-width: 1.2; }
  .fur-floorband { color: var(--fur-ink); }
  .fur-mic {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    fill: var(--ink-muted);
  }
  .fur-mic--load { fill: var(--signal); }
  .fur-mic--dim { fill: var(--accent-deep); }
  .fur-mic--disc { fill: var(--signal); font-size: 11px; }
  .fur-plate svg { inline-size: 100%; block-size: auto; display: block; }

  /* ── Type: lighter, larger, longer measures than the technical chapters ─ */
  .fur-h2 {
    margin-block-start: var(--sp-5);
    font-size: clamp(1.85rem, 3.6vw, 3.05rem);
    line-height: 1.14;
    letter-spacing: -0.018em;
    font-weight: var(--weight-regular);
    max-inline-size: 21ch;
    text-wrap: balance;
  }
  .fur-h4 { font-size: var(--step-3); line-height: 1.2; font-weight: var(--weight-regular); letter-spacing: -0.012em; max-inline-size: 22ch; }
  .fur-h5 { font-size: var(--step-1); line-height: 1.3; font-weight: var(--weight-medium); letter-spacing: var(--track-head); }

  .fur-lead {
    margin-block-start: var(--sp-6);
    font-size: var(--step-0);
    line-height: 1.68;
    color: color-mix(in oklab, var(--ink) 74%, var(--surface));
    max-inline-size: 70ch;
  }
  /* Very short measure, set large: the counterweight to the long paragraphs. */
  .fur-close {
    margin-block-start: clamp(2.5rem, 5vw, 4.5rem);
    font-size: var(--step-2);
    line-height: 1.34;
    letter-spacing: -0.012em;
    max-inline-size: 27ch;
    margin-inline-start: auto;
    text-align: start;
  }
  @media (max-width: 1000px) { .fur-close { margin-inline-start: 0; } }
  .fur-fine {
    margin-block-start: var(--sp-5);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--ink-muted);
    max-inline-size: 58ch;
  }

  /* ── The binding edge: a numeral in the gutter, a hairline down the page ─ */
  .fur-band { padding-block: var(--section-y); }
  .fur-band__grid {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: start;
  }
  .fur-band__idx {
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    color: var(--accent-deep);
    padding-block-start: 0.15em;
  }
  .fur-band__body {
    border-inline-start: var(--rule);
    padding-inline-start: clamp(1.5rem, 3.5vw, 3.75rem);
  }
  @media (max-width: 1000px) {
    .fur-band__grid { grid-template-columns: minmax(0, 1fr); }
    .fur-band__idx { margin-block-end: var(--sp-3); }
    .fur-band__body { border-inline-start: 0; padding-inline-start: 0; }
  }

  /* ── The plate: every drawing sits in one ─────────────────────────────── */
  .fur-plate {
    position: relative;
    background: var(--surface-raise);
    border: var(--rule);
    border-radius: var(--r-1);
    padding: clamp(0.9rem, 2vw, 1.6rem);
  }
  .fur-plate::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-start: -1px;
    inline-size: var(--sp-5);
    block-size: var(--hair-strong);
    background: var(--accent);
  }
  .fur-plate__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block-end: var(--sp-4);
    margin-block-end: var(--sp-4);
    border-block-end: var(--rule);
  }
  .fur-plate__no { font-size: var(--step--2); color: var(--accent-deep); letter-spacing: 0.1em; flex: none; }
  .fur-plate--flat { background: var(--surface-sunk); }

  /* ── Hero — SPLIT ─────────────────────────────────────────────────────────
     Two columns that are deliberately not the same width: the statement takes
     the larger share and a single hairline divides it from a board that runs
     the full height of the opening, so the castor is an object standing on a
     surface rather than a line drawing floating in a half-empty column.

     No `padding-block-start` and no `background` here on purpose. The ground
     class supplies the bed and the chapter layout supplies the clearance under
     the header — restating either is how a tint opening ends up with a strip
     of light page above it. */
  .fur-hero {
    padding-block-end: clamp(3rem, 7vw, 6rem);
    --tex-opacity: 0.3;
  }
  .fur-hero__inner {
    --split-a: 1.28fr;
    --split-b: 0.92fr;
    --split-gap: 0;
    --split-align: stretch;
    --col-pad: clamp(1.5rem, 3.4vw, 3.5rem);
  }
  /* The dividing rule gets air on BOTH sides of it, and the grid still starts
     flush with the gutter. */
  .fur-hero__inner > * {
    min-inline-size: 0;
    border-inline-start: var(--rule);
    padding-inline-start: var(--col-pad);
  }
  .fur-hero__inner > :first-child {
    border-inline-start: 0;
    padding-inline-start: 0;
    padding-inline-end: var(--col-pad);
  }
  @media (max-width: 1000px) {
    .fur-hero__inner > *,
    .fur-hero__inner > :first-child {
      border-inline-start: 0;
      padding-inline: 0;
    }
  }

  .fur-hero__copy { display: grid; align-content: start; }
  /* `.t-statement--wide` carries the size and the measure; the chapter only
     opens the leading, because this headline is two sentences rather than one
     display line and Armenian descenders need the room. */
  .fur-hero__head {
    margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
    line-height: 1.08;
  }

  .fur-hero__lead {
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    font-size: var(--step-0);
    line-height: 1.68;
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }

  /* The board: as tall as the opening, with the object centred on it. */
  .fur-hero__fig {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    align-self: stretch;
  }
  .fur-hero__fig .figure-note { margin-block-start: var(--sp-4); }
  .fur-plate--hero {
    padding: clamp(1rem, 2.4vw, 2rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .fur-plate--hero svg { align-self: center; }

  .fur-hero__foot {
    margin-block-start: clamp(2.5rem, 6vw, 5rem);
    padding-block-start: var(--sp-5);
    border-block-start: var(--rule);
  }
  /* `ground--tint` remaps the token set but carries no `.on-steel` hook, so the
     badge would keep the light-surface relief over a dark bed. */
  .fur-hero .badge { box-shadow: var(--relief-dark); }

  /* The hero drawing inks itself in once, then the load path settles. */
  @keyframes fur-ink { to { stroke-dashoffset: 0; } }
  @keyframes fur-fade { from { opacity: 0; } to { opacity: 1; } }
  .fur-plate--hero .fur-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: fur-ink 900ms var(--ease-glide) both;
    animation-delay: calc(160ms + var(--d, 0) * 110ms);
  }
  .fur-plate--hero .fur-fade { animation: fur-fade 600ms var(--ease-out) 620ms both; }
  .fur-plate--hero .fur-ball { animation: fur-fade 400ms var(--ease-out) both; animation-delay: calc(560ms + var(--i) * 40ms); }
  .fur-plate--hero .fur-load,
  .fur-plate--hero .fur-mic--load,
  .fur-plate--hero .fur-dim,
  .fur-plate--hero .fur-lead,
  .fur-plate--hero .fur-anchor,
  .fur-plate--hero .fur-mic { animation: fur-fade 700ms var(--ease-out) 1150ms both; }
  @media (prefers-reduced-motion: reduce) {
    .fur-plate--hero .fur-draw { stroke-dashoffset: 0; animation: none; }
    .fur-plate--hero .fur-fade,
    .fur-plate--hero .fur-ball,
    .fur-plate--hero .fur-load,
    .fur-plate--hero .fur-mic,
    .fur-plate--hero .fur-dim,
    .fur-plate--hero .fur-lead,
    .fur-plate--hero .fur-anchor { animation: none; opacity: 1; }
  }

  /* ── 01 The atlas ─────────────────────────────────────────────────────── */
  .fur-objects__cap { display: block; margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .fur-atlas { margin-block-start: var(--sp-5); border-block-start: var(--rule-strong); }
  .fur-atlas__row {
    display: grid;
    grid-template-columns: 5.5rem 8.5rem minmax(0, 1fr) minmax(0, 1.35fr);
    gap: var(--sp-5) clamp(1rem, 2.5vw, 2.5rem);
    align-items: center;
    padding-block: clamp(1.25rem, 2.6vw, 2.25rem);
    border-block-end: var(--rule);
  }
  .fur-atlas__no { font-size: var(--step--2); color: var(--accent-deep); letter-spacing: 0.1em; align-self: start; }
  .fur-atlas__fig { color: var(--fur-ink); }
  .fur-atlas__fig svg { inline-size: 100%; block-size: auto; display: block; }
  .fur-atlas__name { font-size: var(--step-1); line-height: 1.28; letter-spacing: -0.012em; }
  .fur-atlas__note { font-size: var(--step--1); line-height: 1.62; color: var(--ink-muted); max-inline-size: 56ch; }
  @media (max-width: 1040px) {
    .fur-atlas__row { grid-template-columns: 4.5rem 7rem minmax(0, 1fr); }
    .fur-atlas__note { grid-column: 2 / -1; }
  }
  @media (max-width: 620px) {
    .fur-atlas__row { grid-template-columns: 4.5rem minmax(0, 1fr); align-items: start; }
    .fur-atlas__no { grid-column: 1; grid-row: 1; }
    .fur-atlas__name { grid-column: 2; grid-row: 1; }
    .fur-atlas__fig { grid-column: 1 / -1; grid-row: 2; max-inline-size: 10rem; }
    .fur-atlas__note { grid-column: 1 / -1; grid-row: 3; }
  }
  .fur-atlas__note-line { margin-block-start: var(--sp-4); }
  .fur-objects__close {
    margin-block-start: clamp(2rem, 4vw, 3rem);
    color: var(--ink-muted);
    max-inline-size: 74ch;
    line-height: 1.7;
  }

  /* ── 02 Load path ─────────────────────────────────────────────────────── */
  .fur-lp { background: var(--surface-sunk); border-block: var(--rule); }
  .fur-lp__grid {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .fur-lp__grid { grid-template-columns: minmax(0, 1fr); } }
  .fur-lp__fig { position: sticky; inset-block-start: clamp(5rem, 11vh, 7.5rem); }
  @media (max-width: 1000px) { .fur-lp__fig { position: static; } }
  .fur-lp__fig .figure-note { margin-block-start: var(--sp-4); }

  .fur-lp__steps { border-block-start: var(--rule-strong); }
  .fur-lp__step {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0 var(--sp-4);
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
    border-block-end: var(--rule);
  }
  .fur-lp__n { grid-row: 1 / span 2; font-size: var(--step-1); color: var(--signal-ink); }
  .fur-lp__step h3 { margin-block-end: var(--sp-3); }
  .fur-lp__step p { font-size: var(--step--1); line-height: 1.68; color: var(--ink-muted); max-inline-size: 46ch; }

  :global(html.js) .fur-lp__step { opacity: 0.45; transition: opacity 420ms var(--ease-out); }
  :global(html.js) .fur-lp[data-step='0'] .fur-lp__step[data-station-step='0'],
  :global(html.js) .fur-lp[data-step='1'] .fur-lp__step[data-station-step='1'],
  :global(html.js) .fur-lp[data-step='2'] .fur-lp__step[data-station-step='2'],
  :global(html.js) .fur-lp[data-step='3'] .fur-lp__step[data-station-step='3'] { opacity: 1; }
  @media (max-width: 1000px) { :global(html.js) .fur-lp__step { opacity: 1; } }

  :global(html.js) .fur-co { opacity: 0.32; transition: opacity 420ms var(--ease-out); }
  :global(html.js) .fur-co .fur-crack { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 640ms var(--ease-out); }
  :global(html.js) .fur-lp[data-step='0'] .fur-co[data-co='0'],
  :global(html.js) .fur-lp[data-step='1'] .fur-co[data-co='1'],
  :global(html.js) .fur-lp[data-step='2'] .fur-co[data-co='2'],
  :global(html.js) .fur-lp[data-step='3'] .fur-co[data-co='3'] { opacity: 1; }
  :global(html.js) .fur-lp[data-step='0'] .fur-co[data-co='0'] .fur-crack,
  :global(html.js) .fur-lp[data-step='1'] .fur-co[data-co='1'] .fur-crack,
  :global(html.js) .fur-lp[data-step='2'] .fur-co[data-co='2'] .fur-crack,
  :global(html.js) .fur-lp[data-step='3'] .fur-co[data-co='3'] .fur-crack { stroke-dashoffset: 0; }

  /* ── 03 Rib and boss ──────────────────────────────────────────────────── */
  .fur-rib__pair {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .fur-rib__pair { grid-template-columns: minmax(0, 1fr); } }
  .fur-rib__cap {
    margin-block-start: var(--sp-4);
    font-size: var(--step--1);
    line-height: 1.62;
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }
  .fur-crack--static { opacity: 0.9; }
  .fur-rib__schematic { margin-block-start: var(--sp-5); }
  .fur-rules { margin-block-start: clamp(2.5rem, 5vw, 4rem); max-inline-size: 62rem; }
  .fur-rules__h { display: block; margin-block-end: var(--sp-4); }
  .fur-rules__list { border-block-start: var(--rule-strong); }

  /* ── 04 Fatigue — the only inverted band in the chapter ───────────────── */
  .fur-fat {
    background: var(--inverse);
    color: var(--inverse-ink);
    --ink: var(--inverse-ink);
    --signal: var(--signal-inverse);
    --signal-ink: var(--signal-inverse);
    --accent: var(--accent-inverse);
    --accent-deep: var(--accent-inverse);
    --fur-ink: color-mix(in oklab, var(--inverse-ink) 80%, transparent);
    --ink-muted: color-mix(in oklab, var(--inverse-ink) 64%, transparent);
    --line: color-mix(in oklab, var(--inverse-ink) 20%, transparent);
    --surface-raise: color-mix(in oklab, var(--inverse-ink) 5%, var(--inverse));
    --accent: color-mix(in oklab, var(--accent-wash) 72%, var(--inverse));
    --accent-deep: var(--accent-wash);
    padding-block: var(--section-y-loose);
    /* Cast grain, felt rather than seen: a dark field this large reads as a
       flat digital rectangle without it. Second and last texture on the page. */
    --tex-opacity: 0.15;
  }
  .fur-fat .fur-lead { color: color-mix(in oklab, var(--inverse-ink) 78%, transparent); }
  .fur-fat .fur-fill { fill: color-mix(in oklab, var(--inverse-ink) 8%, transparent); }
  .fur-fat__grid {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 1000px) { .fur-fat__grid { grid-template-columns: minmax(0, 1fr); } }
  .fur-plate--dark { background: color-mix(in oklab, var(--inverse-ink) 4%, var(--inverse)); border-color: var(--line); }
  .fur-fat__fig .figure-note { margin-block-start: var(--sp-4); }

  .fur-cycles { border-block-start: var(--rule-strong); }
  .fur-cycles li {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.35rem;
    padding-block: var(--sp-5);
    border-block-end: var(--rule);
  }
  .fur-cycles__n { font-size: var(--step-2); color: var(--signal-ink); letter-spacing: 0.01em; }
  .fur-cycles__label { font-size: var(--step-0); }
  .fur-cycles__note { font-size: var(--step--2); line-height: 1.6; color: var(--ink-muted); max-inline-size: 44ch; }

  .fur-std { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .fur-std__list { margin-block: var(--sp-4); }
  /* This band is inverted, so the badge takes the dark relief the shared
     `.on-steel` variant would have given it. */
  .fur-fat .badge { box-shadow: var(--relief-dark); }
  .fur-std__note { font-size: var(--step--1); line-height: 1.68; color: var(--ink-muted); max-inline-size: 66ch; }

  .fur-glass { margin-block-start: clamp(2.5rem, 5vw, 4rem); }
  .fur-glass__body { margin-block-start: var(--sp-4); font-size: var(--step--1); line-height: 1.68; color: var(--ink-muted); max-inline-size: 66ch; }
  .fur-bars { margin-block-start: var(--sp-6); max-inline-size: 46rem; }
  .fur-bar {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) 8rem;
    gap: var(--sp-4);
    align-items: center;
    padding-block: var(--sp-4);
    border-block-end: var(--rule);
  }
  .fur-bar:first-of-type { border-block-start: var(--rule); margin-block-start: var(--sp-4); }
  @media (max-width: 860px) {
    .fur-bar { grid-template-columns: minmax(0, 1fr) 7rem; }
    .fur-bar__track { grid-column: 1 / -1; }
  }
  .fur-bar__label { font-size: var(--step--1); }
