---
/**
 * INDUSTRY SELECTOR
 *
 * Thirteen doors. This is the most important navigation on the site: a buyer
 * arrives wanting to know whether this company makes anything like their part,
 * and this grid is the answer.
 *
 * ── What changed ────────────────────────────────────────────────────────────
 * The previous version put every tile on a near-white surface with its mark at
 * 20% opacity bleeding off a corner. It was tidy and it was interchangeable:
 * the medical tile and the cosmetics tile differed by one accent colour and a
 * faint grey drawing, which is exactly the failure a thirteen-vertical site
 * cannot afford.
 *
 * Now each tile is a plate in that sector's own dark tint, carrying:
 *   · its mark at full presence, drawn in the vertical's accent — a cavity
 *     plate, a preform beside the bottle it becomes, a cam-driven slide
 *   · the surface texture of that sector's material, from `industries.ts`
 *   · a saturated colour band on the leading edge
 *
 * Thirteen dark plates in thirteen different tints, each with a different
 * drawing and a different surface, sitting in a light section. A buyer scanning
 * it sees thirteen different production environments, which is the point.
 */
import IndustryMark from './IndustryMark.astro';
import { INDUSTRY_LIST } from '../config/industries.ts';
import { localePath, type Locale } from '../i18n/locales.ts';
import { getIndustry, getCommon } from '../content/index.ts';

interface Props {
  locale: Locale;
  /** Shown as a small index beside each tile. */
  showIndex?: boolean;
}
const { locale, showIndex = true } = Astro.props;
const c = getCommon(locale);

const tiles = INDUSTRY_LIST.map((ind, i) => {
  const content = getIndustry(locale, ind.key);
  return {
    ind,
    i,
    name: content.name,
    tile: content.tile,
    parts: content.tileParts,
    href: localePath(locale, 'industries', ind.slug),
  };
});
---

<ul class="bento">
  {tiles.map(({ ind, i, name, tile, parts, href }) => (
    <li
      class:list={['bento__cell', ind.flagship && 'bento__cell--flag']}
      data-reveal
      style={`--reveal-delay:${i * 40}ms;--span:${ind.span};--rows:${ind.rowSpan};--accent:${ind.palette.accent};--accent-deep:${ind.palette.accentDeep};--wash:${ind.palette.accentWash};--tile-ground:${ind.palette.inverse};--mark:color-mix(in oklab, ${ind.palette.accent} 26%, #F0F6FA);--tile-ink:${ind.palette.inverseInk};--tile-line:${ind.palette.line};--i:${i}`}
    >
      <a
        class="bento-tile"
        href={href}
        data-analytics={`nav_industry_${ind.key}`}
        data-tex={ind.art.texture}
      >
        <span class="bento-tile__edge" aria-hidden="true"></span>

        <span class="bento-tile__mark" aria-hidden="true">
          <IndustryMark industry={ind.key} />
        </span>

        <span class="bento-tile__body">
          {showIndex && <span class="bento-tile__n t-mono">{String(i + 1).padStart(2, '0')}</span>}
          <span class="bento-tile__name">{name}</span>
          <span class="bento-tile__line">{tile}</span>
        </span>

        <span class="bento-tile__foot">
          {parts && <span class="bento-tile__parts t-mono">{parts}</span>}
          <span class="bento-tile__go">
            <span class="bento-tile__go-label">{c.actions.viewIndustry}</span>
            <svg viewBox="0 0 16 12" fill="none" class="bento-tile__arrow">
              <path d="M1 6h13M9.5 1.2 14.3 6l-4.8 4.8" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(9rem, auto);
    gap: 2px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 1080px) { .bento { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .bento__cell {
    grid-column: span var(--span);
    grid-row: span var(--rows);
    display: flex;
    min-inline-size: 0;
  }
  @media (max-width: 1080px) {
    .bento__cell { grid-column: span min(var(--span), 4); }
    .bento__cell--flag { grid-column: span 4; grid-row: span 2; }
  }
  @media (max-width: 720px) {
    .bento__cell { grid-column: span 2; grid-row: span 1; }
    .bento__cell--flag { grid-column: span 2; grid-row: span 2; }
  }

  /* ── Tile ─────────────────────────────────────────────────────────────
     A plate in the vertical's own dark tint. The thirteen `inverse` values in
     `industries.ts` are genuinely different colours — a clinical blue-green,
     a bottling-hall blue, an oiled graphite, a warm rose-black — so the grid
     reads as thirteen environments rather than thirteen tints of one. */
  .bento-tile {
    position: relative;
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-5);
    padding: clamp(0.9rem, 1.6vw, 1.4rem);
    background: var(--tile-ground);
    color: var(--tile-ink);
    overflow: hidden;
    isolation: isolate;
    --tex-ink: var(--tile-ink);
    transition: background-color var(--dur-4) var(--ease-out);
  }
  /* The texture layer belongs to the tile, so its own content has to clear it —
     but the edge band and the mark are positioned layers of their own and must
     not be dragged back into flow by this. */
  .bento-tile > *:not(.bento-tile__edge):not(.bento-tile__mark) {
    position: relative;
    z-index: 2;
  }

  /* The saturated band on the leading edge. This is the one place the
     vertical's accent runs at full strength. */
  .bento-tile__edge {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    inline-size: 4px;
    background: var(--accent);
    z-index: 3;
    transition: inline-size var(--dur-3) var(--ease-out);
  }

  /* ── The mark ─────────────────────────────────────────────────────────
     Not a watermark. It is a drawing of that sector's engineering and it is
     drawn to be read: full opacity on the flagships, and never faded so far
     that a buyer cannot tell a cavity plate from a bottle. */
  .bento-tile__mark {
    position: absolute;
    /* `inset-block: 50%` would set both edges and collapse the box to zero
       height; only the start edge is anchored here. */
    inset-block-start: 50%;
    inset-block-end: auto;
    inset-inline-end: -4%;
    translate: 0 -50%;
    inline-size: min(60%, 12.5rem);
    /* The vertical's accent, lightened for a dark plate. The raw accent is
       chosen to be readable as TEXT on that vertical's near-white page; on its
       near-black tile the same value disappears. */
    color: var(--mark);
    opacity: 0.95;
    pointer-events: none;
    z-index: 1;
    transition: opacity var(--dur-4) var(--ease-out), transform var(--dur-4) var(--ease-out);
  }
  .bento__cell--flag .bento-tile__mark {
    inline-size: min(62%, 21rem);
    inset-block-start: auto;
    inset-block-end: 5%;
    inset-inline-end: -2%;
    translate: none;
    opacity: 1;
  }
  /* A soft fall-off under the mark so type never crosses a drawn line at low
     contrast — the drawing gets the trailing half of the plate, the type the
     leading half. */
  .bento-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Opaque where the type sits, clear across the middle band where the
       drawing does. A flat veil over the whole plate would take the drawing
       back down to the watermark this grid is trying to stop being. */
    background: linear-gradient(
      to bottom,
      color-mix(in oklab, var(--tile-ground) 90%, transparent) 0%,
      color-mix(in oklab, var(--tile-ground) 24%, transparent) 34%,
      color-mix(in oklab, var(--tile-ground) 16%, transparent) 64%,
      color-mix(in oklab, var(--tile-ground) 88%, transparent) 100%
    );
  }

  .bento-tile__body {
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  .bento-tile__n {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: color-mix(in oklab, var(--tile-ink) 62%, transparent);
  }

  .bento-tile__name {
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-head);
    line-height: 1.14;
    text-wrap: balance;
    color: #FFFFFF;
  }
  .bento__cell--flag .bento-tile__name {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    letter-spacing: var(--track-display);
  }

  .bento-tile__line {
    font-size: var(--step--1);
    line-height: 1.45;
    color: color-mix(in oklab, var(--tile-ink) 80%, transparent);
    max-inline-size: 34ch;
    margin-block-start: 0.35rem;
  }
  .bento__cell--flag .bento-tile__line {
    font-size: var(--step-0);
    max-inline-size: 36ch;
    margin-block-start: 0.6rem;
  }
  /* The supporting line used to be a hover reward, because it was a four-line
     paragraph and there was no room for it beside a drawing. It is one short
     sentence now, so it is always visible: a grid a buyer can scan without
     hovering thirteen times is worth more than a reveal. */

  .bento-tile__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    padding-block-start: 0.6rem;
    border-block-start: 1px solid color-mix(in oklab, var(--tile-ink) 22%, transparent);
  }

  .bento-tile__parts {
    font-size: 0.66rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--tile-ink) 68%, transparent);
    min-inline-size: 0;
  }
  :global(html[lang='zh']) .bento-tile__parts,
  :global(html[lang='th']) .bento-tile__parts,
  :global(html[lang='ar']) .bento-tile__parts,
  :global(html[lang='fa']) .bento-tile__parts,
  :global(html[lang='ur']) .bento-tile__parts {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--step--2);
  }

  .bento-tile__go {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--2);
    color: #FFFFFF;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
    margin-inline-start: auto;
  }
  .bento-tile__arrow { inline-size: 0.9rem; flex: none; }
  [dir='rtl'] .bento-tile__arrow { transform: scaleX(-1); }

  .bento-tile:hover,
  .bento-tile:focus-visible {
    background: color-mix(in oklab, var(--tile-ground) 84%, #FFFFFF);
  }
  .bento-tile:hover .bento-tile__edge,
  .bento-tile:focus-visible .bento-tile__edge { inline-size: 9px; }
  .bento-tile:hover .bento-tile__mark,
  .bento-tile:focus-visible .bento-tile__mark {
    opacity: 1;
    transform: translate(calc(-3% * var(--dir)), 0) scale(1.05);
  }
  .bento-tile:hover .bento-tile__go,
  .bento-tile:focus-visible .bento-tile__go { opacity: 1; transform: none; }

  .bento-tile:focus-visible { outline: 2px solid #FFFFFF; outline-offset: -4px; }

  /* ── Narrow ─────────────────────────────────────────────────────────────
     Thirteen tiles stacked into thirteen identical cards is the failure this
     section is most prone to: title, paragraph, drawing, divider, repeat, for
     nine screens of scrolling. On a phone the grid becomes a list with three
     rhythms instead of one.

       · the standard row — copy leading, drawing trailing
       · every third row — drawing leading, copy trailing
       · the two flagships — a wide drawing band above the copy

     The drawing moves from an absolutely-positioned watermark into the flow at
     a size where it can actually be read. A cavity plate at 8% opacity behind
     a paragraph tells a buyer nothing. */
  @media (max-width: 720px) {
    .bento { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .bento__cell,
    .bento__cell--flag { grid-column: 1 / -1; grid-row: auto; }

    .bento-tile {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'body mark' 'foot mark';
      align-items: center;
      column-gap: var(--sp-4);
      row-gap: 0.4rem;
      padding: 0.8rem 0.9rem 0.7rem;
    }
    /* No scrim: the drawing is beside the type now, not under it. */
    .bento-tile::after { display: none; }

    .bento-tile__body { grid-area: body; }
    .bento-tile__foot { grid-area: foot; }
    .bento-tile__mark {
      grid-area: mark;
      position: relative;
      inset: auto;
      translate: none;
      /* Big enough to read as a drawing. A cavity plate at thumbnail size is
         a decorative mark, which is exactly what this section is trying to
         stop being. */
      inline-size: clamp(5.5rem, 26vw, 7.5rem);
      opacity: 1;
      align-self: center;
    }

    /* Every third row reverses, so the eye is not tracking one column for
       nine screens. */
    .bento__cell:nth-child(3n):not(.bento__cell--flag) .bento-tile {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'mark body' 'mark foot';
    }

    /* The two flagships get the drawing at full width above the copy. */
    .bento__cell--flag .bento-tile {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'mark' 'body' 'foot';
      row-gap: 0.55rem;
      padding-block: 0.9rem 0.8rem;
    }
    .bento__cell--flag .bento-tile__mark {
      inline-size: 100%;
      max-inline-size: 16rem;
      justify-self: end;
      margin-inline-end: calc(var(--sp-2) * -1);
    }

    .bento-tile__name { font-size: var(--step-1); }
    .bento__cell--flag .bento-tile__name { font-size: var(--step-2); }
    .bento-tile__line {
      font-size: var(--step--1);
      line-height: 1.45;
      max-inline-size: none;
      opacity: 1;
      max-block-size: none;
      margin-block-start: 0.25rem;
    }
    .bento__cell--flag .bento-tile__line { font-size: var(--step-0); }
    .bento-tile__go-label { display: none; }
    .bento-tile__go { opacity: 1; transform: none; }
    /* The parts list is scanning material, not prose: one line, truncated,
       rather than two lines of tracked-out capitals per industry across
       thirteen rows. */
    .bento-tile__parts {
      font-size: 0.6rem;
      letter-spacing: 0.08em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1 1 auto;
    }
    .bento-tile__foot { padding-block-start: 0.45rem; flex-wrap: nowrap; }
    .bento-tile__edge { inline-size: 3px; }
  }

  /* Entrance: the grid assembles rather than fading in as one block. Handled
     by the project's reveal observer so it behaves the same as everything else
     on the page and resolves correctly under reduced motion. */
  .bento__cell[data-reveal] { --reveal-y: 12px; }
</style>
