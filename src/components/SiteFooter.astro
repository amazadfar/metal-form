---
/**
 * FOOTER
 *
 * A designed conclusion rather than a dense list. Three changes from the
 * previous version:
 *
 *  · The language row is gone. The navigation overlay already switches language
 *    in place from every page, and the header carries a route back to the
 *    selector — three sets of language controls on one page is two too many,
 *    and the footer's row was the one nobody used. The hreflang alternates in
 *    the document head still expose every translation to a crawler.
 *
 *  · The brand block leads with the one commitment the company makes in public:
 *    a first technical read within a stated window. That is the most useful
 *    thing a buyer who has scrolled this far can be told.
 *
 *  · Type sizes go up and the columns get room. A footer set entirely at 13px
 *    reads as small print, and small print is not what the last impression of
 *    a supplier should be.
 *
 * It still carries the one piece of transparency the whole project depends on:
 * a plain statement that the drawings and diagrams throughout the site are
 * schematics, not photographs of company equipment or completed work. That
 * sits here, in every language, on every page.
 */
import Wordmark from './Wordmark.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { localePath, type Locale } from '../i18n/locales.ts';
import { getCommon, getIndustry, getHome } from '../content/index.ts';
import { INDUSTRY_LIST } from '../config/industries.ts';
import { BRAND, CONTACT, resolved } from '../config/site.ts';
import { availableChannels, mailtoLink, telLink } from '../lib/contact.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;

const c = getCommon(locale);
const h = getHome(locale);
const channels = availableChannels();
const email = resolved(CONTACT.email);
const phone = resolved(CONTACT.phone);
const street = resolved(CONTACT.address.line1);
const city = resolved(CONTACT.address.city);

const companyLinks = [
  { label: c.nav.industries, href: localePath(locale, 'industries') },
  { label: c.nav.capabilities, href: localePath(locale, 'capabilities') },
  { label: c.nav.about, href: localePath(locale, 'about') },
  { label: c.nav.contact, href: localePath(locale, 'contact') },
];

const year = 2026;
---

<footer class="ftr mat mat--milled">
  {/* ── The closing offer ──────────────────────────────────────────────── */}
  <div class="shell--wide ftr__lede">
    <div class="ftr__lede-copy">
      <Wordmark href={localePath(locale)} size="lg" inverse />
      <p class="ftr__tagline">{c.footer.tagline}</p>
    </div>
    <div class="ftr__lede-act">
      <p class="ftr__promise">{c.trust.response}</p>
      <WhatsAppButton
        locale={locale}
        prefill={h.cta.prefill}
        label={c.actions.sendProject}
        source="footer"
      />
    </div>
  </div>

  <div class="shell--wide ftr__cols">
    <nav class="ftr__col ftr__col--wide" aria-label={c.footer.industriesHeading}>
      <h2 class="ftr__h">{c.footer.industriesHeading}</h2>
      <ul class="ftr__inds">
        {INDUSTRY_LIST.map((ind) => (
          <li>
            <a href={localePath(locale, 'industries', ind.slug)}>
              <span class="ftr__ind-dot" aria-hidden="true" style={`--dot:${ind.palette.accent}`}></span>
              {getIndustry(locale, ind.key).name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="ftr__col" aria-label={c.footer.companyHeading}>
      <h2 class="ftr__h">{c.footer.companyHeading}</h2>
      <ul class="ftr__list">
        {companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <section class="ftr__col">
      <h2 class="ftr__h">{c.footer.contactHeading}</h2>
      <ul class="ftr__list">
        {channels.email && email && <li><a href={mailtoLink(BRAND.name)}>{email}</a></li>}
        {channels.phone && phone && <li><a href={telLink()} dir="ltr">{phone}</a></li>}
        <li><a href={localePath(locale, 'contact')}>{c.contact.whatsappLabel}</a></li>
      </ul>
      {(street || city) && (
        <address class="ftr__addr">
          {street && <span>{street}</span>}
          {city && <span>{city}</span>}
          <span>{CONTACT.address.country}</span>
        </address>
      )}
    </section>
  </div>

  <div class="shell--wide ftr__base">
    <p class="ftr__legal">© {year} {BRAND.name}. {c.footer.rights}</p>
    <p class="ftr__media-note">{c.footer.mediaNote}</p>
  </div>
</footer>

<style>
  .ftr {
    background: var(--steel-950);
    color: var(--inverse-ink, #EDEDEA);
    /* The whole token set flips, not just the background. Leaving --ink-muted
       at its light-surface value put grey text on near-black. */
    --ink: var(--inverse-ink, #EDEDEA);
    --ink-muted: color-mix(in oklab, var(--inverse-ink, #EDEDEA) 74%, transparent);
    --signal: var(--signal-inverse);
    --signal-ink: var(--signal-inverse);
    --accent: var(--accent-inverse);
    --accent-deep: var(--accent-inverse);
    --line: color-mix(in oklab, currentColor 16%, transparent);
    --btn-bg: var(--inverse-ink, #EDEDEA);
    --btn-fg: var(--steel-950);
    --btn-hover: #FFFFFF;
    margin-block-start: auto;
  }
  .ftr .btn--whatsapp:hover { color: var(--steel-950); }

  /* ── Lede ─────────────────────────────────────────────────────────────── */
  .ftr__lede {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4rem);
    flex-wrap: wrap;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem);
    border-block-end: 1px solid var(--line);
  }
  .ftr__tagline {
    margin-block-start: var(--sp-5);
    font-size: var(--step-2);
    line-height: 1.28;
    letter-spacing: var(--track-head);
    max-inline-size: 26ch;
    color: #FFFFFF;
  }
  .ftr__lede-act { display: grid; gap: var(--sp-4); justify-items: start; }
  .ftr__promise {
    font-size: var(--step-0);
    color: var(--ink-muted);
    max-inline-size: 30ch;
  }

  /* ── Columns ──────────────────────────────────────────────────────────── */
  .ftr__cols {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  @media (max-width: 900px) { .ftr__cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  @media (max-width: 620px) { .ftr__cols { grid-template-columns: minmax(0, 1fr); gap: var(--sp-8); } }
  .ftr__col--wide { grid-column: span 1; }
  @media (max-width: 900px) { .ftr__col--wide { grid-column: 1 / -1; } }

  .ftr__h {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: color-mix(in oklab, currentColor 66%, transparent);
    margin-block-end: var(--sp-5);
    padding-block-end: var(--sp-3);
    border-block-end: 1px solid var(--line);
  }
  :where(html[lang='zh'], html[lang='th'], html[lang='ar'], html[lang='fa'], html[lang='ur']) .ftr__h {
    font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--step--1);
  }

  .ftr__inds {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 0.55rem 1.75rem;
  }
  .ftr__list { display: grid; gap: 0.55rem; }

  .ftr__inds a, .ftr__list a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-0);
    line-height: 1.3;
    color: color-mix(in oklab, currentColor 80%, transparent);
    transition: color var(--dur-2) var(--ease-out);
  }
  .ftr__inds a:hover, .ftr__list a:hover { color: #FFFFFF; }

  /* One dot per vertical, in that vertical's own colour — the same colour it
     carries on its tile and across its whole chapter. */
  .ftr__ind-dot {
    inline-size: 5px;
    block-size: 5px;
    background: var(--dot);
    flex: none;
  }

  .ftr__addr {
    margin-block-start: var(--sp-5);
    display: grid;
    gap: 0.2rem;
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* ── Base ─────────────────────────────────────────────────────────────── */
  .ftr__base {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--sp-5) clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-block: var(--sp-6) var(--sp-7);
    border-block-start: 1px solid var(--line);
  }
  @media (max-width: 760px) { .ftr__base { grid-template-columns: minmax(0, 1fr); } }
  .ftr__legal { font-size: var(--step--1); color: var(--ink-muted); white-space: nowrap; }
  .ftr__media-note {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-muted);
    max-inline-size: 78ch;
    justify-self: end;
  }
  @media (max-width: 760px) { .ftr__media-note { justify-self: start; } }
</style>
