---
/**
 * The three reasons a manufacturer changes supplier.
 *
 * Three alternating full-width bands rather than three equal cards: each one
 * gets a diagram at a size where it can actually argue, and the alternation
 * stops the section reading as a template.
 *
 * Each diagram makes one falsifiable point:
 *   01  where the money in a moulded part actually sits
 *   02  the three-way blame triangle, and what removes it
 *   03  one route versus two
 *
 * Every label is HTML rather than SVG text. That is not incidental: these
 * strings run in nine languages, and an SVG `<text>` cannot wrap, so a Russian
 * or Armenian translation would run straight off the edge of the drawing.
 */
import type { HomeContent } from '../../content/types.ts';

interface Props {
  pillars: HomeContent['pillars'];
  /** Drawing labels, reused from the hero figure. Already localised. */
  d: HomeContent['diagram']['hero'];
  schematicLabel: string;
}
const { pillars, d, schematicLabel } = Astro.props;
---

<section class="pl" id="advantages">
  <div class="shell--wide">
    <p class="eyebrow">{pillars.kicker}</p>
    <div class="pl__head split">
      <h2 class="t-statement t-statement--wide pl__title" data-split-copy>{pillars.heading}</h2>
      <p class="t-lead pl__lead" data-split-figure>{pillars.lead}</p>
    </div>
  </div>

  <div class="pl__bands">
    {pillars.items.map((item, i) => (
      <article class="pl__band" data-band={i} data-reveal style={`--reveal-delay:${i * 60}ms`}>
        <div class="shell--wide pl__band-inner">
          <div class="pl__copy">
            <p class="pl__n t-mono">{item.index}</p>
            <h3 class="pl__h">{item.title}</h3>
            <p class="pl__b">{item.body}</p>
            <ul class="pl__points">
              {item.points.map((p) => <li>{p}</li>)}
            </ul>
            <p class="pl__outcome">{item.outcome}</p>
          </div>

          <figure class="pl__fig">
            {i !== 0 && <figcaption class="pl__cap">{item.figure.caption}</figcaption>}

            {i === 0 && (
              /* The percentage split that used to sit here was illustrative,
                 and its own caption said so. On a page whose whole argument is
                 that this company is precise, an invented 46% is worse than no
                 number: it is the one thing on the page a buyer can catch out.

                 What replaces it explains the same point better. A section
                 through a boss and its base shows the mass that collects at the
                 junction — the hot spot that sets the cooling time, and with it
                 the cycle, the machine hours and most of the cost per part. The
                 dashed profile is the same feature cored out. Nothing here is
                 a claim; it is the geometry every moulder recognises.

                 The cost lines remain, as a ledger of what is in the number,
                 with no proportions attached to them. */
              <>
                <div class="pl__cost">
                  <svg viewBox="0 0 420 236" class="pl__sec" data-nomirror role="img" aria-label={item.figure.captionAlt ?? item.figure.caption}>
                    <defs>
                      <pattern id="pl-hatch" width="7" height="7" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
                        <line x1="0" y1="0" x2="0" y2="7" stroke="currentColor" stroke-width="0.85" opacity="0.4" />
                      </pattern>
                    </defs>

                    {/* Base wall and boss, in section. */}
                    <path
                      d="M46 208 L374 208 L374 158 L238 158 L238 52 L182 52 L182 158 L46 158 Z"
                      fill="url(#pl-hatch)" stroke="currentColor" stroke-width="1.5" class="pl__steel-edge"
                    />

                    {/* The inscribed circle at the junction: the standard way a
                        toolmaker shows where mass — and cooling time — collects. */}
                    <circle cx="210" cy="176" r="31" class="pl__mass" />

                    {/* The same feature, cored. */}
                    <path d="M196 52 L196 150 Q196 160 206 162 L214 162 Q224 160 224 150 L224 52"
                      fill="none" class="pl__cored" />

                    {/* Cooling, placed where it can actually reach. */}
                    <circle cx="128" cy="183" r="9" class="pl__cool" />
                    <circle cx="300" cy="183" r="9" class="pl__cool" />
                    <line x1="128" y1="183" x2="300" y2="183" class="pl__cool-line" />

                    {/* Wall callouts, numbered — the strings are HTML below. */}
                    <g class="pl__mark">
                      <line x1="182" y1="86" x2="120" y2="70" />
                      <circle cx="182" cy="86" r="3" />
                      <circle cx="112" cy="68" r="9" class="pl__mark-n" />
                      <text x="112" y="72" text-anchor="middle" class="pl__mark-t">1</text>
                    </g>
                    <g class="pl__mark">
                      <line x1="300" y1="183" x2="356" y2="112" />
                      <circle cx="300" cy="183" r="3" />
                      <circle cx="362" cy="105" r="9" class="pl__mark-n" />
                      <text x="362" y="109" text-anchor="middle" class="pl__mark-t">2</text>
                    </g>
                  </svg>

                  <p class="pl__cap pl__cap--alt">{item.figure.captionAlt}</p>
                  <ol class="pl__keys">
                    <li><span class="pl__key-n" aria-hidden="true">1</span><span>{d.wall}</span></li>
                    <li><span class="pl__key-n" aria-hidden="true">2</span><span>{d.cooling}</span></li>
                  </ol>
                </div>

                <p class="pl__cap pl__cap--ledger">{item.figure.caption}</p>
                <ul class="pl__ledger">
                  {item.figure.rows.map((row) => <li>{row.label}</li>)}
                </ul>
              </>
            )}

            {i === 1 && (
              /* The triangle that used to sit here was a decorative shape: it
                 said "three parties" and nothing else, and it broke into an
                 unreadable 210px square on a phone.

                 The point it was trying to make is about handovers, so the
                 figure now shows handovers. Three separate suppliers, each in
                 its own block, with the break between them drawn — that gap is
                 where a project loses a month and nobody is responsible. Beside
                 it, the same route as one continuous chain.

                 It is HTML, not SVG, so it wraps in nine languages and stacks
                 on a phone without redrawing anything. */
              <div class="pl__pair">
                <div class="pl__pair-half">
                  <ol class="pl__silo">
                    {item.figure.rows.slice(0, 3).map((row, ri) => (
                      <li class="pl__silo-item" style={`--g:${ri}`}>
                        <span class="pl__silo-tag t-mono">{row.value}</span>
                        <span class="pl__silo-name">{row.label}</span>
                      </li>
                    ))}
                  </ol>
                  <p class="pl__warn">{item.figure.rows[3].label}</p>
                </div>

                <div class="pl__pair-half">
                  <p class="pl__cap pl__cap--alt">{item.figure.captionAlt}</p>
                  <ol class="pl__chain">
                    {(item.figure.chain ?? []).map((link, li) => (
                      <li style={`--g:${li}`}>{link}</li>
                    ))}
                  </ol>
                  <p class="pl__chain-note t-mono">{item.figure.chainNote}</p>
                </div>
              </div>
            )}

            {i === 2 && (
              /* One route versus two. The break is the whole argument. */
              <div class="pl__routes">
                <div class="pl__route">
                  <svg viewBox="0 0 420 92" data-nomirror role="img" aria-label={item.figure.caption}>
                    <rect x="2" y="30" width="86" height="34" class="pl__box" />
                    <line x1="88" y1="47" x2="166" y2="47" class="pl__flow" />
                    <rect x="166" y="30" width="86" height="34" class="pl__box" />
                    <line x1="252" y1="47" x2="330" y2="47" class="pl__flow" />
                    <rect x="330" y="30" width="88" height="34" class="pl__box" />
                    <g class="pl__break">
                      <line x1="209" y1="16" x2="209" y2="78" />
                      <path d="M201 39 L217 55 M217 39 L201 55" />
                    </g>
                  </svg>
                  <ul class="pl__route-keys t-mono">
                    <li>{item.figure.rows[0].label}</li>
                    <li>{item.figure.rows[1].label}</li>
                    <li>{item.figure.rows[2].label}</li>
                  </ul>
                  <p class="pl__warn">{item.figure.rows[3].label}</p>
                </div>

                <div class="pl__route">
                  <p class="pl__cap pl__cap--alt">{item.figure.captionAlt}</p>
                  <svg viewBox="0 0 420 122" data-nomirror role="img" aria-label={item.figure.captionAlt}>
                    <rect x="2" y="44" width="86" height="34" class="pl__box" />
                    <path d="M88 61 L127 61 L127 22 L166 22" class="pl__flow" fill="none" />
                    <path d="M88 61 L127 61 L127 100 L166 100" class="pl__flow pl__flow--alt" fill="none" />
                    <rect x="166" y="5" width="86" height="34" class="pl__box" />
                    <rect x="166" y="83" width="86" height="34" class="pl__box pl__box--alt" />
                    <path d="M252 22 L291 22 L291 61 L330 61" class="pl__flow" fill="none" />
                    <path d="M252 100 L291 100 L291 61 L330 61" class="pl__flow pl__flow--alt" fill="none" />
                    <rect x="330" y="44" width="88" height="34" class="pl__box" />
                  </svg>
                </div>
              </div>
            )}

            <p class="pl__note">{item.figure.note}</p>
            <span class="figure-note">{schematicLabel}</span>
          </figure>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .pl { padding-block: var(--section-y-tight) 0; }
  .pl__head {
    margin-block-start: var(--sp-5);
    padding-block-start: var(--sp-6);
    border-block-start: var(--rule-strong);
    --split-a: 1.15fr;
    --split-b: 0.85fr;
    --split-align: end;
  }
  .pl__title { max-inline-size: 20ch; }
  .pl__lead { padding-block-end: 0.35em; }

  .pl__bands { margin-block-start: clamp(2.5rem, 6vw, 4.5rem); }

  .pl__band { border-block-start: var(--rule); padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .pl__band:last-child { border-block-end: var(--rule); }
  /* Alternating background keeps the rhythm from flattening. */
  .pl__band[data-band='1'] { background: var(--surface-sunk); }

  .pl__band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  /* The middle band mirrors, so the eye crosses the page rather than tracking
     down one column. */
  .pl__band[data-band='1'] .pl__band-inner { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); }
  .pl__band[data-band='1'] .pl__copy { order: 2; }
  .pl__band[data-band='1'] .pl__fig { order: 1; }
  @media (max-width: 940px) {
    .pl__band-inner,
    .pl__band[data-band='1'] .pl__band-inner { grid-template-columns: minmax(0, 1fr); }
    .pl__band[data-band='1'] .pl__copy { order: 0; }
    .pl__band[data-band='1'] .pl__fig { order: 0; }
  }

  .pl__n { font-size: var(--step--2); letter-spacing: 0.16em; color: var(--accent-deep); }
  .pl__h {
    margin-block-start: var(--sp-4);
    font-size: var(--step-4);
    letter-spacing: var(--track-display);
    max-inline-size: 14ch;
  }
  .pl__b {
    margin-block-start: var(--sp-5);
    color: var(--ink-muted);
    font-size: var(--step-0);
    max-inline-size: 54ch;
  }
  .pl__points {
    margin-block-start: var(--sp-6);
    border-block-start: var(--rule);
  }
  .pl__points li {
    padding-block: 0.7rem;
    border-block-end: var(--rule);
    font-size: var(--step--1);
    padding-inline-start: 1.6rem;
    position: relative;
    max-inline-size: 56ch;
  }
  .pl__points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 1.15rem;
    inline-size: 0.62rem;
    block-size: 1px;
    background: var(--accent);
  }
  .pl__outcome {
    margin-block-start: var(--sp-6);
    font-size: var(--step-0);
    line-height: 1.5;
    max-inline-size: 52ch;
    padding-inline-start: var(--sp-5);
    border-inline-start: 2px solid var(--accent);
  }

  /* ── Figures ──────────────────────────────────────────────────────────── */
  .pl__fig { margin: 0; color: var(--ink); min-inline-size: 0; }
  .pl__fig svg { inline-size: 100%; block-size: auto; display: block; }

  .pl__cap {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-deep);
    margin-block-end: var(--sp-4);
  }
  .pl__cap--alt { margin-block-end: var(--sp-4); }
  :global(html[lang='zh']) .pl__cap,
  :global(html[lang='th']) .pl__cap,
  :global(html[lang='ar']) .pl__cap,
  :global(html[lang='fa']) .pl__cap,
  :global(html[lang='ur']) .pl__cap {
    font-family: var(--font-body); text-transform: none; letter-spacing: 0; font-size: var(--step--1);
  }

  .pl__note {
    margin-block-start: var(--sp-5);
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 52ch;
  }
  .pl__fig .figure-note { margin-block-start: var(--sp-3); }

  /* ── 01 · Where the cost is decided ───────────────────────────────────
     A section, drawn the way a toolmaker draws one: hatched material, an
     inscribed circle at the junction where mass collects, the same feature
     cored out in dashed line, and the cooling that has to reach it. */
  .pl__cost { margin-block-start: var(--sp-4); }
  .pl__sec { inline-size: 100%; block-size: auto; color: var(--ink-muted); }
  .pl__steel-edge { stroke: var(--ink); }

  /* The hot spot. This is the one place on the homepage the heat colour is
     used, and it means exactly one thing: the geometry that costs money. */
  .pl__mass {
    fill: color-mix(in oklab, var(--hot) 18%, transparent);
    stroke: var(--hot);
    stroke-width: 1.4;
    stroke-dasharray: 5 4;
  }
  .pl__cored { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 7 4; }
  .pl__cool { fill: var(--surface); stroke: var(--accent); stroke-width: 1.6; }
  .pl__cool-line { stroke: var(--accent); stroke-width: 1; opacity: 0.4; stroke-dasharray: 3 5; }

  .pl__mark line { stroke: var(--ink-muted); stroke-width: 0.9; }
  .pl__mark circle { fill: var(--ink-muted); }
  .pl__mark .pl__mark-n { fill: var(--surface); stroke: var(--ink); stroke-width: 1.1; }
  .pl__mark-t {
    font-family: var(--font-mono);
    font-size: 10px;
    fill: var(--ink);
    stroke: none;
  }

  .pl__keys {
    margin-block-start: var(--sp-4);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .pl__keys li { display: flex; align-items: center; gap: 0.5rem; }
  .pl__key-n {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--ink);
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink);
    flex: none;
  }

  /* The cost lines. A ledger of what is in the number — with no proportions
     attached to any of them, because the honest proportion is per project. */
  .pl__cap--ledger { margin-block-start: var(--sp-7); margin-block-end: var(--sp-3); }
  .pl__ledger { border-block-start: var(--rule); }
  .pl__ledger li {
    padding-block: 0.6rem;
    padding-inline-start: 1.5rem;
    border-block-end: var(--rule);
    font-size: var(--step--1);
    position: relative;
  }
  .pl__ledger li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 1.05rem;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    border: 1px solid var(--accent);
  }

  /* ── 02 · Three suppliers, three handovers ────────────────────────────── */
  .pl__silo { display: grid; gap: 0; }
  .pl__silo-item {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    padding: 0.75rem 0.9rem;
    background: var(--surface-raise);
    border: var(--rule);
    box-shadow: var(--relief);
  }
  /* The gap between two suppliers, drawn. This is the argument: the break is
     not between the blocks, it IS the blocks not touching. */
  .pl__silo-item + .pl__silo-item { margin-block-start: 1.5rem; position: relative; }
  .pl__silo-item + .pl__silo-item::before {
    content: '';
    position: absolute;
    inset-block-start: -1.5rem;
    inset-inline-start: 1.6rem;
    inline-size: 1.5px;
    block-size: 1.5rem;
    background: repeating-linear-gradient(to bottom, var(--signal) 0 3px, transparent 3px 7px);
  }
  .pl__silo-item + .pl__silo-item::after {
    content: '';
    position: absolute;
    inset-block-start: -0.95rem;
    inset-inline-start: 1.05rem;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-block-start: 1.5px solid var(--signal);
    border-inline-end: 1.5px solid var(--signal);
    transform: rotate(45deg) scaleX(var(--dir));
    opacity: 0.9;
  }
  .pl__silo-tag {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    color: var(--ink-muted);
    flex: none;
    min-inline-size: 3.6em;
  }
  .pl__silo-name { font-size: var(--step-0); font-weight: var(--weight-medium); }

  /* The three-supplier route beside the one-partner chain. */
  .pl__pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: start;
  }
  @media (max-width: 560px) { .pl__pair { grid-template-columns: minmax(0, 1fr); } }
  .pl__warn {
    margin-block-start: var(--sp-4);
    font-size: var(--step--2);
    color: var(--signal-ink);
    line-height: 1.45;
  }
  .pl__chain { display: grid; gap: 0.35rem; }
  .pl__chain li {
    padding: 0.55rem 0.75rem;
    background: var(--accent-wash);
    border-inline-start: 2px solid var(--accent);
    font-size: var(--step--1);
    position: relative;
  }
  .pl__chain li + li::before {
    content: '';
    position: absolute;
    inset-block-start: -0.35rem;
    inset-inline-start: 1.6rem;
    inline-size: 1.5px;
    block-size: 0.35rem;
    background: var(--accent);
  }
  .pl__chain-note {
    margin-block-start: var(--sp-4);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--ink-muted);
  }

  /* One route vs two */
  .pl__routes { display: grid; gap: var(--sp-7); }
  .pl__box { fill: none; stroke: currentColor; stroke-width: 1.3; }
  .pl__box--alt { stroke: var(--accent); stroke-dasharray: 6 4; }
  .pl__flow { stroke: currentColor; stroke-width: 1.4; opacity: 0.5; }
  .pl__flow--alt { stroke: var(--accent); opacity: 0.9; stroke-dasharray: 6 4; }
  .pl__break line { stroke: var(--signal); stroke-width: 1; stroke-dasharray: 4 4; }
  .pl__break path { stroke: var(--signal); stroke-width: 2; fill: none; }
  .pl__route-keys {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin-block-start: 0.35rem;
  }
  .pl__route-keys li { flex: 1; }
  .pl__route-keys li:nth-child(2) { text-align: center; }
  .pl__route-keys li:last-child { text-align: end; }

  @media (max-width: 640px) {
    .pl__h { font-size: var(--step-3); max-inline-size: none; }
  }
</style>
