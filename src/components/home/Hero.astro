---
import HeroFigure from './HeroFigure.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import type { Locale } from '../../i18n/locales.ts';
import type { HomeContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  hero: HomeContent['hero'];
  prefill: string;
  /** Legend labels for the five figure states. */
  stages: string[];
  /** Labels drawn inside the figure. */
  d: Record<string, string>;
}
const { locale, hero, prefill, stages, d } = Astro.props;
---

<section class="hero" id="hero">
  <div class="hero__grid shell--wide">
    <div class="hero__copy">
      <p class="eyebrow hero__kicker">{hero.kicker}</p>

      <h1 class="hero__head">
        {hero.headline.map((line, i) => (
          <span class="hero__line" style={`--l:${i}`}>{line}</span>
        ))}
      </h1>

      <p class="hero__lead">{hero.lead}</p>

      {/* The four possible starting points, stated as a rule rather than as a
          list of features — this is the objection the headline pre-empts. */}
      <ul class="hero__inputs">
        {hero.inputs.map((input, i) => (
          <li style={`--l:${i}`}><span class="t-mono hero__input-n">{String(i + 1).padStart(2, '0')}</span>{input}</li>
        ))}
      </ul>

      <div class="hero__actions">
        <WhatsAppButton
          locale={locale}
          prefill={prefill}
          label={hero.primary}
          source="home_hero"
          size="lg"
        />
        <a class="btn btn--ghost btn--lg" href="#process">
          <span>{hero.secondary}</span>
          <svg class="btn__arrow" viewBox="0 0 16 12" aria-hidden="true" fill="none" data-icon style="transform:rotate(90deg)">
            <path d="M1 6h13M9.5 1.2 14.3 6l-4.8 4.8" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
      </div>

      <p class="hero__note t-fine">{hero.note}</p>
    </div>

    <div class="hero__figure">
      <HeroFigure labels={stages} d={d} />
    </div>
  </div>

  <ul class="hero__floor shell--wide">
    {hero.facts.map((fact, i) => (
      <>
        {i > 0 && <li class="hero__floor-line" aria-hidden="true"></li>}
        <li class="t-mono">{fact}</li>
      </>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
    overflow: clip;
  }

  /* A faint measured grid behind the whole opening. It is the reason the
     composition feels set out rather than arranged. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-unit) var(--grid-unit);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 72%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 72%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block-end: clamp(3rem, 7vw, 6rem);
  }
  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: 1fr; gap: var(--sp-9); }
  }

  /* ── Copy ─────────────────────────────────────────────────────────────── */
  .hero__kicker { margin-block-end: clamp(1.25rem, 3vw, 2rem); }

  .hero__head {
    font-size: clamp(2.15rem, 5.4vw, 4.35rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    font-weight: 500;
  }
  .hero__line { display: block; }
  /* The third line carries the payload; the first two set it up. */
  .hero__line:last-child { color: var(--accent-deep); }

  .hero__lead {
    margin-block-start: clamp(1.25rem, 2.6vw, 2rem);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 44ch;
  }

  .hero__inputs {
    margin-block-start: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.5rem;
  }
  .hero__inputs li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    font-size: var(--step--1);
    background: color-mix(in oklab, var(--surface-raise) 55%, transparent);
    color: var(--ink);
  }
  .hero__input-n { font-size: 0.62rem; letter-spacing: 0.12em; color: var(--accent-deep); }

  .hero__actions {
    margin-block-start: clamp(1.75rem, 3.4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }

  .hero__note {
    margin-block-start: var(--sp-5);
    max-inline-size: 48ch;
  }

  /* ── Figure ───────────────────────────────────────────────────────────── */
  .hero__figure {
    position: relative;
    /* Nudged off the copy's baseline so the two halves are not a mirrored pair. */
    padding-block-start: clamp(0rem, 2vw, 1.5rem);
  }
  @media (max-width: 980px) {
    .hero__figure { max-inline-size: 34rem; margin-inline: auto; inline-size: 100%; }
  }

  /* ── Floor rail ───────────────────────────────────────────────────────── */
  .hero__floor {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    padding-block: var(--sp-5);
    border-block-start: var(--rule);
    font-size: var(--step--2);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-muted);
    overflow: hidden;
    list-style: none;
  }
  :global(html[lang='zh']) .hero__floor,
  :global(html[lang='th']) .hero__floor,
  :global(html[lang='ar']) .hero__floor,
  :global(html[lang='fa']) .hero__floor,
  :global(html[lang='ur']) .hero__floor {
    font-family: var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--step--1);
  }
  .hero__floor-line {
    flex: 1;
    block-size: 1px;
    background: var(--line);
    min-inline-size: 1rem;
  }
  @media (max-width: 760px) {
    .hero__floor { flex-wrap: wrap; gap: 0.4rem 1rem; }
    .hero__floor-line { display: none; }
    .hero__floor li:not(.hero__floor-line)::after {
      content: '·';
      margin-inline-start: 1rem;
      opacity: 0.5;
    }
    .hero__floor li:last-child::after { content: none; }
  }

  /* Staggered entrance. Text only; the figure runs its own sequence. */
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  :global(html.js) .hero__line,
  :global(html.js) .hero__inputs li {
    animation: hero-in 700ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--l) * 80ms);
  }
  :global(html.js) .hero__kicker { animation: hero-in 600ms var(--ease-out) both; }
  :global(html.js) .hero__lead { animation: hero-in 700ms var(--ease-out) both; animation-delay: 380ms; }
  :global(html.js) .hero__actions { animation: hero-in 700ms var(--ease-out) both; animation-delay: 520ms; }
  :global(html.js) .hero__note { animation: hero-in 700ms var(--ease-out) both; animation-delay: 600ms; }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__line,
    :global(html.js) .hero__inputs li,
    :global(html.js) .hero__kicker,
    :global(html.js) .hero__lead,
    :global(html.js) .hero__actions,
    :global(html.js) .hero__note { animation: none; }
  }
</style>
