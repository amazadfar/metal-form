---
/**
 * HOMEPAGE HERO
 *
 * The first screen has one job: make a manufacturing buyer believe these
 * people can actually make the thing, before they read a paragraph. The
 * previous version was a headline on white with a small line drawing floating
 * in a large empty right-hand column — competent, and completely forgettable.
 *
 * What changed:
 *
 *  · It is set on steel. The company machines metal; the page it opens with
 *    should look like the material, not like a text editor. The drawing on top
 *    of it becomes a blueprint, which is a stronger and more honest register
 *    for a toolmaker than a grey sketch on white.
 *
 *  · The five-stage chain is stated here, not deferred. The figure cycles the
 *    same component through sketch, geometry, tool, part and production, and
 *    the legend under it names the five stages. A visitor who reads nothing at
 *    all still leaves knowing what the business does.
 *
 *  · The four possible starting points are the argument, so they are given
 *    real presence rather than four 12px chips.
 *
 * Mobile is a different composition, not a narrower one: the object appears
 * between the promise and the action, so the first screen is never four
 * paragraphs of type.
 */
import HeroFigure from './HeroFigure.astro';
import WhatsAppButton from '../WhatsAppButton.astro';
import CapabilityRail from '../CapabilityRail.astro';
import type { Locale } from '../../i18n/locales.ts';
import type { HomeContent } from '../../content/types.ts';

interface Props {
  locale: Locale;
  hero: HomeContent['hero'];
  prefill: string;
  /** Legend labels for the five figure states. */
  stages: string[];
  /** Labels drawn inside the figure. */
  d: Record<string, string>;
  /** "Schematic" — every generated visual on the site is labelled as one. */
  schematicLabel: string;
}
const { locale, hero, prefill, stages, d, schematicLabel } = Astro.props;
---

<section class="hero on-steel mat mat--milled" id="hero">
  <div class="hero__grid shell--wide">
    <div class="hero__lede">
      <p class="eyebrow hero__kicker">{hero.kicker}</p>

      <h1 class="hero__head">
        {hero.headline.map((line, i) => (
          <span class="hero__line" style={`--l:${i}`}>{line}</span>
        ))}
      </h1>

      <p class="hero__lead">{hero.lead}</p>
    </div>

    <div class="hero__figure" data-split-figure>
      <div class="hero__frame">
        <HeroFigure labels={stages} d={d} />
      </div>
      <p class="figure-note hero__schematic">{schematicLabel}</p>
    </div>

    <div class="hero__act">
      {/* The four possible starting points. This is the objection the headline
          pre-empts — "we do not have drawings" — so it is answered in full
          view rather than in a footnote. */}
      <ul class="hero__inputs">
        {hero.inputs.map((input, i) => (
          <li style={`--l:${i}`}>
            <span class="t-mono hero__input-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="hero__input-t">{input}</span>
          </li>
        ))}
      </ul>

      <div class="hero__actions">
        <WhatsAppButton
          locale={locale}
          prefill={prefill}
          label={hero.primary}
          source="home_hero"
          size="lg"
        />
        <a class="btn btn--ghost btn--lg" href="#industries">
          <span>{hero.secondary}</span>
          <svg class="btn__arrow" viewBox="0 0 16 12" aria-hidden="true" fill="none" data-icon style="transform:rotate(90deg)">
            <path d="M1 6h13M9.5 1.2 14.3 6l-4.8 4.8" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
      </div>

      <p class="hero__note t-fine">{hero.note}</p>
    </div>
  </div>

  <div class="hero__floor">
    <div class="shell--wide">
      <CapabilityRail locale={locale} compact tight />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* The header overlays this section, so the composition starts below it. */
    padding-block-start: calc(4.25rem + clamp(2.25rem, 5vw, 4.5rem));
    overflow: clip;
  }

  /* The measured grid, drawn in light on the steel and faded out before it
     reaches the capability rail. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-unit) var(--grid-unit);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 68%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 68%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    grid-template-areas:
      'lede fig'
      'act  fig';
    column-gap: clamp(2rem, 5vw, 4.5rem);
    row-gap: clamp(1.75rem, 3.4vw, 2.75rem);
    align-items: start;
    padding-block-end: clamp(2.75rem, 6vw, 5rem);
  }
  .hero__lede { grid-area: lede; }
  .hero__figure { grid-area: fig; align-self: center; }
  .hero__act { grid-area: act; }

  /* ── Copy ─────────────────────────────────────────────────────────────── */
  .hero__kicker { margin-block-end: clamp(1.1rem, 2.6vw, 1.75rem); }

  .hero__head {
    font-size: clamp(2.35rem, 5.6vw, 4.7rem);
    line-height: 1.0;
    letter-spacing: var(--track-mega);
    font-weight: 500;
    color: #FFFFFF;
  }
  .hero__line { display: block; }
  /* The first two lines set the payload up and are held back so the third one
     lands. Colouring the whole headline flattens it. */
  .hero__line:not(:last-child) { color: color-mix(in oklab, #FFFFFF 78%, transparent); }
  .hero__line:last-child { color: var(--accent-inverse); }
  :global(html[lang='ur']) .hero__head { line-height: 1.75; }
  :global(html[lang='th']) .hero__head { line-height: 1.28; }
  :global(html[lang='zh']) .hero__head { line-height: 1.16; }
  :global(html[lang='ar']) .hero__head,
  :global(html[lang='fa']) .hero__head { line-height: 1.32; }

  .hero__lead {
    margin-block-start: clamp(1.1rem, 2.4vw, 1.75rem);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-muted);
    max-inline-size: 46ch;
  }

  /* ── Inputs ───────────────────────────────────────────────────────────── */
  .hero__inputs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .hero__inputs li {
    display: grid;
    gap: 0.3rem;
    align-content: start;
    padding: 0.75rem 0.85rem 0.85rem;
    background: color-mix(in oklab, var(--steel-800) 78%, transparent);
    min-inline-size: 0;
  }
  .hero__input-n { font-size: 0.62rem; letter-spacing: 0.14em; color: var(--accent-inverse); }
  .hero__input-t { font-size: var(--step--1); line-height: 1.3; color: #FFFFFF; }
  @media (max-width: 620px) {
    .hero__inputs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .hero__actions {
    margin-block-start: clamp(1.4rem, 2.8vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }
  .hero__note { margin-block-start: var(--sp-5); max-inline-size: 48ch; }

  /* ── Figure ───────────────────────────────────────────────────────────
     Framed like a drawing on a light table: a raised panel with a corner tick,
     so the blueprint reads as an object sitting on the steel rather than as
     line art printed onto it. */
  .hero__frame {
    position: relative;
    padding: clamp(1rem, 2.4vw, 2rem);
    background: color-mix(in oklab, var(--steel-850) 72%, transparent);
    border: 1px solid var(--line);
    box-shadow: var(--relief-dark);
  }
  .hero__frame::before,
  .hero__frame::after {
    content: '';
    position: absolute;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border: 0 solid var(--accent-inverse);
    opacity: 0.75;
  }
  .hero__frame::before {
    inset-block-start: -1px; inset-inline-start: -1px;
    border-block-start-width: 2px; border-inline-start-width: 2px;
  }
  .hero__frame::after {
    inset-block-end: -1px; inset-inline-end: -1px;
    border-block-end-width: 2px; border-inline-end-width: 2px;
  }
  .hero__schematic { margin-block-start: var(--sp-4); }

  /* ── Capability rail ──────────────────────────────────────────────────
     The floor of the hero, and the first proof on the page. Set on the deeper
     steel so it reads as a plinth under the composition. */
  .hero__floor {
    position: relative;
    z-index: 1;
    background: var(--steel-950);
    border-block-start: 1px solid var(--line);
    padding-block: clamp(1.25rem, 2.6vw, 2rem);
  }
  .hero__floor :global(.caps) {
    background: color-mix(in oklab, var(--inverse-ink) 14%, transparent);
    border-color: color-mix(in oklab, var(--inverse-ink) 14%, transparent);
  }
  .hero__floor :global(.cap) { background: var(--steel-950); }

  /* ── Narrow ───────────────────────────────────────────────────────────
     A real mobile composition: promise, then the object, then the action. The
     desktop arrangement stacked naively would put four paragraphs of type on
     the first screen and the drawing below the fold. */
  @media (max-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'lede' 'fig' 'act';
      row-gap: clamp(1.75rem, 5vw, 2.75rem);
    }
    .hero__figure { max-inline-size: 34rem; margin-inline: auto; inline-size: 100%; }
    .hero__lead { max-inline-size: 52ch; }
  }
  @media (max-width: 560px) {
    .hero__frame { padding: 0.85rem; }
  }

  /* ── Entrance ─────────────────────────────────────────────────────────── */
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  :global(html.js) .hero__line,
  :global(html.js) .hero__inputs li {
    animation: hero-in 700ms var(--ease-out) both;
    animation-delay: calc(120ms + var(--l) * 80ms);
  }
  :global(html.js) .hero__kicker { animation: hero-in 600ms var(--ease-out) both; }
  :global(html.js) .hero__lead { animation: hero-in 700ms var(--ease-out) both; animation-delay: 380ms; }
  :global(html.js) .hero__actions { animation: hero-in 700ms var(--ease-out) both; animation-delay: 520ms; }
  :global(html.js) .hero__note { animation: hero-in 700ms var(--ease-out) both; animation-delay: 600ms; }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__line,
    :global(html.js) .hero__inputs li,
    :global(html.js) .hero__kicker,
    :global(html.js) .hero__lead,
    :global(html.js) .hero__actions,
    :global(html.js) .hero__note { animation: none; }
  }
</style>
