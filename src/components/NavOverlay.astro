---
/**
 * Navigation overlay.
 *
 * Built for the live sales meeting: the whole industry list is one click away
 * from every page, each row carries its vertical's colour so it is recognisable
 * at a glance, and the nine languages sit in the same panel so a presenter can
 * switch language mid-conversation without going back to the root.
 */
import { localePath, swapLocale, LOCALES, LOCALE_ORDER, type Locale } from '../i18n/locales.ts';
import { getCommon, getIndustry } from '../content/index.ts';
import type { Industry } from '../config/industries.ts';

interface Props {
  locale: Locale;
  current?: string;
  industries: Industry[];
}

const { locale, current, industries } = Astro.props;
const c = getCommon(locale);

const rows = industries.map((ind) => ({
  ind,
  name: getIndustry(locale, ind.key).name,
  tile: getIndustry(locale, ind.key).tileParts ?? '',
  href: localePath(locale, 'industries', ind.slug),
}));

const pages = [
  { key: 'industries', label: c.nav.allIndustries, href: localePath(locale, 'industries') },
  { key: 'capabilities', label: c.nav.capabilities, href: localePath(locale, 'capabilities') },
  { key: 'about', label: c.nav.about, href: localePath(locale, 'about') },
  { key: 'contact', label: c.nav.contact, href: localePath(locale, 'contact') },
];

const pathname = Astro.url.pathname;
---

<div class="ov" id="nav-overlay" data-nav-overlay hidden>
  <div class="ov__scrim" data-nav-close aria-hidden="true"></div>

  <div class="ov__panel" role="dialog" aria-modal="true" aria-label={c.nav.menu}>
    <div class="ov__head">
      <span class="t-label">{c.nav.menu}</span>
      <button class="ov__close" type="button" data-nav-close aria-label={c.nav.close}>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4 16 16M16 4 4 16" stroke="currentColor" stroke-width="1.4" /></svg>
        <span>{c.nav.close}</span>
      </button>
    </div>

    <div class="ov__body">
      <section class="ov__col ov__col--industries">
        <h2 class="ov__h t-label">{c.nav.industries}</h2>
        <ul class="ov__inds">
          {rows.map(({ ind, name, tile, href }, i) => (
            <li>
              <a
                class="ind-row"
                href={href}
                aria-current={current === ind.key ? 'page' : undefined}
                style={`--row-accent:${ind.palette.accent}`}
              >
                <span class="ind-row__n t-mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="ind-row__name">{name}</span>
                {tile && <span class="ind-row__parts t-fine">{tile}</span>}
                <span class="ind-row__swatch" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <div class="ov__side">
        <section class="ov__col">
          <h2 class="ov__h t-label">{c.nav.home}</h2>
          <ul class="ov__pages">
            <li><a href={localePath(locale)} class="ov__page">{c.nav.home}</a></li>
            {pages.map((p) => (
              <li>
                <a href={p.href} class="ov__page" aria-current={current === p.key ? 'page' : undefined}>
                  {p.label}
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section class="ov__col">
          <h2 class="ov__h t-label">{c.nav.language}</h2>
          <ul class="ov__langs">
            {LOCALE_ORDER.map((code) => {
              const l = LOCALES[code];
              return (
                <li>
                  <a
                    class="ov__lang"
                    href={swapLocale(pathname, code)}
                    lang={l.tag}
                    dir={l.dir}
                    aria-current={code === locale ? 'true' : undefined}
                  >
                    <span class="ov__lang-native">{l.native}</span>
                    <span class="ov__lang-code t-mono" dir="ltr">{code.toUpperCase()}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      </div>
    </div>
  </div>
</div>

<script>
  /**
   * Open/close with focus management. The overlay is `hidden` in markup, so a
   * visitor without JavaScript never sees an inert panel — the header links
   * still carry them everywhere the overlay would.
   */
  const overlay = document.querySelector<HTMLElement>('[data-nav-overlay]');
  const openers = document.querySelectorAll<HTMLElement>('[data-nav-open]');
  if (overlay && openers.length) {
    const panel = overlay.querySelector<HTMLElement>('.ov__panel')!;
    let lastFocused: HTMLElement | null = null;

    const focusables = () =>
      Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))
        .filter((el) => el.offsetParent !== null);

    const open = () => {
      lastFocused = document.activeElement as HTMLElement;
      overlay.hidden = false;
      // Force a frame so the transition runs from the hidden state.
      requestAnimationFrame(() => overlay.setAttribute('data-open', 'true'));
      document.documentElement.style.overflow = 'hidden';
      openers.forEach((o) => o.setAttribute('aria-expanded', 'true'));
      focusables()[0]?.focus();
    };

    const close = () => {
      overlay.removeAttribute('data-open');
      document.documentElement.style.removeProperty('overflow');
      openers.forEach((o) => o.setAttribute('aria-expanded', 'false'));
      const done = () => { overlay.hidden = true; };
      overlay.addEventListener('transitionend', done, { once: true });
      // Belt and braces if the transition is suppressed by reduced motion.
      setTimeout(done, 400);
      lastFocused?.focus();
    };

    openers.forEach((o) => o.addEventListener('click', open));
    overlay.querySelectorAll('[data-nav-close]').forEach((el) => el.addEventListener('click', close));

    document.addEventListener('keydown', (e) => {
      if (overlay.hidden) return;
      if (e.key === 'Escape') { close(); return; }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>

<style>
  .ov { position: fixed; inset: 0; z-index: var(--z-overlay); }
  .ov[hidden] { display: none; }

  .ov__scrim {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, #0B0D0F 62%, transparent);
    opacity: 0;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .ov[data-open] .ov__scrim { opacity: 1; }

  .ov__panel {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(100%, 62rem);
    background: var(--surface-raise, #fff);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    transform: translateX(var(--slide, 3%));
    opacity: 0;
    transition: transform var(--dur-4) var(--ease-out), opacity var(--dur-3) var(--ease-out);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  [dir='rtl'] .ov__panel { --slide: -3%; }
  .ov[data-open] .ov__panel { transform: none; opacity: 1; }

  .ov__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-5) clamp(1.25rem, 3vw, 2.5rem);
    border-block-end: var(--rule);
    position: sticky;
    inset-block-start: 0;
    background: inherit;
    z-index: 1;
  }
  .ov__close {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    transition: color var(--dur-2) var(--ease-out);
  }
  .ov__close:hover { color: var(--ink); }
  .ov__close svg { inline-size: 0.9rem; block-size: 0.9rem; }

  .ov__body {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 0;
    flex: 1;
  }
  @media (max-width: 820px) { .ov__body { grid-template-columns: 1fr; } }

  .ov__col { padding: clamp(1.25rem, 3vw, 2.25rem); }
  .ov__col--industries { border-inline-end: var(--rule); }
  @media (max-width: 820px) {
    .ov__col--industries { border-inline-end: 0; border-block-end: var(--rule); }
  }
  .ov__side { display: flex; flex-direction: column; }
  .ov__side .ov__col + .ov__col { border-block-start: var(--rule); }

  .ov__h { display: block; margin-block-end: var(--sp-4); }

  /* ── Industry rows ─────────────────────────────────────────────────────── */
  .ind-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas: 'n name swatch' '. parts swatch';
    align-items: baseline;
    column-gap: var(--sp-4);
    padding-block: 0.68rem;
    border-block-end: var(--rule);
    position: relative;
    transition: padding-inline-start var(--dur-3) var(--ease-out);
  }
  .ind-row__n { grid-area: n; font-size: var(--step--2); color: var(--ink-muted); letter-spacing: 0.1em; }
  .ind-row__name { grid-area: name; font-size: var(--step-0); font-weight: var(--weight-medium); }
  .ind-row__parts { grid-area: parts; margin-block-start: 0.15rem; }
  .ind-row__swatch {
    grid-area: swatch;
    align-self: center;
    inline-size: 0.55rem;
    block-size: 0.55rem;
    background: var(--row-accent);
    opacity: 0.32;
    transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .ind-row:hover { padding-inline-start: 0.4rem; }
  .ind-row:hover .ind-row__swatch,
  .ind-row[aria-current='page'] .ind-row__swatch { opacity: 1; transform: scale(1.25); }
  .ind-row[aria-current='page'] .ind-row__name { color: var(--row-accent); }

  /* ── Pages + languages ─────────────────────────────────────────────────── */
  .ov__pages { display: grid; gap: 0.15rem; }
  .ov__page {
    display: block;
    padding-block: 0.5rem;
    font-size: var(--step-1);
    font-weight: var(--weight-medium);
    letter-spacing: var(--track-head);
    transition: color var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out);
  }
  .ov__page:hover { color: var(--accent-deep); transform: translateX(3px); }
  [dir='rtl'] .ov__page:hover { transform: translateX(-3px); }
  .ov__page[aria-current='page'] { color: var(--accent-deep); }

  .ov__langs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 1px;
    background: var(--line);
    border: var(--rule);
  }
  .ov__lang {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.7rem;
    background: var(--surface-raise, #fff);
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
  }
  .ov__lang:hover { background: var(--ink); color: var(--surface); }
  .ov__lang[aria-current='true'] { background: var(--accent-wash); color: var(--accent-deep); }
  .ov__lang-native { font-size: var(--step--1); }
  .ov__lang-code { font-size: 0.62rem; letter-spacing: 0.13em; opacity: 0.55; }
  .ov__lang[lang='ur'] .ov__lang-native { font-family: var(--font-urdu); line-height: 1.9; }
  .ov__lang[lang='hy'] .ov__lang-native { font-family: var(--font-armenian); }
  .ov__lang[lang='th'] .ov__lang-native { font-family: var(--font-thai); }
  .ov__lang[lang='zh-Hans'] .ov__lang-native { font-family: var(--font-han); }
  .ov__lang[lang='ar'] .ov__lang-native { font-family: var(--font-arabic); }
  .ov__lang[lang='fa'] .ov__lang-native { font-family: var(--font-persian); }
  .ov__lang[lang='ru'] .ov__lang-native { font-family: var(--font-cyrillic); }
</style>
