# Nothing here is required to build or run the site — every value the project
# needs lives in src/config/site.ts, which is the single place to edit when the
# real contact details arrive.
#
# These exist for deployment only.

# Overrides SITE.origin at build time if your host sets it.
# PUBLIC_SITE_ORIGIN=https://metalform.co

# Set once an analytics provider is connected. See src/scripts/analytics.ts —
# no provider is wired today and nothing is sent anywhere.
# PUBLIC_ANALYTICS_ID=
